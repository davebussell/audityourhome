---
/** FAQ block for /us/programs/ pages. The page adds the matching faqSchema() JSON-LD. */
interface Props {
  faqs: { q: string; a: string }[];
  heading?: string;
  id?: string;
}
const { faqs, heading = 'Common questions', id = 'faq' } = Astro.props;
---

<section class="pfaq" id={id} aria-labelledby={`${id}-h`}>
  <h2 class="up-sec" id={`${id}-h`}>{heading}</h2>
  <div class="measure">
    {faqs.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <div class="faq-body"><p>{f.a}</p></div>
      </details>
    ))}
  </div>
</section>

<style>
  .pfaq { padding: 0; margin-bottom: 8px; }
</style>
