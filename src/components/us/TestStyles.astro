---
/**
 * Shared styles for the US testing guide (/us/tests/…). Everything is scoped under
 * .ust so it can't leak into other pages that happen to share a CSS chunk.
 */
---

<style is:global>
  .ust .crumbs { padding-top: 24px; font-size: 13.5px; color: var(--faint); }
  .ust .crumbs a { color: var(--muted); }
  .ust .hero-ctas { display: flex; flex-wrap: wrap; gap: 10px; margin: 6px 0 10px; }

  /* at-a-glance tiles */
  .ust .glance { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin: 4px 0 30px; }
  .ust .glance .g { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; min-width: 0; }
  .ust .glance .k { font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); margin-bottom: 4px; }
  .ust .glance .v { font-family: var(--mono); font-weight: 600; font-size: 15px; color: var(--ink); margin: 0; line-height: 1.35; }
  .ust .glance .gs { margin: 6px 0 0; font-size: 12px; }
  .ust .glance .gs a { color: var(--steel); }
  @media (max-width: 840px) { .ust .glance { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 380px) { .ust .glance { grid-template-columns: 1fr; } }

  /* sections and prose (global.css gives every <section> 64px padding; these are tighter) */
  .ust section.sec { padding: 0; }
  .ust .sec { margin: 40px 0 8px; }
  .ust .sec > h2, .ust h2.sh { font-size: 25px; margin: 0 0 10px; }
  .ust .sec h3 { font-size: 18px; margin: 18px 0 6px; }
  .ust .prose p, .ust .prose li { max-width: 68ch; }
  .ust .prose ul, .ust .prose ol { padding-left: 20px; margin: 0 0 1em; }
  .ust .prose li { margin-bottom: 6px; }
  .ust .num { font-family: var(--mono); font-weight: 600; white-space: nowrap; }
  .ust .formula { font-family: var(--mono); font-weight: 600; font-size: 16px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 16px; display: inline-block; max-width: 100%; }

  /* citations */
  .ust .cite { font-size: 12.5px; color: var(--faint); margin: 6px 0 14px; line-height: 1.5; }
  .ust .cite a { color: var(--steel); }
  .ust span.cite { margin: 0; }

  /* numbered steps */
  .ust .steps { counter-reset: s; list-style: none; padding: 0; margin: 10px 0 8px; display: grid; gap: 12px; max-width: 68ch; }
  .ust .steps li { position: relative; padding: 14px 16px 14px 58px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); }
  .ust .steps li::before { counter-increment: s; content: counter(s); position: absolute; left: 16px; top: 15px; width: 28px; height: 28px; border-radius: 50%; background: var(--heat); color: #fff; font-family: var(--mono); font-weight: 600; display: grid; place-items: center; font-size: 14px; }
  .ust .steps h3 { margin: 0 0 4px; font-size: 16.5px; }
  .ust .steps p { margin: 0; font-size: 15px; color: var(--muted); }
  .ust .steps p + p { margin-top: 6px; }

  /* standard / threshold cards */
  .ust .std-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin: 12px 0 6px; }
  .ust .std { background: var(--card); border: 1px solid var(--line); border-left: 4px solid var(--steel); border-radius: var(--radius); padding: 16px 18px; min-width: 0; }
  .ust .std .sv { font-family: var(--mono); font-weight: 600; font-size: 20px; color: var(--ink); margin: 0 0 2px; line-height: 1.25; }
  .ust .std .sl { font-family: var(--display); font-weight: 700; font-size: 15px; margin: 0 0 6px; }
  .ust .std p { font-size: 14.5px; color: var(--muted); margin: 0 0 6px; }
  .ust .std .cite { margin: 8px 0 0; }
  .ust .std.warn { border-left-color: var(--warn); }
  .ust .std.heat { border-left-color: var(--heat); }
  .ust .std.pine { border-left-color: var(--pine); }
  .ust .std.dead { border-left-color: var(--dead); }

  /* callouts */
  .ust .callout { border-left: 4px solid var(--heat); margin: 22px 0; max-width: 76ch; }
  .ust .callout h3 { margin: 0 0 6px; font-size: 18px; }
  .ust .callout p { font-size: 15px; }
  .ust .callout.pine { border-left-color: var(--pine); }
  .ust .callout.steel { border-left-color: var(--steel); }
  .ust .callout.dead { border-left-color: var(--dead); }

  /* tables */
  .ust .tablewrap { margin: 12px 0 6px; }
  .ust table caption { text-align: left; font-family: var(--display); font-weight: 700; font-size: 15px; padding: 0 0 8px; color: var(--ink); }
  .ust td .chip { white-space: normal; }
  .ust td details { margin-top: 6px; font-size: 14px; color: var(--muted); }
  .ust td details summary { cursor: pointer; color: var(--steel); font-weight: 600; font-size: 13.5px; }
  .ust td details p { margin: 6px 0 0; }
  .ust .datatable td, .ust .datatable th { font-size: 14.5px; }
  .ust .datatable td:first-child { font-weight: 600; }
  .ust .datatable .src-cell a { white-space: normal; }
  @media (min-width: 641px) {
    .ust .datatable td:first-child { white-space: nowrap; }
  }
  /* phones: state name and status chip share a line; text and source follow without labels */
  @media (max-width: 640px) {
    .ust table.stack.datatable td.st-name { display: inline-block; width: auto; margin-right: 8px; }
    .ust table.stack.datatable td.st-status { display: inline-block; width: auto; vertical-align: 2px; }
    .ust table.stack.datatable td.st-text { margin-top: 4px; }
    .ust table.stack.datatable td.src-cell { margin-top: 6px; font-size: 13.5px; }
    .ust table.stack td.kv { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 3px 0; }
    .ust table.stack td.kv[data-label]::before { margin-top: 0; }
  }

  /* lists of links / metros */
  .ust .linkrow { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 4px; padding: 0; list-style: none; }
  .ust .linkrow a { display: inline-block; font-size: 14px; font-weight: 600; padding: 6px 12px; border: 1px solid var(--line-strong); border-radius: 999px; text-decoration: none; color: var(--ink); background: var(--card); }
  .ust .linkrow a:hover { border-color: var(--ink); }
  .ust .zonelist { display: grid; gap: 10px; margin: 10px 0 6px; }
  .ust .zonelist .zr { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: 8px 16px; align-items: start; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 14px; }
  .ust .zonelist .zk { font-family: var(--mono); font-weight: 600; font-size: 14px; padding-top: 6px; }
  .ust .zonelist .zk small { display: block; font-family: var(--body); font-weight: 400; color: var(--faint); font-size: 12.5px; }
  .ust .zonelist .linkrow { margin: 0; }
  @media (max-width: 560px) { .ust .zonelist .zr { grid-template-columns: 1fr; } .ust .zonelist .zk { padding-top: 0; } }

  /* FAQ, sources, related */
  .ust .faqs { max-width: 76ch; }
  .ust .faqs .cite { margin: 8px 0 0; }
  .ust .srcs { border-left: 4px solid var(--steel); margin: 32px 0 12px; }
  .ust .srcs h2 { font-size: 21px; margin: 0 0 4px; }
  .ust .srcs ul { margin: 10px 0 0; padding-left: 20px; display: grid; gap: 7px; font-size: 14px; }
  .ust .srcs li { overflow-wrap: anywhere; }
  .ust .srcs .meta { white-space: nowrap; }
  .ust .related { display: flex; flex-wrap: wrap; gap: 10px; margin: 14px 0 26px; }
  .ust .related .btn { white-space: normal; text-align: left; }
  .ust .lead-wrap { margin: 10px 0 44px; }

  /* gear links */
  .ust .gear { margin: 26px 0 8px; padding: 16px 18px; }
  .ust .gear p.gh { font-family: var(--display); font-weight: 700; margin: 0 0 8px; }
  .ust .gear .gnote { margin: 8px 0 0; font-size: 13px; color: var(--faint); }

  @media (max-width: 640px) {
    .ust .sec > h2, .ust h2.sh { font-size: 22px; }
    .ust .steps li { padding: 14px 14px 14px 52px; }
    .ust .steps li::before { left: 12px; }
    .ust .callout { padding: 18px; }
    .ust .srcs { padding: 18px; }
  }
</style>
