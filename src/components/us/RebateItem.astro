---
/**
 * One rebate, incentive or financing offer from a metro research record.
 * Two columns on wide screens (name and status | amount and eligibility), stacked on phones.
 */
import type { RebateView } from '../../lib/us/metro-view';
import { fmtISO } from '../../lib/us/metro-text';
import StatusLine from './StatusLine.astro';

interface Props {
  r: RebateView;
}
const { r } = Astro.props;
---

<article class:list={['card', 'rb', { 'rb-closed': r.status === 'closed' }]}>
  <div class="rb-main">
    <h4 class="rb-name">{r.name}</h4>
    {r.runBy && <p class="rb-by">{r.runBy}</p>}
    <StatusLine text={r.statusText} chip={r.chip} />
    <p class="meta rb-src">
      {r.url ? <a href={r.url} rel="noopener" target="_blank">Official page&nbsp;↗</a> : <span>No official page given</span>}
      {r.checked && <span> · verified {fmtISO(r.checked)}</span>}
    </p>
  </div>
  <div class="rb-detail">
    <p class="rb-amt"><span class="lbl">Amount</span> {r.amount ?? 'Not published'}</p>
    {r.whoQualifies && <p class="rb-who"><span class="lbl">Who qualifies</span> {r.whoQualifies}</p>}
  </div>
</article>

<style>
  .rb { padding: 16px 20px; display: grid; gap: 10px; align-content: start; min-width: 0; box-shadow: none; }
  @media (min-width: 900px) {
    .rb { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 10px 30px; }
  }
  .rb-closed { background: #FBFAF7; }
  .rb-main, .rb-detail { display: grid; gap: 8px; align-content: start; min-width: 0; }
  .rb-name { font-size: 16px; margin: 0; line-height: 1.3; }
  .rb-by { margin: -3px 0 0; font-size: 13px; color: var(--faint); line-height: 1.45; }
  .rb-amt, .rb-who { margin: 0; font-size: 14px; line-height: 1.55; overflow-wrap: anywhere; }
  .rb-amt { color: var(--ink); }
  .rb-who { color: var(--muted); }
  .lbl { display: block; font-family: var(--display); font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin-bottom: 1px; }
  .rb-src { margin: 0; }
  .rb-src a { color: var(--steel); }
</style>
