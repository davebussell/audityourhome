---
/**
 * One house drawn in the era colours and infrared-glow style of the Canadian housing portrait (HousingPortrait.astro,
 * same four shapes), for the US metro signature panel. Decorative: the text beside it says the same thing.
 */
interface Props {
  era: 'pre1961' | 'y1961' | 'y1991' | 'y2001';
  color: string;
  /** Glow strength: older eras glow hotter (they are usually leakier) */
  glow?: number;
}
const { era, color } = Astro.props;
const GLOW = { pre1961: [0.85, 0.95], y1961: [0.62, 0.8], y1991: [0.4, 0.6], y2001: [0.22, 0.42] } as const;
const [glow, win] = GLOW[era];
const id = `hg-${era}`;
---

<svg class="hg" viewBox="-14 6 78 74" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={id}>
      <stop offset="0" stop-color={color} stop-opacity={glow} />
      <stop offset="0.55" stop-color={color} stop-opacity={glow * 0.35} />
      <stop offset="1" stop-color={color} stop-opacity="0" />
    </radialGradient>
  </defs>
  <circle cx="25" cy="50" r="38" fill={`url(#${id})`} />
  <g stroke={color} stroke-width="2" stroke-linejoin="round" fill="#1B2A3A">
    {era === 'pre1961' && (
      <>
        <rect x="32" y="13" width="6" height="18" />
        <path d="M3 38 25 12l22 26Z" />
        <rect x="7" y="37" width="36" height="35" />
        <g fill={color} fill-opacity={win} stroke="none">
          <rect x="12" y="46" width="9" height="10" />
          <rect x="29" y="46" width="9" height="10" />
          <rect x="22" y="24" width="6" height="6" />
        </g>
      </>
    )}
    {era === 'y1961' && (
      <>
        <path d="M-1 47 25 33l26 14Z" />
        <rect x="1" y="47" width="48" height="25" />
        <g fill={color} fill-opacity={win} stroke="none">
          <rect x="6" y="53" width="19" height="10" />
          <rect x="31" y="53" width="10" height="10" />
        </g>
      </>
    )}
    {era === 'y1991' && (
      <>
        <path d="M-1 53 10 46l11 7Z" />
        <rect x="0" y="53" width="20" height="19" />
        <path d="M16 33 33.5 18 51 33Z" />
        <rect x="19" y="33" width="30" height="39" />
        <g fill={color} fill-opacity={win} stroke="none">
          <rect x="24" y="40" width="8" height="8" />
          <rect x="37" y="40" width="8" height="8" />
          <rect x="24" y="56" width="8" height="8" />
        </g>
        <path d="M4 60h12M4 64h12M4 68h12" stroke-width="1.2" fill="none" />
      </>
    )}
    {era === 'y2001' && (
      <>
        <path d="M5 33 45 24v48H5Z" />
        <path d="M2 34.5 48 24" stroke-width="3" stroke-linecap="round" />
        <g fill={color} fill-opacity={win} stroke="none">
          <rect x="10" y="40" width="8" height="18" />
          <rect x="25" y="37" width="14" height="9" />
          <rect x="25" y="53" width="14" height="9" />
        </g>
      </>
    )}
  </g>
  <path d="M-12 72.5H62" stroke="#DCE5EC" stroke-opacity="0.35" />
</svg>

<style>
  .hg { display: block; width: 100%; height: auto; overflow: visible; }
</style>
