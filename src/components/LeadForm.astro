---
import { SITE, ACCOUNTS_ENABLED } from '../config/site';
import { NETLIFY_FORMS, FORM_NAMES } from '../config/forms';
import { regions } from '../lib/data';
import { SERVICES, TIMELINES, BUILDINGS, MATCH_CONSENT } from '../lib/account/catalog';

interface Props {
  heading?: string;
  sub?: string;
  /** Pre-select a region */
  region?: string;
  /** Context tag submitted with the lead */
  context?: string;
}
const {
  heading = 'Get matched with a registered advisor',
  sub = 'Tell us where you are and what you’re planning. We’ll connect you with a registered service organization for your area — no spam, no shared lead lists.',
  region = '',
  context = 'general',
} = Astro.props;

// On Netlify builds the form posts to Netlify Forms (emailed to dave@clickshift.ca); a custom endpoint
// still works if one is set; otherwise people get the email fallback.
const netlifyForm = NETLIFY_FORMS;
const hasEndpoint = netlifyForm || SITE.formEndpoint.length > 0;
const mailtoFallback = `mailto:${SITE.contactEmail}?subject=Audit%20request%20(${encodeURIComponent(context)})`;

/** Pick the most likely service from the page the form sits on. */
function serviceFor(ctx: string): string {
  const c = ctx.toLowerCase();
  const rules: [RegExp, string][] = [
    [/radon/, 'radon'],
    [/well/, 'well-water'],
    [/mold|mould|iaq/, 'mould-air'],
    [/wood-burning|wett/, 'wood-stove'],
    [/asbestos|lead-paint|guide-lead/, 'asbestos-lead'],
    [/windows-doors/, 'windows-doors'],
    [/water-heater/, 'water-heater'],
    [/hrv|ventilation|moisture/, 'ventilation'],
    [/heating-systems|air-conditioning|hvac|thermostat|heat-pump/, 'heat-pump'],
    [/walls|roofs-attics|foundations|air-sealing|insulation/, 'insulation'],
  ];
  return rules.find(([re]) => re.test(c))?.[1] ?? 'energy-audit';
}
const defaultService = serviceFor(context);
const otherAreas: [string, string][] = [
  ['other-ontario', 'Elsewhere in Ontario'],
  ['bc', 'British Columbia'],
  ['alberta', 'Alberta'],
  ['saskatchewan', 'Saskatchewan'],
  ['manitoba', 'Manitoba'],
  ['quebec', 'Quebec'],
  ['new-brunswick', 'New Brunswick'],
  ['nova-scotia', 'Nova Scotia'],
  ['pei', 'Prince Edward Island'],
  ['newfoundland-labrador', 'Newfoundland & Labrador'],
  ['north', 'Yukon / NWT / Nunavut'],
  ['outside-canada', 'Outside Canada'],
];
const uid = `lf-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="card leadform" id="lead-form" data-clarity-mask="true">
  <h3>{heading}</h3>
  <p class="small">{sub}</p>

  {ACCOUNTS_ENABLED ? (
    <div class="lf-acct-wrap">
      <form class="lf-acct" data-context={context} novalidate>
        <div class="grid-2">
          <div class="field">
            <label for={`${uid}-name`}>Name</label>
            <input id={`${uid}-name`} name="name" type="text" autocomplete="name" maxlength="120" required />
          </div>
          <div class="field">
            <label for={`${uid}-email`}>Email</label>
            <input id={`${uid}-email`} name="email" type="email" autocomplete="email" required />
          </div>
        </div>
        <div class="grid-2">
          <div class="field">
            <label for={`${uid}-postal`}>Postal code</label>
            <input id={`${uid}-postal`} name="postal" type="text" autocomplete="postal-code" maxlength="7" required />
          </div>
          <div class="field">
            <label for={`${uid}-region`}>Area</label>
            <select id={`${uid}-region`} name="region">
              <option value="">Choose your area…</option>
              {regions.map((r) => (
                <option value={r.slug} selected={r.slug === region}>{r.name}</option>
              ))}
              {otherAreas.map(([v, l]) => <option value={v}>{l}</option>)}
            </select>
          </div>
        </div>
        <div class="grid-2">
          <div class="field">
            <label for={`${uid}-service`}>What do you need?</label>
            <select id={`${uid}-service`} name="service">
              {SERVICES.map((s) => <option value={s.value} selected={s.value === defaultService}>{s.label}</option>)}
            </select>
          </div>
          <div class="field">
            <label for={`${uid}-timeline`}>When</label>
            <select id={`${uid}-timeline`} name="timeline">
              {TIMELINES.map((t) => <option value={t.value} selected={t.value === '1-3-months'}>{t.label}</option>)}
            </select>
          </div>
        </div>
        <div class="grid-2">
          <div class="field">
            <label for={`${uid}-building`}>Type of building</label>
            <select id={`${uid}-building`} name="building">
              {BUILDINGS.map((b) => <option value={b.value}>{b.label}</option>)}
            </select>
          </div>
          <div class="field">
            <label for={`${uid}-phone`}>Phone <span class="optional">(optional)</span></label>
            <input id={`${uid}-phone`} name="phone" type="tel" autocomplete="tel" maxlength="40" />
          </div>
        </div>
        <div class="field">
          <label for={`${uid}-message`}>What are you planning? <span class="optional">(optional)</span></label>
          <textarea id={`${uid}-message`} name="message" rows="3" maxlength="2000" placeholder="e.g. Drafty 1968 backsplit, thinking insulation + heat pump, want the HRSP rebates"></textarea>
        </div>
        <label class="lf-check"><input type="checkbox" name="consent" value="yes" /> <span>{MATCH_CONSENT}</span></label>
        <label class="lf-check lf-alerts"><input type="checkbox" name="alerts" value="yes" /> <span>Also email me when rebates in my province change (free, a few emails a year, unsubscribe any time).</span></label>
        <button class="btn btn-primary" type="submit">Request my match</button>
        <p class="lf-err" role="alert"></p>
        <p class="meta lf-meta">Next, we email you a 6-digit code to confirm your address. That also opens your free My Home account, where you can follow your request. <a href="/privacy/">Privacy</a></p>
      </form>
      <form class="lf-code" hidden novalidate>
        <p class="lf-code-head"><strong>Check your email.</strong> We sent a code to <span class="lf-email"></span>. Enter it to confirm and send your request, or tap the link in the email.</p>
        <div class="field">
          <label for={`${uid}-code`}>6-digit code</label>
          <input id={`${uid}-code`} name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="12" class="lf-code-in" />
        </div>
        <button class="btn btn-primary" type="submit">Confirm and send</button>
        <p class="lf-err" role="alert"></p>
        <p class="small"><button type="button" class="lf-back linkish">Change my details</button></p>
      </form>
      <div class="lf-done" hidden role="status">
        <p class="lf-done-t">Request sent.</p>
        <p>We review every request and introduce you to one company that serves your area, usually within one business day. You can follow it, and add your home details, in My Home.</p>
        <a class="btn btn-ghost" href="/account/#match">Open My Home</a>
      </div>
    </div>
  ) : hasEndpoint ? (
    <form
      method="POST"
      action={netlifyForm ? '/ca/thanks/' : SITE.formEndpoint}
      name={netlifyForm ? FORM_NAMES.auditRequest : undefined}
      data-netlify={netlifyForm ? 'true' : undefined}
      netlify-honeypot={netlifyForm ? 'bot-field' : undefined}
      class="lf-netlify"
      data-context={context}
    >
      {netlifyForm && <input type="hidden" name="form-name" value={FORM_NAMES.auditRequest} />}
      <input type="hidden" name="context" value={context} />
      {netlifyForm && <input type="hidden" name="subject" value={`Audit request (${context})`} />}
      {netlifyForm && <p class="lf-hide"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>}
      <div class="grid-2">
        <div class="field">
          <label for={`${uid}-f-name`}>Name</label>
          <input id={`${uid}-f-name`} name="name" type="text" autocomplete="name" maxlength="120" required />
        </div>
        <div class="field">
          <label for={`${uid}-f-email`}>Email</label>
          <input id={`${uid}-f-email`} name="email" type="email" autocomplete="email" maxlength="200" required />
        </div>
      </div>
      <div class="grid-2">
        <div class="field">
          <label for={`${uid}-f-postal`}>Postal code</label>
          <input id={`${uid}-f-postal`} name="postal" type="text" autocomplete="postal-code" maxlength="7" required />
        </div>
        <div class="field">
          <label for={`${uid}-f-region`}>Area</label>
          <select id={`${uid}-f-region`} name="region">
            <option value="">Choose your area…</option>
            {regions.map((r) => (
              <option value={r.slug} selected={r.slug === region}>{r.name}</option>
            ))}
            {otherAreas.map(([v, l]) => <option value={v}>{l}</option>)}
          </select>
        </div>
      </div>
      <div class="field">
        <label for={`${uid}-f-building`}>Type of building</label>
        <select id={`${uid}-f-building`} name="building">
          <option value="house">House (detached, semi, row or town)</option>
          <option value="duplex-triplex">Duplex or triplex</option>
          <option value="multi-unit">Multi-unit building (4 or more units)</option>
          <option value="condo-unit">Condo unit</option>
          <option value="commercial">Commercial building</option>
        </select>
      </div>
      <div class="field">
        <label for={`${uid}-f-phone`}>Phone <span class="optional">(optional)</span></label>
        <input id={`${uid}-f-phone`} name="phone" type="tel" autocomplete="tel" maxlength="40" />
      </div>
      <div class="field">
        <label for={`${uid}-f-message`}>What are you planning? <span class="optional">(optional)</span></label>
        <textarea id={`${uid}-f-message`} name="message" rows="3" maxlength="4000" placeholder="e.g. Drafty 1968 backsplit, thinking insulation + heat pump, want the HRSP rebates"></textarea>
      </div>
      <button class="btn btn-primary" type="submit">Request my match</button>
      <p class="meta consent">By submitting you agree we may share your request with one registered service organization serving your area. Participating advisors pay us a referral fee — you pay nothing, and it never affects the directory. See our <a href="/privacy/">privacy note</a>.</p>
    </form>
  ) : (
    <div class="fallback">
      <p>
        Email us what you’re planning, your postal code and the type of building (a house, a duplex
        or triplex, or a larger multi-unit building) — we’ll reply with registered service
        organizations for your area and which rebates apply.
      </p>
      <a class="btn btn-primary" href={mailtoFallback}>Email {SITE.contactEmail}</a>
      <p class="meta">This inbox is answered by a person. Participating advisors pay us a referral fee — you pay nothing, and it never affects the directory.</p>
    </div>
  )}
</div>

<script>
  // Netlify form: record the lead in analytics without any personal details.
  document.querySelectorAll<HTMLFormElement>('form.lf-netlify').forEach((f) => {
    f.addEventListener('submit', () => {
      const w = window as unknown as { gtag?: (...a: unknown[]) => void };
      try {
        w.gtag?.('event', 'generate_lead', { form_name: 'audit_request', country: 'ca', page_context: f.dataset.context });
      } catch {
        /* analytics is optional */
      }
    });
  });

  // Account-backed lead form: hold the request, confirm the email with a code,
  // then release it. The account code loads only when someone submits.
  const AREA_PROVINCE: Record<string, string> = {
    bc: 'BC', alberta: 'AB', saskatchewan: 'SK', manitoba: 'MB', quebec: 'QC', 'new-brunswick': 'NB',
    'nova-scotia': 'NS', pei: 'PE', 'newfoundland-labrador': 'NL', north: 'YT', 'other-ontario': 'ON',
  };
  const FSA: Record<string, string> = { A: 'NL', B: 'NS', C: 'PE', E: 'NB', G: 'QC', H: 'QC', J: 'QC', K: 'ON', L: 'ON', M: 'ON', N: 'ON', P: 'ON', R: 'MB', S: 'SK', T: 'AB', V: 'BC', X: 'NT', Y: 'YT' };

  document.querySelectorAll<HTMLElement>('.lf-acct-wrap').forEach((wrap) => {
    const form = wrap.querySelector<HTMLFormElement>('form.lf-acct')!;
    const codeForm = wrap.querySelector<HTMLFormElement>('form.lf-code')!;
    const done = wrap.querySelector<HTMLElement>('.lf-done')!;
    const err = (f: HTMLFormElement, m: string) => { f.querySelector<HTMLElement>('.lf-err')!.textContent = m; };
    let email = '';
    let key = '';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const v = (k: string) => String(fd.get(k) ?? '').trim();
      email = v('email').toLowerCase();
      const postal = v('postal').toUpperCase().replace(/[^A-Z0-9]/g, '');
      if (!v('name')) return err(form, 'Please add your name.');
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return err(form, 'Please enter a valid email address.');
      if (!postal) return err(form, 'Please add your postal code.');
      if (v('consent') !== 'yes') return err(form, 'Please tick the box so we can share your request with one company.');
      err(form, '');
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      btn.textContent = 'Sending…';
      const province = (/^[A-Z]\d[A-Z]/.test(postal) ? FSA[postal[0]] : '') || AREA_PROVINCE[v('region')] || (v('region') ? 'ON' : '');
      try {
        const { startSignIn, queueAndClaim, signedInEmail } = await import('../lib/account/client');
        const { alertConsentText, MATCH_CONSENT } = await import('../lib/account/catalog');
        const pending: { kind: 'match' | 'alerts' | 'plan'; payload: Record<string, unknown> }[] = [];
        // On the planner, save the plan too, so the match arrives with the home details.
        const plan = (window as unknown as { ayhPlan?: Record<string, unknown> }).ayhPlan;
        if (plan && form.dataset.context === 'planner') pending.push({ kind: 'plan', payload: plan });
        pending.push({
          kind: 'match',
          payload: {
            service: v('service'), timeline: v('timeline'), building: v('building'), details: v('message'),
            name: v('name'), phone: v('phone'), contact_pref: v('phone') ? 'phone' : 'email',
            postal, province, region: v('region'), source: form.dataset.context === 'planner' ? 'planner' : 'lead-form',
            context: form.dataset.context, consent: 'true', consent_text: MATCH_CONSENT,
          },
        });
        if (v('alerts') === 'yes' && province) {
          pending.push({ kind: 'alerts', payload: { program_updates: 'true', provinces: [province], consent_text: alertConsentText(['program_updates']) } });
        }
        // Already signed in with this address: no code needed.
        if ((await signedInEmail()) === email) {
          await queueAndClaim(email, pending);
          form.hidden = true;
          done.hidden = false;
          return;
        }
        key = await startSignIn(email, pending, 'match');
        form.hidden = true;
        codeForm.hidden = false;
        codeForm.querySelector<HTMLElement>('.lf-email')!.textContent = email;
        codeForm.querySelector<HTMLInputElement>('input[name=code]')!.focus();
      } catch (ex) {
        const { friendlyError } = await import('../lib/account/client');
        err(form, friendlyError(ex));
      } finally {
        btn.disabled = false;
        btn.textContent = 'Request my match';
      }
    });

    codeForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = String(new FormData(codeForm).get('code') ?? '').replace(/\D/g, '');
      if (code.length < 6) return err(codeForm, 'Enter the code from the email.');
      const btn = codeForm.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      btn.textContent = 'Checking…';
      try {
        const { verifyCode, claim } = await import('../lib/account/client');
        await verifyCode(email, code);
        await claim(key);
        codeForm.hidden = true;
        done.hidden = false;
      } catch (ex) {
        const { friendlyError } = await import('../lib/account/client');
        err(codeForm, friendlyError(ex));
      } finally {
        btn.disabled = false;
        btn.textContent = 'Confirm and send';
      }
    });

    codeForm.querySelector('.lf-back')?.addEventListener('click', () => {
      codeForm.hidden = true;
      form.hidden = false;
    });
  });
</script>

<style>
  .leadform { padding: 28px 30px; border-top: 4px solid var(--heat); }
  .leadform h3 { margin-bottom: 4px; }
  .optional { font-weight: 400; color: var(--faint); }
  .consent { margin-top: 12px; }
  .lf-hide { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .fallback { display: grid; gap: 10px; justify-items: start; }
  .leadform input[type='tel'] {
    width: 100%; font-family: var(--body); font-size: 16px; color: var(--ink); background: #fff;
    border: 1.5px solid var(--line-strong); border-radius: 8px; padding: 11px 14px;
  }
  .lf-check { display: flex; gap: 10px; align-items: flex-start; font-weight: 500; font-size: 13.5px; line-height: 1.5; margin: 0 0 12px; color: var(--ink); }
  .lf-check input { margin-top: 3px; width: 17px; height: 17px; flex-shrink: 0; accent-color: var(--heat); }
  .lf-alerts { color: var(--muted); }
  .lf-err { color: var(--dead); font-weight: 600; font-size: 14px; margin: 10px 0 0; }
  .lf-err:empty { display: none; }
  .lf-meta { margin-top: 12px; }
  .lf-code-head { font-size: 15px; }
  .lf-code-in { font-family: var(--mono) !important; font-size: 22px !important; letter-spacing: 0.25em; max-width: 220px; }
  .lf-done { background: var(--pine-tint); border-radius: var(--radius); padding: 16px 18px; }
  .lf-done-t { font-family: var(--display); font-weight: 800; font-size: 20px; color: var(--pine-deep); margin: 0 0 6px; }
  .linkish { background: none; border: 0; padding: 0; cursor: pointer; font: inherit; font-weight: 600; color: var(--heat-deep); text-decoration: underline; }
</style>
