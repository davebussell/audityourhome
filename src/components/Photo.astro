---
/**
 * Responsive site photo (AVIF/WebP via astro:assets) in a camera-viewfinder frame,
 * with an optional instrument-style label in the corner.
 */
import { Picture } from 'astro:assets';
import { photo as getPhoto } from '../lib/photos';

interface Props {
  /** Key in src/lib/photos.ts */
  name: string;
  /** `sizes` attribute for the responsive image */
  sizes?: string;
  /** Above the fold: load eagerly with high fetch priority */
  eager?: boolean;
  /** CSS aspect-ratio for the crop, e.g. "4 / 3" (default: the photo's own) */
  ratio?: string;
  /** Show the corner label (true = the photo's default; a string overrides it; false hides it) */
  hud?: boolean | string;
  /** Hide the viewfinder corner marks */
  plain?: boolean;
  caption?: string;
  class?: string;
}

const {
  name,
  sizes = '(max-width: 860px) calc(100vw - 44px), 500px',
  eager = false,
  ratio,
  hud = true,
  plain = false,
  caption,
  class: cls,
} = Astro.props;

const p = getPhoto(name);
if (!p) throw new Error(`Photo.astro: unknown photo "${name}"`);
const widths = [480, 768, p.src.width].filter((w, i, a) => w <= p.src.width && a.indexOf(w) === i);
const hudText = typeof hud === 'string' ? hud : hud ? p.hud : undefined;
---

<figure class:list={['photo', cls]} style={ratio ? `--ratio: ${ratio}` : undefined}>
  <div class="frame">
    <Picture
      src={p.src}
      alt={p.alt}
      widths={widths}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={68}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
    />
    {!plain && <span class="vf" aria-hidden="true"></span>}
    {hudText && <span class="hud" aria-hidden="true"><i></i>{hudText}</span>}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .photo { margin: 0; min-width: 0; }
  .frame {
    container-type: inline-size;
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: #1e2f41;
    aspect-ratio: var(--ratio, auto);
    box-shadow: var(--shadow-md);
    isolation: isolate;
  }
  .frame :global(picture) { display: block; height: 100%; }
  .frame :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* viewfinder corner marks */
  .vf {
    position: absolute;
    inset: 12px;
    pointer-events: none;
    --c: rgba(255, 255, 255, 0.82);
    --l: 18px;
    --t: 2px;
    background:
      linear-gradient(var(--c), var(--c)) top left / var(--l) var(--t) no-repeat,
      linear-gradient(var(--c), var(--c)) top left / var(--t) var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) top right / var(--l) var(--t) no-repeat,
      linear-gradient(var(--c), var(--c)) top right / var(--t) var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) bottom left / var(--l) var(--t) no-repeat,
      linear-gradient(var(--c), var(--c)) bottom left / var(--t) var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) bottom right / var(--l) var(--t) no-repeat,
      linear-gradient(var(--c), var(--c)) bottom right / var(--t) var(--l) no-repeat;
  }
  .hud {
    position: absolute;
    left: 20px;
    bottom: 20px;
    max-width: calc(100% - 40px);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.2;
    color: #fff;
    background: rgba(20, 32, 44, 0.66);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    padding: 5px 10px 5px 8px;
    border-radius: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hud i {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--heat);
    box-shadow: 0 0 0 3px rgba(224, 92, 31, 0.28);
    animation: rec 2.4s ease-in-out infinite;
  }
  @keyframes rec { 50% { opacity: 0.35; } }
  /* smaller marks and label on small frames (cards, thumbnails) */
  @container (max-width: 340px) {
    .vf { inset: 8px; --l: 11px; --t: 1.5px; }
    .hud { left: 12px; bottom: 12px; font-size: 10.5px; padding: 4px 8px 4px 7px; }
  }
  figcaption { font-size: 13px; color: var(--faint); margin-top: 8px; line-height: 1.45; }
</style>
