---
/**
 * The sky behind the top of a page: a gradient, a sun, three layers of slowly drifting cloud and, on home pages, a paper plane
 * crossing. Pure decoration (aria-hidden, no pointer events), drawn by src/styles/sky.css. Rendered once, first in <body>, by
 * both layouts; the shapes are CSS backgrounds, so the markup costs a few hundred bytes a page.
 *
 *   kind="page"  the band behind a normal page's heading (default)
 *   kind="hero"  taller, with the plane: for the home pages
 */
interface Props {
  kind?: 'page' | 'hero';
}
const { kind = 'page' } = Astro.props;
---

<div class="sky" data-kind={kind} aria-hidden="true">
  <i class="sky-far"></i>
  {kind === 'hero' && <b class="sky-plane"></b>}
  <i class="sky-mid"></i>
  <i class="sky-near"></i>
</div>
