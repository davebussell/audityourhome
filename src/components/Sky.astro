---
/**
 * The wash behind the top of a page: a pale blue-to-paper gradient with a faint, still haze (a faint drawing grid on the building
 * site). Pure decoration (aria-hidden, no pointer events), drawn by src/styles/sky.css. Rendered once, first in <body>, by both
 * layouts.
 *
 *   kind="page"  the band behind a normal page's heading (default)
 *   kind="hero"  taller: for the home pages
 */
interface Props {
  kind?: 'page' | 'hero';
}
const { kind = 'page' } = Astro.props;
---

<div class="sky" data-kind={kind} aria-hidden="true"></div>
