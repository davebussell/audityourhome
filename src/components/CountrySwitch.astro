---
/**
 * Canada / United States switcher. Each country is its own site (audityourhome.ca and
 * audityourhome.com), so the links cross domains: to the same page on the other site when one
 * exists (read at runtime from the page's hreflang alternates), otherwise to that site's home.
 * Links go through the other site's /switch/ page, which records the choice (ayh_site cookie) so
 * that site neither redirects the visitor back by country nor shows its "other site" bar.
 */
import { COUNTRIES, switchUrl, type Country } from '../lib/country';

interface Props {
  current: Country | null;
  variant?: 'desk' | 'mobile';
}
const { current, variant = 'desk' } = Astro.props;
const list = [COUNTRIES.ca, COUNTRIES.us];
const hrefFor = (c: (typeof list)[number]) => (c.code === current ? '/' : switchUrl(c.code, '/'));
---

<div class:list={['ctry', variant]} role="group" aria-label="Country">
  {variant === 'mobile' && <span class="ctry-t">Country</span>}
  {list.map((c) => (
    <a
      href={hrefFor(c)}
      data-ctry={c.code}
      data-locale={c.locale}
      data-origin={c.origin}
      aria-current={current === c.code ? 'true' : undefined}
      title={c.name}
    >
      <span class="ctry-short" aria-hidden="true">{c.short}</span>
      <span class="ctry-name">{c.name}</span>
    </a>
  ))}
</div>

<style>
  .ctry { display: inline-flex; align-items: center; gap: 2px; border: 1.5px solid var(--line-strong); border-radius: 999px; padding: 2px; background: var(--card); }
  .ctry a {
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--mono); font-weight: 700; font-size: 12px; letter-spacing: 0.06em;
    color: var(--steel); text-decoration: none; border-radius: 999px; padding: 5px 8px; line-height: 1;
  }
  .ctry a:hover { color: var(--heat-deep); }
  .ctry a[aria-current='true'] { background: var(--navy); color: #fff; }
  .ctry .ctry-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ctry.mobile { display: flex; width: 100%; border: none; padding: 0; gap: 8px; background: none; margin: 4px 0 10px; }
  .ctry.mobile .ctry-t { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--steel); font-weight: 600; margin-right: 4px; }
  .ctry.mobile a { flex: 1; border: 1.5px solid var(--line-strong); padding: 10px 12px; font-family: var(--body); font-size: 14px; letter-spacing: 0; }
  .ctry.mobile .ctry-short { display: none; }
  .ctry.mobile .ctry-name { position: static; width: auto; height: auto; overflow: visible; clip: auto; }
</style>

<script>
  import { CHOICE_COOKIE } from '../lib/country';
  const current = document.documentElement.dataset.country;
  const alt: Record<string, string> = {};
  document.querySelectorAll<HTMLLinkElement>('link[rel="alternate"][hreflang]').forEach((l) => {
    alt[l.hreflang.toLowerCase()] = l.href;
  });
  document.querySelectorAll<HTMLAnchorElement>('.ctry a[data-ctry]').forEach((a) => {
    const code = a.dataset.ctry || '';
    if (code === current) return;
    const locale = (a.dataset.locale || '').toLowerCase();
    if (alt[locale]) {
      const u = new URL(alt[locale]);
      a.href = `${u.origin}/switch/?to=${encodeURIComponent(u.pathname)}`;
    }
    a.addEventListener('click', () => {
      // Staying is also a choice: the banner on this site should not nag after a deliberate switch back.
      document.cookie = `${CHOICE_COOKIE}=${code}; path=/; max-age=31536000; samesite=lax`;
    });
  });
</script>
