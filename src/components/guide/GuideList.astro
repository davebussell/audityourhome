---
/** Cards linking to the buying guides: all of them on the hub, the others at the foot of each guide. */
import { GUIDES, HUB } from '../../lib/guide-run';

interface Props {
  /** the guide this list sits on, left out of the cards */
  current?: string;
  heading?: string;
}
const { current, heading = 'More buying guides' } = Astro.props;
const list = GUIDES.filter((g) => g.slug !== current);
---

<section class="sec" id="more-guides">
  <h2>{heading}</h2>
  <div class="g-links">
    {list.map((g) => (
      <a class="card" href={g.path}>
        <strong>{g.name}</strong>
        <span>{g.blurb}</span>
      </a>
    ))}
  </div>
  {current && <p class="g-more"><a class="btn btn-ghost btn-sm" href={HUB}>All buying guides</a></p>}
</section>
