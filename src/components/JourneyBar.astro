---
/**
 * "Your audit journey": the same four stages on every flow page, so people always know where
 * they are and what comes next. Stage names live in src/lib/journey.ts (the planners use them too).
 *
 *   <JourneyBar country="ca" current={2} />                  find page, booking
 *   <JourneyBar country="us" current={3} ticks={false} />    how-it-works: a map, nothing "done"
 *   <JourneyBar country="ca" current={2} compact />          one line per stage, no descriptions
 */
import { journeyStages, type JourneyCountry, type JourneyStep } from '../lib/journey';

interface Props {
  country: JourneyCountry;
  /** The stage this page is about (1–4) */
  current: JourneyStep;
  /** Hide the one-line descriptions */
  compact?: boolean;
  /** Tick the stages before the current one as done (true on the planner results) */
  ticks?: boolean;
  /** Tag on the current stage */
  hereLabel?: string;
  class?: string;
}
const { country, current, compact = false, ticks = true, hereLabel = 'You are here', class: cls } = Astro.props;
const stages = journeyStages(country);
---

<nav class:list={['journey', compact && 'journey-compact', cls]} aria-label="Your audit journey">
  <p class="jb-k">Your audit journey <span class="jb-of">· stage {current} of 4</span></p>
  <ol class="jb-list">
    {stages.map((s) => {
      const done = ticks && s.n < current;
      const now = s.n === current;
      return (
        <li class:list={['jb-step', done && 'is-done', now && 'is-now']}>
          <a href={s.href} aria-current={now ? 'step' : undefined}>
            <span class="jb-n" aria-hidden="true">{done ? '✓' : s.n}</span>
            <span class="jb-t">
              <span class="jb-l">{s.label}{done && <span class="sr-only"> (done)</span>}</span>
              {!compact && <span class="jb-s">{s.sub}</span>}
              {now && <span class="jb-here">{hereLabel}</span>}
            </span>
          </a>
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .journey { margin: 18px 0 6px; }
  .jb-k {
    font-family: var(--mono); font-size: 11.5px; font-weight: 600; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--muted); margin: 0 0 8px;
  }
  .jb-of { color: var(--faint); letter-spacing: 0.06em; }
  .jb-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px;
  }
  .jb-step { min-width: 0; }
  .jb-step a {
    display: flex; gap: 10px; align-items: flex-start; height: 100%;
    padding: 10px 12px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    color: var(--ink); text-decoration: none; transition: border-color 0.15s ease;
  }
  .jb-step a:hover { border-color: var(--line-strong); color: var(--ink); }
  .jb-n {
    flex: 0 0 26px; width: 26px; height: 26px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--display); font-weight: 800; font-size: 13.5px;
    background: #EFEBE2; color: var(--muted);
  }
  .jb-t { display: grid; gap: 2px; min-width: 0; }
  .jb-l { font-family: var(--display); font-weight: 700; font-size: 14.5px; line-height: 1.25; }
  .jb-s { font-size: 13px; line-height: 1.4; color: var(--muted); }
  .jb-here {
    justify-self: start; margin-top: 3px; max-width: 100%;
    font-family: var(--mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--heat-deep); background: var(--heat-tint); border-radius: 6px; padding: 1px 8px;
  }
  .is-now a { border-color: var(--heat); box-shadow: 0 0 0 2px var(--heat-tint); }
  .is-now .jb-n { background: var(--heat); color: #fff; }
  .is-done .jb-n { background: var(--pine); color: #fff; }
  .is-done .jb-l { color: var(--pine-deep); }

  @media (max-width: 760px) {
    .jb-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .jb-step a { padding: 9px 10px; gap: 8px; }
    .jb-n { flex-basis: 24px; width: 24px; height: 24px; font-size: 12.5px; }
    .jb-l { font-size: 14px; }
    .jb-s { font-size: 12.5px; }
    /* phones: only the current stage keeps its description, so the bar stays short */
    .jb-step:not(.is-now) .jb-s { display: none; }
  }
  .journey-compact .jb-step a { align-items: center; }
</style>
