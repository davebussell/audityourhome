---
/**
 * "Your audit journey": the same four stages on every flow page, so people always know where
 * they are and what comes next. Stage names live in src/lib/journey.ts (the planners use them too).
 * The stages are drawn as a flight path: four stops climbing left to right, a paper plane at the current one,
 * and a solid trail behind it where the stages are done. The path is decoration (aria-hidden); the four cards
 * under it are the real navigation.
 *
 *   <JourneyBar country="ca" current={2} />                  find page, booking
 *   <JourneyBar country="us" current={3} ticks={false} />    how-it-works: a map, nothing "done"
 *   <JourneyBar country="ca" current={2} compact />          one line per stage, no descriptions
 */
import { journeyStages, type JourneyCountry, type JourneyStep } from '../lib/journey';

interface Props {
  country: JourneyCountry;
  /** The stage this page is about (1–4) */
  current: JourneyStep;
  /** Hide the one-line descriptions */
  compact?: boolean;
  /** Tick the stages before the current one as done (true on the planner results) */
  ticks?: boolean;
  /** Tag on the current stage */
  hereLabel?: string;
  class?: string;
}
const { country, current, compact = false, ticks = true, hereLabel = 'You are here', class: cls } = Astro.props;
const stages = journeyStages(country);

/*
 * The flight path. It is drawn in a 1000 × 64 box that is stretched to the width of the cards (the stops sit over the middle of
 * each of the four columns), so the same numbers fit every screen. Stops climb: y is measured from the top, so smaller is higher.
 * The curve is a Catmull-Rom spline through the stops, written as one cubic segment per leg so that the trail behind the plane
 * (solid) and the way ahead (dotted) are separate paths and need no dash arithmetic.
 */
const XS = [125, 375, 625, 875];
const YS = [50, 37, 23, 10];
const PTS: [number, number][] = [[0, 57], ...XS.map((x, i): [number, number] => [x, YS[i]]), [1000, 3]];
const r1 = (n: number) => Math.round(n * 10) / 10;
function leg(i: number) {
  const p0 = PTS[Math.max(i - 1, 0)];
  const p1 = PTS[i];
  const p2 = PTS[i + 1];
  const p3 = PTS[Math.min(i + 2, PTS.length - 1)];
  const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
  const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
  return `C${r1(c1[0])},${r1(c1[1])} ${r1(c2[0])},${r1(c2[1])} ${p2[0]},${p2[1]}`;
}
function route(from: number, to: number) {
  if (from >= to) return '';
  let d = `M${PTS[from][0]},${PTS[from][1]}`;
  for (let i = from; i < to; i++) d += ' ' + leg(i);
  return d;
}
/** Index into PTS of the current stop (PTS[0] is the runway at the left edge) */
const here = current;
const behind = ticks ? route(0, here) : '';
const ahead = ticks ? route(here, PTS.length - 1) : route(0, PTS.length - 1);
const yf = (n: number) => r1(YS[n - 1] / 64);
/** The plane arrives from the previous stop; on stage 1 there is nowhere to arrive from */
const from = current > 1 ? current - 1 : current;
---

<nav class:list={['journey', compact && 'journey-compact', cls]} aria-label="Your audit journey">
  <p class="jb-k">Your audit journey <span class="jb-of">· stage {current} of 4</span></p>
  <div class="jb-track" aria-hidden="true" style={`--i:${current - 1};--yf:${yf(current)};--fi:${from - 1};--fyf:${yf(from)}`}>
    <svg class="jb-svg" viewBox="0 0 1000 64" preserveAspectRatio="none" focusable="false">
      <path class="jb-ahead" d={ahead}></path>
      {behind && <path class="jb-behind" d={behind}></path>}
    </svg>
    {stages.map((s) => (
      <span class:list={['jb-dot', ticks && s.n < current && 'is-done', s.n === current && 'is-now']} data-n={s.n} style={`--i:${s.n - 1};--yf:${yf(s.n)}`}></span>
    ))}
    <span class="jb-fly">
      <svg class="jb-plane" viewBox="0 0 32 32" focusable="false"><path class="pa" d="M30 3 2 13l11 5z"></path><path class="pb" d="M30 3 13 18l6 11z"></path></svg>
    </span>
  </div>
  <ol class="jb-list">
    {stages.map((s) => {
      const done = ticks && s.n < current;
      const now = s.n === current;
      return (
        <li class:list={['jb-step', done && 'is-done', now && 'is-now']}>
          <a href={s.href} aria-current={now ? 'step' : undefined}>
            <span class="jb-n" aria-hidden="true">{done ? '✓' : s.n}</span>
            <span class="jb-t">
              <span class="jb-l">{s.label}{done && <span class="sr-only"> (done)</span>}</span>
              {!compact && <span class="jb-s">{s.sub}</span>}
              {now && <span class="jb-here">{hereLabel}</span>}
            </span>
          </a>
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .journey { margin: 18px 0 6px; }
  .jb-k {
    font-family: var(--mono); font-size: 11.5px; font-weight: 600; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--muted); margin: 0 0 4px;
  }
  .jb-of { color: var(--muted); letter-spacing: 0.06em; }

  /* ---- the flight path ---- */
  .jb-track { --h: 64px; position: relative; height: var(--h); margin: 0 0 4px; }
  .jb-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .jb-svg path { fill: none; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
  .jb-ahead { stroke: var(--faint); stroke-width: 2.2px; stroke-dasharray: 0.1 7; }
  .jb-behind { stroke: var(--pine); stroke-width: 2.6px; }
  /* each stop sits over the middle of its column: four equal columns with an 8px gap */
  .jb-dot, .jb-fly {
    position: absolute;
    left: calc((100% - 24px) / 4 * (var(--i) + 0.5) + 8px * var(--i));
  }
  .jb-dot {
    top: calc(var(--h) * var(--yf));
    width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%;
    background: #fff; border: 2.5px solid var(--faint);
    display: grid; place-items: center;
  }
  .jb-dot::after { content: ''; font: 800 10px/1 var(--display); color: var(--muted); }
  .jb-dot.is-done { background: var(--pine); border-color: var(--pine); }
  .jb-dot.is-now { background: #fff; border-color: var(--heat); box-shadow: 0 0 0 4px var(--heat-tint); animation: jb-ping 2.8s ease-out infinite; }
  .jb-fly {
    top: calc(var(--h) * var(--yf) - 21px);
    width: 0; height: 0;
    animation: jb-fly 1.7s cubic-bezier(0.3, 0.1, 0.2, 1) 0.2s 1 both;
  }
  .jb-plane {
    position: absolute; left: -16px; top: -16px; width: 32px; height: 32px;
    transform: rotate(22deg);
    filter: drop-shadow(0 3px 2px rgba(19, 39, 59, 0.22));
    animation: jb-bob 4.6s ease-in-out infinite;
  }
  .jb-plane .pa { fill: var(--heat); }
  .jb-plane .pb { fill: var(--heat-deep); }
  @keyframes jb-fly {
    from { left: calc((100% - 24px) / 4 * (var(--fi) + 0.5) + 8px * var(--fi)); top: calc(var(--h) * var(--fyf) - 21px); }
    to { left: calc((100% - 24px) / 4 * (var(--i) + 0.5) + 8px * var(--i)); top: calc(var(--h) * var(--yf) - 21px); }
  }
  @keyframes jb-bob {
    0%, 100% { transform: translateY(0) rotate(22deg); }
    50% { transform: translateY(-4px) rotate(16deg); }
  }
  @keyframes jb-ping {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--heat) 38%, transparent); }
    70%, 100% { box-shadow: 0 0 0 9px color-mix(in srgb, var(--heat) 0%, transparent); }
  }

  /* ---- the four stage cards ---- */
  .jb-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px;
  }
  .jb-step { min-width: 0; }
  .jb-step a {
    display: flex; gap: 10px; align-items: flex-start; height: 100%;
    padding: 10px 12px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    color: var(--ink); text-decoration: none; box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .jb-step a:hover { border-color: var(--line-strong); color: var(--ink); box-shadow: var(--shadow-md); transform: translateY(-1px); }
  .jb-n {
    flex: 0 0 26px; width: 26px; height: 26px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--display); font-weight: 800; font-size: 13.5px;
    background: var(--wash); color: var(--muted);
  }
  .jb-t { display: grid; gap: 2px; min-width: 0; }
  .jb-l { font-family: var(--display); font-weight: 700; font-size: 14.5px; line-height: 1.25; }
  .jb-s { font-size: 13px; line-height: 1.4; color: var(--muted); }
  .jb-here {
    justify-self: start; margin-top: 3px; max-width: 100%;
    font-family: var(--mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--heat-deep); background: var(--heat-tint); border-radius: 6px; padding: 1px 8px;
  }
  .is-now a { border-color: var(--heat); box-shadow: 0 0 0 2px var(--heat-tint), var(--shadow-sm); }
  .is-now .jb-n { background: var(--heat); color: #fff; }
  .is-done .jb-n { background: var(--pine); color: #fff; }
  .is-done .jb-l { color: var(--pine-deep); }

  @media (max-width: 760px) {
    /* phones: the cards run two by two, so the path above them numbers its stops */
    .jb-track { --h: 46px; }
    .jb-dot { width: 20px; height: 20px; margin: -10px 0 0 -10px; border-width: 2px; }
    .jb-dot::after { content: attr(data-n); }
    .jb-dot.is-done::after, .jb-dot.is-now::after { color: #fff; }
    .jb-dot.is-now { background: var(--heat); }
    .jb-plane { left: -13px; top: -13px; width: 26px; height: 26px; }
    .jb-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .jb-step a { padding: 9px 10px; gap: 8px; }
    .jb-n { flex-basis: 24px; width: 24px; height: 24px; font-size: 12.5px; }
    .jb-l { font-size: 14px; }
    .jb-s { font-size: 12.5px; }
    /* phones: only the current stage keeps its description, so the bar stays short */
    .jb-step:not(.is-now) .jb-s { display: none; }
  }
  .journey-compact .jb-step a { align-items: center; }
  .journey-compact .jb-track { --h: 46px; }
</style>
