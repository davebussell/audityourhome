---
import { SITE, ACCOUNTS_ENABLED, siteFor } from '../config/site';
import Logo from './Logo.astro';
import { countryOf, COUNTRIES } from '../lib/country';

const country = countryOf(Astro.url.pathname);
const site = siteFor(country);
const other = country === 'us' ? COUNTRIES.ca : COUNTRIES.us;
const otherSite = siteFor(other.code);
const blurb =
  country === 'us'
    ? 'Plan home energy upgrades in the United States with certified auditors, real prices and rebate data we keep current.'
    : country === 'ca'
      ? 'The trusted way to plan home energy upgrades in Canada: verified auditors, real prices, and rebate data we actually keep current.'
      : 'Find a certified home energy auditor, compare real prices and see which rebates are live, in Canada and the United States.';
const notAffiliated =
  country === 'us'
    ? 'We are not affiliated with the U.S. Department of Energy, the EPA, RESNET, BPI, any utility or any government program.'
    : country === 'ca'
      ? 'We are not affiliated with Natural Resources Canada, Enbridge, the IESO, or any government program.'
      : 'We are not affiliated with any government program, utility or certification body in Canada or the United States.';
const metaLine =
  country === 'us'
    ? 'United States, metro by metro'
    : country === 'ca'
      ? 'Canada-wide, province by province · Version française à venir'
      : 'Canada and the United States';
---

<footer class="band-dark site-footer">
  <div class="container">
    <div class="cols">
      <div class="brand-col">
        <Logo onDark />
        <p class="small">{blurb}</p>
        {country === 'ca' && <p class="meta">Program data last reviewed {SITE.dataReviewDate}</p>}
      </div>
      {country === 'ca' && (
        <nav aria-label="Homeowners">
          <h4>Homeowners</h4>
          <ul>
            <li><a href="/plan/">Home Energy Planner</a></li>
            <li><a href="/calculators/">Calculators for your city</a></li>
            <li><a href="/learn/">Keeping the heat in</a></li>
            <li><a href="/find/">Find an auditor</a></li>
            <li><a href="/programs/">Rebates &amp; programs</a></li>
            <li><a href="/updates/">Rebate &amp; program changes</a></li>
            {ACCOUNTS_ENABLED && <li><a href="/alerts/">Free home alerts</a></li>}
            {ACCOUNTS_ENABLED && <li><a href="/account/">My Home (sign in)</a></li>}
            <li><a href="/tests/">The complete testing guide</a></li>
            <li><a href="/tests/screener/">Specialty test screener</a></li>
            <li><a href="/products/">Monitoring &amp; testing gear</a></li>
            <li><a href="/provinces/">Province-by-province</a></li>
            <li><a href="/cities/">70 cities, 16 local services</a></li>
            <li><a href="/areas/">Smaller towns &amp; counties</a></li>
            <li><a href="/services/">Audit &amp; testing services</a></li>
            <li><a href="/guides/">Ontario city guides</a></li>
            <li><a href="/articles/">Articles</a></li>
            <li><a href="/issues/">Fix an issue</a></li>
            <li><a href="/cost/">What an audit costs</a></li>
            <li><a href="/how-it-works/">How an audit works</a></li>
            <li><a href="/glossary/">Glossary of audit terms</a></li>
          </ul>
        </nav>
      )}
      {country === 'us' && (
        <nav aria-label="Homeowners">
          <h4>Homeowners</h4>
          <ul>
            <li><a href="/plan/">Home Energy Planner</a></li>
            <li><a href="/find/">Find a certified auditor</a></li>
            <li><a href="/cities/">26 metro areas</a></li>
            <li><a href="/programs/">Rebates, tax credits &amp; programs</a></li>
            <li><a href="/programs/states/">Home energy rebates by state</a></li>
            <li><a href="/tests/">The complete testing guide</a></li>
            <li><a href="/tests/screener/">Specialty test screener</a></li>
            <li><a href="/products/">Monitoring &amp; testing gear</a></li>
            <li><a href="/cost/">What an audit costs</a></li>
            <li><a href="/how-it-works/">How an audit works</a></li>
            <li><a href="/glossary/">Glossary of audit terms</a></li>
          </ul>
        </nav>
      )}
      <nav aria-label="Professionals and company">
        {country === 'ca' && (
          <>
            <h4>Professionals</h4>
            <ul>
              <li><a href="/for-professionals/">Leads &amp; listings for advisors</a></li>
            </ul>
          </>
        )}
        <h4 class:list={[{ second: country === 'ca' }]}>Company</h4>
        <ul>
          <li><a href="/about/">About &amp; data policy</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href={`mailto:${SITE.contactEmail}`}>Contact</a></li>
          <li><a href={`${other.origin}/?site=${other.code}`}>{country === 'us' ? 'Canadian site' : 'United States site'} ({otherSite.domain})</a></li>
        </ul>
      </nav>
    </div>
    <div class="legal">
      <p>
        {site.name} is an independent directory and planning tool. {notAffiliated} Program details
        change — always confirm on the official program page before spending money. Savings figures
        are estimates based on typical performance of similar homes, not a model of yours.
        Photos on this site are AI-generated illustrations made for it; they don't show real
        customers, specific homes or any listed provider, and the infrared views are illustrative,
        not measurements.
      </p>
      <p class="meta">© 2026 {site.name} · {metaLine}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding: 56px 0 36px; margin-top: 40px; }
  .cols {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--navy-line);
  }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr; gap: 28px; } }
  .brand-col p { margin-top: 14px; max-width: 40ch; }
  h4 {
    color: #fff;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }
  h4.second { margin-top: 22px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  ul a { text-decoration: none; font-size: 14.5px; }
  ul a:hover { color: #fff; text-decoration: underline; }
  .legal { padding-top: 24px; }
  .legal p:first-child { font-size: 13px; max-width: 90ch; }
  .meta { color: var(--navy-muted); }
</style>
