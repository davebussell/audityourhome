---
import { SITE } from '../config/site';
import Logo from './Logo.astro';
---

<footer class="band-dark site-footer">
  <div class="container">
    <div class="cols">
      <div class="brand-col">
        <Logo onDark />
        <p class="small">
          The trusted way to plan home energy upgrades in Canada: verified auditors, real prices,
          and rebate data we actually keep current.
        </p>
        <p class="meta">Program data last reviewed {SITE.dataReviewDate}</p>
      </div>
      <nav aria-label="Homeowners">
        <h4>Homeowners</h4>
        <ul>
          <li><a href="/plan/">Home Energy Planner</a></li>
          <li><a href="/find/">Find an auditor</a></li>
          <li><a href="/programs/">Rebates &amp; programs</a></li>
          <li><a href="/tests/">The complete testing guide</a></li>
          <li><a href="/tests/screener/">Specialty test screener</a></li>
          <li><a href="/products/">Monitoring &amp; testing gear</a></li>
          <li><a href="/provinces/">Province-by-province</a></li>
          <li><a href="/guides/">City-by-city guides</a></li>
          <li><a href="/articles/">Articles</a></li>
          <li><a href="/issues/">Fix an issue</a></li>
          <li><a href="/cost/">What an audit costs</a></li>
          <li><a href="/how-it-works/">How an audit works</a></li>
        </ul>
      </nav>
      <nav aria-label="Professionals and company">
        <h4>Professionals</h4>
        <ul>
          <li><a href="/for-professionals/">Get listed</a></li>
        </ul>
        <h4 class="second">Company</h4>
        <ul>
          <li><a href="/about/">About &amp; data policy</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href={`mailto:${SITE.contactEmail}`}>Contact</a></li>
        </ul>
      </nav>
    </div>
    <div class="legal">
      <p>
        {SITE.name} is an independent directory and planning tool. We are not affiliated with
        Natural Resources Canada, Enbridge, the IESO, or any government program. Program details
        change — always confirm on the official program page before spending money. Savings figures
        are estimates based on typical performance of similar homes, not a model of yours.
      </p>
      <p class="meta">© 2026 {SITE.name} · Canada-wide, province by province · US launch coming · Version française à venir</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding: 56px 0 36px; margin-top: 40px; }
  .cols {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--navy-line);
  }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr; gap: 28px; } }
  .brand-col p { margin-top: 14px; max-width: 40ch; }
  h4 {
    color: #fff;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }
  h4.second { margin-top: 22px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  ul a { text-decoration: none; font-size: 14.5px; }
  ul a:hover { color: #fff; text-decoration: underline; }
  .legal { padding-top: 24px; }
  .legal p:first-child { font-size: 13px; max-width: 90ch; }
  .meta { color: var(--navy-muted); }
</style>
