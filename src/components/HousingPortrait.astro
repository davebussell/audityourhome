---
/**
 * "Housing portrait" — a data drawing of a city's houses from the 2021 Census.
 * Ten house shapes, one per tenth of the city's houses, drawn in the style of
 * the era they were built in and glowing like an infrared scan: older eras
 * glow hotter because they are typically leakier and less insulated.
 * Snowfall density scales with heating degree-days.
 */
interface Era {
  pre1961: number | null;
  y1961to1990: number | null;
  y1991to2000: number | null;
  since2001: number | null;
}
interface Props {
  slug: string;
  name: string;
  era: Era;
  houses: number;
  hdd: number;
  designHeat: number;
  /** Heading level text above the drawing (omit to hide) */
  heading?: string;
}

const { slug, name, era, houses, hdd, designHeat, heading } = Astro.props;

const ERAS = [
  { key: 'pre1961', label: 'Before 1961', color: '#F4A53F', glow: 0.85, win: 0.95 },
  { key: 'y1961to1990', label: '1961–1990', color: '#E8622A', glow: 0.62, win: 0.8 },
  { key: 'y1991to2000', label: '1991–2000', color: '#C04A86', glow: 0.4, win: 0.6 },
  { key: 'since2001', label: '2001 or later', color: '#7A63E0', glow: 0.22, win: 0.42 },
] as const;

const shares = ERAS.map((e) => Math.max(0, Number(era[e.key] ?? 0)));
const total = shares.reduce((a, b) => a + b, 0) || 1;
// Largest-remainder rounding to exactly ten houses.
const raw = shares.map((s) => (s / total) * 10);
const counts = raw.map(Math.floor);
let left = 10 - counts.reduce((a, b) => a + b, 0);
raw
  .map((r, i) => ({ i, frac: r - Math.floor(r) }))
  .sort((a, b) => b.frac - a.frac)
  .forEach(({ i }) => { if (left > 0) { counts[i] += 1; left -= 1; } });

const glyphs: number[] = [];
counts.forEach((c, i) => { for (let k = 0; k < c; k++) glyphs.push(i); });

// Deterministic "random" snow per city.
let seed = 0;
for (const ch of slug) seed = (seed * 31 + ch.charCodeAt(0)) >>> 0;
const rnd = () => {
  seed = (seed + 0x6d2b79f5) >>> 0;
  let t = seed;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const flakeCount = Math.max(6, Math.min(42, Math.round(hdd / 200)));
const flakes = Array.from({ length: flakeCount }, () => ({
  x: +(8 + rnd() * 584).toFixed(1),
  y: +(8 + rnd() * 88).toFixed(1),
  r: +(0.9 + rnd() * 1.1).toFixed(2),
  o: +(0.3 + rnd() * 0.45).toFixed(2),
}));

const fmt = (v: number) => v.toLocaleString('en-CA');
const pctTxt = (v: number | null) => (v == null ? '—' : `${Math.round(v)}%`);
const degTxt = `${designHeat < 0 ? '−' : ''}${Math.abs(designHeat).toFixed(1)}°C`;
const uid = `hp-${slug}`;
const summary = ERAS.map((e, i) => `${e.label}: ${pctTxt(shares[i])}`).join(', ');
---

<figure class="hp" aria-labelledby={`${uid}-cap`}>
  {heading && <p class="hp-h">{heading}</p>}
  <div class="hp-frame">
    <svg viewBox="0 0 600 150" role="img" aria-labelledby={`${uid}-t ${uid}-d`} preserveAspectRatio="xMidYMid meet">
      <title id={`${uid}-t`}>{name}'s houses by when they were built</title>
      <desc id={`${uid}-d`}>Ten house shapes, one for each tenth of {name}'s {fmt(houses)} houses. {summary}. Older houses glow hotter.</desc>
      <defs>
        <linearGradient id={`${uid}-sky`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#1B2A3A" />
          <stop offset="1" stop-color="#121D29" />
        </linearGradient>
        {ERAS.map((e, i) => (
          <radialGradient id={`${uid}-g${i}`}>
            <stop offset="0" stop-color={e.color} stop-opacity={e.glow} />
            <stop offset="0.55" stop-color={e.color} stop-opacity={e.glow * 0.35} />
            <stop offset="1" stop-color={e.color} stop-opacity="0" />
          </radialGradient>
        ))}
      </defs>
      <rect width="600" height="150" fill={`url(#${uid}-sky)`} />
      <g fill="#DCE5EC">
        {flakes.map((f) => <circle cx={f.x} cy={f.y} r={f.r} opacity={f.o} />)}
      </g>
      <rect y="112" width="600" height="38" fill="#0E1620" />
      <line x1="0" y1="112.5" x2="600" y2="112.5" stroke="#DCE5EC" stroke-opacity="0.35" stroke-width="1" />
      {glyphs.map((g, i) => {
        const e = ERAS[g];
        const x = 20 + i * 56 + 3;
        return (
          <g transform={`translate(${x} 40)`} class="house" style={`--d:${(i * 0.23).toFixed(2)}s`}>
            <circle class="glow" cx="25" cy="50" r="36" fill={`url(#${uid}-g${g})`} />
            {g === 0 && (
              <g stroke={e.color} stroke-width="2" stroke-linejoin="round" fill="#1B2A3A">
                <rect x="32" y="13" width="6" height="18" />
                <path d="M3 38 25 12l22 26Z" />
                <rect x="7" y="37" width="36" height="35" />
                <g fill={e.color} fill-opacity={e.win} stroke="none">
                  <rect x="12" y="46" width="9" height="10" />
                  <rect x="29" y="46" width="9" height="10" />
                  <rect x="22" y="24" width="6" height="6" />
                </g>
              </g>
            )}
            {g === 1 && (
              <g stroke={e.color} stroke-width="2" stroke-linejoin="round" fill="#1B2A3A">
                <path d="M-1 47 25 33l26 14Z" />
                <rect x="1" y="47" width="48" height="25" />
                <g fill={e.color} fill-opacity={e.win} stroke="none">
                  <rect x="6" y="53" width="19" height="10" />
                  <rect x="31" y="53" width="10" height="10" />
                </g>
              </g>
            )}
            {g === 2 && (
              <g stroke={e.color} stroke-width="2" stroke-linejoin="round" fill="#1B2A3A">
                <path d="M-1 53 10 46l11 7Z" />
                <rect x="0" y="53" width="20" height="19" />
                <path d="M16 33 33.5 18 51 33Z" />
                <rect x="19" y="33" width="30" height="39" />
                <g fill={e.color} fill-opacity={e.win} stroke="none">
                  <rect x="24" y="40" width="8" height="8" />
                  <rect x="37" y="40" width="8" height="8" />
                  <rect x="24" y="56" width="8" height="8" />
                </g>
                <path d="M4 60h12M4 64h12M4 68h12" stroke-width="1.2" fill="none" />
              </g>
            )}
            {g === 3 && (
              <g stroke={e.color} stroke-width="2" stroke-linejoin="round" fill="#1B2A3A">
                <path d="M5 33 45 24v48H5Z" />
                <path d="M2 34.5 48 24" stroke-width="3" stroke-linecap="round" />
                <g fill={e.color} fill-opacity={e.win} stroke="none">
                  <rect x="10" y="40" width="8" height="18" />
                  <rect x="25" y="37" width="14" height="9" />
                  <rect x="25" y="53" width="14" height="9" />
                </g>
              </g>
            )}
          </g>
        );
      })}
    </svg>
    <span class="hp-hud" aria-hidden="true"><i></i>{degTxt} design · {fmt(hdd)} HDD</span>
  </div>
  <ul class="hp-legend">
    {ERAS.map((e, i) => (
      <li><span class="sw" style={`--c:${e.color}`}></span>{e.label} <b>{pctTxt(shares[i])}</b></li>
    ))}
  </ul>
  <figcaption id={`${uid}-cap`}>
    Each house stands for one in ten of {name}'s {fmt(houses)} houses (single-detached, semi-detached, row and duplex),
    drawn by when it was built. The glow shows the usual pattern: older houses tend to be leakier and less insulated.
    Snowfall scales with heating degree-days. Sources: Statistics Canada 2021 Census
    (<a href="https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=9810023301" rel="noopener">table 98-10-0233-01</a>),
    NRCan HOT2000 climate data.
  </figcaption>
</figure>

<style>
  .hp { margin: 0; min-width: 0; }
  .hp-h {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--heat);
    margin: 0 0 10px;
  }
  .hp-frame { position: relative; border-radius: 14px; overflow: hidden; background: #121d29; box-shadow: var(--shadow-md); }
  .hp-frame svg { display: block; width: 100%; height: auto; }
  .house .glow { animation: hpglow 3.6s ease-in-out infinite; animation-delay: var(--d); transform-box: fill-box; transform-origin: center; }
  @keyframes hpglow { 0%, 100% { opacity: 0.8; } 50% { opacity: 1; } }
  .hp-hud {
    position: absolute;
    right: 12px;
    top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #fff;
    background: rgba(14, 22, 32, 0.7);
    padding: 4px 9px;
    border-radius: 6px;
    white-space: nowrap;
  }
  .hp-hud i { width: 6px; height: 6px; border-radius: 50%; background: #7fb4d9; }
  .hp-legend { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 13.5px; color: var(--muted); }
  .hp-legend li { display: inline-flex; align-items: center; gap: 7px; }
  .hp-legend b { font-family: var(--mono); font-weight: 600; color: var(--ink); font-size: 13px; }
  .sw { width: 11px; height: 11px; border-radius: 3px; background: var(--c); box-shadow: 0 0 8px var(--c); }
  figcaption { font-size: 12.5px; color: var(--faint); margin-top: 8px; line-height: 1.5; }
  figcaption a { color: var(--muted); }
  @media (max-width: 520px) { .hp-hud { font-size: 10px; right: 8px; top: 7px; padding: 3px 7px; } }
</style>
