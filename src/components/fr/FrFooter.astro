---
/** The footer of the French pages: the same features as Footer.astro (where we work, connect, credits, live year), in French. */
import Logo from '../Logo.astro';
import { SITE } from '../../config/site';
import { BUILDING } from '../../config/building';

const LINKEDIN = 'https://www.linkedin.com/in/davebussell/';
const INSTAGRAM = 'https://www.instagram.com/davebussell/';
const year = new Date().getFullYear();
/** "October 2, 2026" → "2 octobre 2026" */
const MOIS = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];
const d = new Date(SITE.dataReviewDateISO + 'T12:00:00');
const dateFr = `${d.getDate() === 1 ? '1er' : d.getDate()} ${MOIS[d.getMonth()]} ${d.getFullYear()}`;
---

<footer class="band-dark site-footer">
  <div class="container">
    <div class="cols">
      <div class="brand-col">
        <Logo onDark href="/fr/" />
        <p class="small">La façon fiable de planifier les rénovations écoénergétiques de votre maison au Québec : des conseillers reconnus, les vrais prix, et des données sur les subventions que nous tenons à jour.</p>
        <p class="meta">Programmes vérifiés le {dateFr}</p>
        <h4 class="where-h">Où nous sommes</h4>
        <p class="small where">À Wakefield (Québec), dans les collines de la Gatineau au nord d’Ottawa. Conçu au Canada; le site anglais couvre 70 villes et chaque province et territoire.</p>
      </div>
      <nav aria-label="Propriétaires">
        <h4>Propriétaires</h4>
        <ul>
          <li><a href="/fr/planificateur/">Planificateur énergétique</a></li>
          <li><a href="/fr/programmes/">Subventions et programmes</a></li>
          <li><a href="/fr/quebec/">Guide du Québec</a></li>
          <li><a href="/fr/villes/">Villes du Québec</a></li>
          <li><a href="/fr/trouver-un-conseiller/">Trouver un conseiller</a></li>
          <li><a href="/fr/comment-ca-marche/">Comment fonctionne une évaluation</a></li>
          <li><a href="/fr/thermopompes/">Thermopompes</a></li>
        </ul>
      </nav>
      <nav aria-label="Entreprise">
        <h4>Entreprise</h4>
        <ul>
          <li><a href="/fr/a-propos/">À propos et politique de données</a></li>
          <li><a href="/fr/confidentialite/">Confidentialité</a></li>
          <li><a href="/credits/" hreflang="en-CA">Crédits photos et données (en anglais)</a></li>
          <li><a href="/" hreflang="en-CA" lang="en">English site (audityourhome.ca)</a></li>
          <li><a href={BUILDING.url + '/'} hreflang="en-CA">Immeubles commerciaux et à logements ({BUILDING.domain}, en anglais)</a></li>
        </ul>
      </nav>
      <nav aria-label="Nous joindre">
        <h4>Nous joindre</h4>
        <ul class="connect">
          <li><a href="/fr/planificateur/">Commencer : votre plan gratuit →</a></li>
          <li><a href={`mailto:${SITE.contactEmail}`}>Courriel {SITE.contactEmail}</a></li>
          <li><a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href={INSTAGRAM} target="_blank" rel="noopener">Instagram</a></li>
        </ul>
      </nav>
    </div>
    <div class="legal">
      <p>
        AuditYourHome est un guide indépendant et un service de mise en relation. Nous ne sommes affiliés ni à Ressources naturelles Canada,
        ni à Hydro-Québec, ni au gouvernement du Québec, ni à aucun programme. Les programmes changent : confirmez sur la page officielle,
        liée depuis chaque fiche, avant d’engager de l’argent. Rien ici ne constitue un avis technique, juridique ou financier, et une page qui
        décrit un programme n’affirme pas que votre maison y est admissible. Les conseillers participants nous versent des frais de
        référence; vous ne payez rien pour la mise en relation. Les images du site sont des illustrations générées par IA : elles ne montrent
        ni clients réels, ni maisons précises.
      </p>
      <p class="meta">© <span id="year">{year}</span> AuditYourHome · Québec, ville par ville · Connaissez votre maison avant d’y investir.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding: 56px 0 36px; margin-top: 40px; }
  .cols { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 36px; padding-bottom: 32px; border-bottom: 1px solid var(--navy-line); }
  @media (max-width: 1000px) { .cols { grid-template-columns: 1.4fr 1fr 1fr; } .cols nav:last-child { grid-column: 1 / -1; } }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr; gap: 28px; } .cols nav:last-child { grid-column: auto; } }
  .brand-col p { margin-top: 14px; max-width: 40ch; }
  .where-h { margin-top: 22px; }
  .brand-col .where { margin-top: 0; }
  .connect a { overflow-wrap: anywhere; }
  h4 { color: #fff; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 12px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  ul a { text-decoration: none; font-size: 14.5px; }
  ul a:hover { color: #fff; text-decoration: underline; }
  .legal { padding-top: 24px; }
  .legal p:first-child { font-size: 13px; max-width: 90ch; }
  .meta { color: var(--navy-muted); }
</style>
