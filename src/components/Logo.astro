---
interface Props {
  /** Renders the wordmark light-on-dark (footer) */
  onDark?: boolean;
}
const { onDark = false } = Astro.props;
---

<a href="/" class:list={['logo', { dark: onDark }]} aria-label="AuditYourHome — home">
  <svg width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id="ayh-heat" x1="4" y1="28" x2="28" y2="6" gradientUnits="userSpaceOnUse">
        <stop stop-color="#B84713" />
        <stop offset="1" stop-color="#E05C1F" />
      </linearGradient>
    </defs>
    <!-- house -->
    <path
      d="M16 3.5 3.5 14.2a1.6 1.6 0 0 0-.5 1.2v11a2.6 2.6 0 0 0 2.6 2.6h20.8a2.6 2.6 0 0 0 2.6-2.6v-11c0-.46-.18-.9-.5-1.2L16 3.5Z"
      fill="url(#ayh-heat)"
    />
    <!-- checkmark -->
    <path
      d="m10.5 18.2 3.6 3.6 7.4-7.9"
      stroke="#FFFFFF"
      stroke-width="2.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />
  </svg>
  <span class="wordmark">Audit<em>Your</em>Home</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
  }
  .wordmark {
    font-family: var(--display);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .wordmark em {
    font-style: normal;
    color: var(--heat);
  }
  .logo.dark .wordmark {
    color: #fff;
  }
  .logo.dark .wordmark em {
    color: #f08246;
  }
</style>
