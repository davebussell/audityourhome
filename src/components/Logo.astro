---
import { countryOf } from '../lib/country';
import { siteFor } from '../config/site';

interface Props {
  /** Renders the wordmark light-on-dark (footer) */
  onDark?: boolean;
  /** Where the logo links; defaults to the site's home page */
  href?: string;
}
const country = countryOf(Astro.url.pathname) ?? 'ca';
const site = siteFor(country);
const { onDark = false, href = '/' } = Astro.props;
/* House and accent: Canadian flag red, Pantone 032 (sRGB #EF3340) on AuditYourHome; Old Glory red (#B22234) on AuditYourHouse. */
const red = country === 'us' ? '#B22234' : '#EF3340';
/* Wordmark: Audit·Your·Home or Audit·Your·House */
const last = site.name.replace(/^AuditYour/, '');
---

<a href={href} class:list={['logo', { dark: onDark }]} aria-label={`${site.name} — home`} style={`--logo-red:${red}`}>
  <svg width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <!-- house — flag red (PMS 032) -->
    <path
      d="M16 3.5 3.5 14.2a1.6 1.6 0 0 0-.5 1.2v11a2.6 2.6 0 0 0 2.6 2.6h20.8a2.6 2.6 0 0 0 2.6-2.6v-11c0-.46-.18-.9-.5-1.2L16 3.5Z"
      fill={red}
    />
    <!-- checkmark -->
    <path
      d="m10.5 18.2 3.6 3.6 7.4-7.9"
      stroke="#FFFFFF"
      stroke-width="2.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />
  </svg>
  <span class="wordmark">Audit<em>Your</em>{last}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
  }
  .wordmark {
    font-family: var(--display);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .wordmark em {
    font-style: normal;
    color: var(--logo-red, #ef3340);
  }
  .logo.dark .wordmark {
    color: #fff;
  }
  .logo.dark .wordmark em {
    color: var(--logo-red, #ef3340);
  }
</style>
