---
interface Props {
  /** Renders the wordmark light-on-dark (footer) */
  onDark?: boolean;
}
const { onDark = false } = Astro.props;
---

<a href="/" class:list={['logo', { dark: onDark }]} aria-label="AuditYourHome — home">
  <svg width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <!-- house -->
    <path
      class="house"
      d="M16 2.5 3.5 13.2a1.6 1.6 0 0 0-.5 1.2v12a2.6 2.6 0 0 0 2.6 2.6h20.8a2.6 2.6 0 0 0 2.6-2.6v-12c0-.46-.18-.9-.5-1.2L16 2.5Z"
    />
    <!-- maple leaf: cycles red → green → red (leaky → efficient) -->
    <path
      class="leaf"
      d="M16 8.2l1.05 2.45 1.75-.7-.7 2.1 2.45-.35-1.19 1.96 2.24.49-2.1 1.4 2.8 1.75-3.15.14.35 1.61-2.66-.7v2.1l-.84-.7-.84.7v-2.1l-2.66.7.35-1.61-3.15-.14 2.8-1.75-2.1-1.4 2.24-.49-1.19-1.96 2.45.35-.7-2.1 1.75.7L16 8.2Z"
    />
    <path class="leaf stem" d="M15.3 19.4h1.4v4.4h-1.4z" />
  </svg>
  <span class="wordmark">Audit<em>Your</em>Home</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
  }
  .house { fill: var(--navy, #14202c); }
  .logo.dark .house { fill: #faf8f4; }
  .leaf {
    fill: #d94330;
    animation: leafcycle 9s ease-in-out infinite;
  }
  @keyframes leafcycle {
    0%, 100% { fill: #d94330; }   /* leaky red */
    50% { fill: #2f9e63; }        /* efficient green */
  }
  .wordmark {
    font-family: var(--display);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .wordmark em {
    font-style: normal;
    color: var(--heat);
  }
  .logo.dark .wordmark { color: #fff; }
  .logo.dark .wordmark em { color: #f08246; }
</style>
