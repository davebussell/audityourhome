---
/**
 * Small inline SVG flag for the country picker. Inline SVG, not emoji: Windows shows flag emoji as letters.
 * True proportions (Canada 2:1, United States 1.9:1) at a fixed height. Canada follows the official
 * construction; at icon size the US stars are drawn as dots in their real 9-row positions.
 */
import type { Country } from '../lib/country';

interface Props { code: Country; height?: number }
const { code, height = 14 } = Astro.props;
const width = Math.round(height * (code === 'ca' ? 2 : 1.9) * 10) / 10;

/* US: 13 stripes of 300 units (hoist 3900, fly 7410); canton 2964 × 2100; stars 9 rows (6, 5, 6 …). */
const STAR_ROWS = Array.from({ length: 9 }, (_, n) => {
  const y = Math.round((210.6 + 210.6 * n) * 10) / 10;
  return n % 2 === 0 ? `M245.7 ${y}H2702.7` : `M491.4 ${y}H2457`;
}).join('');
---

{code === 'ca' ? (
  <svg class="flag" width={width} height={height} viewBox="0 0 9600 4800" role="img" aria-label="Flag of Canada">
    <path fill="#D52B1E" d="M0 0h2400l99 99h4602l99-99h2400v4800h-2400l-99-99h-4602l-99 99H0z" />
    <path fill="#fff" d="M2400 0h4800v4800h-4800zm2490 4430-45-863a95 95 0 0 1 111-98l859 151-116-320a65 65 0 0 1 20-73l941-762-212-99a65 65 0 0 1-34-79l186-572-542 115a65 65 0 0 1-73-38l-105-247-423 454a65 65 0 0 1-111-57l204-1052-327 189a65 65 0 0 1-91-27l-332-652-332 652a65 65 0 0 1-91 27l-327-189 204 1052a65 65 0 0 1-111 57l-423-454-105 247a65 65 0 0 1-73 38l-542-115 186 572a65 65 0 0 1-34 79l-212 99 941 762a65 65 0 0 1 20 73l-116 320 859-151a95 95 0 0 1 111 98l-45 863z" />
  </svg>
) : (
  <svg class="flag" width={width} height={height} viewBox="0 0 7410 3900" role="img" aria-label="Flag of the United States">
    <rect width="7410" height="3900" fill="#B22234" />
    <path d="M0 450H7410M0 1050H7410M0 1650H7410M0 2250H7410M0 2850H7410M0 3450H7410" stroke="#fff" stroke-width="300" />
    <rect width="2964" height="2100" fill="#3C3B6E" />
    <path d={STAR_ROWS} stroke="#fff" stroke-width="170" stroke-linecap="round" stroke-dasharray="0 491.4" fill="none" />
  </svg>
)}

<style>
  .flag {
    display: block;
    flex: none;
    border-radius: 2px;
    /* keeps the white parts of the flags visible on a white or cream background */
    box-shadow: 0 0 0 1px rgba(26, 36, 48, 0.16);
  }
</style>
