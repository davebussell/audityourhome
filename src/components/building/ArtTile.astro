---
/* A cyanotype picture tile for pages that have no photograph: building-type line icons on a drafting grid.
   Same box as a 16:9 Photo, so it can stand in for one in a card or a page hero. */
import BuildingIcon from './BuildingIcon.astro';

interface Props {
  /** Building-type icons to draw, left to right (see BuildingIcon) */
  types: string[];
  /** Small mono caption in the corner */
  caption?: string;
  ratio?: string;
  /** Square corners and no shadow, for the top of a card that clips its own corners */
  flat?: boolean;
  /** Screen-reader text; the tile is decorative when omitted */
  alt?: string;
}
const { types, caption = '', ratio = '16 / 9', alt = '', flat = false } = Astro.props;
---

<div class:list={['arttile', { flat }]} style={`--r:${ratio}`} role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'}>
  <div class="grid"></div>
  <div class="ic">{types.map((t) => <BuildingIcon type={t} size={72} />)}</div>
  {caption && <span class="cap">{caption}</span>}
</div>

<style>
  .arttile { position: relative; aspect-ratio: var(--r); background: var(--bp); color: var(--bp-ink); display: grid; place-items: center; overflow: hidden; width: 100%; }
  .arttile:not(.flat) { border-radius: 12px; box-shadow: var(--shadow-md); }
  .grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(207, 227, 250, 0.09) 1px, transparent 1px), linear-gradient(90deg, rgba(207, 227, 250, 0.09) 1px, transparent 1px); background-size: 24px 24px; background-position: -1px -1px; }
  .ic { position: relative; display: flex; align-items: flex-end; justify-content: center; gap: clamp(12px, 3.2vw, 30px); padding: 0 16px 10px; }
  .ic :global(svg) { width: clamp(44px, 7.5vw, 80px); height: auto; stroke-width: 1.5; }
  .cap { position: absolute; left: 14px; bottom: 10px; font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: #8FB8E8; }
  /* a pair of crop marks, like the photographs' viewfinder corners */
  .arttile::before, .arttile::after { content: ""; position: absolute; width: 16px; height: 16px; border: 2px solid rgba(207, 227, 250, 0.7); }
  .arttile::before { top: 12px; left: 12px; border-right: 0; border-bottom: 0; }
  .arttile::after { top: 12px; right: 12px; border-left: 0; border-bottom: 0; }
</style>
