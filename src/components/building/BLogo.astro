---
/* AuditYourBuilding wordmark with the building mark: the same red (Pantone 032), the same white checkmark and the same
   red "Your" as AuditYourHome's house mark, as a tower with a lower wing. */
interface Props {
  /** Renders the wordmark light-on-dark (footer) */
  onDark?: boolean;
  href?: string;
}
const { onDark = false, href = '/' } = Astro.props;
const red = '#EF3340';
---

<a href={href} class:list={['logo', { dark: onDark }]} aria-label="AuditYourBuilding — home" style={`--logo-red:${red}`}>
  <svg width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <!-- tower and wing: flag red (PMS 032) -->
    <path d="M8.3 3.5h10c1 0 1.8.8 1.8 1.8V11h5.6c1 0 1.8.8 1.8 1.8v13.9c0 1-.8 1.8-1.8 1.8H8.3c-1 0-1.8-.8-1.8-1.8V5.3c0-1 .8-1.8 1.8-1.8Z" fill={red} />
    <!-- windows -->
    <rect x="9.8" y="7" width="2.6" height="2.6" rx=".5" fill="#fff" opacity=".85" />
    <rect x="14.2" y="7" width="2.6" height="2.6" rx=".5" fill="#fff" opacity=".85" />
    <rect x="22.5" y="15.4" width="2.6" height="2.6" rx=".5" fill="#fff" opacity=".85" />
    <rect x="22.5" y="20.8" width="2.6" height="2.6" rx=".5" fill="#fff" opacity=".85" />
    <!-- checkmark -->
    <path d="m9.7 17.2 3.4 3.4 6.2-6.8" stroke="#FFFFFF" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
  </svg>
  <span class="wordmark">Audit<em>Your</em>Building</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; }
  .wordmark { font-family: var(--display); font-weight: 800; font-size: 20px; letter-spacing: -0.02em; color: var(--ink); }
  .wordmark em { font-style: normal; color: var(--logo-red, #ef3340); }
  .logo.dark .wordmark { color: #fff; }
  @media (max-width: 380px) { .wordmark { font-size: 18px; } }
</style>
