---
/**
 * Shared styles for the calculator pages. Results are injected by script, so the rules are
 * global but every selector is namespaced under .calc / .cpage.
 */
---

<style is:global>
  /* ---------- page shell ---------- */
  .cpage .lede strong { color: var(--ink); }
  .cpage .facts-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin: 4px 0 28px; }
  .cpage .facts-strip .g { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; min-width: 0; }
  .cpage .facts-strip .k { font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); margin: 0 0 4px; }
  .cpage .facts-strip .v { font-family: var(--mono); font-weight: 600; font-size: 16px; color: var(--ink); margin: 0; overflow-wrap: anywhere; }
  .cpage .facts-strip .s { font-size: 12.5px; color: var(--muted); margin: 2px 0 0; line-height: 1.35; }
  @media (max-width: 840px) { .cpage .facts-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .cpage .sec { margin: 40px 0 0; padding: 0; }
  .cpage .sec > h2 { font-size: 26px; margin-bottom: 10px; }
  .cpage .sec h3 { font-size: 19px; margin: 22px 0 8px; }
  .cpage .prose { max-width: 72ch; }
  .cpage .prose p, .cpage .prose li { font-size: 15.5px; }
  .cpage .prose ul { padding-left: 20px; display: grid; gap: 6px; }
  .cpage .glance-note { font-size: 13.5px; color: var(--muted); max-width: 80ch; margin: 8px 0 0; }
  .cpage .gtable { font-size: 14.5px; }
  .cpage .gtable td, .cpage .gtable th { overflow-wrap: anywhere; }
  .cpage .gtable td.num, .cpage .gtable th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cpage .gtable caption { text-align: left; font-family: var(--display); font-weight: 700; font-size: 16px; padding: 14px 14px 6px; color: var(--ink); }
  .cpage .gtable .sub { display: block; font-size: 12.5px; color: var(--muted); font-weight: 400; }
  .cpage .gtable tr.hl td { background: var(--heat-tint); }
  @media (max-width: 640px) {
    .cpage .gtable td.num { text-align: left; white-space: normal; }
    .cpage table.stack.gtable tr.hl { background: var(--heat-tint); }
  }
  .cpage .card.tablewrap { margin: 14px 0; }
  .cpage .two-up { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  @media (max-width: 860px) { .cpage .two-up { grid-template-columns: 1fr; } }
  .cpage .rule-card { padding: 18px 20px; }
  .cpage .rule-card h3 { margin-top: 0; font-size: 17px; }
  .cpage .rule-card p { font-size: 14.5px; }
  .cpage .src-list { margin: 0 0 10px; padding-left: 20px; display: grid; gap: 6px; font-size: 13.5px; }
  .cpage .src-list a { overflow-wrap: anywhere; }
  .cpage .srcs { border-left: 4px solid var(--steel); margin: 30px 0 10px; }
  .cpage .how { border-left: 4px solid var(--pine); }
  .cpage .how h3 { font-size: 17px; margin: 18px 0 6px; }
  .cpage .how h3:first-child { margin-top: 0; }
  .cpage .how p, .cpage .how li { font-size: 14.5px; }
  .cpage .how ul { padding-left: 20px; display: grid; gap: 5px; margin: 0 0 10px; }
  .cpage .formula { font-family: var(--mono); font-size: 13px; background: var(--paper); border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; display: block; overflow-wrap: anywhere; margin: 6px 0 10px; color: var(--ink); }
  .cpage .linkrow { display: flex; flex-wrap: wrap; gap: 10px; margin: 12px 0 0; }
  .cpage .linkrow a { display: inline-flex; align-items: center; gap: 8px; border: 1.5px solid var(--line-strong); border-radius: 999px; padding: 8px 16px; text-decoration: none; font-weight: 600; font-size: 14.5px; color: var(--ink); background: var(--card); }
  .cpage .linkrow a:hover { border-color: var(--ink); }
  .cpage .linkrow a.primary { background: var(--ink); color: #fff; border-color: var(--ink); }
  .cpage .calc-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; margin: 12px 0 0; }
  .cpage .calc-card { display: grid; gap: 6px; align-content: start; padding: 16px 18px; text-decoration: none; color: var(--ink); border-left: 4px solid var(--heat); }
  .cpage .calc-card:hover { box-shadow: var(--shadow-md); color: var(--ink); }
  .cpage .calc-card strong { font-family: var(--display); font-size: 16.5px; }
  .cpage .calc-card span { font-size: 14px; color: var(--muted); line-height: 1.5; }
  .cpage .city-index h3 { font-size: 15px; margin: 18px 0 8px; font-family: var(--display); }
  .cpage .city-index ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 8px; }
  .cpage .city-index a { display: inline-block; font-size: 14px; padding: 5px 12px; border: 1px solid var(--line-strong); border-radius: 999px; text-decoration: none; color: var(--ink); background: var(--card); }
  .cpage .city-index a:hover { border-color: var(--ink); }
  .cpage .city-index a[aria-current="page"] { background: var(--ink); color: #fff; border-color: var(--ink); }
  .cpage .picker { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; margin: 12px 0 0; }
  .cpage .picker .field { margin: 0; min-width: min(320px, 100%); flex: 1 1 260px; max-width: 420px; }
  .cpage .faq-wrap { max-width: 78ch; }

  /* ---------- calculator ---------- */
  .calc { margin: 10px 0 0; padding: 0; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
  .calc .calc-top { padding: 24px 26px 6px; }
  .calc .calc-top h2 { font-size: 26px; margin-bottom: 6px; }
  .calc .calc-top .small { max-width: 80ch; margin-bottom: 4px; }
  .calc-hub-note { background: var(--warn-tint); color: var(--ink); border-radius: 8px; padding: 10px 14px; font-size: 14.5px; margin: 8px 0 10px; }
  .calc-form { margin: 0; }
  .calc-block { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 26px; padding: 22px 26px 24px; border-top: 1px solid var(--line); }
  .calc-block:first-child { border-top: none; }
  @media (max-width: 980px) { .calc-block { grid-template-columns: minmax(0, 1fr); gap: 16px; } }
  @media (max-width: 640px) {
    .calc .calc-top { padding: 18px 16px 4px; }
    .calc-block { padding: 18px 16px 20px; }
  }
  .calc-in { min-width: 0; }
  .calc-out { min-width: 0; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; align-self: start; }
  @media (max-width: 640px) { .calc-out { padding: 14px 14px; } }
  .calc fieldset.cf { border: 0; margin: 0 0 16px; padding: 0; min-width: 0; }
  .calc fieldset.cf > legend { font-family: var(--display); font-weight: 800; font-size: 18px; padding: 0; margin: 0 0 10px; }
  .calc fieldset.rg { border: 0; margin: 0 0 14px; padding: 0; min-width: 0; }
  .calc fieldset.rg > legend, .calc .lbl { font-weight: 600; font-size: 14px; padding: 0; margin: 0 0 8px; display: block; }
  .calc .opt { font-weight: 400; color: var(--faint); font-size: 0.92em; }
  .calc .field { margin: 0 0 14px; min-width: 0; }
  .calc .field.inline { margin-top: 10px; }
  .calc .hint { font-size: 12.5px; color: var(--muted); margin: 5px 0 0; line-height: 1.45; }
  .calc .radio-row { gap: 6px; }
  .calc .radio-pill span { font-size: 13.5px; padding: 6px 13px; }
  .calc select { padding: 9px 12px; font-size: 15px; }
  .calc .in-unit { display: inline-flex; align-items: center; gap: 6px; max-width: 100%; }
  .calc .in-unit input { width: 9.5em; max-width: 100%; padding: 8px 10px; font-size: 15px; font-variant-numeric: tabular-nums; }
  .calc .in-unit > span { font-size: 14px; color: var(--muted); white-space: nowrap; }
  .calc .in-unit.pre > span:first-child { margin-right: -2px; }
  .calc .pair { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .calc .pair .in-unit input { width: 7.5em; }
  .calc .pair .dash { color: var(--muted); }
  .calc details.cf { border: 1px solid var(--line); border-radius: var(--radius); padding: 0; background: var(--card); }
  .calc details.cf > summary { cursor: pointer; padding: 12px 14px; font-family: var(--display); font-weight: 700; font-size: 15.5px; list-style: none; }
  .calc details.cf > summary::-webkit-details-marker { display: none; }
  .calc details.cf > summary::before { content: "+ "; color: var(--heat); font-family: var(--mono); }
  .calc details.cf[open] > summary::before { content: "– "; }
  .calc details.cf > :not(summary) { margin-left: 14px; margin-right: 14px; }
  .calc details.cf > :last-child { margin-bottom: 14px; }
  .calc .price-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 16px; }
  @media (max-width: 640px) { .calc .price-grid { grid-template-columns: minmax(0, 1fr); } }
  .calc .price-grid .in-unit input { width: 6.5em; }
  .calc .measure { border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px 6px; margin: 0 0 12px; background: var(--card); }
  .calc .measure > legend { font-family: var(--display); font-weight: 700; font-size: 16px; padding: 0 6px; margin-left: -6px; }
  .calc .inc { display: flex; align-items: flex-start; gap: 8px; font-weight: 600; font-size: 14px; margin: 0 0 10px; line-height: 1.4; cursor: pointer; }
  .calc .inc input { width: 18px; height: 18px; accent-color: var(--heat); margin: 0; flex: none; }
  .calc .grid-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 14px; }
  @media (max-width: 520px) { .calc .grid-fields { grid-template-columns: minmax(0, 1fr); } }
  .calc .measure[data-off="1"] .grid-fields, .calc .measure[data-off="1"] .mhint { opacity: 0.55; }

  /* results */
  .calc-out .res-head { margin: 0 0 12px; }
  .calc-out .res-kicker { margin: 0 0 6px; display: flex; flex-wrap: wrap; gap: 6px; }
  .calc-out .res-big { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
  .calc-out .res-big .money { font-size: clamp(28px, 4vw, 36px); }
  .calc-out .res-big .money.more { color: var(--heat-deep); }
  .calc-out .res-unit { font-size: 15px; color: var(--muted); font-weight: 600; }
  .calc-out .res-sub { margin: 6px 0 0; font-size: 14.5px; color: var(--ink); }
  .calc-out .res-note { margin: 8px 0 0; }
  .calc-out .res-warn { margin: 8px 0 0; font-size: 14px; color: var(--warn); font-weight: 600; }
  .calc-out .muted { color: var(--faint); }
  .calc-out .save { color: var(--pine); font-weight: 700; }
  .calc-out .more { color: var(--heat-deep); font-weight: 700; }
  .calc-out .foot { margin: 10px 0 0; }
  .calc-out .mini-h { font-size: 15px; margin: 14px 0 6px; }
  .calc-out .rb-list { margin: 0; padding-left: 18px; font-size: 14px; display: grid; gap: 4px; }
  .calc-out .kv-grid { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 6px 14px; margin: 8px 0 0; font-size: 14.5px; }
  .calc-out .kv-grid dt { color: var(--muted); }
  .calc-out .kv-grid dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .calc-table { font-size: 14px; background: var(--card); border-radius: 8px; }
  .calc-table caption { text-align: left; font-weight: 700; font-family: var(--display); padding: 0 0 8px; font-size: 14.5px; color: var(--ink); }
  .calc-table th { font-size: 11.5px; padding: 8px 10px; }
  .calc-table td { padding: 9px 10px; overflow-wrap: anywhere; }
  .calc-table td .eff, .calc-table td .pergj { display: block; font-size: 12px; color: var(--muted); font-weight: 400; }
  .calc-table tr.mine td { background: var(--heat-tint); }
  .calc-table .chip { font-size: 10.5px; padding: 1px 8px; vertical-align: 1px; }
  @media (max-width: 640px) {
    .calc-table caption { padding: 0 0 6px; }
    table.stack caption { display: block; }
  }
  /* compact tables: on phones each row becomes two short lines
     [name ............ value]
     [detail 1 ...... detail 2] */
  @media (max-width: 640px) {
    table.compact thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    table.compact, table.compact tbody { display: block; width: 100%; }
    table.compact caption { display: block; }
    table.compact tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 12px; row-gap: 3px; padding: 10px 12px; border-bottom: 1px solid var(--line); }
    table.compact td { display: block; padding: 0; border: 0; background: transparent !important; text-align: left; }
    table.compact td.c-main { grid-column: 1; grid-row: 1; font-size: 14.5px; }
    table.compact td.c-val { grid-column: 2; grid-row: 1; text-align: right; font-weight: 700; font-size: 15px; white-space: nowrap; }
    table.compact td.c-s1 { grid-column: 1; grid-row: 2; font-size: 12.5px; color: var(--muted); }
    table.compact td.c-s2 { grid-column: 2; grid-row: 2; font-size: 12.5px; text-align: right; white-space: nowrap; }
    table.compact td.c-s3 { grid-column: 1 / -1; grid-row: 3; font-size: 12.5px; color: var(--muted); }
    table.compact td[data-k]::before { content: attr(data-k) " "; color: var(--faint); font-weight: 400; }
    table.compact tr.mine, table.compact tr.hl { background: var(--heat-tint); }
    table.compact td .eff, table.compact td .pergj, table.compact td .sub { display: block; }
    table.compact td.c-val .pergj, table.compact td.c-val .sub { font-weight: 400; }
    .cpage table.compact td.c-val, .cpage table.compact td.c-s2 { text-align: right; }
    .cpage table.compact td.na { display: none; }
  }
  .calc-out .bar { height: 8px; border-radius: 999px; background: var(--line); overflow: hidden; margin: 6px 0 2px; }
  .calc-out .bar > span { display: block; height: 100%; background: var(--pine); }
  .calc-out .verdict { border-left: 4px solid var(--pine); padding: 8px 12px; background: var(--card); border-radius: 0 8px 8px 0; margin: 10px 0 0; font-size: 14.5px; }
  .calc-out .verdict.warn { border-left-color: var(--warn); }
  .calc-out .verdict.bad { border-left-color: var(--dead); }
  .calc-out .verdict p { margin: 0 0 6px; }
  .calc-out .verdict p:last-child { margin: 0; }
</style>
