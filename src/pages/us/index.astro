<script>
  // Quick start: hand the ZIP code (and build year) to the planner in the #fragment, which never
  // reaches a server, and let the planner open at step 2. Without JavaScript the form's GET still works.
  const quick = document.getElementById('usQuick') as HTMLFormElement | null;
  const zipIn = quick?.querySelector<HTMLInputElement>('#h-zip');
  const zipMsg = quick?.querySelector<HTMLElement>('#h-zip-msg');
  const caPostal = (raw: string) => {
    const m = raw.trim().toUpperCase().match(/^([ABCEGHJ-NPRSTVXY]\d[ABCEGHJ-NPRSTV-Z])\s?-?(\d[ABCEGHJ-NPRSTV-Z]\d)$/);
    return m ? `${m[1]} ${m[2]}` : null;
  };
  const say = (html: string, error = false) => {
    if (!zipMsg) return;
    zipMsg.innerHTML = html;
    zipMsg.classList.toggle('err', error);
    zipIn?.setAttribute('aria-invalid', error ? 'true' : 'false');
  };
  zipIn?.addEventListener('input', () => {
    // point Canadians to their planner as soon as the code is recognizable
    const ca = caPostal(zipIn.value);
    if (ca) say(caLink(ca));
    else if (zipMsg?.textContent) say('');
  });
  function caLink(postal: string) {
    const q = new URLSearchParams({ postal });
    const age = quick?.querySelector<HTMLInputElement>('input[name="age"]:checked')?.value;
    if (age) q.set('age', age);
    return `That looks like a Canadian postal code. This planner covers US homes; <a href="https://audityourhome.ca/switch/?to=${encodeURIComponent(`/plan/#${q.toString()}`)}">open the Canadian planner&nbsp;→</a> (we’ll carry your postal code over).`;
  }
  quick?.addEventListener('submit', (e) => {
    const raw = zipIn?.value.trim() ?? '';
    const zip = raw.replace(/\s+/g, '').match(/^(\d{5})(?:-?\d{4})?$/)?.[1];
    e.preventDefault();
    if (!zip) {
      const ca = caPostal(raw);
      say(ca ? caLink(ca) : raw ? 'Enter a 5-digit ZIP code, like 60614.' : 'Enter the home’s 5-digit ZIP code.', !ca);
      zipIn?.focus();
      return;
    }
    const q = new URLSearchParams({ zip });
    const age = quick.querySelector<HTMLInputElement>('input[name="age"]:checked')?.value;
    if (age) q.set('age', age);
    location.href = `/plan/#${q.toString()}`;
  });
</script>
