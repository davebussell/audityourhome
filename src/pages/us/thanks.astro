---
/**
 * Where the US question form lands after a Netlify submission (the form posts to
 * /us/thanks/?sent=1). Without the flag (a bookmark, a reload, a direct visit) the page doesn't
 * claim anything was sent. Not indexed.
 */
import Base from '../../layouts/Base.astro';
import JourneyBar from '../../components/JourneyBar.astro';
import { SITE } from '../../config/site';
---

<Base title="Your question | AuditYourHome" description="What happens after you send us a question about a home energy audit." indexable={false}>
  <div class="container thanks">
    <JourneyBar country="us" current={2} ticks={false} />

    <div class="page-hero">
      <div class="hero-text" data-sent="yes" hidden>
        <p class="eyebrow">Message received</p>
        <h1>Thanks. Your message reached us.</h1>
        <p class="lede measure">A person reads every message, usually within one business day. Here’s what happens next.</p>
      </div>
      <div class="hero-text" data-sent="no">
        <p class="eyebrow">Your question</p>
        <h1>What happens after you send a question</h1>
        <p class="lede measure">
          If you sent a question from one of our forms, a person reads it and replies by email, usually within one
          business day. If you landed here another way, nothing has been sent yet: your
          <a href="/us/cities/">metro guide</a> lists the programs near you, or you can
          <a href="/us/plan/">start with your free plan</a>.
        </p>
      </div>
    </div>

    <section class="next" aria-labelledby="h-next">
      <h2 id="h-next">What happens next</h2>
      <ol class="nsteps">
        <li class="card">
          <h3>We read your message</h3>
          <p>A person, not a bot, usually within one business day.</p>
        </li>
        <li class="card">
          <h3>You get a reply from Dave Bussell</h3>
          <p>Dave runs AuditYourHome and replies from {SITE.contactEmail}, his company address (check your spam folder too), with the energy auditors and utility programs that serve your ZIP code. We don’t pass your details to contractors.</p>
        </li>
        <li class="card">
          <h3>You book the home energy audit</h3>
          <p>Often through your utility, sometimes free. Ask what the visit includes before you book.</p>
        </li>
      </ol>
    </section>

    <section class="wait card card-pad" aria-labelledby="h-wait">
      <h2 id="h-wait">While you wait</h2>
      <ul class="checklist">
        <li>Find your last 12 months of energy bills: electricity, and gas, oil or propane if you use them.</li>
        <li>Note the rooms that run hot or cold, drafty, humid or damp, and in which season.</li>
        <li>Make sure the auditor can reach the attic, any crawlspace or basement, and the furnace, air handler and water heater.</li>
        <li>
          Have your questions ready: Is it free or discounted through my utility? Does it include a blower door test and
          combustion safety testing? Will the report rank the upgrades and list the rebates I qualify for?
        </li>
      </ul>
      <p class="links small">
        <a href="/us/how-it-works/#visit">What happens at the visit</a> ·
        <a href="/us/cities/">Programs by metro</a> ·
        <a href="/us/programs/">Rebates and programs</a>
      </p>
    </section>

    <p class="back"><a class="btn btn-ghost" href="/us/">Back to the home page</a></p>
  </div>
</Base>

<script is:inline>
  (function () {
    var sent = /(?:^|[?&])sent=1(?:&|$)/.test(location.search);
    document.querySelectorAll('[data-sent]').forEach(function (el) {
      el.hidden = (el.getAttribute('data-sent') === 'yes') !== sent;
    });
  })();
</script>

<style>
  .thanks { padding-bottom: 48px; }
  .thanks .page-hero { padding-bottom: 20px; }
  .next h2, .wait h2 { font-size: 22px; margin: 0 0 12px; }
  .nsteps { list-style: none; margin: 0 0 18px; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; counter-reset: ns; }
  .nsteps li { padding: 18px 20px; box-shadow: none; counter-increment: ns; }
  .nsteps h3 { font-size: 17px; margin: 0 0 6px; }
  .nsteps h3::before { content: counter(ns) '. '; color: var(--heat); }
  .nsteps p { margin: 0; color: var(--muted); font-size: 15px; }
  .wait { box-shadow: none; border-left: 4px solid var(--pine); max-width: 820px; }
  .checklist { margin: 0 0 12px; padding-left: 20px; display: grid; gap: 8px; }
  .links { margin: 0; line-height: 1.8; }
  .back { margin-top: 22px; }
</style>
