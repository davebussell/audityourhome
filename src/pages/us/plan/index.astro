---
/**
 * US Home Energy Planner (/us/plan/). Target of every "Check my home" button on the US site, of the
 * ZIP form on /us/ (/us/plan/#zip=12345&age=…) and of the test screener's hand-off. The planner runs
 * entirely in the browser (src/lib/us/plan-client.ts) on a payload built here from the US research
 * files; analytics are off on this page so nothing a visitor enters leaves the browser.
 */
import Base from '../../../layouts/Base.astro';
import LeadFormUS from '../../../components/us/LeadFormUS.astro';
import JourneyBar from '../../../components/JourneyBar.astro';
import GlossaryRuntime from '../../../components/GlossaryRuntime.astro';
import { breadcrumbSchema } from '../../../lib/schema';
import { buildPlanPayload, NATIONAL, PRICE_PERIODS } from '../../../lib/us/plan-payload';
import { METROS, US_VERIFIED, POPULATION_SOURCE } from '../../../lib/us/data';
import { VINTAGES, ERAS, SYMPTOMS, GOALS } from '../../../lib/us/plan-content';
import { eraAssumptions, REF_HDD65, WINDOW_LABEL_US, SQFT_PER_M2 } from '../../../lib/us/plan-model';
import { coolingBaseline, type CoolingData } from '../../../lib/us/plan-cooling';
import { MODEL } from '../../../lib/calc/engine';
import { NETLIFY_FORMS } from '../../../config/forms';
import pricesJson from '../../../data/us/prices.json';
import climateJson from '../../../data/us/climate.json';
import testsJson from '../../../data/us/tests.json';
import zip3Json from '../../../data/us/zip3.json';
import coolingJson from '../../../data/us/cooling-model.json';

const title = 'US Home Energy Planner: what your home needs and what it saves | AuditYourHome';
const description =
  'Six short steps, about 2 minutes. Get an upgrade plan with conservative heating and cooling savings for your climate and state energy prices, the tests worth asking for, and which rebates and assessment programs are open where you live. Nothing you enter leaves your browser.';

const payload = buildPlanPayload();

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/us/' },
    { name: 'Home Energy Planner', path: '/us/plan/' },
  ]),
];

// ---- assumptions tables (the same numbers the planner reads)
const int = (n: number) => Math.round(n).toLocaleString('en-US');
const eraRows = VINTAGES.map((v) => ({ v, label: ERAS[v].label, ...eraAssumptions(v) }));
const sizeSqft = Object.values(MODEL.demand.sizeBandM2).map((m2) => Math.round((m2 * SQFT_PER_M2) / 100) * 100);
const P = pricesJson as any;
const states = payload.states as Record<string, { n: string; p: { e: number; g: number | null; gy: string | null; o: number | null; pr: number | null } }>;
const priceRows = Object.values(states).sort((a, b) => a.n.localeCompare(b.n));
const usd = (n: number) => `$${n.toFixed(2)}`;
const insulation = payload.insulation;
const noaa = (climateJson as any).sources?.find((s: any) => /NOAA/.test(s.label)) ?? null;
const estarSrc = (testsJson as any).energyTests?.insulation?.sources?.[0] ?? null;
const zipSources = ((zip3Json as any).meta?.sources ?? []) as { label: string; href: string }[];
const wh = MODEL.water;
const gallonsPerPerson = Math.round(wh.litresPerPerson / 3.785411784);
const deliveryF = Math.round(wh.deliveryC * 1.8 + 32);
const bands = MODEL.ashpCopBands;

// ---- cooling: a typical 1,600 sq ft, 1981–1995 detached house with an average central AC, per metro
const CD = payload.cooling as unknown as CoolingData;
const metroRows = [...METROS].sort((a, b) => (b.climate?.hdd65 ?? 0) - (a.climate?.hdd65 ?? 0)).map((m) => ({
  m,
  ac: coolingBaseline({
    metro: m.slug, zone: m.climate?.iecc2021ClimateZone ?? null, cdd65: m.climate?.cdd65 ?? 0, size: 'medium', age: '1981-1995',
    htype: 'detached', ac: 'unsure', heat: 'gas', hage: 'unsure', south: false,
  }, CD).kwh,
}));
const C = coolingJson as any;
const pickSrc = (list: string[] | undefined, re: RegExp) => (list ?? []).find((u) => re.test(u)) ?? null;
const coolSources = [
  { label: 'EIA 2020 Residential Energy Consumption Survey (RECS), public microdata', href: pickSrc(C.billMethod.source, /recs2020_public/) },
  { label: 'EIA RECS 2020 end-use table CE5.3a', href: pickSrc(C.billMethod.source, /ce5\.3a/) },
  { label: 'NREL ResStock 2024 release 2 documentation', href: pickSrc(C.measures.attic_insulation.source, /resstock_documentation/) },
  { label: 'Florida Solar Energy Center: duct repair in occupied homes', href: pickSrc(C.measures.duct_sealing.source, /article=1857/) },
  { label: 'Florida Solar Energy Center: attic radiant barriers', href: pickSrc(C.measures.radiant_barrier.source, /article=1610/) },
  { label: 'Florida Solar Energy Center: cool roofs', href: pickSrc(C.measures.cool_roof.source, /article=1733/) },
  { label: 'Florida Solar Energy Center: windows and solar heat gain', href: pickSrc(C.measures.low_shgc_windows.source, /article=1628/) },
  { label: 'Building America Solution Center: attic radiant barriers', href: pickSrc(C.measures.radiant_barrier.source, /basc\.pnnl/) },
  { label: 'DOE Uniform Methods Project, chapter 8: whole-building (bill) analysis', href: pickSrc(C.billMethod.source, /68564/) },
  { label: 'NOAA 1991–2020 monthly degree-day normals', href: C.billMethod.monthlyNormalsSource as string },
  { label: 'Federal AC and heat pump efficiency standards (10 CFR 430.32)', href: pickSrc((C.acEfficiencyByAge as any[]).map((r) => r.source), /ecfr\.gov/) },
  { label: 'LBNL Home Energy Saver: equipment efficiency by year', href: pickSrc((C.acEfficiencyByAge as any[]).map((r) => r.source), /hes-documentation/) },
  { label: 'EIA residential equipment technology assumptions (Appendix A)', href: pickSrc(C.measures.right_sized_variable_speed_ac.source, /appendix-a/) },
  { label: 'NREL: heat pump water heaters and the space they sit in', href: pickSrc(C.measures.hpwh_side_cooling.source, /58594/) },
].filter((s): s is { label: string; href: string } => !!s.href);
if (coolSources.length < 12) throw new Error('us/plan: cooling sources missing from cooling-model.json');
const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

const leadSub = NETLIFY_FORMS
  ? 'A person reads every message and replies with the auditors and utility programs that serve your area. We’ve started the form with your ZIP code, home type and a summary of this plan with its link; change anything you like. Nothing is sent until you press the button.'
  : 'Email us and a person replies with the auditors and utility programs that serve your area. The email starts with your ZIP code and a summary of this plan with its link; nothing is sent until you send it.';
---

<Base title={title} description={description} schema={schema} analytics={false}>
  <div class="container">
    <div class="page-hero">
      <p class="eyebrow">US Home Energy Planner</p>
      <h1>What does <em>your</em> home need?</h1>
      <p class="lede">
        Six short steps, about 2 minutes, no email. You’ll get what homes in your climate usually need,
        an upgrade plan with conservative heating and cooling savings at your state’s energy prices, the
        tests worth asking for, and the programs and rebates open where you live.
      </p>
      <p class="privacy-line">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2.5 4 5v4.6c0 3.6 2.5 6.7 6 7.9 3.5-1.2 6-4.3 6-7.9V5l-6-2.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m7.4 10 1.9 1.9 3.4-3.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        The planner runs in your browser. Nothing you enter is stored or sent anywhere.
      </p>
      <div id="journeyWizard"><JourneyBar country="us" current={1} compact /></div>
    </div>

    <div class="planner card" id="planner">
      <ol class="steps-nav" id="stepsNav" aria-label="Planner steps">
        {['Location', 'Your home', 'Heating and cooling', 'Problems', 'Goals', 'Bills'].map((label, i) => (
          <li data-step={i + 1} class={i === 0 ? 'on' : undefined}>
            <button type="button" data-goto={i + 1} disabled={i > 0} aria-current={i === 0 ? 'step' : undefined}>{label}</button>
          </li>
        ))}
      </ol>

      <form id="plannerForm" novalidate>
        <!-- STEP 1 -->
        <fieldset class="step on" data-step="1">
          <legend><span class="step-of">Step 1 of 6</span><h2>Where’s the house?</h2></legend>
          <div class="field narrow">
            <label for="zip">ZIP code</label>
            <input id="zip" name="zip" type="text" inputmode="numeric" autocomplete="postal-code" placeholder="e.g. 60614" maxlength="10" aria-describedby="zipHint zipFeedback" />
            <p class="small hint" id="zipHint">Sets your climate, energy prices and programs. The lookup runs in your browser.</p>
          </div>
          <div id="zipFeedback" class="zip-feedback" aria-live="polite"></div>
          <div class="field util-field" id="utilField" hidden>
            <span class="lbl" id="utilLbl">Who sends your electric bill? <span class="hint-inline">(optional)</span></span>
            <div class="radio-row wrap" role="radiogroup" aria-labelledby="utilLbl" id="utilOpts"></div>
            <p class="small hint">Utilities here run different programs and rebates, so we’ll show only the ones you can use. It’s the company named at the top of your electric bill.</p>
          </div>
          <div class="field clim-field" id="climField" hidden>
            <label for="climPick" id="climLabel">Climate stand-in for dollar estimates (optional)</label>
            <select id="climPick" name="clim"></select>
            <p class="small hint">Metros are listed coldest first, with their yearly heating and cooling degree days (°F). Pick the one whose winters and summers are most like yours.</p>
          </div>
        </fieldset>

        <!-- STEP 2 -->
        <fieldset class="step" data-step="2">
          <legend><span class="step-of">Step 2 of 6</span><h2>Tell us about the house</h2></legend>
          <!-- filled when the home page quick start skips step 1: where we placed the ZIP code, and the utility question -->
          <p class="zip-match" id="zipMatch" hidden></p>
          <div id="utilSlot2"></div>
          <div class="field">
            <span class="lbl" id="ageLbl">When was it built? <span class="hint-inline">(a rough guess is fine)</span></span>
            <div class="radio-row" role="radiogroup" aria-labelledby="ageLbl">
              {VINTAGES.map((v) => (
                <label class="radio-pill"><input type="radio" name="age" value={v} /><span>{ERAS[v].label}</span></label>
              ))}
            </div>
            <p class="small hint" id="eraHint"></p>
          </div>
          <div class="field">
            <span class="lbl" id="htypeLbl">Home type</span>
            <div class="radio-row" role="radiogroup" aria-labelledby="htypeLbl">
              <label class="radio-pill"><input type="radio" name="htype" value="detached" checked /><span>Detached house</span></label>
              <label class="radio-pill"><input type="radio" name="htype" value="semi" /><span>Townhouse, rowhouse or duplex</span></label>
              <label class="radio-pill"><input type="radio" name="htype" value="condo" /><span>Condo or apartment</span></label>
            </div>
          </div>
          <div class="field">
            <span class="lbl" id="sizeLbl">Rough size</span>
            <div class="radio-row" role="radiogroup" aria-labelledby="sizeLbl">
              <label class="radio-pill"><input type="radio" name="size" value="small" /><span>Under 1,200 sq ft</span></label>
              <label class="radio-pill"><input type="radio" name="size" value="medium" checked /><span>1,200–2,000</span></label>
              <label class="radio-pill"><input type="radio" name="size" value="large" /><span>2,000–3,000</span></label>
              <label class="radio-pill"><input type="radio" name="size" value="xlarge" /><span>Over 3,000</span></label>
            </div>
          </div>
          <div class="field">
            <span class="lbl" id="foundLbl">Foundation <span class="hint-inline">(where the ducts and pipes run)</span></span>
            <div class="radio-row" role="radiogroup" aria-labelledby="foundLbl">
              <label class="radio-pill"><input type="radio" name="found" value="basement" /><span>Basement</span></label>
              <label class="radio-pill"><input type="radio" name="found" value="crawl" /><span>Crawlspace</span></label>
              <label class="radio-pill"><input type="radio" name="found" value="slab" /><span>Slab on grade</span></label>
              <label class="radio-pill"><input type="radio" name="found" value="unsure" checked /><span>Not sure</span></label>
            </div>
          </div>
          <div class="field">
            <span class="lbl" id="waterLbl">Water source <span class="hint-inline">(flags well-water testing)</span></span>
            <div class="radio-row" role="radiogroup" aria-labelledby="waterLbl">
              <label class="radio-pill"><input type="radio" name="water" value="municipal" checked /><span>Public water system</span></label>
              <label class="radio-pill"><input type="radio" name="water" value="well" /><span>Private well</span></label>
              <label class="radio-pill"><input type="radio" name="water" value="unsure" /><span>Not sure</span></label>
            </div>
          </div>
          <div class="field">
            <span class="lbl" id="winLbl">Most of the windows are… <span class="hint-inline">(window age changes the math)</span></span>
            <div class="radio-row" role="radiogroup" aria-labelledby="winLbl">
              <label class="radio-pill"><input type="radio" name="win" value="single" /><span>Single-pane</span></label>
              <label class="radio-pill"><input type="radio" name="win" value="singlestorm" /><span>Single-pane + storm windows</span></label>
              <label class="radio-pill"><input type="radio" name="win" value="double-old" /><span>Double-pane, before 2000</span></label>
              <label class="radio-pill"><input type="radio" name="win" value="double-new" /><span>Double-pane, 2000 or later</span></label>
              <label class="radio-pill"><input type="radio" name="win" value="triple" /><span>Triple-pane or recent ENERGY STAR</span></label>
              <label class="radio-pill"><input type="radio" name="win" value="unsure" checked /><span>Not sure</span></label>
            </div>
          </div>
          <div class="field">
            <span class="lbl" id="prevLbl">Has the house had a professional energy audit before? <span class="hint-inline">(including a HERS rating or Home Energy Score)</span></span>
            <div class="radio-row" role="radiogroup" aria-labelledby="prevLbl">
              <label class="radio-pill"><input type="radio" name="prev" value="no" checked /><span>No</span></label>
              <label class="radio-pill"><input type="radio" name="prev" value="recent" /><span>Yes, in the last 3 years</span></label>
              <label class="radio-pill"><input type="radio" name="prev" value="older" /><span>Yes, longer ago</span></label>
              <label class="radio-pill"><input type="radio" name="prev" value="unsure" /><span>Not sure</span></label>
            </div>
          </div>
        </fieldset>

        <!-- STEP 3 -->
        <fieldset class="step" data-step="3">
          <legend><span class="step-of">Step 3 of 6</span><h2>Heating, hot water and cooling</h2></legend>
          <div class="field">
            <span class="lbl" id="heatLbl">Main heating</span>
            <div class="radio-row wrap" role="radiogroup" aria-labelledby="heatLbl">
              <label class="radio-pill"><input type="radio" name="heat" value="gas" checked /><span>Natural gas furnace</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="gasboiler" /><span>Natural gas boiler (radiators or in-floor)</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="electric" /><span>Electric baseboard</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="elecfurnace" /><span>Electric furnace or boiler</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="heatpump" /><span>Air-source heat pump</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="geothermal" /><span>Geothermal heat pump</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="oil" /><span>Heating oil furnace or boiler</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="propane" /><span>Propane furnace or boiler</span></label>
            </div>
          </div>
          <div class="field" id="heatAgeField">
            <span class="lbl" id="hageLbl">How old is it?</span>
            <div class="radio-row" role="radiogroup" aria-labelledby="hageLbl">
              <label class="radio-pill"><input type="radio" name="hage" value="new" /><span>Under 15 years</span></label>
              <label class="radio-pill"><input type="radio" name="hage" value="old" /><span>15 years or more</span></label>
              <label class="radio-pill"><input type="radio" name="hage" value="unsure" checked /><span>Not sure</span></label>
            </div>
          </div>
          <div class="field">
            <span class="lbl" id="secLbl">Also heated by… <span class="hint-inline">(optional)</span></span>
            <div class="radio-row wrap" role="group" aria-labelledby="secLbl">
              <label class="radio-pill"><input type="checkbox" name="sec" value="woodstove" /><span>Wood stove or fireplace</span></label>
              <label class="radio-pill"><input type="checkbox" name="sec" value="spaceheaters" /><span>Electric space heaters</span></label>
              <label class="radio-pill"><input type="checkbox" name="sec" value="solar" /><span>Lots of sunny south-facing windows</span></label>
            </div>
          </div>
          <div class="field">
            <span class="lbl" id="whLbl">Water heater</span>
            <div class="radio-row wrap" role="radiogroup" aria-labelledby="whLbl">
              <label class="radio-pill"><input type="radio" name="wh" value="gastank" /><span>Gas tank</span></label>
              <label class="radio-pill"><input type="radio" name="wh" value="gastankless" /><span>Gas tankless (on-demand)</span></label>
              <label class="radio-pill"><input type="radio" name="wh" value="electric" /><span>Electric tank</span></label>
              <label class="radio-pill"><input type="radio" name="wh" value="heatpump" /><span>Heat pump water heater</span></label>
              <label class="radio-pill"><input type="radio" name="wh" value="oil" /><span>Oil-fired tank</span></label>
              <label class="radio-pill"><input type="radio" name="wh" value="propane" /><span>Propane tank</span></label>
              <label class="radio-pill"><input type="radio" name="wh" value="boiler" /><span>From the boiler (combi)</span></label>
              <label class="radio-pill"><input type="radio" name="wh" value="unsure" checked /><span>Not sure</span></label>
            </div>
          </div>
          <div class="field">
            <span class="lbl" id="acLbl">Cooling</span>
            <div class="radio-row wrap" role="radiogroup" aria-labelledby="acLbl">
              <label class="radio-pill"><input type="radio" name="ac" value="none" /><span>No air conditioning</span></label>
              <label class="radio-pill"><input type="radio" name="ac" value="central-new" /><span>Central AC, under 10 years</span></label>
              <label class="radio-pill"><input type="radio" name="ac" value="central-old" /><span>Central AC, 10+ years</span></label>
              <label class="radio-pill"><input type="radio" name="ac" value="room" /><span>Window or portable units</span></label>
              <label class="radio-pill"><input type="radio" name="ac" value="heatpump" /><span>The heat pump cools</span></label>
              <label class="radio-pill"><input type="radio" name="ac" value="unsure" checked /><span>Not sure</span></label>
            </div>
          </div>
        </fieldset>

        <!-- STEP 4 -->
        <fieldset class="step" data-step="4">
          <legend><span class="step-of">Step 4 of 6</span><h2>Anything bugging you about the house?</h2></legend>
          <p class="small" id="symIntro">Pick everything that applies; it tunes your plan.</p>
          <div class="field">
            <div class="radio-row wrap" role="group" aria-label="Problems" id="symMain">
              {SYMPTOMS.map((s) => (
                <label class="radio-pill" data-sym={s.value}><input type="checkbox" name="sym" value={s.value} /><span>{s.label}</span></label>
              ))}
            </div>
            <details class="sym-more" id="symMoreWrap" hidden>
              <summary>More problems</summary>
              <div class="radio-row wrap" role="group" aria-label="More problems" id="symMore"></div>
            </details>
          </div>
        </fieldset>

        <!-- STEP 5 -->
        <fieldset class="step" data-step="5">
          <legend><span class="step-of">Step 5 of 6</span><h2>What are you hoping to do?</h2></legend>
          <div class="field">
            <div class="radio-row wrap" role="group" aria-label="Goals">
              {GOALS.map((g) => (
                <label class="radio-pill"><input type="checkbox" name="goal" value={g.value} checked={g.value === 'bills'} /><span>{g.label}</span></label>
              ))}
            </div>
          </div>
        </fieldset>

        <!-- STEP 6 -->
        <fieldset class="step" data-step="6">
          <legend><span class="step-of">Step 6 of 6</span><h2><span id="billTitle">Add your bills for dollar estimates</span> <span class="hint-inline">(optional)</span></h2></legend>
          <div class="field" id="billFuel">
            <p class="small">
              We’ve pre-set this to a typical home of your size and era. Drag it to match your real
              bills (a typical month across the year), or leave it as is and we’ll use the typical figure.
            </p>
            <div class="sliders">
              <div class="slider-field">
                <label for="fuelBill"><span id="fuelBillLabel">Average monthly natural gas bill</span> <output id="fuelOut" for="fuelBill">$0</output></label>
                <input id="fuelBill" name="fuelBill" type="range" min="0" max="400" step="5" value="0" />
                <p class="meta slider-hint" id="fuelHint"></p>
              </div>
            </div>
            <p class="small bill-note">
              Why we ask: a “typical” house can be far from yours. With your bill, every heating
              saving below is scaled to how much energy your house actually uses.
            </p>
          </div>
          <div class="field" id="billElec" hidden>
            <p class="small measure" id="elecLead"></p>
            <div class="elec-grid">
              <div class="elec-row">
                <label for="elecS">A summer electric bill</label>
                <div class="elec-in">
                  <span class="cur" aria-hidden="true">$</span>
                  <input id="elecS" name="es" type="number" inputmode="decimal" min="0" max="5000" step="1" placeholder="e.g. 210" aria-describedby="elecHint" />
                  <span class="for">for</span>
                  <select id="elecSm" name="esm" aria-label="Month the summer bill mostly covers">{months.map((m, i) => <option value={i}>{m}</option>)}</select>
                </div>
              </div>
              <div class="elec-row">
                <label for="elecW">A winter electric bill</label>
                <div class="elec-in">
                  <span class="cur" aria-hidden="true">$</span>
                  <input id="elecW" name="ew" type="number" inputmode="decimal" min="0" max="5000" step="1" placeholder="e.g. 120" aria-describedby="elecHint" />
                  <span class="for">for</span>
                  <select id="elecWm" name="ewm" aria-label="Month the winter bill mostly covers">{months.map((m, i) => <option value={i}>{m}</option>)}</select>
                </div>
              </div>
            </div>
            <p class="meta elec-out" id="elecOut" aria-live="polite"></p>
            <p class="small bill-note" id="elecHint">
              Use what each bill came to; the fixed monthly charge cancels out. We compare the two months’
              normal weather (NOAA degree days) to split your bill into air conditioning, heating and
              everything else, and we tell you if two bills can’t be split. A pool pump or an electric car
              skews the answer; a full year of bills is better still.
            </p>
          </div>
          <div class="field" id="billNoClim" hidden>
            <p class="small measure">
              Scaling to a bill needs climate numbers, and there aren’t any for your ZIP code unless
              you pick a climate stand-in on the first step. Press <b>See my plan</b>; you can pick
              one from the results too.
            </p>
          </div>
        </fieldset>

        <div class="wizard-actions">
          <button type="button" class="btn btn-ghost" id="backBtn" hidden>Back</button>
          <button type="button" class="btn btn-primary" id="nextBtn">Next</button>
        </div>
      </form>
    </div>

    <!-- RESULTS -->
    <div id="results" hidden>
      <div class="results-head">
        <p class="eyebrow">Your free plan · a pre-audit estimate</p>
        <h2 id="rTitle">Your home’s energy plan</h2>
        <p class="small" id="rSub"></p>
        <p class="head-actions"><button type="button" class="btn btn-ghost btn-sm" id="editBtn">Edit answers</button></p>
