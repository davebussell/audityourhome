---
/**
 * Worked examples: four houses run through the same engine as the calculators and the planner,
 * every step shown. Modelled examples (not customer stories) — labelled as such on the page.
 */
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import LeadForm from '../../components/LeadForm.astro';
import { ogFor } from '../../lib/photos';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';
import { SITE } from '../../config/site';
import { cityBySlug, resolvePrices, enginePrices, source } from '../../lib/calc/data';
import {
  MODEL, baselineDemandGJ, heatingCost, geometry, atticMeasure, atticTargetR, wallMeasure, basementMeasure,
  windowMeasure, airMeasure, setbackMeasure, savingValue, combineMeasures, waterHeatingDemand, waterHeaterCost,
  systemEfficiency, fuelOf, fuelUnit, calibrate,
  type SystemKey, type Vintage, type WindowKey, type MeasureResult, type WaterHeaterKey,
} from '../../lib/calc/engine';
import { money, num, int, gj as fgj, pct, unitPrice, years } from '../../lib/calc/format';

type MeasureKey = 'attic' | 'walls' | 'basement' | 'windows' | 'air' | 'setback';
interface ExampleDef {
  id: string; city: string; title: string; who: string;
  vintage: Vintage; sqft: number; storeys: number; type: 'detached' | 'semi';
  sys: SystemKey; water: WaterHeaterKey; win: WindowKey;
  measures: MeasureKey[]; monthlyBill?: number; billNote?: string;
  switchTo: SystemKey[]; waterAlt: WaterHeaterKey[];
  takeaway: string;
}

const DEFS: ExampleDef[] = [
  {
    id: 'ottawa-1970s-gas', city: 'ottawa',
    title: 'A 1970s two-storey in Ottawa, heated with gas',
    who: '1,600 sq ft detached house built 1966–1980, mid-efficiency gas furnace (about 80%), gas tank water heater, older double-pane windows. The owners entered a $130 average monthly gas bill.',
    vintage: '1966-1980', sqft: 1600, storeys: 2, type: 'detached', sys: 'gasFurnaceMid', water: 'gasTank', win: 'doubleClear',
    measures: ['air', 'attic', 'basement', 'windows'], monthlyBill: 130,
    switchTo: ['gasFurnaceHigh', 'ashpCold'], waterAlt: ['gasTankless', 'heatPump'],
    takeaway: 'With Ontario gas at about 31 cents per cubic metre at the margin, insulation and air sealing save real energy but pay back slowly on the bill alone. Rebates, comfort and a cold basement that becomes usable are what make them worth doing; new windows are the slowest payback of all.',
  },
  {
    id: 'winnipeg-1950s-electric', city: 'winnipeg',
    title: 'A 1950s bungalow in Winnipeg with electric baseboards',
    who: '1,100 sq ft one-storey detached house built 1946–1965, electric baseboards, electric tank water heater, single-pane windows with storms. No bills entered, so this is the typical-house estimate.',
    vintage: '1946-1965', sqft: 1100, storeys: 1, type: 'detached', sys: 'electricResistance', water: 'electricTank', win: 'singleStorm',
    measures: ['air', 'attic', 'walls'],
    switchTo: ['ashpCold', 'gshp'], waterAlt: ['heatPump'],
    takeaway: 'Manitoba has some of Canada’s cheapest electricity, so even an all-electric house has modest bills. A cold-climate heat pump still cuts the heating bill by about half at Winnipeg’s seasonal efficiency, and topping up the attic pays back in roughly four to seven years before rebates.',
  },
  {
    id: 'halifax-1920s-oil', city: 'halifax',
    title: 'A 1920s house in Halifax heated with oil',
    who: '1,600 sq ft two-storey detached house built before 1946, oil furnace (about 78%), electric tank water heater, single-pane windows with storms. No bills entered.',
    vintage: 'pre-1946', sqft: 1600, storeys: 2, type: 'detached', sys: 'oilFurnaceMid', water: 'electricTank', win: 'singleStorm',
    measures: ['air', 'attic', 'walls', 'windows'],
    switchTo: ['ashpCold'], waterAlt: ['heatPump'],
    takeaway: 'Oil makes this the house where every upgrade pays fastest, even at the 12-month average price we use (recent months have been higher). Switching to a cold-climate heat pump saves about $3,000 a year, and air sealing and the attic pay back in roughly one to five years before rebates.',
  },
  {
    id: 'toronto-2000s-semi', city: 'toronto',
    title: 'A 2000s semi in Toronto that is already fairly efficient',
    who: '1,600 sq ft semi-detached house built 1996–2010, high-efficiency gas furnace (95%), gas tank water heater, double-pane low-e windows. No bills entered.',
    vintage: '1996-2010', sqft: 1600, storeys: 2, type: 'semi', sys: 'gasFurnaceHigh', water: 'gasTank', win: 'doubleLowE',
    measures: ['setback', 'air', 'attic'],
    switchTo: ['ashpCold'], waterAlt: ['gasTankless', 'heatPump'],
    takeaway: 'A newer house with a 95% furnace and cheap gas has little left to save on heating; a thermostat schedule is the best value. Here the case for a heat pump rests on replacing an aging air conditioner, comfort and emissions rather than the bill, and the numbers say so plainly.',
  },
];

const M2 = (sqft: number) => sqft / 10.7639;
const C = MODEL.costs as Record<string, { low: number; high: number }>;
const E = MODEL.envelope;

function build(d: ExampleDef) {
  const city = cityBySlug(d.city);
  const rp = resolvePrices(city);
  const P = enginePrices(rp);
  const hdd = city.hot2000.hdd;
  const area = M2(d.sqft);
  const I = (MODEL.demand.intensityGJperM2 as Record<string, number>)[d.vintage];
  const tf = (MODEL.demand.typeFactor as Record<string, number>)[d.type];
  const model = baselineDemandGJ({ vintage: d.vintage, floorAreaM2: area, hdd, type: d.type });
  const fuel = fuelOf(d.sys);
  const fu = fuelUnit(fuel);
  const eff = systemEfficiency(d.sys, hdd);
  const sameFuelWater = d.water === 'gasTank' && fuel === 'gas';
  const cal = d.monthlyBill
    ? calibrate(model, d.sys, hdd, P, { mode: 'bill', monthlyBill: d.monthlyBill, waterHeaterSameFuel: sameFuelWater })
    : calibrate(model, d.sys, hdd, P, { mode: 'none', waterHeaterSameFuel: sameFuelWater });
  const demand = model * cal.factor;
  const now = heatingCost(demand, d.sys, hdd, P, 'now');
  const g = geometry(area, d.storeys, true);
  const results: { key: MeasureKey; label: string; how: string; r: MeasureResult; cost: [number, number] | null }[] = [];
  for (const k of d.measures) {
    if (k === 'attic') {
      const rb = (E.atticRByVintage as Record<string, number>)[d.vintage];
      const t = atticTargetR(hdd);
      const r = atticMeasure({ areaM2: g.atticM2, rBefore: rb, rAfter: t.target, hdd, demandGJ: demand, calibration: cal.factor });
      const sq = g.atticM2 * 10.7639;
      results.push({ key: k, label: `Attic insulation, R-${rb} → R-${t.target}`, how: `${int(g.atticM2)} m² of attic × (1/RSI ${num(rb / 5.678)} − 1/RSI ${num(t.target / 5.678)}) × ${int(hdd)} degree-days × 24 h × 0.75`, r, cost: [C.atticPerSqft.low * sq, C.atticPerSqft.high * sq] });
    }
    if (k === 'walls') {
      const rb = (E.wallRsiByVintage as Record<string, number>)[d.vintage];
      const r = wallMeasure({ areaM2: g.wallNetM2, option: 'dense', rsiBefore: rb, hdd, demandGJ: demand, calibration: cal.factor });
      results.push({ key: k, label: `Dense-pack the wall cavities, RSI ${num(rb)} → RSI ${num(E.denseRsi)}`, how: `${int(g.wallNetM2)} m² of wall (less windows) × (1/RSI ${num(rb)} − 1/RSI ${num(E.denseRsi)}) × ${int(hdd)} × 24 h × 0.75`, r, cost: null });
    }
    if (k === 'basement') {
      const rb = (E.basementRsiByVintage as Record<string, number>)[d.vintage];
      const r = basementMeasure({ areaM2: g.basementWallM2, rsiBefore: rb, rsiAfter: E.basementTargetRsi, hdd, demandGJ: demand, calibration: cal.factor });
      results.push({ key: k, label: `Basement walls to R-20 (RSI ${num(E.basementTargetRsi)})`, how: `${int(g.basementWallM2)} m² of basement wall × (1/RSI ${num(rb)} − 1/RSI ${num(E.basementTargetRsi)}) × ${int(hdd)} × 24 h × 0.4 (the ground moderates temperatures)`, r, cost: null });
    }
    if (k === 'windows') {
      const before = (E.windowU as Record<string, { u: number; label: string }>)[d.win];
      const after = (E.windowU as Record<string, { u: number; label: string }>).energyStar;
      const r = windowMeasure({ areaM2: g.windowM2, before: d.win, after: 'energyStar', hdd, demandGJ: demand, calibration: cal.factor });
      results.push({ key: k, label: `Replace ${g.windowCount} windows (${before.label.toLowerCase()} → ENERGY STAR)`, how: `${num(g.windowM2)} m² of glass × (U ${num(before.u, 2)} − U ${num(after.u, 2)}) × ${int(hdd)} × 24 h × 0.75`, r, cost: [C.windowEach.low * g.windowCount, C.windowEach.high * g.windowCount] });
    }
    if (k === 'air') {
      const r = airMeasure({ volumeM3: g.volumeM3, hdd, demandGJ: demand, calibration: 1 });
      results.push({ key: k, label: 'Professional air sealing (20% less leakage)', how: `NRCan: about 25% of heat loss is air leakage → ${fgj(demand)} × 25% × 20% × 0.75`, r, cost: [C.airSealing.low, C.airSealing.high] });
    }
    if (k === 'setback') {
      const r = setbackMeasure({ degrees: 3, hours: 8, demandGJ: demand, heatPump: false });
      results.push({ key: k, label: 'Thermostat schedule: 3 °C lower for 8 hours a night', how: `NRCan: about 2% per 1 °C over 8 hours → 3 × 2% = 6% of ${fgj(demand)}`, r, cost: [0, 0] });
    }
  }
  const rows = results.map((x) => {
    const v = savingValue(x.r.gj, d.sys, hdd, P, 'variable');
    const pay = x.cost && v.dollars && v.dollars > 0 ? [x.cost[0] / v.dollars, x.cost[1] / v.dollars] : null;
    return { ...x, units: v.units, unit: v.unit, dollars: v.dollars, pay };
  });
  const combined = combineMeasures(results.map((x) => x.r), demand);
  const combinedValue = savingValue(combined.gj, d.sys, hdd, P, 'variable');
  const after = demand - combined.gj;
  const systems = [d.sys, ...d.switchTo].map((s) => {
    const cNow = heatingCost(after, s, hdd, P, 'now');
    const cVar = heatingCost(after, s, hdd, P, 'variable');
    return { sys: s, label: (MODEL.systems as Record<string, { label: string }>)[s].label, eff: systemEfficiency(s, hdd), now: cNow.cost, variable: cVar.cost, perGJ: cNow.costPerGJ };
  });
  const water = waterHeatingDemand(3, city.eccc.annualMean);
  const waters = [d.water, ...d.waterAlt].map((w) => {
    const c = waterHeaterCost(w, water.gj, P, 'now', { sys: d.sys, hdd });
    return { w, label: (MODEL.water.types as Record<string, { label: string }>)[w].label, cost: c.cost === null ? null : c.cost + (c.extraCost ?? 0), extra: c.extraCost ?? 0, units: c.units, unit: c.unit };
  });
  return {
    d, city, cityName: city.label ?? city.name, rp, P, hdd, area, I, tf, model, cal, demand, fuel, fu, eff, now, g,
    rows, combined, combinedValue, after, systems, water, waters,
    priceNow: fuel === 'gas' ? rp.gas!.now : fuel === 'electricity' ? rp.elec.now : rp.oil?.perL ?? null,
    priceVar: fuel === 'gas' ? rp.gas!.variable : fuel === 'electricity' ? rp.elec.variable : rp.oil?.perL ?? null,
  };
}
const EXAMPLES = DEFS.map(build);

const title = 'What upgrades really save: four worked examples | AuditYourHome';
const description = 'Four Canadian houses run through our energy model with every number shown: heating need, local prices, insulation, air sealing, windows and heat pumps.';
const path = '/learn/real-numbers/';
const faqs = [
  { q: 'Are these real customers?', a: 'No. They are modelled examples: typical houses run through the same calculations our planner and calculators use, with local prices and climate data. We show every step so you can check the arithmetic, and the calculators let you replace any assumption with your own numbers.' },
  { q: 'Why are the savings smaller than some contractors quote?', a: 'We stay conservative on purpose. Savings are reduced by a factor of 0.75 (0.4 for basements) for free heat from the sun, people and appliances and for real-world installation, valued at the price of your next unit of energy without fixed charges, and no upgrade is credited with more than 35% of heating (60% for all of them together).' },
  { q: 'Why does a heat pump cost more to run than gas in some examples?', a: 'In Ontario, natural gas costs about 31 cents per cubic metre at the margin, and a cold-climate heat pump’s seasonal efficiency in a cold city is about 2 to 2.5. At those prices the running costs can come out close, or higher for the heat pump. Against oil, propane or electric baseboards the heat pump wins by a wide margin.' },
  { q: 'How do I get numbers for my own house?', a: 'Enter your bills in the planner or a calculator: we then scale every saving to how much heat your house actually uses. An EnerGuide evaluation replaces the estimates with measurements, including a blower door test.' },
];
const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Learn', path: '/learn/' },
    { name: 'Worked examples', path },
  ]),
  faqSchema(faqs),
  { '@context': 'https://schema.org', '@type': 'Article', headline: 'What upgrades really save: four worked examples', description, dateModified: '2026-10-08', mainEntityOfPage: `${SITE.url}${path}`, author: { '@type': 'Organization', name: SITE.name, url: SITE.url }, publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url } },
];
const SRC = ['nrcan-ceud-t33', 'nrcan-hwg', 'nrcan-hot2000-map', 'nrcan-kthi-s9', 'nrcan-kthi-s7', 'nrcan-kthi-s8', 'dunsky-cci-2024', 'nrcan-heat-pump-guide', 'homestars-attic', 'homestars-windows', 'furnaceprices-hp', 'eccc-normals', 'doe-tankless'].map(source);
const mj = (gjPerUnit: number) => `${(gjPerUnit * 1000).toFixed(1).replace(/\.0$/, '')} MJ`;
const unitWord = (u: string) => (u === 'm³' ? 'm³ of gas' : u === 'kWh' ? 'kWh' : u === 'L' ? 'L of oil' : u);
---

<Base title={title} description={description} schema={schema} ogImage={ogFor('energy-bill-analysis')}>
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/learn/">Learn</a> <span aria-hidden="true">/</span> <span>Worked examples</span></nav>
    <div class="page-hero has-photo">
      <div class="hero-text">
        <p class="eyebrow">Keeping the heat in · worked examples · prices as of October 8, 2026</p>
        <h1>What upgrades really save: four houses, every number shown</h1>
        <p class="lede measure">
          Estimates only build confidence if you can see where they come from. Here are four typical
          Canadian houses run through the same model our <a href="/plan/">planner</a> and
          <a href="/calculators/">calculators</a> use: local climate, today's local prices, and the
          physics of each upgrade, with nothing hidden. They are modelled examples, not customer stories.
        </p>
      </div>
      <Photo name="energy-bill-analysis" eager />
    </div>

    <nav class="card card-pad toc" aria-label="Examples on this page">
      <strong>The four houses</strong>
      <ol>
        {EXAMPLES.map((x) => <li><a href={`#${x.d.id}`}>{x.d.title}</a></li>)}
      </ol>
      <p class="small mb-0">The method in one line: heat needed = NRCan's heat need per m² for the era × floor area × (local degree-days ÷ 4,200); each upgrade's saving comes from its own physics, × 0.75 to stay conservative; savings are valued at the price of the next unit of energy. <a href="#method">More on the method</a>.</p>
    </nav>

    {EXAMPLES.map((x, i) => (
      <section class="example" id={x.d.id}>
        <p class="eyebrow">Example {i + 1} · {x.cityName}, {x.city.provName}</p>
        <h2>{x.d.title}</h2>
        <p class="measure">{x.d.who}</p>

        <h3>1. How much heat does it need?</h3>
        <div class="tablewrap card">
          <table class="stack steps">
            <thead><tr><th>Step</th><th>Calculation</th><th>Result</th></tr></thead>
            <tbody>
              <tr><td data-label="Step">Local climate</td><td data-label="Calculation">{x.cityName}: heating degree-days from NRCan's HOT2000 weather data ({x.city.hot2000.station})</td><td data-label="Result">{int(x.hdd)} degree-days</td></tr>
              <tr><td data-label="Step">Typical heat need</td><td data-label="Calculation">{x.I} GJ/m² × {int(x.area)} m² × ({int(x.hdd)} ÷ 4,200){x.tf !== 1 ? ` × ${x.tf} (semi-detached)` : ''}</td><td data-label="Result">{fgj(x.model)} a year</td></tr>
              {x.cal.calibrated ? (
                <tr><td data-label="Step">Scaled to the bill</td><td data-label="Calculation">${x.d.monthlyBill}/month × 12 ÷ {unitPrice(x.priceNow, x.fu.unit)} = {int((x.d.monthlyBill ?? 0) * 12 / (x.priceNow ?? 1))} {unitWord(x.fu.unit)}; {pct(MODEL.calibration.heatShareWithSameFuelWaterHeater)} for heating × {mj(x.fu.gjPerUnit)} per {x.fu.unit} × {pct(x.eff)} efficiency = {fgj(x.cal.actualDemandGJ)}</td><td data-label="Result">× {num(x.cal.factor, 2)} → {fgj(x.demand)}</td></tr>
              ) : (
                <tr><td data-label="Step">Scaled to the bill</td><td data-label="Calculation">No bill entered, so the typical figure stands</td><td data-label="Result">{fgj(x.demand)}</td></tr>
              )}
              <tr><td data-label="Step">Heating cost today</td><td data-label="Calculation">{fgj(x.demand)} ÷ {x.eff < 1.01 ? pct(x.eff) : `COP ${num(x.eff, 1)}`} = {fgj(x.demand / x.eff)} bought ÷ {mj(x.fu.gjPerUnit)} per {x.fu.unit} = {int(x.now.units)} {unitWord(x.fu.unit)} × {unitPrice(x.priceNow, x.fu.unit)} (average, taxes in)</td><td data-label="Result">{money(x.now.cost)} a year</td></tr>
            </tbody>
          </table>
        </div>

        <h3>2. What each upgrade saves</h3>
        <div class="tablewrap card">
          <table class="stack">
            <thead><tr><th>Upgrade</th><th>The physics</th><th>Heat saved</th><th>On the bill</th><th>Typical cost</th><th>Payback</th></tr></thead>
            <tbody>
              {x.rows.map((r) => (
                <tr>
                  <td data-label="Upgrade"><strong>{r.label}</strong></td>
                  <td data-label="The physics" class="small">{r.how}{r.r.capped ? ' (capped at 35% of heating)' : ''}</td>
                  <td data-label="Heat saved">{fgj(r.r.gj)} ({pct(r.r.fraction)})</td>
                  <td data-label="On the bill">{int(r.units)} {unitWord(r.unit)} = {money(r.dollars)}/yr</td>
                  <td data-label="Typical cost">{r.cost ? (r.cost[1] === 0 ? 'about $0 with your thermostat' : `${money(r.cost[0])}–${money(r.cost[1])}`) : 'get quotes (no reliable published price)'}</td>
                  <td data-label="Payback">{r.cost && r.cost[1] === 0 ? 'immediate' : r.pay ? `${years(r.pay[0])}–${years(r.pay[1])}` : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="small measure">
          Savings at the next-unit price of {unitPrice(x.priceVar, x.fu.unit)} (no fixed charges), before rebates. All of them together:
          about {fgj(x.combined.gj)} ({pct(x.combined.fraction)} of heating{x.combined.overlap && pct(x.combined.sumFraction) !== pct(x.combined.fraction) ? `, less than the ${pct(x.combined.sumFraction)} you get by adding them, because savings overlap` : ''}), worth about {money(x.combinedValue.dollars)} a year.
        </p>

        <h3>3. Heating it a different way (after those upgrades: {fgj(x.after)} a year)</h3>
        <div class="tablewrap card">
          <table class="stack">
            <thead><tr><th>System</th><th>Seasonal efficiency</th><th>Cost a year (average prices)</th><th>Cost a year (next-unit prices)</th></tr></thead>
            <tbody>
              {x.systems.map((s, j) => (
                <tr>
                  <td data-label="System">{j === 0 ? <strong>{s.label} (now)</strong> : s.label}</td>
                  <td data-label="Seasonal efficiency">{s.eff < 1.01 ? pct(s.eff) : `COP ${num(s.eff, 1)}`}</td>
                  <td data-label="Average prices">{money(s.now)}</td>
                  <td data-label="Next-unit prices">{money(s.variable)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="small measure">Heat pump efficiencies are whole-season figures for {x.cityName}'s climate, including backup heat on the coldest days (Dunsky for the Canadian Climate Institute; field studies in BC and Yukon), set on the low side.</p>

        <h3>4. Hot water for three people</h3>
        <p class="small measure">{int(x.water.litresPerDay)} litres a day heated from about {num(x.water.inletC, 0)} °C (cold water in {x.cityName}) to 55 °C = {fgj(x.water.gj)} a year.</p>
        <div class="tablewrap card">
          <table class="stack">
            <thead><tr><th>Water heater</th><th>Cost a year</th></tr></thead>
            <tbody>
              {x.waters.map((w, j) => (
                <tr><td data-label="Water heater">{j === 0 ? <strong>{w.label} (now)</strong> : w.label}</td><td data-label="Cost a year">{money(w.cost)}{w.extra > 0 ? ` (includes ${money(w.extra)} of extra space heating: it cools the room it sits in)` : ''}</td></tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="card card-pad takeaway">
          <h3>What this house tells you</h3>
          <p class="mb-0">{x.d.takeaway}</p>
          <p class="small mb-0 tk-links"><a href={`/calculators/upgrade-payback/${x.d.city}/`}>Run your own {x.cityName} numbers →</a> · <a href={`/calculators/energy-costs/${x.d.city}/`}>Compare heating systems in {x.cityName} →</a></p>
        </div>
      </section>
    ))}

    <section class="method measure" id="method">
      <h2>The method, and why it leans conservative</h2>
      <p>
        Heat need comes from NRCan's Comprehensive Energy Use Database: heating requirement per square
        metre of floor for each construction period, normalised to 4,200 degree-days and checked against
        NRCan's typical heating loads for Ottawa and Toronto houses. Your city's degree-days come from
        NRCan's HOT2000 weather data, the same data EnerGuide evaluations use.
      </p>
      <p>
        Each upgrade's saving is calculated from its own physics: the change in insulation or window
        U-value times the area times the degree-days. We then multiply by 0.75 (0.4 for basement walls)
        because the sun, people and appliances already supply some free heat and real installations
        underperform their labels. Air sealing uses NRCan's rule that about a quarter of heat loss is
        air leakage, with a 20% reduction in leakage. Starting insulation levels by era are our
        assumptions (no Canadian survey table exists); the calculators let you change them.
      </p>
      <p>
        Savings are valued at the price of your next unit of energy, without fixed monthly charges,
        which is lower than your average price. Costs are published installed-cost ranges (HomeStars,
        FurnacePrices.ca) where a reliable figure exists, and "get quotes" where it doesn't. Rebates
        aren't subtracted here because they depend on your province and program rules: the
        <a href="/calculators/upgrade-payback/">upgrade payback calculator</a> applies the ones that are open.
      </p>
    </section>

    <h2>Common questions</h2>
    <div class="measure">
      {faqs.map((f) => (
        <details class="faq"><summary>{f.q}</summary><div class="faq-body"><p>{f.a}</p></div></details>
      ))}
    </div>

    <div class="card card-pad srcs">
      <h3>Sources</h3>
      <ul>
        {SRC.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}
        <li>Energy prices: provincial utility tariffs, Hydro-Québec's comparison of electricity prices, and Statistics Canada table 18-10-0001-01 for heating oil, as listed on each <a href="/calculators/energy-costs/">city calculator page</a>.</li>
      </ul>
      <p class="small mb-0">Prices and program details checked October 8, 2026.</p>
    </div>

    <div class="related">
      <a class="btn btn-ghost" href="/learn/">Keeping the heat in</a>
      <a class="btn btn-ghost" href="/plan/">Plan your own house</a>
