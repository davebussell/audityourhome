---
import Base from '../../layouts/Base.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import { SITE } from '../../config/site';
import { breadcrumbSchema } from '../../lib/schema';
import { programs } from '../../lib/data';

const title = 'Canadian energy rebate tracker — what’s actually live, province by province | AuditYourHome';
const description =
  'Every major home energy rebate in Canada, verified against official pages with dates: Home Renovation Savings, BC’s Improvement Bonus, Efficiency Manitoba, Rénoclimat, LogisVert, the Atlantic programs — and the closed ones other sites still advertise.';

const isOntario = (p: any) => ['ontario', 'toronto'].includes(p.jurisdiction);
const isFederal = (p: any) => p.jurisdiction === 'canada';
const onfed = programs.filter((p) => isOntario(p) || isFederal(p));
const provincial = programs.filter((p) => !isOntario(p) && !isFederal(p));
const live = onfed.filter((p) => p.status === 'active');
const limited = onfed.filter((p) => p.status === 'active-limited');
const closed = onfed.filter((p) => p.status === 'closed');
const provLive = provincial.filter((p) => p.status !== 'closed');
const provClosed = provincial.filter((p) => p.status === 'closed');

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Rebates & programs', path: '/programs/' },
  ]),
];
---

<Base title={title} description={description} schema={schema}>
  <div class="container">
    <div class="page-hero">
      <p class="eyebrow">Program tracker</p>
      <h1>What's actually live right now</h1>
      <p class="lede measure">
        Rebate programs open, shrink, and close with little warning — the Greener Homes Loan died
        with two weeks' notice. Every entry below is verified against its official page and stamped
        with the date. Last full review: <strong>{SITE.dataReviewDate}</strong>.
      </p>
    </div>

    <h2 class="grp"><span class="chip chip-active">Active</span> Ontario &amp; federal — live</h2>
    <div class="grid-3">
      {live.map((p) => <ProgramCard program={p} />)}
    </div>

    {limited.length > 0 && (
      <>
        <h2 class="grp"><span class="chip chip-limited">Limits apply</span> Active with restrictions</h2>
        <div class="grid-3">
          {limited.map((p) => <ProgramCard program={p} />)}
        </div>
      </>
    )}

    <h2 class="grp"><span class="chip chip-active">Across Canada</span> Provincial programs, coast to coast</h2>
    <p class="small measure">
      Every province and territory now has full program pages — amounts, eligibility, how to apply,
      and the gotchas — each linked to its <a href="/provinces/">provincial guide</a>.
    </p>
    <div class="grid-3">
      {provLive.map((p) => <ProgramCard program={p} />)}
    </div>

    <h2 class="grp"><span class="chip chip-closed">Closed</span> Gone — but still advertised elsewhere</h2>
    <p class="small measure">
      We list closed programs on purpose: if a website or salesperson promises you one of these,
      their information is stale — a useful trust test.
    </p>
    <div class="grid-3">
      {[...closed, ...provClosed].map((p) => <ProgramCard program={p} />)}
    </div>

    <div class="card card-pad note">
      <h3>How this tracker works</h3>
      <p class="mb-0">
        Every entry is verified against its official page and stamped with the date — including the
        closed programs, because stale promises are how homeowners get burned. Your province's full
        picture (housing stock, what to monitor, every program) lives in the
        <a href="/provinces/">province guides</a>, and the <a href="/plan/">planner</a> matches
        programs to your specific home from your postal code.
      </p>
    </div>
  </div>
</Base>

<style>
  .grp { display: flex; align-items: center; gap: 12px; margin: 40px 0 16px; font-size: 22px; }
  .note { border-left: 4px solid var(--steel); margin-top: 40px; }
</style>
