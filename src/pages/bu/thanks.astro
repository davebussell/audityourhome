---
/**
 * Where the building-audit request form lands after a Netlify submission (the form posts to /thanks/?sent=1).
 * Without the flag (a bookmark, a reload, a direct visit) the page doesn't claim anything was sent. Not indexed.
 */
import BuildingBase from '../../layouts/BuildingBase.astro';
import { BUILDING } from '../../config/building';
---

<BuildingBase title="Your request | AuditYourBuilding" description="What happens after you ask to be introduced to an engineering firm or energy consultant." indexable={false}>
  <div class="container thanks">
    <div class="page-hero">
      <div class="hero-text" data-sent="yes" hidden>
        <p class="eyebrow">Request received</p>
        <h1>Thanks. Your request reached us.</h1>
        <p class="lede measure">A person reads every request, usually within one business day. Here’s what happens next.</p>
      </div>
      <div class="hero-text" data-sent="no">
        <p class="eyebrow">Your request</p>
        <h1>What happens after you ask for an introduction</h1>
        <p class="lede measure">
          If you sent a request from one of our forms, a person reads it and replies by email, usually within one business day. If you landed here another
          way, nothing has been sent yet: you can <a href="/request/">send a request</a> or <a href="/commercial-energy-audit/">start with your city</a>.
        </p>
      </div>
    </div>

    <section class="next" aria-labelledby="h-next">
      <h2 id="h-next">What happens next</h2>
      <ol class="nsteps">
        <li class="card sheet"><h3>We read your request</h3><p>A person, not a bot, usually within one business day.</p></li>
        <li class="card sheet">
          <h3>You get a reply from Dave Bussell</h3>
          <p>Dave runs AuditYourBuilding and replies from {BUILDING.contactEmail}, so watch for it (and check your spam folder). We introduce you to one engineering firm or energy consultant that serves your area.</p>
        </li>
        <li class="card sheet"><h3>The firm contacts you</h3><p>You talk through the building and the audit level. You decide whether to go ahead; you pay the firm for the audit, not us.</p></li>
      </ol>
    </section>

    <section class="wait card card-pad" aria-labelledby="h-wait">
      <h2 id="h-wait">While you wait</h2>
      <ul class="checklist">
        <li>Find the last 12 months of utility bills for electricity, natural gas and anything else the building burns.</li>
        <li>Gather what you have on the building: drawings, equipment lists, any earlier audit or study, and any reporting notice.</li>
        <li>Check the <a href="/commercial-energy-audit/">city page</a> for incentives that need approval before the audit starts.</li>
        <li>Decide who the firm should talk to: someone who knows the building and can open the plant rooms and the roof.</li>
      </ul>
      <p class="links small">
        <a href="/audit-levels/">The three audit levels</a> · <a href="/how-it-works/">How an audit works</a> · <a href="/incentives/">Incentives</a>
      </p>
    </section>

    <p class="back"><a class="btn btn-ghost" href="/">Back to the home page</a></p>
  </div>
</BuildingBase>

<script is:inline>
  (function () {
    var sent = /(?:^|[?&])sent=1(?:&|$)/.test(location.search);
    document.querySelectorAll('[data-sent]').forEach(function (el) {
      el.hidden = (el.getAttribute('data-sent') === 'yes') !== sent;
    });
  })();
</script>

<style>
  .thanks { padding-bottom: 48px; }
  .thanks .page-hero { padding-bottom: 20px; }
  .next h2, .wait h2 { font-size: 22px; margin: 0 0 12px; }
  .nsteps { list-style: none; margin: 0 0 18px; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; counter-reset: ns; }
  .nsteps li { padding: 18px 20px; box-shadow: none; counter-increment: ns; }
  .nsteps h3 { font-size: 17px; margin: 0 0 6px; }
  .nsteps h3::before { content: counter(ns) '. '; color: var(--heat); }
  .nsteps p { margin: 0; color: var(--muted); font-size: 15px; }
  .wait { box-shadow: none; border-left: 4px solid var(--pine); max-width: 820px; }
  .checklist { margin: 0 0 12px; padding-left: 20px; display: grid; gap: 8px; }
  .links { margin: 0; line-height: 1.8; }
  .back { margin-top: 22px; }
</style>
