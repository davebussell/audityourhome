---
import BuildingBase from '../../../layouts/BuildingBase.astro';
import RequestForm from '../../../components/building/RequestForm.astro';
import Photo from '../../../components/Photo.astro';
import ArtTile from '../../../components/building/ArtTile.astro';
import { ogFor } from '../../../lib/photos';
import { BUILDING } from '../../../config/building';
import { breadcrumbSchema, faqSchema } from '../../../lib/schema';
import { articles, ARTICLE_PHOTO, ARTICLE_TILE } from '../../../lib/building';
import type { BArticle } from '../../../lib/building';

export function getStaticPaths() {
  return articles.map((x) => ({ params: { slug: x.slug }, props: { x } }));
}

interface Props { x: BArticle }
const { x } = Astro.props;
const path = `/articles/${x.slug}/`;
const photo = ARTICLE_PHOTO[x.slug] ?? 'commercial-energy-audit';
const tile = ARTICLE_TILE[x.slug];
const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Articles', path: '/articles/' },
    { name: x.crumb, path },
  ]),
  faqSchema(x.faq),
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: x.h1,
    description: x.description,
    dateModified: x.verifiedISO,
    mainEntityOfPage: path,
    author: { '@type': 'Organization', name: BUILDING.name, url: BUILDING.url },
    publisher: { '@type': 'Organization', name: BUILDING.name, url: BUILDING.url },
  },
];
const external = (h: string) => /^https?:\/\//.test(h);
---

<BuildingBase title={`${x.title} | AuditYourBuilding`} description={x.description} schema={schema} ogImage={ogFor(photo)}>
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/articles/">Articles</a> <span aria-hidden="true">/</span> <span>{x.crumb}</span></nav>
    <div class="page-hero has-photo">
      <div class="hero-text">
        <p class="eyebrow">{x.kicker} · verified {x.verified}</p>
        <h1>{x.h1}</h1>
        <p class="lede measure" set:html={x.lede} />
      </div>
      {tile ? <ArtTile types={tile.types} caption={tile.caption} alt={tile.alt} ratio="3 / 2" /> : <Photo name={photo} eager />}
    </div>

    <div class="measure prose">
      {x.sections.map((s) => (
        <>
          <h2>{s.h2}</h2>
          <Fragment set:html={s.html} />
        </>
      ))}
    </div>

    <h2 class="faqh">Common questions</h2>
    <div class="measure">
      {x.faq.map((f) => <details class="faq"><summary>{f.q}</summary><div class="faq-body"><p>{f.a}</p></div></details>)}
    </div>

    <div class="card card-pad srcs">
      <h3>Sources</h3>
      <ul>
        {x.sources.map((s) => <li><a href={s.href} rel="noopener">{s.label}</a></li>)}
      </ul>
      <p class="small mb-0">Program facts checked against these pages on {x.verified}. Programs change: confirm on the official page before you spend.</p>
    </div>

    {x.related.length > 0 && (
      <div class="related">
        {x.related.map((r) => <a class="btn btn-ghost" href={r.href} rel={external(r.href) ? 'noopener' : undefined}>{r.label}</a>)}
        <a class="btn btn-ghost" href="/articles/">All articles</a>
      </div>
    )}

    <RequestForm context={`article-${x.slug}`} heading="Need an audit for a building like this?" sub="Tell us about it and we’ll introduce you to one engineering firm or energy consultant that serves your area." />
  </div>
</BuildingBase>

<style>
  .crumbs { padding-top: 24px; font-size: 13.5px; color: var(--faint); }
  .crumbs a { color: var(--muted); }
  .prose :global(h2) { font-size: 23px; margin: 26px 0 10px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 22px; display: grid; gap: 8px; margin: 0 0 16px; }
  .prose :global(.tablewrap) { margin: 8px 0 14px; overflow-x: auto; }
  .prose :global(table) { font-size: 14.5px; }
  .prose :global(.tel) { white-space: nowrap; }
  .faqh { font-size: 23px; margin: 30px 0 10px; }
  .srcs { border-left: 4px solid var(--steel); margin: 30px 0 10px; }
  .srcs ul { margin: 0 0 10px; padding-left: 20px; display: grid; gap: 6px; font-size: 14px; }
  .srcs a { overflow-wrap: anywhere; }
  .related { display: flex; flex-wrap: wrap; gap: 10px; margin: 18px 0 26px; }
</style>
