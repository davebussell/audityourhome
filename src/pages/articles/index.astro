---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { ogFor } from '../../lib/photos';
import { SITE } from '../../config/site';
import { breadcrumbSchema } from '../../lib/schema';
import articlesJson from '../../data/articles.json';

const title = 'Articles — cited, current, local | AuditYourHome';
const description =
  'Deep-dive articles on home energy audits: definitions, requirements and standards, Toronto services and financing, and regional specials — every claim cited to official sources and dated.';

const handWritten = [
  {
    href: '/articles/what-is-a-home-energy-audit/',
    kicker: 'The foundation',
    title: 'What is a home energy audit?',
    blurb: 'The measured definition: what happens, what it establishes, what it isn\'t — with a switcher that localizes programs and requirements to your region.',
  },
  {
    href: '/articles/energy-audit-requirements-ontario/',
    kicker: 'Rules & standards',
    title: 'When is an energy audit required in Ontario?',
    blurb: 'The honest split between mandatory and voluntary — the selling-your-home myth, EWRB for large buildings, and the standards stack from CGSB to SB-12 decoded.',
  },
  {
    href: '/articles/energy-audit-services-toronto/',
    kicker: 'Toronto',
    title: 'Energy audit services in Toronto: homes, buildings, and who does what',
    blurb: 'EnerGuide for houses, ASHRAE Levels 1–3 for buildings, mandatory EWRB reporting at 50,000 sq ft — and which professional performs each.',
  },
  {
    href: '/articles/home-renovation-loans-toronto/',
    kicker: 'Financing',
    title: 'Home renovation loans in Toronto',
    blurb: 'HELP up to $125,000 at posted rates, the dead federal loan still haunting search results, the CMHC 25% refund, and the sequence that stacks them.',
  },
  {
    href: '/articles/energy-audits-northern-bc/',
    kicker: 'Northern BC',
    title: 'Energy audits in Prince George, Dawson Creek & Northern BC',
    blurb: 'Why -30° winters sharpen the payback math, the Improvement Bonus now province-wide, and booking an evaluation up north.',
  },
];

type Card = { href: string; kicker: string; title: string; blurb: string };
const fromData = (articlesJson as any[]).map((x) => ({ href: `/articles/${x.slug}/`, kicker: x.kicker, title: x.h1, blurb: x.blurb, slug: x.slug }));
const bySlug = (s: string) => fromData.find((x) => x.slug === s)!;
const byHref = (h: string) => handWritten.find((x) => x.href === h)!;
const articles: Card[] = [
  byHref('/articles/what-is-a-home-energy-audit/'),
  bySlug('home-energy-audit-ontario'),
  bySlug('home-energy-audit-cost'),
  bySlug('energy-audit-companies-ontario'),
  byHref('/articles/energy-audit-requirements-ontario/'),
  byHref('/articles/energy-audit-services-toronto/'),
  bySlug('commercial-energy-audits-ontario'),
  bySlug('heat-pump-rebates-toronto-ontario'),
  byHref('/articles/home-renovation-loans-toronto/'),
  bySlug('vermiculite-insulation'),
  bySlug('home-energy-assessment-winnipeg'),
  bySlug('bc-home-energy-testing-faq'),
  byHref('/articles/energy-audits-northern-bc/'),
];
const london = fromData.filter((x) => x.slug.endsWith('-london'));

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Articles', path: '/articles/' },
  ]),
];
---

<Base title={title} description={description} schema={schema} ogImage={ogFor('heat-loss-calculation')}>
  <div class="container">
    <div class="page-hero has-photo">
      <div class="hero-text">
      <p class="eyebrow">Articles · last verification pass {SITE.dataReviewDate}</p>
      <h1>Cited, current, local</h1>
      <p class="lede measure">
        Long-form answers with receipts: every program claim links to its official page and
        carries the date we checked it. Where a topic isn't inherently local, a region switcher
        makes it local — programs, requirements, and standards for where you actually live.
      </p>
      </div>
      <Photo name={'heat-loss-calculation'} eager />
    </div>

    <div class="article-list">
      {articles.map((a) => (
        <a class="card art" href={a.href}>
          <p class="eyebrow">{a.kicker}</p>
          <h2>{a.title}</h2>
          <p class="small">{a.blurb}</p>
          <span class="go">Read →</span>
        </a>
      ))}
    </div>

    <h2 class="grp">London, Ontario — neighbourhood by neighbourhood</h2>
    <div class="article-list">
      {london.map((a) => (
        <a class="card art" href={a.href}>
          <p class="eyebrow">{a.kicker}</p>
          <h2>{a.title}</h2>
          <p class="small">{a.blurb}</p>
          <span class="go">Read →</span>
        </a>
      ))}
    </div>

    <div class="card card-pad more">
      <h3>Looking for your city?</h3>
      <p class="mb-0">
        The <a href="/guides/">regional guides</a> cover twelve Ontario areas neighbourhood-deep,
        and the <a href="/tests/">testing guide</a> walks every instrument from blower doors to
        radon kits.
      </p>
    </div>
  </div>
</Base>

<style>
  .grp { margin: 36px 0 14px; font-size: 22px; }
  .article-list { display: grid; gap: 16px; max-width: 800px; }
  .art { padding: 26px 30px; text-decoration: none; display: flex; flex-direction: column; gap: 6px; transition: border-color 0.15s ease; }
  .art:hover { border-color: var(--heat); }
  .art h2 { margin: 0; font-size: 21px; color: var(--ink); }
  .art .small { margin: 0; }
  .art .go { margin-top: 8px; font-weight: 700; font-size: 14px; color: var(--heat-deep); }
  .more { border-left: 4px solid var(--heat); margin-top: 28px; max-width: 800px; }
</style>
