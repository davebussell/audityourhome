    items.push(`<li><a href="/programs/">The live program tracker</a> — every rebate verified against official pages</li>`);
    items.push(`<li><a href="https://natural-resources.canada.ca/energy-efficiency/home-energy-efficiency" rel="noopener" target="_blank">NRCan home energy efficiency hub ↗</a> — the official EnerGuide source</li>`);
    el.innerHTML = `
      <div class="rsec">
        <h3>Resources for your plan</h3>
        <ul class="res-list">${items.join('')}</ul>
      </div>`;
  }

  function prefillLead(arch: any, htype: string, size: string, heat: string, syms: string[], goals: string[], loc: any, testsList: string[]) {
    const heatLabel = heat === 'gas' ? 'gas furnace' : heat === 'electric' ? 'electric baseboard' : heat === 'oil' ? 'oil/propane' : 'heat pump';
    const where = loc.kind === 'ca' && loc.region ? loc.region.name : loc.kind === 'ca' ? (loc.province ?? 'Canada') : 'Ontario';
    const lines = [
      'My AuditYourHome plan summary:',
      `• Home: ${arch.years}, ${htype}, ${size}, heated by ${heatLabel}, in ${where}`,
      syms.length ? `• Issues: ${syms.join(', ')}` : '',
      goals.length ? `• Goals: ${goals.join(', ')}` : '',
      `• Tests to include in the audit: ${testsList.join('; ')}`,
      `• Full plan: ${location.href}`,
    ].filter(Boolean);
    const summary = lines.join('\n');
    const ta = document.querySelector<HTMLTextAreaElement>('#lead-form textarea[name="message"]');
    if (ta && !ta.value) ta.value = summary;
    const mailto = document.querySelector<HTMLAnchorElement>('#lead-form a[href^="mailto:"]');
    if (mailto) {
      const base = mailto.href.split('&body=')[0];
      mailto.href = `${base}&body=${encodeURIComponent(summary)}`;
    }
  }

  // ---------- restart / share / prefill ----------
  document.getElementById('restartBtn')?.addEventListener('click', () => {
    resultsEl.hidden = true;
    plannerEl.hidden = false;
    history.replaceState(null, '', location.pathname);
    show(1);
  });
  document.getElementById('copyLink')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(location.href);
      btn.textContent = 'Link copied ✓';
      setTimeout(() => (btn.textContent = 'Copy link to this plan'), 2000);
    } catch { btn.textContent = location.href; }
  });

  (function prefill() {
    const q = new URLSearchParams(location.search);
    if (!q.size) return;
    const set = (name: string, val: string | null) => {
      if (!val) return;
      const radio = form.querySelector<HTMLInputElement>(`[name="${name}"][value="${CSS.escape(val)}"]`);
      if (radio) radio.checked = true;
      else {
        const input = form.querySelector<HTMLInputElement>(`input[name="${name}"]:not([type=radio]):not([type=checkbox])`);
        if (input) input.value = val;
      }
    };
    set('postal', q.get('postal'));
    set('age', q.get('age'));
    set('htype', q.get('htype'));
    set('size', q.get('size'));
    set('heat', q.get('heat'));
    set('gasBill', q.get('gas'));
    set('elecBill', q.get('elec'));
    (q.get('sym') ?? '').split(',').filter(Boolean).forEach((v) => set('sym', v));
    (q.get('goal') ?? '').split(',').filter(Boolean).forEach((v) => set('goal', v));
    if (q.get('done') === '1' && q.get('age')) finish();
  })();
</script>
