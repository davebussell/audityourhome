    const el = $('#rResources');
    const region = loc.kind === 'ca' ? loc.region : null;
    const items: string[] = [];
    if (region) items.push(`<li><a href="/guides/${region.slug}/">The ${esc(region.name)} home energy guide</a> — local housing stock, rebates, and auditors in one place</li>`);
    items.push(`<li><a href="/tests/">The complete home testing guide</a> — every test from blower doors to radon, and who performs each</li>`);
    items.push(`<li><a href="/how-it-works/">What happens in an EnerGuide assessment</a> — the full walkthrough, step by step</li>`);
