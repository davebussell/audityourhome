  function renderSequence(arch: any, heat: string, syms: string[], goals: string[], age: string, gasBill: number, elecBill: number, isON: boolean, isToronto: boolean, htype: string) {
    const el = $('#rSequence');
    if (htype === 'condo') {
      el.innerHTML = `
        <div class="rsec"><h3>Condos work differently</h3>
        <p class="sub">EnerGuide evaluations and most Ontario rebates target houses and townhomes — in a condo, the envelope and heating usually belong to the corporation. Your best levers: in-suite sealing, window coverings, a heat-pump conversation with your board, and pushing the corporation toward a building-level audit.</p></div>`;
      return;
    }
    const R = D.rates.ontario;
    let heatSpend = 0;
    if (heat === 'gas' && gasBill) heatSpend = gasBill * 12 * R.benchmarks.heatShareOfGas;
    if (heat === 'electric' && elecBill) heatSpend = elecBill * 12 * R.benchmarks.heatShareOfElectricHeatedElec;

    const seq = buildSequence(arch, heat, syms, goals);
    const rebateChip = (cat: string) => {
      if (!isON) return '';
      const map: Record<string, string> = {
        'air-sealing': 'HRSP assessment path',
        'attic-insulation': 'HRSP up to $7,700 insulation',
        'wall-insulation': 'HRSP up to $7,700 insulation',
        'basement-insulation': 'HRSP up to $7,700 insulation',
        'windows-doors': 'HRSP $100/opening',
        'heat-pump': 'HRSP up to $12,000',
        'solar': 'HRSP up to $10,000',
        'water-heating': 'HRSP $500',
        'controls': 'HRSP $75–$100',
      };
      const label = map[cat];
      const help = isToronto ? ' <span class="chip chip-neutral">+ HELP financing</span>' : '';
      return label ? `<span class="chip chip-active">${label}</span>${help}` : help;
    };

    const rows = seq.map((item) => {
      const m = findMeasure(item.category, age, heat);
      let saveTxt = '';
      if (m) {
        if (m.fixedAnnual) saveTxt = `~${money(m.fixedAnnual[0])}–${money(m.fixedAnnual[1])}/yr`;
        else if (m.pctHeating?.[1] > 0) {
          saveTxt = heatSpend
            ? `~${money(heatSpend * m.pctHeating[0])}–${money(heatSpend * m.pctHeating[1])}/yr`
            : `~${Math.round(m.pctHeating[0] * 100)}–${Math.round(m.pctHeating[1] * 100)}% of heating costs`;
        }
      }
      return `
        <div class="seq-item">
          <h4>${esc(item.action)}</h4>
          <p class="why">${esc(item.why)}${m?.note ? ' ' + esc(m.note) : ''}</p>
          <div class="nums">
            ${saveTxt ? `<span class="save">${saveTxt}</span>` : ''}
            ${m?.typicalCost ? `<span class="cost">typical cost ${esc(m.typicalCost)}</span>` : ''}
            ${rebateChip(item.category)}
          </div>
        </div>`;
    });

    el.innerHTML = `
      <div class="rsec">
        <h3>Your upgrade sequence</h3>
        <p class="sub">Ordered for your era, heating, and the problems you flagged. ${heatSpend ? 'Dollar ranges use your bills.' : 'Add your bills (start over → step 6) to see dollar ranges.'}</p>
        <div class="seq">${rows.join('')}</div>
        <p class="small">${esc(D.savings.wholeHouseNote)}</p>
      </div>`;
  }

