---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const title = 'For energy advisors: exclusive homeowner leads — first 10 free, then $40 | AuditYourHome';
const description =
  'Free verified listings for NRCan-licensed service organizations, plus exclusive, pre-qualified homeowner leads: your first ten free, then $40 each. Never shared, no subscription — and directory rankings are never for sale.';

const applySubject = 'Founding advisor — homeowner leads';
const applyBody = [
  'Organization:',
  'NRCan service organization (or the one you work under):',
  'Service area (cities or postal prefixes, e.g. M4, L6, K2):',
  'Best phone:',
  'Where should leads go (email):',
  'Roughly how many new evaluations can you take per month:',
].join('\n');
const applyHref = `mailto:${SITE.contactEmail}?subject=${encodeURIComponent(applySubject)}&body=${encodeURIComponent(applyBody)}`;

const faqs = [
  {
    q: 'Does paying for leads move me up the directory?',
    a: 'No. The directory is free for every licensed service organization, and its order never depends on payment — organizations that publish their assessment pricing sort first, because homeowners reward it. Paying for leads buys you introductions, not placement.',
  },
  {
    q: 'Are the leads shared with other advisors?',
    a: 'Never. Each homeowner request goes to one advisor serving that area, and it is not resold. That is the whole difference from shared marketplaces, where one lead is typically sold to three to five contractors.',
  },
  {
    q: 'What counts as a lead?',
    a: 'A homeowner in your service area who asked to be matched and left working contact details. A request outside your area, fake or non-working contact details, or a duplicate of one you already received does not count toward your ten free or your bill.',
  },
  {
    q: 'How many leads will I get?',
    a: "Honestly: we're early. Founding advisors get first access as request volume grows, and we will tell you the actual monthly request count for your area — no inflated projections. The first ten are free precisely so you can judge the quality before paying anything.",
  },
  {
    q: 'Do I need to be NRCan-registered?',
    a: 'Yes. Leads go only to NRCan-licensed service organizations, or advisors working under one, because only their EnerGuide evaluations qualify for rebate programs like Ontario’s Home Renovation Savings Program. Homeowners are told that up front.',
  },
  {
    q: 'How does billing work?',
    a: 'After your first ten free leads, $40 per lead delivered, billed monthly by invoice. No subscription, no monthly minimum, no card on file — and you can stop receiving leads at any time by email.',
  },
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'For professionals', path: '/for-professionals/' },
  ]),
  faqSchema(faqs),
];
---

<Base title={title} description={description} schema={schema}>
  <div class="container">
    <div class="page-hero">
      <p class="eyebrow">For energy advisors &amp; service organizations</p>
      <h1>Exclusive homeowner leads for the people doing real audits</h1>
      <p class="lede measure">
        Generalist platforms sell the same "energy audit" lead to three to five contractors — most
        of them selling equipment, not evaluations. We route each homeowner request to
        <strong>one</strong> licensed service organization, and the homeowner arrives already knowing
        their home's era profile, likely upgrade path, and rebate eligibility.
      </p>
    </div>

    <div class="tiers">
      <article class="card tier">
        <p class="t-name">Verified listing</p>
        <p class="t-price">Free</p>
        <p class="t-sub">Always free, for every licensed service organization.</p>
        <ul class="t-list">
          <li>Your profile on every city and province page you serve</li>
          <li>NRCan status, pricing, booking method, and links to your Google, HomeStars and BBB reviews</li>
          <li>Order never for sale — organizations that publish their pricing sort first</li>
        </ul>
        <a class="btn btn-ghost" href="#claim">Claim your listing</a>
      </article>

      <article class="card tier tier-lead">
        <p class="t-flag">Founding advisors</p>
        <p class="t-name">Homeowner leads</p>
        <p class="t-price">$40 <span>per lead</span></p>
        <p class="t-sub"><strong>Your first 10 leads are free.</strong> Then pay only for leads delivered.</p>
        <ul class="t-list">
          <li><strong>Exclusive</strong> — each request goes to one advisor, never shared or resold</li>
          <li><strong>Pre-qualified</strong> — era, heating, symptoms, the tests our planner flagged, rebate path and postal code arrive with the contact</li>
          <li><strong>No subscription, no minimum</strong> — billed monthly for leads delivered; stop anytime</li>
          <li>Outside your area or bad contact details? It doesn't count</li>
        </ul>
        <a class="btn btn-primary" href={applyHref}>Become a founding advisor</a>
        <p class="t-note">Opens an email to {SITE.contactEmail} — a person replies within one business day.</p>
      </article>
    </div>

    <h2 class="sec">How a lead reaches you</h2>
    <ol class="steps measure">
      <li><p><strong>A homeowner plans first.</strong> They run our planner or a guide and ask to be matched, sharing their postal code and home profile.</p></li>
      <li><p><strong>We route it to one advisor.</strong> The request goes to a single founding advisor serving that area — never to a list.</p></li>
      <li><p><strong>You get the whole picture.</strong> Contact details plus the home's era, heating, symptoms and flagged tests arrive by email, usually within one business day.</p></li>
      <li><p><strong>You judge, then pay.</strong> Your first ten leads are free. After that, $40 per lead delivered, billed monthly.</p></li>
    </ol>

    <h2 class="sec">What $40 buys compared to the usual channels</h2>
    <div class="tablewrap card">
      <table>
        <thead>
          <tr><th>Channel</th><th>Typical cost per lead</th><th>Who else gets it</th></tr>
        </thead>
        <tbody>
          <tr><td>Shared marketplaces (Angi, HomeAdvisor, Thumbtack)</td><td>$15 – $100+</td><td>Sold to 3–5 contractors</td></tr>
          <tr><td>Google Local Services Ads</td><td>$25 – $150+</td><td>You compete in a pay-per-lead auction</td></tr>
          <tr><td>Google Ads (search)</td><td>$40 – $250+ after clicks</td><td>You pay for the clicks that don't convert, too</td></tr>
          <tr class="us"><td><strong>AuditYourHome</strong></td><td><strong>$40 — first 10 free</strong></td><td><strong>Only you</strong></td></tr>
        </tbody>
      </table>
    </div>
    <p class="meta srcline">
      Ranges: <a href="https://beseencontractors.com/guides/contractor-lead-cost-per-lead-2026/" rel="noopener">BeSeen Contractors, contractor cost per lead (2026)</a> — rough ranges that swing by trade and market.
    </p>

    <div class="card card-pad rules">
      <h3>The rules don't change</h3>
      <p class="mb-0">
        Listings stay free and complete. Directory order is never for sale. Homeowners are told, on
        the form, that participating advisors pay us a referral fee — and they can always contact any
        listed advisor directly instead. The trust layer is the product; we won't trade it for a lead.
      </p>
    </div>

    <h2 class="sec">Questions advisors ask</h2>
    <div class="measure">
      {faqs.map((f) => (
        <details class="faq"><summary>{f.q}</summary><div class="faq-body"><p>{f.a}</p></div></details>
      ))}
    </div>

    <div class="card card-pad claim" id="claim">
      <h2>Claim or add your organization — free</h2>
      <p>
        Email <a href={`mailto:${SITE.contactEmail}?subject=Provider%20listing`}>{SITE.contactEmail}</a> with:
      </p>
      <ol>
        <li>Your organization name and NRCan service-organization status</li>
        <li>Service areas (cities or postal prefixes)</li>
        <li>Assessment pricing if you publish it (we hope you will)</li>
        <li>Booking method — phone, form, or a scheduling link</li>
      </ol>
      <p class="mb-0 small">
        We verify registration before listing, mark verified profiles, and correct or remove any
        listing on request from the organization. A free listing never obliges you to take leads.
      </p>
    </div>
  </div>
</Base>

<style>
  .tiers { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; align-items: stretch; margin-bottom: 8px; }
  @media (max-width: 820px) { .tiers { grid-template-columns: 1fr; } }
  .tier { padding: 26px 28px; display: grid; gap: 10px; align-content: start; justify-items: start; }
  .tier-lead { border: 2px solid var(--heat); box-shadow: var(--shadow-md); }
  .t-flag { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--heat-deep); background: var(--heat-tint); border-radius: 999px; padding: 3px 10px; margin: 0; font-weight: 600; }
  .t-name { font-family: var(--display); font-weight: 700; font-size: 20px; margin: 0; color: var(--ink); }
  .t-price { font-family: var(--display); font-weight: 800; font-size: 40px; line-height: 1; margin: 2px 0 0; color: var(--ink); }
  .t-price span { font-size: 16px; font-weight: 600; color: var(--muted); }
  .t-sub { margin: 0; font-size: 15px; color: var(--muted); }
  .t-list { margin: 4px 0 8px; padding-left: 20px; display: grid; gap: 8px; font-size: 14.5px; }
  .t-note { margin: 0; font-size: 12.5px; color: var(--faint); }
  .sec { margin: 34px 0 12px; font-size: 23px; }
  .steps { counter-reset: s; list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .steps li { position: relative; padding: 13px 16px 13px 56px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); }
  .steps li::before { counter-increment: s; content: counter(s); position: absolute; left: 15px; top: 12px; width: 27px; height: 27px; border-radius: 50%; background: var(--heat); color: #fff; font-family: var(--mono); font-weight: 600; display: grid; place-items: center; font-size: 13.5px; }
  .steps p { margin: 0; font-size: 14.5px; color: var(--muted); }
  .steps strong { color: var(--ink); }
  .tablewrap { overflow-x: auto; }
  .tablewrap table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .tablewrap th, .tablewrap td { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .tablewrap th { font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); font-family: var(--mono); }
  .tablewrap tr.us td { background: var(--heat-tint); border-bottom: none; }
  .srcline { margin: 8px 0 0; }
  .rules { border-left: 4px solid var(--pine); margin: 26px 0 6px; }
  .rules h3 { margin-bottom: 6px; }
  .claim { margin: 30px 0 34px; border-top: 4px solid var(--heat); }
  .claim ol { margin: 0 0 16px; padding-left: 22px; display: grid; gap: 8px; }
</style>
