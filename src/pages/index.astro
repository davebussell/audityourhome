---
/**
 * The global entry point (x-default). On Netlify, "/" redirects before this page loads:
 * to the remembered country (cookie), otherwise by the visitor's country. This page is what
 * everyone else sees, and the fallback when the host can't redirect.
 */
import Base from '../layouts/Base.astro';
import { organizationSchema } from '../lib/schema';

const title = 'AuditYourHome: home energy audits in Canada and the United States';
const description =
  'Find a certified home energy auditor, compare real prices and see which rebates are live. Choose the Canadian or US site for local programs, rules and prices.';
---

<Base title={title} description={description} schema={[organizationSchema()]}>
  <section class="choose">
    <div class="container">
      <p class="eyebrow">Choose your country</p>
      <h1>Home energy audits, rebates and testing, country by country</h1>
      <p class="lede measure">
        Programs, credentials, prices and rules differ on each side of the border, so each country
        has its own site. We'll remember your choice.
      </p>
      <div class="pick">
        <a class="card pick-card" href="/ca/" data-ctry="ca">
          <span class="pick-tag" data-suggest hidden>Suggested for you</span>
          <span class="pick-code" aria-hidden="true">CA</span>
          <span class="pick-name">Canada</span>
          <span class="pick-desc">NRCan-registered energy advisors, EnerGuide evaluations and live provincial and federal rebates, across 70 cities.</span>
          <span class="pick-go">Go to the Canadian site →</span>
        </a>
        <a class="card pick-card" href="/us/" data-ctry="us">
          <span class="pick-tag" data-suggest hidden>Suggested for you</span>
          <span class="pick-code" aria-hidden="true">US</span>
          <span class="pick-name">United States</span>
          <span class="pick-desc">HERS raters and BPI professionals, utility audit programs, and where federal and state rebates stand.</span>
          <span class="pick-go">Go to the US site →</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .choose { padding: 64px 0 80px; }
  .choose h1 { font-size: clamp(30px, 4.2vw, 46px); line-height: 1.12; margin: 6px 0 14px; max-width: 22ch; }
  .pick { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 34px; max-width: 920px; }
  @media (max-width: 720px) { .pick { grid-template-columns: 1fr; } }
  .pick-card { position: relative; display: grid; gap: 10px; padding: 28px 28px 26px; text-decoration: none; color: var(--ink); transition: border-color 0.15s, transform 0.15s; }
  .pick-card:hover { border-color: var(--heat); transform: translateY(-2px); }
  .pick-code { font-family: var(--mono); font-weight: 700; font-size: 13px; letter-spacing: 0.1em; color: #fff; background: var(--navy); border-radius: 999px; padding: 6px 11px; justify-self: start; }
  .pick-name { font-family: var(--display); font-weight: 700; font-size: 26px; line-height: 1.15; }
  .pick-desc { color: var(--muted); font-size: 16px; line-height: 1.55; }
  .pick-go { font-weight: 700; color: var(--heat-deep); margin-top: 4px; }
  .pick-tag { position: absolute; top: 18px; right: 18px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; color: var(--pine); background: var(--pine-tint); border-radius: 999px; padding: 5px 10px; }
  .pick-card.suggested { border-color: var(--heat); }
</style>

<script>
  // Hosts without edge redirects (GitHub Pages) still honour a remembered choice.
  const has = (n: string) => document.cookie.split('; ').some((c) => c.startsWith(n + '='));
  const remembered = has('ayh_ca') ? 'ca' : has('ayh_us') ? 'us' : null;
  if (remembered) location.replace(`/${remembered}/`);

  // Otherwise suggest one from the browser's region, without sending anything anywhere.
  const langs = (navigator.languages || [navigator.language]).map((l) => l.toLowerCase());
  const tz = (Intl.DateTimeFormat().resolvedOptions().timeZone || '').toLowerCase();
  const caZones = ['toronto', 'vancouver', 'edmonton', 'winnipeg', 'halifax', 'st_johns', 'regina', 'moncton', 'whitehorse', 'yellowknife', 'iqaluit', 'montreal', 'glace_bay', 'goose_bay', 'swift_current', 'dawson_creek', 'fort_nelson', 'rankin_inlet', 'cambridge_bay', 'inuvik'];
  let guess: 'ca' | 'us' | null = null;
  if (langs.some((l) => l.endsWith('-ca')) || caZones.some((z) => tz.endsWith('/' + z))) guess = 'ca';
  else if (langs.some((l) => l === 'en-us') && tz.startsWith('america/')) guess = 'us';
  if (guess) {
    const card = document.querySelector<HTMLElement>(`.pick-card[data-ctry="${guess}"]`);
    card?.classList.add('suggested');
    card?.querySelector<HTMLElement>('[data-suggest]')?.removeAttribute('hidden');
  }

  document.querySelectorAll<HTMLAnchorElement>('.pick-card').forEach((a) => {
    a.addEventListener('click', () => {
      const code = a.dataset.ctry as 'ca' | 'us';
      const other = code === 'ca' ? 'us' : 'ca';
      document.cookie = `ayh_${code}=1; path=/; max-age=31536000; samesite=lax`;
      document.cookie = `ayh_${other}=; path=/; max-age=0; samesite=lax`;
    });
  });
</script>
