---
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import { SITE } from '../../config/site';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

const title = 'Well water testing in Ontario — free bacterial tests, how often, and what else to check | AuditYourHome';
const description =
  'Public Health Ontario tests private well water for E. coli and total coliforms free of charge. How to collect and submit a sample within the 48-hour window, how often rural homes should test, and when to pay a private lab for nitrates, arsenic, and other chemistry.';

const faqs = [
  {
    q: 'How often should I test?',
    a: 'Public Health Ontario\'s guidance is to test often, because well water quality changes — many Ontario health units suggest a seasonal rhythm along the lines of spring, summer, and fall, and Ontario\'s well guidance singles out spring snowmelt and heavy-rain periods as the moments contamination sneaks in. Shallow and older dug wells need more frequent checks than deep drilled wells with sound casings. Since the bacterial test is free, frequency costs you only the drive to a drop-off.',
  },
  {
    q: 'My result came back positive for coliforms. Now what?',
    a: 'Stop drinking it untreated (boil or use bottled), resample to rule out collection error, and look for the cause: a damaged or unsealed well cap, casing cracks, surface water pooling at the wellhead, or a nearby septic issue. Shock chlorination plus repairs often clears it — then retest until you have consecutive clean results. Your local health unit will walk you through it; that\'s literally their job.',
  },
  {
    q: 'Do I need the paid chemistry tests too?',
    a: 'Periodically, yes. The free test covers bacteria only — it says nothing about nitrates (a real concern near farmland), arsenic or uranium (bedrock geology), sodium, fluoride, or metals. Ontario\'s guidance is to run those through a private accredited lab: a baseline panel when you move in or drill, again every few years, and any time taste, colour, or smell changes. Budget $100–$300 depending on the panel.',
  },
  {
    q: 'Buying a rural home — what should I ask for?',
    a: 'Test before closing (make it a condition), and ask the sellers for their testing history — a documented record of clean results is worth real money, and its absence is worth a question. Include a chemistry panel, not just the free bacterial test, plus a well record: depth, age, casing, and the flow test. Our planner folds the well test into your audit request automatically for rural homes.',
  },
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Testing guide', path: '/tests/' },
    { name: 'Well water', path: '/tests/well-water/' },
  ]),
  faqSchema(faqs),
];
---

<Base title={title} description={description} schema={schema}>
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/tests/">Testing guide</a> <span aria-hidden="true">/</span> <span>Well water</span></nav>
    <div class="page-hero">
      <p class="eyebrow">Specialty test guide · verified {SITE.dataReviewDate}</p>
      <h1>Well water: the free test rural Ontario keeps forgetting</h1>
      <p class="lede measure">
        If your water comes from a private well, nobody is testing it but you. Ontario makes the
        important half effortless — Public Health Ontario analyzes private well samples for
        E.&nbsp;coli and total coliforms <strong>free of charge</strong> — and the discipline is
        simply doing it regularly, plus a paid chemistry panel every few years for what bacteria
        tests can't see.
      </p>
    </div>

    <div class="glance">
      <div class="g"><p class="k">Bacterial test</p><p class="v">Free (PHO)</p></div>
      <div class="g"><p class="k">Sample window</p><p class="v">To lab within 48 h</p></div>
      <div class="g"><p class="k">Rhythm</p><p class="v">Test often — seasonal</p></div>
      <div class="g"><p class="k">Chemistry panel</p><p class="v">$100–$300, private lab</p></div>
    </div>

    <div class="measure prose">
      <h2>The testing routine</h2>
    </div>

    <ol class="steps measure">
      <li>
        <h3>Pick up the free kit</h3>
        <p>Sterile sample bottles come from your nearest Public Health Ontario laboratory, your
        local health unit, or a designated pickup location — no charge, no appointment.</p>
      </li>
      <li>
        <h3>Collect the sample properly</h3>
        <p>Follow the kit card exactly: a clean tap without an aerator screen if possible, run
        the cold water a few minutes first, don't rinse the bottle or touch its rim, fill to the
        line, cap immediately.</p>
      </li>
      <li>
        <h3>Get it to a drop-off within 48 hours, kept cool</h3>
        <p>Samples older than 48 hours can't be tested. Regional PHO labs take drop-offs weekdays
        8:30–4:30 (Toronto's Resources Road lab until 1:30); many health units run local
        drop-off points. Cooler bag in the car, not the trunk in July.</p>
      </li>
      <li>
        <h3>Read the result — the target is zero</h3>
        <p>Safe well water shows no total coliforms and no E. coli. Any detection means
        investigate: wellhead condition, casing, surface drainage, septic distance. Resample
        after any fix, and after every spring melt if your well has history.</p>
      </li>
      <li>
        <h3>Every few years, pay for the chemistry</h3>
        <p>An accredited private lab panel for nitrates, arsenic, uranium, sodium, and metals —
        the free test says nothing about these. Baseline it when you buy or drill, repeat every
        few years or when taste, colour, or smell changes.</p>
      </li>
      <li>
        <h3>Keep every report</h3>
        <p>A dated file of clean results documents your water the way an EnerGuide label
        documents your energy — it answers a buyer's hardest rural question before it's asked.</p>
      </li>
    </ol>

    <div class="card card-pad callout measure">
      <h3>The rural audit connection</h3>
      <p class="mb-0">
        Rural retrofits touch the well more than you'd think: the pump is part of your electrical
        baseload (it shows up in the <a href="/plan/">planner's</a> bill analysis), trenching and
        grading work near the wellhead can change surface drainage, and a heat pump conversion
        that frees you from fuel deliveries pairs naturally with getting the water file in order.
        If you told the planner you're on a well, this test is already in your audit request.
      </p>
    </div>

    <h2>Common questions</h2>
    <div class="measure">
      {faqs.map((f) => (
        <details class="faq"><summary>{f.q}</summary><div class="faq-body"><p>{f.a}</p></div></details>
      ))}
    </div>

    <div class="card card-pad srcs">
      <h3>Sources</h3>
      <ul>
        <li><a href="https://www.publichealthontario.ca/en/Laboratory-Services/Well-Water-Testing" rel="noopener">Public Health Ontario — Well water testing (free service, what's tested, kits &amp; drop-offs, 48-hour rule) (verified {SITE.dataReviewDate})</a></li>
        <li><a href="https://www.ontario.ca/page/testing-and-treating-private-water-wells" rel="noopener">Ontario — Testing and treating private water wells (chemistry via private labs, snowmelt risk, disinfection) (verified {SITE.dataReviewDate})</a></li>
      </ul>
    </div>

    <div class="related">
      <a class="btn btn-ghost" href="/tests/screener/">Which specialty tests does my home need? →</a>
      <a class="btn btn-ghost" href="/tests/">All tests</a>
      <a class="btn btn-ghost" href="/tests/radon/">Related guide: radon</a>
    </div>

    <LeadForm
      heading="Rural home, full picture"
      sub="Tell us where you are — we'll match you with an advisor who covers the whole rural checklist: envelope, heating, radon, and the well."
      context="guide-well"
    />
  </div>
</Base>

<style>
  .crumbs { padding-top: 24px; font-size: 13.5px; color: var(--faint); }
  .crumbs a { color: var(--muted); }
  .glance { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 4px 0 26px; }
  .glance .g { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; }
  .glance .k { font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); margin-bottom: 4px; }
  .glance .v { font-family: var(--mono); font-weight: 600; font-size: 15px; color: var(--ink); margin: 0; }
  @media (max-width: 840px) { .glance { grid-template-columns: repeat(2, 1fr); } }
  .prose h2 { font-size: 23px; margin: 26px 0 10px; }
  .steps { counter-reset: s; list-style: none; padding: 0; margin: 10px 0 6px; display: grid; gap: 12px; }
  .steps li { position: relative; padding: 14px 16px 14px 58px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); }
  .steps li::before { counter-increment: s; content: counter(s); position: absolute; left: 16px; top: 15px; width: 28px; height: 28px; border-radius: 50%; background: var(--heat); color: #fff; font-family: var(--mono); font-weight: 600; display: grid; place-items: center; font-size: 14px; }
  .steps h3 { margin: 0 0 4px; font-size: 16.5px; }
  .steps p { margin: 0; font-size: 14.5px; color: var(--muted); }
  .callout { border-left: 4px solid var(--heat); margin: 26px 0; }
  .srcs { border-left: 4px solid var(--steel); margin: 30px 0 10px; }
  .srcs ul { margin: 0; padding-left: 20px; display: grid; gap: 6px; font-size: 14px; }
  .related { display: flex; flex-wrap: wrap; gap: 10px; margin: 8px 0 26px; }
</style>
