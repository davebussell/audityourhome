---
/** "Keeping the heat in" hub: headline numbers + the 15 topics in four groups. */
import Base from '../../../layouts/Base.astro';
import Photo from '../../../components/Photo.astro';
import { ogFor } from '../../../lib/photos';
import { SITE } from '../../../config/site';
import { breadcrumbSchema } from '../../../lib/schema';
import learnJson from '../../../data/learn.json';

interface Stat { value: string; label: string; source: string; sourceName: string }
interface LearnTopic {
  slug: string;
  group: string;
  topic: string;
  blurb: string;
  stats: Stat[];
  keyStat: number;
  verified: string;
}

const topics = learnJson as LearnTopic[];
const bySlug = (s: string) => {
  const t = topics.find((x) => x.slug === s);
  if (!t) throw new Error(`learn/index: unknown topic "${s}"`);
  return t;
};

const title = 'Keeping the heat in: how your house works | AuditYourHome';
const description =
  'The numbers behind every upgrade, from NRCan and other official sources: 15 plain-language guides, from the basement to the thermostat.';
const verified = topics[0].verified;

/** Headline strip: one figure from six topics across all four groups. */
const headline = (
  [
    ['foundations-basements', 0],
    ['windows-doors', 0],
    ['air-sealing', 2],
    ['thermostats', 0],
    ['water-heaters', 0],
    ['energuide-ratings', 0],
  ] as const
).map(([slug, i]) => {
  const t = bySlug(slug);
  return { href: `/ca/learn/${slug}/`, topic: t.topic, ...t.stats[i] };
});

const GROUP_INTRO: Record<string, string> = {
  'The envelope': 'The shell that holds the heat in: foundation, walls, roof, windows and doors, and the air leaks between them.',
  'Air and moisture': 'How water vapour and fresh air move through a house, and how to control both as the house gets tighter.',
  'Heating, cooling and hot water': 'The equipment that uses the energy: how efficient each type is, how to run it and how to keep it safe.',
  'Ratings and audits': 'What an EnerGuide evaluation measures, and what an older report is still good for.',
};
const groups = [...new Set(topics.map((t) => t.group))].map((name) => ({
  name,
  id: name.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, ''),
  intro: GROUP_INTRO[name] ?? '',
  items: topics.filter((t) => t.group === name),
}));

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/ca/' },
    { name: 'Learn', path: '/ca/learn/' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Keeping the heat in',
    description,
    url: `${SITE.url}/ca/learn/`,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: topics.length,
      itemListElement: topics.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: t.topic,
        url: `${SITE.url}/ca/learn/${t.slug}/`,
      })),
    },
  },
];
---

<Base title={title} description={description} schema={schema} ogImage={ogFor('home-hero-thermal')}>
  <div class="container">
    <div class="page-hero has-photo">
      <div class="hero-text">
        <p class="eyebrow">Learn · {topics.length} topics · verified {verified}</p>
        <h1>Keeping the heat in: how your house really works</h1>
        <p class="lede measure">
          Every upgrade decision comes down to a few numbers: how much heat leaves through each part
          of the house, how much a fix keeps in and what the equipment costs to run. These guides set
          out those numbers from NRCan, Health Canada, the National Building Code and other official
          sources, with the sources listed on every page.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/ca/calculators/">Run the numbers for your city →</a>
          <a class="btn btn-ghost" href="/ca/plan/">Build my plan</a>
        </div>
      </div>
      <Photo name="home-hero-thermal" eager />
    </div>

    <section class="glance" aria-labelledby="glance-h">
      <h2 id="glance-h" class="sr-only">Headline numbers</h2>
      <ul class="headline">
        {headline.map((h) => (
          <li>
            <a class="hn" href={h.href}>
              <span class="hn-value">{h.value}</span>
              <span class="hn-label">{h.label}</span>
              <span class="hn-go">{h.topic} →</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="small glance-note">
        NRCan’s heat-loss shares describe what each part of a house <em>can</em> account for. They
        vary from house to house, so they aren’t meant to be added together. Each figure links to
        the guide that cites its source.
      </p>
    </section>

    <p class="measure route">
      Start with the envelope (the shell of the house that holds heat in), then air and moisture,
      then the equipment that heats, cools and makes hot water. Already have an EnerGuide report?
      The last two guides explain what it tells you.
    </p>

    <a class="card card-pad worked" href="/ca/learn/real-numbers/">
      <span class="eyebrow">Worked examples</span>
      <span class="wk-title">What upgrades really save: four houses, every number shown →</span>
      <span class="small">A 1970s gas-heated house in Ottawa, a 1950s electric bungalow in Winnipeg, a 1920s oil-heated house in Halifax and a 2000s Toronto semi, run through the same model as our calculators, step by step.</span>
    </a>

    {groups.map((g, gi) => (
      <section class="grp" id={g.id} aria-labelledby={`${g.id}-h`}>
        <div class="grp-head">
          <span class="grp-no" aria-hidden="true">{gi + 1}</span>
          <div>
            <h2 id={`${g.id}-h`}>{g.name}</h2>
            <p class="small mb-0">{g.intro}</p>
          </div>
        </div>
        <div class="lcards">
          {g.items.map((t) => {
            const k = t.stats[t.keyStat] ?? t.stats[0];
            return (
              <a class="card lcard" href={`/ca/learn/${t.slug}/`}>
                <h3>{t.topic}</h3>
                <p class="blurb">{t.blurb}</p>
                <p class="knum">
                  <span class="kv">{k.value}</span>
                  <span class="kl">{k.label}</span>
                </p>
                <span class="go">Read the guide →</span>
              </a>
            );
          })}
        </div>
      </section>
    ))}

    <section class="next" aria-labelledby="next-h">
      <h2 id="next-h">Put the numbers to work</h2>
      <div class="next-grid">
        <a class="card nx nx-main" href="/ca/calculators/">
          <span class="nx-title">Run the numbers for your city →</span>
          <span class="small">Energy costs and upgrade payback at your local energy prices.</span>
        </a>
        <a class="card nx" href="/ca/plan/">
          <span class="nx-title">Build your home plan →</span>
          <span class="small">Put upgrades in a sensible order for your house, before anyone visits.</span>
        </a>
        <a class="card nx" href="/ca/tests/">
          <span class="nx-title">See the testing guide →</span>
          <span class="small">Blower door, thermal imaging, radon and more: what each test measures.</span>
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  .worked { display: grid; gap: 6px; margin: 4px 0 26px; text-decoration: none; color: var(--ink); border-left: 4px solid var(--heat); }
  .worked:hover { box-shadow: var(--shadow-md); color: var(--ink); }
  .worked .eyebrow { margin: 0; }
  .wk-title { font-family: var(--display); font-weight: 700; font-size: 19px; color: var(--heat-deep); }
  /* headline numbers */
  .glance { padding: 4px 0 8px; }
  .headline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .hn {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px 16px;
    background: var(--navy);
    color: var(--navy-ink);
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .hn:hover { color: var(--navy-ink); transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .hn-value {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(28px, 3.2vw, 36px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .hn-label { font-size: 14.5px; line-height: 1.45; color: var(--navy-ink); }
  .hn-go {
    margin-top: auto;
    padding-top: 6px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: #F6B48F;
  }
  .glance-note { max-width: 80ch; margin: 12px 0 0; }
  @media (max-width: 900px) { .headline { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) {
    .headline { grid-template-columns: 1fr; gap: 10px; }
    .hn { padding: 16px 18px 14px; }
  }

  .route { margin: 30px 0 0; font-size: 17px; color: var(--muted); }

  /* groups of topic cards */
  .grp { padding: 34px 0 6px; }
  .grp-head { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 16px; }
  .grp-head h2 { font-size: clamp(23px, 2.6vw, 28px); margin: 0 0 4px; }
  .grp-no {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-weight: 600;
    font-size: 15px;
    color: #fff;
    background: var(--heat);
    margin-top: 1px;
  }
  .lcards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 900px) { .lcards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .lcards { grid-template-columns: 1fr; } }
  .lcard {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px 18px;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .lcard:hover { border-color: var(--heat); color: var(--ink); transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .lcard h3 { font-size: 19px; margin: 0; }
  .blurb { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--muted); }
  .knum {
    margin: 4px 0 0;
    padding: 10px 12px;
    background: var(--heat-tint);
    border-radius: 8px;
    display: grid;
    gap: 2px;
  }
  .kv { font-family: var(--display); font-weight: 800; font-size: 21px; line-height: 1.15; color: var(--heat-deep); }
  .kl { font-size: 13px; line-height: 1.4; color: var(--ink); }
  .go { margin-top: auto; padding-top: 4px; font-weight: 700; font-size: 14px; color: var(--heat-deep); }

  /* next steps */
  .next { padding: 40px 0 56px; }
  .next h2 { font-size: clamp(23px, 2.6vw, 28px); }
  .next-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .nx { display: flex; flex-direction: column; gap: 4px; padding: 18px 20px; text-decoration: none; color: var(--ink); transition: border-color 0.15s ease; }
  .nx:hover { border-color: var(--heat); color: var(--ink); }
  .nx-main { border-top: 4px solid var(--pine); }
  .nx-title { font-family: var(--display); font-weight: 700; font-size: 17px; color: var(--heat-deep); }
  @media (max-width: 760px) { .next-grid { grid-template-columns: 1fr; } }
</style>
