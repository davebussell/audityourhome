---
import Base from '../../../layouts/Base.astro';
import LeadForm from '../../../components/LeadForm.astro';
import { SITE } from '../../../config/site';
import { breadcrumbSchema, providerSchema } from '../../../lib/schema';
import { allProviders, providerBySlug, regionBySlug, reviewLinks } from '../../../lib/data';

export function getStaticPaths() {
  return allProviders.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const p = providerBySlug(slug!)!;
const servedRegions = p.serves.map((s) => regionBySlug(s)).filter(Boolean);

const inactive = p.status === 'inactive';
const alternatives = (p.alternatives ?? []).map((s) => providerBySlug(s)).filter((x) => x && x.status !== 'inactive');

const title = inactive
  ? `${p.name} — no longer offering EnerGuide evaluations | AuditYourHome`
  : `${p.name} — EnerGuide energy assessments | AuditYourHome`;
const description = inactive
  ? `${p.name} no longer offers EnerGuide home energy evaluations. Who serves ${p.serviceNote} now — checked against NRCan's list of licensed service organizations.`
  : `${p.name}: ${p.registration}. Serving ${p.serviceNote}. Profile, service area, and how to book — on AuditYourHome, the audit-first directory.`;

const typeLabel = p.type === 'non-profit' ? 'Non-profit organization' : p.type === 'franchise' ? 'Franchise network' : 'Company';
const rv = reviewLinks(p);

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/ca/' },
    { name: 'Find an auditor', path: '/ca/find/' },
    { name: p.name, path: `/ca/providers/${p.slug}/` },
  ]),
  ...(inactive ? [] : [providerSchema(p)]),
];
---

<Base title={title} description={description} schema={schema}>
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/ca/find/">Find an auditor</a> <span aria-hidden="true">/</span> <span>{p.name}</span>
    </nav>

    <div class="page-hero">
      <div class="headrow">
        <h1>{p.name}</h1>
        <span class="chip chip-neutral">{typeLabel}</span>
        {inactive && <span class="chip chip-closed">No longer offering evaluations</span>}
        {!inactive && (p.hrsApproved
          ? <a class="chip chip-active hrs-chip" href="/ca/programs/home-renovation-savings-assessment/">HRSP-approved: Yes</a>
          : <a class="chip chip-neutral hrs-chip" href="/ca/programs/home-renovation-savings-assessment/">HRSP-approved: No</a>)}
      </div>
      {inactive ? (
        <div class="card card-pad inactive-note">
          <h3>This organization no longer offers EnerGuide evaluations</h3>
          <p>{p.statusNote}</p>
          {alternatives.length > 0 && (
            <p class="mb-0">
              <strong>Serving this area now:</strong>{' '}
              {alternatives.map((a, i) => (
                <span>{i > 0 && ' · '}<a href={`/ca/providers/${a!.slug}/`}>{a!.name}</a></span>
              ))}
            </p>
          )}
        </div>
      ) : (
      <p class="badge-verify big">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 1.5 2.5 4v4c0 3.2 2.3 5.6 5.5 6.5 3.2-.9 5.5-3.3 5.5-6.5V4L8 1.5Z" fill="currentColor" opacity="0.18"/>
          <path d="m5.4 8.1 1.8 1.8 3.4-3.7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {p.registration}
        <span class="meta">source: {p.registrationSource} · checked {p.checkedOn}</span>
      </p>
      )}
      {p.hrsApproved && !inactive && (
        <p class="small hrs-note measure">
          One of the seven service organizations approved for Ontario's
          <a href="/ca/programs/home-renovation-savings-assessment/">Home Renovation Savings assessment path</a>,
          so its EnerGuide assessments can qualify for the $600 assessment rebate (paid once you install at
          least two recommended upgrades) and the insulation, window and air-sealing rebates. The same
          organization has to do both visits, and the follow-up must be booked by November 30, 2026 and
          done within 180 days of the first assessment or by December 31, 2026, whichever comes first.
        </p>
      )}
      {!p.hrsApproved && !inactive && (
        <p class="small hrs-note measure">
          Not one of the seven organizations approved for Ontario's
          <a href="/ca/programs/home-renovation-savings-assessment/">Home Renovation Savings assessment path</a>.
          Its EnerGuide evaluations are official and still count for planning, financing and other
          programs, but only assessments from the seven HRSP-approved organizations qualify for the $600
          rebate and the assessment-path upgrade rebates.
        </p>
      )}
      <p class="lede measure">{p.profile}</p>
    </div>

    <div class="grid-2 detail-grid">
      <div class="card card-pad">
        <h3>Service area</h3>
        <p>{p.serviceNote}</p>
        {servedRegions.length > 0 && (
          <p class="small">
            Directory areas:
            {servedRegions.map((r, i) => (
              <span>{i > 0 && ', '}<a href={`/ca/find/${r!.slug}/`}>{r!.name}</a></span>
            ))}
          </p>
        )}
        {p.scaleClaim && <p class="small mb-0">{p.scaleClaim}</p>}
      </div>

      {!inactive && <div class="card card-pad">
        <h3>Pricing &amp; booking</h3>
        {p.pricing ? (
          <>
            <p>
              <span class="money">{p.pricing.preRetrofit}</span> initial assessment ·
              <span class="money"> {p.pricing.postRetrofit}</span> follow-up
            </p>
            <p class="small">{p.pricing.note}</p>
            <p class="meta">Published price · as of {p.pricing.asOf}</p>
          </>
        ) : (
          <p class="small">
            Prices not published. Typical Ontario prices are about $500–$700 for the initial
            evaluation and $200–$450 for the follow-up, plus HST where it applies.
            {p.hrsApproved
              ? ' As an HRSP-approved organization, its assessments can earn the $600 Home Renovation Savings rebate once you install two or more recommended upgrades.'
              : ''}
            Ask for a written quote; transparent providers get featured here.
          </p>
        )}
        <p class="mb-0"><strong>Booking:</strong> {p.booking}</p>
        <div class="actions">
          {p.website && <a class="btn btn-primary btn-sm" href={p.website} rel="noopener nofollow" target="_blank">Visit website</a>}
          {p.phone && <a class="btn btn-ghost btn-sm" href={`tel:${p.phone.replace(/[^0-9+]/g, '')}`}>{p.phone}</a>}
        </div>
      </div>}
    </div>

    {!inactive && <div class="card card-pad reputation">
      <h3>Check their reputation</h3>
      <p class="small">
        Read what real customers say before you book — we link you straight to the independent
        sources rather than curating quotes. (On-platform verified reviews are on our roadmap.)
      </p>
      <div class="rep-links">
        <a class="btn btn-ghost btn-sm" href={rv.google} rel="noopener nofollow" target="_blank">Google reviews ↗</a>
        <a class="btn btn-ghost btn-sm" href={rv.homestars} rel="noopener nofollow" target="_blank">HomeStars ↗</a>
        <a class="btn btn-ghost btn-sm" href={rv.bbb} rel="noopener nofollow" target="_blank">Better Business Bureau ↗</a>
      </div>
      <p class="meta mb-0">Search links — if a profile doesn't exist on a platform, that's worth knowing too.</p>
    </div>}

    <div class="card card-pad listing-note">
      <h4>About this listing</h4>
      <p class="small mb-0">
        Compiled from public sources ({p.sources.map((s, i) => (
          <span>{i > 0 && ', '}<a href={s} rel="noopener nofollow" target="_blank">source {i + 1}</a></span>
        ))}) and checked {p.checkedOn}. {SITE.name} verification — where providers confirm
        registration, insurance, and pricing with us directly — is rolling out; verified profiles
        will be marked. Spot an error? <a href={`mailto:${SITE.contactEmail}`}>Tell us</a> and we'll
        fix it fast. This provider can <a href="/ca/for-professionals/">claim this profile</a>.
      </p>
    </div>

    <LeadForm
      heading={inactive ? `Find an active advisor near ${p.serviceNote}` : `Planning an audit with ${p.name}?`}
      sub="We can also suggest comparison quotes from other registered organizations serving your area."
      region={servedRegions[0]?.slug ?? ''}
      context={`provider-${p.slug}`}
    />
  </div>
</Base>

<style>
  .hrs-chip { text-decoration: none; }
  .hrs-note { margin: -6px 0 14px; }
  .crumbs { padding-top: 24px; font-size: 13.5px; color: var(--faint); }
  .crumbs a { color: var(--muted); }
  .headrow { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .headrow h1 { margin-bottom: 0; }
  .badge-verify.big { font-size: 14px; margin: 14px 0 18px; padding: 6px 12px; flex-wrap: wrap; }
  .badge-verify.big .meta { font-weight: 400; }
  .detail-grid { margin-bottom: 18px; }
  .actions { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
  .reputation { border-left: 4px solid var(--pine); margin-bottom: 18px; }
  .rep-links { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 12px; }
  .listing-note { border-left: 4px solid var(--steel); margin-bottom: 18px; }
  .listing-note h4 { margin-bottom: 6px; }
  .inactive-note { border-left: 4px solid var(--dead); margin: 14px 0 18px; }
  .inactive-note h3 { margin-bottom: 6px; }
</style>
