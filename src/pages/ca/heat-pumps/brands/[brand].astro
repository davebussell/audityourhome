---
import BrandPage from '../../../../components/hp/BrandPage.astro';
import { brandSlugs } from '../../../../lib/heatpumps';

export function getStaticPaths() {
  return brandSlugs('ca').map((brand) => ({ params: { brand } }));
}
const { brand } = Astro.params;
---

<BrandPage market="ca" slug={brand!} />
