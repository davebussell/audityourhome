---
/**
 * Where the Canadian audit-request form lands after a Netlify submission (the form posts to
 * /ca/thanks/?sent=1). Without the flag (a bookmark, a reload, a direct visit) the page doesn't
 * claim anything was sent. Not indexed.
 */
import Base from '../../layouts/Base.astro';
import JourneyBar from '../../components/JourneyBar.astro';
import { SITE } from '../../config/site';
---

<Base title="Your request | AuditYourHome" description="What happens after you ask to be matched with a registered energy advisor." indexable={false}>
  <div class="container thanks">
    <JourneyBar country="ca" current={2} ticks={false} />

    <div class="page-hero">
      <div class="hero-text" data-sent="yes" hidden>
        <p class="eyebrow">Request received</p>
        <h1>Thanks. Your request reached us.</h1>
        <p class="lede measure">A person reads every request, usually within one business day. Here’s what happens next.</p>
      </div>
      <div class="hero-text" data-sent="no">
        <p class="eyebrow">Your request</p>
        <h1>What happens after you ask to be matched</h1>
        <p class="lede measure">
          If you sent a request from one of our forms, a person reads it and replies by email, usually within one
          business day. If you landed here another way, nothing has been sent yet: you can ask from any
          <a href="/ca/find/">city’s advisor list</a>, or <a href="/ca/plan/">start with your free plan</a>.
        </p>
      </div>
    </div>

    <section class="next" aria-labelledby="h-next">
      <h2 id="h-next">What happens next</h2>
      <ol class="nsteps">
        <li class="card">
          <h3>We read your request</h3>
          <p>A person, not a bot, usually within one business day.</p>
        </li>
        <li class="card">
          <h3>We email you from {SITE.contactEmail}</h3>
          <p>
            We introduce you to one licensed service organization that serves your area; one of its registered energy
            advisors does the visit. Where your province or territory runs the bookings (Nova Scotia, New Brunswick, PEI,
            Yukon, the NWT), we point you to its program instead.
          </p>
        </li>
        <li class="card">
          <h3>You book the EnerGuide evaluation</h3>
          <p>The visit takes about 2–3 hours. Ask whether the price includes the follow-up visit that most rebates need.</p>
        </li>
      </ol>
    </section>

    <section class="wait card card-pad" aria-labelledby="h-wait">
      <h2 id="h-wait">While you wait</h2>
      <ul class="checklist">
        <li>Find your last 12 months of energy bills: gas, oil or propane, and electricity.</li>
        <li>Note the rooms that run hot or cold, drafty or damp, and when it happens.</li>
        <li>Make sure the advisor can reach the attic hatch, the basement and the furnace or boiler room.</li>
        <li>
          Have your questions ready: Is the blower door test included? Does the price cover the follow-up visit? Which
          rebates need the evaluation before I start any work? Will you check combustion safety?
        </li>
      </ul>
      <p class="links small">
        <a href="/ca/how-it-works/#visit">What happens at the visit</a> ·
        <a href="/ca/find/">How booking works in your province</a> ·
        <a href="/ca/programs/">Rebates and programs</a>
      </p>
    </section>

    <p class="back"><a class="btn btn-ghost" href="/ca/">Back to the home page</a></p>
  </div>
</Base>

<script is:inline>
  (function () {
    var sent = /(?:^|[?&])sent=1(?:&|$)/.test(location.search);
    document.querySelectorAll('[data-sent]').forEach(function (el) {
      el.hidden = (el.getAttribute('data-sent') === 'yes') !== sent;
    });
  })();
</script>

<style>
  .thanks { padding-bottom: 48px; }
  .thanks .page-hero { padding-bottom: 20px; }
  .next h2, .wait h2 { font-size: 22px; margin: 0 0 12px; }
  .nsteps { list-style: none; margin: 0 0 18px; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; counter-reset: ns; }
  .nsteps li { padding: 18px 20px; box-shadow: none; counter-increment: ns; }
  .nsteps h3 { font-size: 17px; margin: 0 0 6px; }
  .nsteps h3::before { content: counter(ns) '. '; color: var(--heat); }
  .nsteps p { margin: 0; color: var(--muted); font-size: 15px; }
  .wait { box-shadow: none; border-left: 4px solid var(--pine); max-width: 820px; }
  .checklist { margin: 0 0 12px; padding-left: 20px; display: grid; gap: 8px; }
  .links { margin: 0; line-height: 1.8; }
  .back { margin-top: 22px; }
</style>
