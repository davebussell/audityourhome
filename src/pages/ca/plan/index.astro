  /** Annual saving for one sequence item, valued at the next-unit (variable) price. */
  function itemSaving(cat: string, a: Answers, m: ReturnType<typeof houseModel>, cal: any): { dollars: number | null; note?: string; cost?: [number, number]; qty?: Record<string, unknown> } {
    const R = m.R;
    const demand = m.demand * cal.factor;
    const storeys = a.size === 'small' ? 1 : 2;
    const g = geometry(m.area, storeys, true);
    const E = MODEL.envelope;
    const Cc = MODEL.costs as any;
    const fuel = REBATE_FUEL[a.heat] ?? 'gas';
    const val = (gj: number) => savingValue(gj, m.hi.sys, R.hdd, R.prices, 'variable').dollars;
    switch (cat) {
      case 'air-sealing': {
        const r = airMeasure({ volumeM3: g.volumeM3, hdd: R.hdd, demandGJ: demand, calibration: 1 });
        return { dollars: val(r.gj), cost: [Cc.airSealing.low, Cc.airSealing.high], qty: { fuel } };
      }
      case 'attic-insulation': {
        const rb = (E.atticRByVintage as Record<string, number>)[a.age];
        const t = atticTargetR(R.hdd);
        const r = atticMeasure({ areaM2: g.atticM2, rBefore: rb, rAfter: t.target, hdd: R.hdd, demandGJ: demand, calibration: cal.factor });
        const sqft = g.atticM2 * 10.764;
        return { dollars: r.applicable ? val(r.gj) : 0, note: `from about R-${rb} to R-${t.target}`, cost: [Cc.atticPerSqft.low * sqft, Cc.atticPerSqft.high * sqft], qty: { sqft, rBefore: rb, rAfter: t.target, fuel } };
      }
      case 'wall-insulation': {
        const rb = (E.wallRsiByVintage as Record<string, number>)[a.age];
        const r = wallMeasure({ areaM2: g.wallNetM2, option: 'dense', rsiBefore: rb, hdd: R.hdd, demandGJ: demand, calibration: cal.factor });
        const rBefore = Math.round(rb * 5.678);
        return { dollars: r.applicable ? val(r.gj) : 0, qty: { sqft: g.wallNetM2 * 10.764, rBefore, rAfter: Math.max(rBefore, 13), option: 'dense', fuel } };
      }
      case 'basement-insulation': {
        const rb = (E.basementRsiByVintage as Record<string, number>)[a.age];
        const r = basementMeasure({ areaM2: g.basementWallM2, rsiBefore: rb, rsiAfter: E.basementTargetRsi, hdd: R.hdd, demandGJ: demand, calibration: cal.factor });
        return { dollars: r.applicable ? val(r.gj) : 0, qty: { sqft: g.basementWallM2 * 10.764, rBefore: Math.round(rb * 5.678), rAfter: Math.round(E.basementTargetRsi * 5.678), fuel } };
      }
      case 'windows-doors': {
        const before = winKey(a.win, a.age);
        const r = windowMeasure({ areaM2: g.windowM2, before, after: 'energyStar', hdd: R.hdd, demandGJ: demand, calibration: cal.factor });
        return { dollars: r.applicable ? val(r.gj) : 0, cost: [Cc.windowEach.low * g.windowCount, Cc.windowEach.high * g.windowCount], note: `${g.windowCount} windows`, qty: { count: g.windowCount, windowAfter: 'energyStar', fuel } };
      }
      case 'heat-pump': {
        const now = heatingCost(demand, m.hi.sys, R.hdd, R.prices, 'variable');
        const hp = heatingCost(demand, 'ashpCold', R.hdd, R.prices, 'variable');
        const ducted = ['gas', 'oil', 'propane', 'elecfurnace'].includes(a.heat);
        const qty = { tons: m.tons, kBtu: m.tons * 12, ducted, coldClimate: true, fuel };
        if (now.cost === null || hp.cost === null) return { dollars: null, cost: [Cc.ashpColdDucted.low, Cc.ashpColdDucted.high], qty };
        return { dollars: now.cost - hp.cost, cost: [Cc.ashpColdDucted.low, Cc.ashpColdDucted.high], qty };
      }
      case 'water-heating': {
        if (m.wk === 'heatPump') return { dollars: 0 };
        const cur = m.wk === 'boiler' ? heatingCost(m.water.gj, m.hi.sys, R.hdd, R.prices, 'variable').cost : waterHeaterCost(m.wk, m.water.gj, R.prices, 'variable').cost;
        const alt = waterHeaterCost('heatPump', m.water.gj, R.prices, 'variable', { sys: m.hi.sys, hdd: R.hdd });
        const whf = m.wk === 'electricTank' ? 'electricity' : m.wk === 'oilTank' ? 'oil' : m.wk === 'boiler' ? fuel : 'gas';
        if (cur === null || alt.cost === null) return { dollars: null };
        return { dollars: cur - (alt.cost + (alt.extraCost ?? 0)), qty: { waterHeaterFuel: whf, fuel } };
      }
      case 'controls': {
        const hp = m.hi.sys === 'ashpCold' || m.hi.sys === 'ashpStandard' || m.hi.sys === 'gshp';
        const r = setbackMeasure({ degrees: hp ? 2 : 3, hours: 8, demandGJ: demand, heatPump: hp });
        return { dollars: val(r.gj), qty: { count: 1, fuel } };
      }
    }
    return { dollars: null };
  }

  function findMeasure(category: string, era: string, heat: string) {
    const hk = heat === 'oil' ? 'oil' : heat === 'electric' ? 'electric' : 'gas';
    return D.savings.measures.find(
      (x: any) =>
        x.category === category &&
        (!x.eras?.length || x.eras.includes(era)) &&
        (!x.heatingTypes?.length || x.heatingTypes.includes(hk))
    );
  }
  const parseRange = (s: string | undefined): [number, number] | null => {
    const mm = s?.match(/\$([\d,]+)\s*[–-]\s*\$([\d,]+)/);
    return mm ? [Number(mm[1].replace(/,/g, '')), Number(mm[2].replace(/,/g, ''))] : null;
  };
  const years = (p: { kind: string; years: number | null }) => (p.kind === 'immediate' ? 0 : p.years);
  function yearsRange(cost: [number, number], rebate: number, saving: number): string {
    const lo = years(payback(cost[0], rebate, saving));
    const hi = years(payback(cost[1], rebate, saving));
    if (lo === null) return '';
    if (lo === 0 && (hi === 0 || hi === null)) return 'right away';
    const CAP = 50;
    const a1 = Math.max(1, Math.round(lo));
    if (a1 >= CAP) return `more than ${CAP} years`;
    const b1 = hi === null ? null : Math.round(hi);
    if (b1 === null) return `${a1}+ years`;
    if (b1 >= CAP) return `${a1} to more than ${CAP} years`;
    return a1 === b1 ? `about ${a1} year${a1 === 1 ? '' : 's'}` : `${a1}–${b1} years`;
  }
  const NEUTRAL_WHY: Record<string, string> = {
    'attic-insulation': 'Thin by modern standards. On its own the bill saving here is modest, so do it together with air sealing, or for comfort and to stop ice dams.',
    'basement-insulation': 'Bare foundation walls lose heat all winter; the bill saving here is modest, so it often makes most sense during a basement renovation.',
  };
  // What a long payback means for each upgrade, so two cards don't print the same sentence.
  const LONG_PAYBACK: Record<string, string> = {
    'basement-insulation': 'A long payback on bills alone: fix any water problems first, then pair it with finishing the basement.',
    'windows-doors': 'A long payback on bills alone: replace windows as they wear out or during a renovation, not to cut the bill.',
    'wall-insulation': 'A long payback on bills alone: cheapest when the siding or drywall comes off for other work.',
  };
  const LONG_PAYBACK_ANY = 'A long payback on bills alone: worth it for comfort, for stopping problems, or when it can be combined with other work.';

  function noIceDams(text: string): string {
    if (!text || !/ice dam/i.test(text)) return text;
    const t = text.replace(/,? or for comfort and to stop ice dams/i, ', or for comfort').replace(/ and (help )?(prevent|stop) ice dams/i, '');
    if (!/ice dam/i.test(t)) return t;
    const kept = sentences(t).filter((x) => !/ice dam/i.test(x));
    return kept.length ? kept.join(' ') : t;
  }

  function renderSequence(arch: any, a: Answers, syms: string[], goals: string[], m: ReturnType<typeof houseModel>, cal: any, isON: boolean, isToronto: boolean, ctx: Ctx) {
    const el = $('#rSequence');
    const later = $('#rLater');
    if (a.htype === 'condo') {
      lastItems = [];
      later.innerHTML = '';
      el.innerHTML = `
        <div class="rsec"><h3>Condos work differently</h3>
        <p class="sub">EnerGuide evaluations and most rebates target houses and townhomes; in a condo, the envelope and heating usually belong to the corporation. Your best levers: in-suite sealing, window coverings, a heat-pump conversation with your board, and pushing the corporation toward a building-level audit.</p></div>`;
      return;
    }
    const seq = buildSequence(arch, a.heat, syms, goals, a, isON);
    const ON_REBATE: Record<string, string> = {
      'air-sealing': 'HRSP assessment path', 'attic-insulation': 'HRSP insulation rebates', 'wall-insulation': 'HRSP insulation rebates',
      'basement-insulation': 'HRSP insulation rebates', 'windows-doors': 'HRSP $100/opening', 'heat-pump': 'HRSP heat pump rebate',
      solar: 'HRSP solar + battery', 'water-heating': 'HRSP $500', controls: 'HRSP thermostat rebate',
    };
    const prov = ctx.loc.province;
    lastItems = [];
    const main: string[] = [];
    const laterRows: string[] = [];
    const usedPayNotes = new Set<string>();
    for (const item of seq) {
      const sm = findMeasure(item.category, a.age, m.hi.screen);
      const s = itemSaving(item.category, a, m, cal);
      const cost = s.cost ?? parseRange(localizeCost(sm?.typicalCost ?? '', isON));
      const reb = s.qty ? rebateFor(item.category, prov, { ...s.qty, cost: cost ? cost[0] : undefined }) : null;
      let title = item.action;
      let why = localize(item.why, isON);
      let note = item.category === 'heat-pump' ? '' : localize(sm?.note ?? '', isON);
      if (item.category === 'attic-insulation' && s.note) {
        title = `Attic insulation, ${s.note}${/after sealing/i.test(item.action) ? ' (after sealing and safety checks)' : ''}`;
      }
      if (item.category === 'water-heating' && !why) why = 'When your tank wears out, a heat pump water heater makes the same hot water with far less energy.';
      if (item.category === 'solar' && !why) why = 'Worth a look if your roof faces south and isn’t shaded. Get the envelope done first.';
      const hpCase = item.category === 'heat-pump';
      if (hpCase) {
        const hc = heatPumpCopy(ctx.C.key, a.heat, s.dollars, ctx.R.name);
        title = hc.title;
        why = hc.why;
      }
      if (note && why && (note.slice(0, 40).toLowerCase() === why.slice(0, 40).toLowerCase() || why.includes(note) || note.includes(why))) note = '';
      if (note && why && note.split(' — ')[0] === why.split(' — ')[0]) note = '';
      if (note && why && sharesPhrase(note, why)) note = '';
      // Long paybacks contradict "cheap win" claims: say what the numbers mean instead.
      let payTxt = '';
      let payNote = '';
      if (s.dollars !== null && s.dollars !== undefined && s.dollars >= 15 && cost) {
        const before = yearsRange(cost, 0, s.dollars);
        const after = reb ? yearsRange(cost, reb.amount, s.dollars) : '';
        if (before) payTxt = `payback: ${before} before rebates${after ? `, ${after} after a rebate of at least ${money(reb!.amount)}` : ''}`;
        const lowYears = years(payback(cost[0], reb?.amount ?? 0, s.dollars));
        if (lowYears !== null && lowYears > 15) {
          if (NEUTRAL_WHY[item.category] && /cheap win|best payback|Highest return|Cheap, fast/i.test(why)) why = NEUTRAL_WHY[item.category];
          payNote = LONG_PAYBACK[item.category] ?? LONG_PAYBACK_ANY;
        }
      }
      // Where ice dams aren't a local problem (mild coastal cities), don't sell upgrades on stopping them.
      if (ctx.C.place?.iceDams === false) {
        why = noIceDams(why);
        note = noIceDams(note);
      }
      // Heat pumps that wouldn't lower the bill move to "when your system needs replacing".
      if (hpCase && (s.dollars === null || s.dollars < 100) && !['electric', 'elecfurnace'].includes(a.heat)) {
        laterRows.push(`
          <div class="seq-item">
            <h4>${esc(title)}</h4>
            <p class="why">${esc(heatPumpLaterNote(a.heat, s.dollars, ctx.R.name, ctx.C.key, prov))}</p>
            ${why ? `<p class="why">${esc(why)}</p>` : ''}
            <div class="nums">
              ${cost ? `<span class="cost">typical cost ${money(cost[0])}–${money(cost[1])}</span>` : ''}
              ${reb ? `<span class="chip chip-active">rebate: at least ${money(reb.amount)} (${esc(shortLabel(reb.program))})</span>` : ''}
              <a class="chip chip-info" href="/ca/programs/national-heat-pump-rebate/">+ federal rebate, opens early 2027</a>
            </div>
          </div>`);
        lastItems.push({ key: item.category, title, category: item.category, cost_low: cost ? Math.round(cost[0]) : null, cost_high: cost ? Math.round(cost[1]) : null, saving_year: null, rebate: reb?.program ?? null });
        continue;
      }
      lastItems.push({
        key: item.category, title, category: item.category,
        cost_low: cost ? Math.round(cost[0]) : null, cost_high: cost ? Math.round(cost[1]) : null,
        saving_year: s.dollars !== null && s.dollars !== undefined && s.dollars >= 15 ? Math.round(s.dollars) : null,
        rebate: reb?.program ?? (isON ? ON_REBATE[item.category] ?? null : null),
      });
      let saveTxt = '';
      if (s.dollars !== null && s.dollars !== undefined) {
        if (s.dollars >= 15) saveTxt = `about ${money(s.dollars)}/yr <span class="save-range">(likely ${money(s.dollars * 0.75)}–${money(s.dollars * 1.25)})</span>`;
        else if (item.category !== 'ventilation' && item.category !== 'solar') saveTxt = `<span class="save-small">little or no bill saving for a house like yours</span>`;
      }
      if (item.category === 'ventilation') payNote = 'Bought for air quality and moisture control, not for bill savings.';
      if (payNote && sharesPhrase(`${why} ${note}`, payNote)) payNote = '';
      if (payNote && usedPayNotes.has(payNote)) payNote = '';
      if (payNote) usedPayNotes.add(payNote);
      const costTxt = cost ? `typical cost ${money(cost[0])}–${money(cost[1])}` : sm?.typicalCost ? `typical cost ${esc(localizeCost(sm.typicalCost, isON))}` : '';
      const onChip = isON && ON_REBATE[item.category] ? `<span class="chip chip-active">${ON_REBATE[item.category]}</span>${isToronto ? ' <span class="chip chip-neutral">+ HELP financing</span>' : ''}` : '';
      const rebChip = !onChip && reb ? `<span class="chip chip-active">rebate: at least ${money(reb.amount)} (${esc(shortLabel(reb.program))})</span>` : '';
      main.push(`
        <div class="seq-item">
          <h4>${esc(title)}${s.note && item.category !== 'attic-insulation' ? ` <span class="small">(${esc(s.note)})</span>` : ''}</h4>
          <p class="why">${esc(why)}${note ? ' ' + esc(note) : ''}</p>
          <div class="nums">
            ${saveTxt ? `<span class="save">${saveTxt}</span>` : ''}
            ${costTxt ? `<span class="cost">${costTxt}</span>` : ''}
            ${payTxt ? `<span class="cost">${payTxt}</span>` : ''}
            ${onChip}${rebChip}
            ${hpCase ? '<a class="chip chip-info" href="/ca/programs/national-heat-pump-rebate/">+ federal rebate, opens early 2027</a>' : ''}
            ${payNote ? `<p class="pay-note">${esc(payNote)}</p>` : ''}
          </div>
        </div>`);
    }
    const basis = cal.calibrated
      ? `<span class="chip chip-active">Scaled to your bills</span> Dollar figures use your bills and ${esc(m.R.name)}-area prices and climate.`
      : `<span class="chip chip-neutral">Typical house estimate</span> Based on a typical house of your era near ${esc(m.R.name)}. <a href="#" id="addBills">Add your bills</a> to scale these to your house.`;
    el.innerHTML = `
      <div class="rsec">
        <h3>Your upgrade sequence</h3>
        <p class="sub">${basis}</p>
        <p class="order-rule"><b>How we order it:</b> the way energy advisors do. Seal air leaks before you insulate, and insulate before you replace heating and cooling equipment, so the new system can be smaller. The exception is expensive heat (oil, propane or electric resistance): there a heat pump usually saves the most, so it moves up, sized with a heat-loss calculation. The problems and goals you picked move matching items up the list. <b>Payback</b> is how many years of bill savings it takes to cover the cost.</p>
        <div class="seq">${main.join('')}</div>
        <p class="small">Savings don’t simply add up: once the attic is insulated there’s less heat left to save elsewhere. We value savings at the price of your next unit of energy and stay on the low side on purpose.</p>
      </div>`;
    later.innerHTML = laterRows.length ? `
      <div class="rsec">
        <h3>When your furnace or boiler needs replacing</h3>
        <p class="sub">At today’s prices these wouldn’t lower your bills, so time them for when your current system wears out.</p>
        <div class="seq later-seq">${laterRows.join('')}</div>
      </div>` : '';
    document.getElementById('addBills')?.addEventListener('click', (e) => {
      e.preventDefault();
      setMode('wizard'); maxVisited = TOTAL; show(6);
      setupSticky();
      plannerEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  function renderSystems(a: Answers, m: ReturnType<typeof houseModel>, isON: boolean) {
    const el = $('#rSystems');
    if (a.htype === 'condo') { el.innerHTML = ''; return; }
    const R = m.R;
    const cards: string[] = [];
    if (m.waterCost !== null) {
      const alts: string[] = [];
      const hpwh = waterHeaterCost('heatPump', m.water.gj, R.prices, 'now', { sys: m.hi.sys, hdd: R.hdd });
      const tl = R.prices.gas ? waterHeaterCost('gasTankless', m.water.gj, R.prices, 'now') : null;
      if (m.wk !== 'heatPump' && hpwh.cost !== null) alts.push(`heat pump water heater about ${money(hpwh.cost + (hpwh.extraCost ?? 0))}/yr`);
      if (tl && tl.cost !== null && m.wk === 'gasTank') alts.push(`gas tankless about ${money(tl.cost)}/yr (US DOE: on-demand units are 24–34% more efficient than tanks in homes using up to about 155 litres a day)`);
      cards.push(`<div class="sys-card"><h4>Hot water: ${esc(WH_NAME[m.wk] ?? m.wk)}${a.wh === 'unsure' ? ' (assumed)' : ''}</h4>
        <p class="small">About <b>${money(m.waterCost)}/yr</b> for a household of three near ${esc(R.name)} (cold water arrives at about ${m.water.inletC.toFixed(0)} °C here).${alts.length ? ' Alternatives: ' + alts.join('; ') + '.' : ''}</p>
        <p class="small"><a href="/ca/learn/water-heaters/">Water heaters compared →</a></p></div>`);
    }
    if (m.acKwh > 0) {
      const ep = R.prices.electricity.now;
      const old = a.ac === 'central-old';
      cards.push(`<div class="sys-card"><h4>Cooling: ${esc(m.acNote)}</h4>
        <p class="small">About <b>${Math.round(m.acKwh).toLocaleString('en-CA')} kWh</b> a summer (${money(m.acKwh * ep)}) with ${R.cdd} cooling degree-days near ${esc(R.name)}.${old ? ' An older central air conditioner is a natural time to switch to a heat pump: one unit then cools and heats.' : ''}</p>
        <p class="small"><a href="/ca/learn/air-conditioning/">Air conditioning and cooling →</a></p></div>`);
    }
    if (a.win !== 'unsure') {
      const wk = winKey(a.win, a.age);
      const msg = (wk === 'single' || wk === 'singleStorm')
        ? 'Single glazing loses far more heat than an insulated wall, so replacement can pay here, but air sealing, attic and basement work usually pay faster. Storm windows are a cheaper middle step.'
        : wk === 'doubleClear'
          ? 'Older double-pane windows still work; replacing them mostly buys comfort and quiet. Do it when they fail or at a renovation, and seal around frames now.'
          : 'Your windows are already efficient; caulk and weatherstrip, and spend elsewhere first.';
      cards.push(`<div class="sys-card"><h4>Windows: ${esc((MODEL.envelope.windowU as any)[wk]?.label ?? wk)}</h4><p class="small">${msg}</p><p class="small"><a href="/ca/learn/windows-doors/">Windows and doors: when upgrades pay →</a></p></div>`);
    }
    if (a.sec.includes('woodstove') || ['wood', 'outdoorwood', 'pellet'].includes(a.heat)) {
      cards.push(`<div class="sys-card"><h4>Wood heat</h4><p class="small">Have a WETT-certified inspector check the stove, chimney and clearances (insurers usually ask), sweep as needed, and keep a working CO alarm. Wood and pellet costs vary too much to estimate; enter yours in the <a href="/ca/calculators/energy-costs/${esc(R.slug)}/">energy cost calculator</a>.</p><p class="small"><a href="/ca/tests/wood-burning-inspection/">Wood-burning inspections →</a></p></div>`);
    }
    if (a.sec.includes('spaceheaters')) {
      const ep = R.prices.electricity.now;
      cards.push(`<div class="sys-card"><h4>Electric space heaters</h4><p class="small">A 1,500 W heater costs about ${money(1.5 * ep * 100)} per 100 hours near ${esc(R.name)}. Needing one usually points to a draft, a cold room over a garage, or a duct problem worth finding.</p></div>`);
    }
    if (a.sec.includes('solar')) {
      cards.push(`<div class="sys-card"><h4>Free heat from the sun</h4><p class="small">Sunny south windows supply real heat on clear winter days. Our estimate allows for typical solar gain; if your bills come in lower than the typical range, this is one reason. Keep low-e coatings in mind when replacing south glass.</p><p class="small"><a href="/ca/learn/heating-systems/">Heating systems and solar gain →</a></p></div>`);
    }
    if (a.prev === 'recent' || a.prev === 'older') {
      const rule = isON
        ? `Ontario’s Home Renovation Savings needs a first assessment dated January 28, 2025 or later, done by the same approved organization as the follow-up${a.prev === 'older' ? ', and renovations since your old report change the numbers' : ''}.`
        : `Whether it counts for rebates depends on your province’s program, so ask before any work starts${a.prev === 'older' ? '; renovations since your old report change the numbers' : ''}.`;
      cards.push(`<div class="sys-card prev"><h4>You’ve had an evaluation before</h4><p class="small">Dig out the report: its upgrade list and blower-door number are still useful for planning. ${rule}</p><p class="small"><a href="/ca/learn/previous-audit/">What an old EnerGuide report is still good for →</a></p></div>`);
    }
    el.innerHTML = cards.length ? `<div class="rsec"><h3>Your home’s systems</h3><p class="sub">Estimated at ${esc(R.name)}-area prices. Every number has a calculator behind it, pre-filled for your city.</p><div class="sys-grid">${cards.join('')}</div></div>` : '';
  }

  function renderMethod(m: ReturnType<typeof houseModel>, cal: any) {
    const R = m.R;
    $('#rMethod').innerHTML = `
      <details class="card card-pad method">
        <summary><strong>How we got these numbers</strong> <span class="small">(and why they’re conservative)</span></summary>
        <p class="small">${R.exact ? `Your postal code matched ${esc(R.name)}` : `Your postal code isn’t in one of the 70 cities we cover, so we used ${esc(R.name)}, the closest covered city`}: ${R.hdd.toLocaleString('en-CA')} heating degree-days (NRCan HOT2000 weather data, the same data EnerGuide evaluations use) and local energy prices with taxes. A typical house like yours needs about <b>${Math.round(m.demand)} GJ</b> of heat a year (NRCan’s heating need per square metre for your era, scaled to the local climate).${cal.calibrated ? ` Your bills point to about <b>${Math.round(cal.actualDemandGJ)} GJ</b>, so we scaled every saving by ${cal.factor.toFixed(2)}${cal.clamped ? ' (we cap the scaling between 0.5 and 1.6)' : ''}.` : ' Without your bills, we use the typical figure.'}</p>
