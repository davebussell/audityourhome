      html = `<div class="card province-note"><h3>Programs in ${esc(loc.province)}</h3><p class="small">${PROVINCE_NOTES[loc.province] ?? 'Provincial programs vary — check your utility.'}</p><p class="small">${FED_HP_NOTE}</p><p class="small"><a href="/ca/programs/">See the full program tracker →</a></p></div>`;
