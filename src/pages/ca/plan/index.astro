    // HRSP-approved organizations first (only their assessments earn the $600 rebate); the first
    // few show, the rest fold away so the request form isn't buried on a phone.
    const sorted = [...all].sort((x: any, y: any) => Number(!!y.hrsApproved) - Number(!!x.hrsApproved));
    const FIRST = 4;
    const card = (p: any) => `
      <div class="mini-provider">
        <a href="/ca/providers/${p.slug}/">${esc(p.name)}</a>
        <p class="reg">✓ ${esc(p.registration)}</p>
        <p class="pr">${p.hrsApproved ? '<span class="chip chip-active">HRSP-approved: Yes</span>' : '<span class="chip chip-neutral">HRSP-approved: No</span>'}</p>
        ${p.pricing ? `<p class="pr">${esc(p.pricing)}</p>` : ''}
        ${p.phone ? `<p class="pr"><a href="tel:${p.phone.replace(/[^0-9+]/g, '')}">${esc(p.phone)}</a></p>` : ''}
        <p class="rev">Reviews:
          <a href="${p.reviews.google}" rel="noopener nofollow" target="_blank">Google</a> ·
          <a href="${p.reviews.homestars}" rel="noopener nofollow" target="_blank">HomeStars</a> ·
          <a href="${p.reviews.bbb}" rel="noopener nofollow" target="_blank">BBB</a>
        </p>
      </div>`;
    const rest = sorted.slice(FIRST);
    const more = rest.length
      ? `<details class="rsec-collapse">
          <summary>Show the other ${rest.length} advisor${rest.length === 1 ? '' : 's'} in our ${esc(region.name)} directory</summary>
          <div class="mini-providers">${rest.map(card).join('')}</div>
        </details>`
      : '';
    el.innerHTML = `
      <div class="rsec" id="rProvidersList">
        <h3>${all.length} registered advisors in our ${esc(region.name)} directory${count > all.length ? ` (of ${count} NRCan-licensed organizations serving ${esc(cityName)})` : ''}</h3>
        <p class="sub">Every listing is a licensed service organization. Only assessments from the seven HRSP-approved organizations qualify for the $600 Home Renovation Savings rebate. <a href="/ca/find/${region.slug}/">Full ${esc(region.name)} directory →</a>${count > all.length ? ` · <a href="/ca/services/home-energy-audit/${esc(ctx.R.slug)}/#providers">See the ${count} licensed organizations serving ${esc(cityName)} →</a>` : ''}</p>
        <div class="mini-providers">${sorted.slice(0, FIRST).map(card).join('')}</div>
        ${more}
      </div>`;
  }

  function renderResources(ctx: Ctx, arch: any) {
    const el = $('#rResources');
    const region = ctx.isON ? ctx.loc.region : null;
    const cityName = ctx.city?.n ?? ctx.R.name;
    const items: string[] = [];
    if (region) items.push(`<li><a href="/ca/guides/${region.slug}/">The ${esc(region.name)} home energy guide</a>: local housing, rebates and auditors in one place</li>`);
    else items.push(`<li><a href="/ca/cities/${esc(ctx.R.slug)}/">The ${esc(cityName)} home energy guide</a>: local climate, housing, rebates and advisors</li>`);
    items.push(`<li><a href="/ca/provinces/${esc(ctx.provSlug)}/">Home energy in ${esc(ctx.provName)}</a>: every provincial program, with dates</li>`);
    items.push(`<li><a href="/ca/tests/">The complete home testing guide</a>: every test from blower doors to radon, and who does each</li>`);
    items.push(`<li><a href="/ca/how-it-works/">What happens in an EnerGuide evaluation</a>: the visit, step by step</li>`);
    items.push(`<li><a href="/ca/cost/">What an EnerGuide evaluation costs in ${esc(ctx.provName)}</a>: prices and the help available, by province</li>`);
    items.push(`<li><a href="/ca/glossary/">The glossary</a>: every term in this plan, in plain words</li>`);
    items.push(`<li><a href="/ca/programs/">The live program tracker</a>: every rebate verified against official pages</li>`);
    el.innerHTML = `
      <div class="rsec">
        <h3>Resources for your plan</h3>
        <ul class="res-list">${items.join('')}</ul>
      </div>`;
  }

  function renderAuditCta(_ctx: Ctx) {
    // How to book in this province is in "Your next 3 steps" at the top; don't repeat it here.
    $('#rAuditCtaText').textContent = 'Everything above comes from how homes like yours typically perform (scaled to your bills if you entered them), not from measurements of your house. An EnerGuide evaluation, with a blower door test, thermal imaging and a heat-loss model, turns these ranges into numbers for your address, and it’s the first step for the biggest rebates.';
  }

  function prefillLead(arch: any, a: Answers, syms: string[], goals: string[], ctx: Ctx, testsList: string[], m: ReturnType<typeof houseModel>, water: string) {
    const where = ctx.R.exact ? `${ctx.R.name}, ${ctx.provName}` : ctx.R.prov === ctx.loc.province ? `${ctx.provName} (near ${ctx.R.name})` : ctx.provName;
    const lines = [
      'My AuditYourHome plan summary:',
      `• Home: built ${LABEL.era[a.age]}, ${LABEL.htype[a.htype] ?? a.htype}, ${LABEL.size[a.size] ?? a.size}, heated by ${LABEL.heat[a.heat] ?? a.heat} (${LABEL.hage[a.hage] ?? a.hage}), in ${where}`,
      `• Water heater: ${a.wh === 'unsure' ? 'not sure' : (WH_NAME[whKey(a.wh, m.hi)] ?? a.wh)}; cooling: ${LABEL.ac[a.ac] ?? a.ac}; windows: ${LABEL.win[a.win] ?? a.win}; ${LABEL.water[water] ?? water}`,
      a.prev === 'recent' || a.prev === 'older' ? `• Previous EnerGuide evaluation: ${LABEL.prev[a.prev]}` : '',
      syms.length ? `• Concerns: ${syms.map((s) => SYMPTOM_LABEL[s] ?? s).join(', ')}` : '',
      goals.length ? `• Goals: ${goals.map((g) => LABEL.goal[g] ?? g).join(', ')}` : '',
      `• Tests to include in the evaluation: ${testsList.join('; ')}`,
      `• Full plan: ${location.href}`,
    ].filter(Boolean);
    const summary = lines.join('\n');
    const lf = document.getElementById('lead-form');
    if (!lf) return;
    const ta = lf.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
    if (ta) ta.value = summary;
    const pc = lf.querySelector<HTMLInputElement>('input[name="postal"]');
    const chk = checkPostal(postalEl.value);
    // Fill (or refresh after "Edit answers") unless the visitor typed their own value into the form.
    if (pc && chk.ok && (!pc.value || pc.dataset.prefilled === '1')) {
      pc.value = formatPostal(postalEl.value);
      pc.dataset.prefilled = '1';
      pc.addEventListener('input', () => { delete pc.dataset.prefilled; }, { once: true });
    }
    const reg = lf.querySelector<HTMLSelectElement>('select[name="region"]');
    if (reg) {
      const want = ctx.isON && ctx.loc.region ? ctx.loc.region.slug : LEAD_AREA[ctx.loc.province];
      if ([...reg.options].some((o) => o.value === want)) reg.value = want;
    }
    const bld = lf.querySelector<HTMLSelectElement>('select[name="building"]');
    if (bld) bld.value = a.htype === 'condo' ? 'condo-unit' : 'house';
    const mailto = lf.querySelector<HTMLAnchorElement>('a[href^="mailto:"]');
    if (mailto) {
      const base = mailto.href.split('&body=')[0];
      mailto.href = `${base}&body=${encodeURIComponent(summary)}`;
    }
  }

  // ---------- sticky next-step bar on phones (text and target set in renderNext) ----------
  let stickyObs: IntersectionObserver | null = null;
  function setupSticky() {
    stickyObs?.disconnect();
    const onResults = !resultsEl.hidden;
    const mq = window.matchMedia('(max-width: 760px)');
    const targets = ['next-steps', 'lead-form'].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    if (!onResults || !targets.length) { stickyCta.hidden = true; document.body.classList.remove('has-sticky'); return; }
    const visible = new Set<Element>();
    const update = () => {
      const show = mq.matches && visible.size === 0;
      stickyCta.hidden = !show;
      document.body.classList.toggle('has-sticky', show);
    };
    stickyObs = new IntersectionObserver((entries) => {
      for (const en of entries) { if (en.isIntersecting) visible.add(en.target); else visible.delete(en.target); }
      update();
    }, { threshold: 0.05 });
    targets.forEach((t) => stickyObs!.observe(t));
    mq.addEventListener?.('change', update);
    update();
  }

  // ---------- edit / restart / share ----------
  document.getElementById('editTopBtn')?.addEventListener('click', () => document.getElementById('editBtn')?.click());
  document.getElementById('editBtn')?.addEventListener('click', () => {
    setMode('wizard');
    maxVisited = TOTAL;
    setupSticky();
    show(1);
    plannerEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  document.getElementById('restartBtn')?.addEventListener('click', () => {
    setMode('wizard');
    form.reset();
    touched.gas = touched.elec = touched.other = false;
    syncHeatAge();
    setPostalError('');
    maxVisited = 1;
    history.replaceState(null, '', location.pathname);
    setupSticky();
    show(1);
    plannerEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  document.getElementById('copyLink')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(location.href);
      btn.textContent = 'Link copied ✓';
      setTimeout(() => (btn.textContent = 'Copy link to this plan'), 2000);
    } catch { btn.textContent = location.href; }
  });

  // ---------- prefill from the address (quick start, screener, shared plans) ----------
  (function prefill() {
    const q = initial;
    if (![...q.keys()].length) { show(1); return; }
    const set = (name: string, val: string | null) => {
      if (!val) return;
      const radio = form.querySelector<HTMLInputElement>(`[name="${name}"][value="${CSS.escape(val)}"]`);
      if (radio) radio.checked = true;
      else {
        const input = form.querySelector<HTMLInputElement | HTMLSelectElement>(`input[name="${name}"]:not([type=radio]):not([type=checkbox]), select[name="${name}"]`);
        if (input) input.value = val;
      }
    };
    set('postal', q.get('postal'));
    set('prov', q.get('prov'));
    set('age', q.get('age'));
    set('htype', q.get('htype'));
    set('size', q.get('size'));
    set('heat', q.get('heat'));
    set('hage', q.get('hage'));
    set('wh', q.get('wh'));
    set('ac', q.get('ac'));
    set('win', q.get('win'));
    set('prev', q.get('prev'));
    set('water', q.get('water'));
    set('gasBill', q.get('gas'));
    set('elecBill', q.get('elec'));
    set('otherBill', q.get('other'));
    if (q.get('gas')) touched.gas = true;
    if (q.get('elec')) touched.elec = true;
    if (q.get('other')) touched.other = true;
    (q.get('sec') ?? '').split(',').filter(Boolean).forEach((v) => set('sec', v));
    (q.get('sym') ?? '').split(',').filter(Boolean).forEach((v) => set('sym', v));
    if (q.has('goal')) {
      form.querySelectorAll<HTMLInputElement>('input[name="goal"]').forEach((g) => (g.checked = false));
      (q.get('goal') ?? '').split(',').filter(Boolean).forEach((v) => set('goal', v));
    }
    syncHeatAge();
    const located = checkPostal(postalEl.value).ok || Boolean(provEl.value);
    if (q.get('done') === '1' && q.get('age') && located) { maxVisited = TOTAL; finish(); return; }
    if (located) {
      // Arriving from the home page quick start (or a partial link): the location is settled, carry on at step 2,
      // and bring the wizard into view (on phones the intro fills the first screen).
      maxVisited = 2;
      show(2);
      if (plannerEl.getBoundingClientRect().top > window.innerHeight * 0.4) plannerEl.scrollIntoView({ behavior: 'auto', block: 'start' });
      return;
    }
    show(1);
    if (postalEl.value) validate(1);
  })();
</script>
