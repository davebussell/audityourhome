  function renderPrograms(loc: any, goals: string[], isON: boolean, isToronto: boolean) {
    const el = $('#rPrograms');
    const byId = (id: string) => D.programs.find((p: any) => p.id === id);
    let html = '';
    if (loc.kind === 'us') {
      html = `<div class="card province-note"><h3>US launch is coming</h3><p class="small">Our US directory (HOMES-rebate states and audit-ordinance cities first) is in the works. Meanwhile: your utility may offer a free or cheap assessment — check before paying for one.</p></div>`;
