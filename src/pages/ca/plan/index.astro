  type TestPick = { id: string; name: string; why: string; href: string; icon?: string; establishes?: string; cost?: string; health?: boolean; level?: string };
  function testPicks(age: string, heat: string, syms: string[], goals: string[], htype: string, water: string, heatAnswer: string, isON: boolean): TestPick[] {
    if (htype === 'condo') return [];
    const E = Object.fromEntries(D.tests.energy.map((t: any) => [t.id, t]));
    const H = Object.fromEntries(D.tests.health.map((t: any) => [t.id, t]));
    const older = ['pre-1946', '1946-1965', '1966-1980'].includes(age);
    const newer = ['1981-1995', '1996-2010', '2011-plus'].includes(age);
    const fuel = heat === 'gas' || heat === 'oil';
    const out: TestPick[] = [];
    const add = (t: any, why: string) => out.push({ id: t.id, name: t.name, why, href: `/ca/tests/${t.id}/`, icon: t.icon, establishes: t.establishes, cost: t.cost });
    add(E['blower-door'], older ? 'Your era’s biggest unknown is air leakage. This puts a number on it and finds the entry points.' : 'Verifies the airtightness your home’s era promises; builders miss spots.');
    add(E['thermal-imaging'], syms.includes('drafty-rooms') ? 'Finds the cold walls you flagged without opening anything.' : 'Maps exactly which cavities are empty before you pay to fill them.');
    if (older || syms.includes('ice-dams')) add(E['attic-inspection'], syms.includes('ice-dams') ? 'Ice dams start in the attic: bypasses and thin insulation show up immediately.' : 'Often the cheapest big win for your era, and this scopes it precisely.');
    if (fuel) add(E['combustion-safety'], 'You heat with combustion: tightening the house requires this safety check first.');
    if (goals.includes('heatpump') || heat === 'electric' || heat === 'oil' || syms.includes('summer-overheating') || syms.includes('humid-summer')) add(E['heat-loss-calc'], heat === 'electric' ? 'Turns baseboard-to-heat-pump savings from a guess into a sized quote.' : 'Sizes a heat pump or air conditioner properly before anyone quotes you; oversizing is the industry’s favourite mistake.');
    if ((syms.includes('cold-second-floor') || syms.includes('summer-overheating')) && heat !== 'electric') add(E['duct-leakage'], 'Hot or cold upstairs rooms usually come down to the ducts. Measure before buying bigger equipment.');
    if (syms.includes('condensation-mould') || syms.includes('window-frost') || syms.includes('smoke') || newer) add(E['ventilation-assessment'], syms.includes('condensation-mould') || syms.includes('window-frost') ? 'Condensation is usually a ventilation problem, not a window problem. This proves which before you spend on glass.' : syms.includes('smoke') ? 'Checks how fresh air gets in and whether it can be filtered on smoke days.' : 'Tighter eras need verified ventilation: humidity problems sneak up.');
    add(E['bill-analysis'], 'Bring 12 months of bills to the evaluation: it anchors every projection to your reality.');
    const scrHeat = heatAnswer === 'propane' ? 'oil' : heat;
    const flags = screenSpecialtyTests({ era: age, heat: scrHeat, water, symptoms: syms, goals, htype });
    for (const f of flags) {
      const t = H[f.id] ?? {};
      out.push({ id: f.id, name: f.name, why: localizeScreener(f.id, f.why, isON), href: f.guide, icon: t.icon, cost: t.cost, health: true, level: f.level });
    }
    checklist = out.map((p) => p.name);
    return out;
  }

  function readingDetails(id: string): string {
    const g = D.reading[id];
    if (!g) return '';
    const bands = g.bands.map((b: any) => `<li class="t-${esc(b.t)}"><span class="tr-l">${esc(b.l)}</span> <span class="tr-r">${esc(b.r)}</span><br>${esc(b.m)} <b>What to do:</b> ${esc(b.d)}</li>`).join('');
    return `<details class="tread"><summary>How to read the result</summary><p class="small">${esc(g.measure)}</p><ul>${bands}</ul></details>`;
  }
  function healthCost(id: string, cost: string | undefined, isON: boolean) {
    if (!cost) return '';
    if (id === 'well-water' && !isON) return 'Bacteria tests: ask your provincial public health lab · $100–$300 for extended panels';
    return cost;
  }

