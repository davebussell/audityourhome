  input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 24px; height: 24px; border-radius: 50%; background: var(--heat); border: 3px solid #fff; box-shadow: 0 1px 4px rgba(26,36,48,0.3); cursor: pointer; }
  input[type='range']::-moz-range-thumb { width: 20px; height: 20px; border-radius: 50%; background: var(--heat); border: 3px solid #fff; box-shadow: 0 1px 4px rgba(26,36,48,0.3); cursor: pointer; }
  input[type='range']:focus-visible { outline: 2.5px solid var(--heat); outline-offset: 4px; }
  .res-list { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 9px; }
  .res-list li { font-size: 15px; padding-left: 22px; position: relative; }
  .res-list li::before { content: "→"; position: absolute; left: 0; color: var(--heat); font-weight: 700; }
  .sys-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-top: 12px; }
  .sys-card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; min-width: 0; }
  .sys-card h4 { margin: 0 0 6px; font-size: 16px; }
  .sys-card p:last-child { margin-bottom: 0; }
  .sys-card.prev { border-left: 4px solid var(--steel); }
  .method { margin: 18px 0; }
  .method summary { cursor: pointer; }
  .method p { margin: 10px 0 0; }
  .save-range { font-weight: 400; color: var(--muted); }
  .save-neg { color: var(--heat-deep); font-weight: 600; }
  .save-small { color: var(--muted); font-weight: 400; }
  .bill-note { margin-top: 14px; max-width: 70ch; }
  /* next steps */
  .next-steps { border-top: 4px solid var(--heat); padding: 24px 26px; margin: 18px 0 22px; }
  .next-steps h3 { margin-bottom: 12px; }
  .ns-list { list-style: none; counter-reset: ns; margin: 0; padding: 0; display: grid; gap: 16px; }
  .ns-list > li { counter-increment: ns; position: relative; padding-left: 44px; }
  .ns-list > li::before {
    content: counter(ns); position: absolute; left: 0; top: 0; width: 30px; height: 30px; border-radius: 50%;
    background: var(--navy); color: #fff; font: 800 15px/30px var(--display); text-align: center;
  }
  .ns-list p { margin: 0 0 6px; font-size: 15px; }
  .ns-t { font-family: var(--display); font-weight: 800; font-size: 17px !important; }
  .ns-cost { color: var(--muted); font-size: 14px !important; }
  .ns-cta { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; margin-top: 8px !important; }
  .ns-tests { display: flex; flex-wrap: wrap; gap: 6px; }
  .ns-tests a { font-size: 13.5px; padding: 4px 11px; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--steel); text-decoration: none; background: #fff; }
  .ns-tests a:hover { border-color: var(--steel); }
  .ns-progs { margin: 0; padding-left: 1.1em; display: grid; gap: 4px; font-size: 15px; }
  /* climate */
  .climate-box { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 24px; }
  .cb-k { margin: 0 0 6px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 13.5px; color: var(--muted); }
  .cb-chip { display: inline-block; padding: 3px 10px; border-radius: 999px; background: var(--heat-tint); color: var(--heat-deep); font-weight: 700; font-size: 12.5px; letter-spacing: 0.02em; text-transform: uppercase; }
  .cb-one { font-weight: 600; font-size: 16.5px; margin: 0 0 8px; }
  .cb-list { margin: 10px 0; padding-left: 1.2em; display: grid; gap: 8px; font-size: 15px; }
  .cb-ask { color: var(--pine-deep); }
  /* concerns */
  .concern-list { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); margin-top: 12px; }
  .concern { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; min-width: 0; }
  .concern h4 { margin: 0 0 8px; font-size: 16px; }
  .concern p { margin: 0 0 6px; font-size: 14.5px; }
  .concern .k { font-weight: 700; }
  @media (max-width: 600px) {
    .next-steps { padding: 20px 18px; }
    .seq-item { padding: 16px 16px 16px 52px; }
    .seq-item::before { left: 14px; }
    .climate-box { padding: 18px; }
  }
</style>

<script>
  import { screenSpecialtyTests } from '../../../lib/screener';
  import {
    baselineDemandGJ, floorAreaM2, heatingCost, calibrate, geometry, atticMeasure, atticTargetR, wallMeasure,
    basementMeasure, windowMeasure, airMeasure, setbackMeasure, savingValue, waterHeatingDemand, waterHeaterCost,
    coolingKwh, defaultAcTons, rebateAmount, payback, MODEL,
  } from '../../../lib/calc/engine';
  import type { SystemKey, Vintage, WindowKey, WaterHeaterKey, Prices, RebateEntry } from '../../../lib/calc/engine';
  import {
    checkPostal, formatPostal, PROV_NAME, PROV_SLUG, LEAD_AREA, LABEL, ERA_NOTE, SYMPTOMS, SYMPTOM_LABEL, EXTRA_CONCERNS,
    localize, localizeCost, localizeSummary, localizeScreener, watchFor, heatPumpCopy, heatPumpLaterNote, sentences,
  } from '../../../lib/ca/plan-helpers';
  import type { ProvCode, ClimateFlags } from '../../../lib/ca/plan-helpers';

  const D = JSON.parse(document.getElementById('planner-data')!.textContent!);

  const form = document.getElementById('plannerForm') as HTMLFormElement;
  const stepsNav = document.getElementById('stepsNav')!;
  const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement;
  const backBtn = document.getElementById('backBtn') as HTMLButtonElement;
  const resultsEl = document.getElementById('results')!;
  const plannerEl = document.getElementById('planner')!;
  const introEl = document.getElementById('planIntro');
  /** One journey bar at a time: the intro's (stage 1) while answering, the results' (stage 2) after. */
  function setMode(mode: 'wizard' | 'results') {
    plannerEl.hidden = mode === 'results';
    resultsEl.hidden = mode !== 'results';
    if (introEl) introEl.hidden = mode === 'results';
  }
  const postalEl = document.getElementById('postal') as HTMLInputElement;
  const provEl = document.getElementById('provPick') as HTMLSelectElement;
  const postalErr = document.getElementById('postalError')!;
  const matchLine = document.getElementById('matchLine')!;
  const stepCount = document.getElementById('stepCount')!;
  const stickyCta = document.getElementById('stickyCta')!;
  const TOTAL = 6;
  let step = 1;
  let maxVisited = 1;
  /** The upgrade sequence as shown, for saving to My Home. */
  let lastItems: Record<string, unknown>[] = [];
  /** Test names for the checklist (both copy buttons use it). */
  let checklist: string[] = [];

  const $ = (sel: string, root: ParentNode = document) => root.querySelector(sel) as HTMLElement;
  const esc = (s: string) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const money = (n: number) => '$' + (Math.round(n / 10) * 10).toLocaleString('en-CA');

  const PROVINCE_NOTES: Record<string, string> = {
    QC: 'Since October 1, 2026, Quebec’s <b>Rénoclimat</b> makes the EnerGuide evaluation optional (up to $500 back toward it) and pays for roof, wall and foundation insulation and ENERGY STAR Most Efficient windows; <b>Hydro-Québec LogisVert</b> pays for heat pumps. <a href="/ca/programs/renoclimat/">Rénoclimat 2026 →</a> · <a href="/ca/provinces/quebec/">Quebec guide →</a>',
    MB: '<b>Efficiency Manitoba</b> pays a $400 EnerGuide evaluation rebate, insulation rebates by R-value, $100 per triple-pane ENERGY STAR window or door and up to $2,000 for a cold-climate heat pump. <a href="/ca/programs/efficiency-manitoba-rebates/">Manitoba rebates →</a>',
    NB: 'New Brunswick’s <b>Total Home Energy Savings Program</b> starts with a Home Energy Evaluation ($99 + HST for both visits) and pays published amounts for insulation, air sealing, windows and heat pumps. <a href="/ca/programs/nb-total-home-energy-savings/">NB program →</a>',
    NS: '<b>Efficiency Nova Scotia</b> runs a $199 home energy assessment (waived under its income threshold) with rebates for insulation, air sealing and heat pumps; the federal oil-to-heat-pump intake closed July 2, 2026. <a href="/ca/programs/efficiency-nova-scotia-rebates/">Nova Scotia rebates →</a>',
    PE: 'efficiencyPEI offers <b>$99 + HST</b> home energy assessments and pays for insulation, air sealing and windows ($125 per opening). Its heat pump rebates ended April 15, 2026. <a href="/ca/programs/efficiency-pei-rebates/">PEI rebates →</a>',
    BC: 'BC’s <b>Home Renovation Rebate</b> pays for insulation, windows and heat pump water heaters, and heat pumps when they replace electric heat (more in the north); the income-tiered <b>CleanBC Energy Savings Program</b> pays more. <a href="/ca/programs/cleanbc-energy-savings-program/">CleanBC rebates →</a> · <a href="/ca/provinces/bc/">BC guide →</a>',
    AB: 'Alberta has no provincial home rebate. <b>Clean Energy Improvement (CEIP)</b> financing runs in some municipalities and requires an EnerGuide evaluation (Calgary closed until winter 2026/27, Edmonton waitlisting). <a href="/ca/articles/alberta-energy-efficiency-rebates/">Alberta rebates in 2026 →</a>',
    SK: 'Saskatchewan’s Home Efficiency Retrofit Rebate ended in April 2026. The provincial <b>Home Renovation Tax Credit</b> (10.5% of eligible costs above $1,000, up to $420) still applies. <a href="/ca/articles/saskatchewan-energy-efficiency-rebates/">Saskatchewan options in 2026 →</a>',
    NL: '<b>takeCHARGE</b> pays insulation and air sealing rebates, and the Oil to Electric program pays up to $9,000 for a central heat pump ($22,000 if income-qualified). <a href="/ca/programs/takecharge-nl/">takeCHARGE NL →</a>',
    NT: 'The <b>Arctic Energy Alliance</b> runs EnerGuide evaluations ($200 + GST) and pays insulation and wood or pellet stove rebates. <a href="/ca/provinces/north/">Territories guide →</a>',
    YT: 'Yukon’s <b>Good Energy</b> rebates pay half of a heat pump (up to $10,500) plus insulation, air sealing and window rebates. <a href="/ca/provinces/north/">Territories guide →</a>',
    NU: 'Nunavut homeowner support runs through the <b>Nunavut Housing Corporation</b>. <a href="/ca/provinces/north/">Territories guide →</a>',
  };

  // ---------- state lives in the address after # (never the query string, which analytics and logs can see) ----------
  function readState(): URLSearchParams {
    const h = location.hash.replace(/^#/, '');
    if (h && /(^|&)(postal|age|prov|heat|sym|done)=/.test(h)) return new URLSearchParams(h);
    if (location.search) {
      const q = new URLSearchParams(location.search);
      if ([...q.keys()].length) {
        history.replaceState(null, '', location.pathname + '#' + q.toString());
        return q;
      }
    }
    return new URLSearchParams();
  }
  const initial = readState();

  // In-page links (#lead-form, #assumptions …) would overwrite the plan in the address: scroll instead.
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('a[href^="#"]') as HTMLAnchorElement | null;
    if (!a) return;
    const id = a.getAttribute('href')!.slice(1);
    if (!id) return;
    const t = document.getElementById(id);
    if (!t) return;
    e.preventDefault();
    if (t instanceof HTMLDetailsElement) t.open = true;
    t.scrollIntoView({ behavior: 'smooth', block: 'start' });
    if (!t.hasAttribute('tabindex')) t.setAttribute('tabindex', '-1');
    t.focus({ preventScroll: true });
  });

  // ---------- wizard navigation ----------
  function show(n: number) {
    step = n;
    maxVisited = Math.max(maxVisited, n);
    form.querySelectorAll('fieldset.step').forEach((f) => f.classList.toggle('on', (f as HTMLElement).dataset.step === String(n)));
    stepsNav.querySelectorAll('li').forEach((li) => {
      const s = Number((li as HTMLElement).dataset.step);
      li.classList.toggle('on', s === n);
      li.classList.toggle('done', s < n || (s <= maxVisited && s !== n));
      const b = li.querySelector('button') as HTMLButtonElement;
      b.disabled = s > maxVisited || s === n;
      if (s === n) b.setAttribute('aria-current', 'step'); else b.removeAttribute('aria-current');
    });
    stepCount.textContent = `Step ${n} of ${TOTAL}`;
    nextBtn.textContent = n === TOTAL ? 'See my plan' : 'Next';
    backBtn.textContent = n === 1 ? '← Back' : 'Back';
    if (n === 4) syncSymptoms();
    if (n === 6) initBillSliders();
    if (n > 1) updateMatchLine(); else { matchLine.hidden = true; updatePostalMatch(); }
    form.querySelectorAll('.field-error:not(#postalError)').forEach((el) => el.remove());
    const first = form.querySelector<HTMLElement>(`fieldset[data-step="${n}"] input`);
    first?.focus({ preventScroll: true });
  }

  function fieldVal(name: string): string {
    const el = form.querySelector<HTMLInputElement>(`[name="${name}"]:checked, input[name="${name}"]:not([type=radio]):not([type=checkbox]), select[name="${name}"]`);
    return el?.value.trim() ?? '';
  }
  function multiVal(name: string): string[] {
    return [...form.querySelectorAll<HTMLInputElement>(`[name="${name}"]:checked`)].map((el) => el.value);
  }

  function setPostalError(html: string) {
    postalErr.innerHTML = html;
    postalErr.hidden = !html;
    postalEl.setAttribute('aria-invalid', html ? 'true' : 'false');
  }

  function validate(n: number): boolean {
    if (n === 1) {
      const chk = checkPostal(postalEl.value);
      const prov = provEl.value;
      if (chk.ok) { setPostalError(''); return true; }
      if (chk.reason === 'us-zip') {
        const ageNow = fieldVal('age');
        setPostalError(`That looks like a US ZIP code. <a href="/us/plan/#zip=${encodeURIComponent(chk.zip)}${ageNow ? `&age=${encodeURIComponent(ageNow)}` : ''}">Open the US planner with ${esc(chk.zip)} →</a>`);
        return false;
      }
      if (prov) { setPostalError(''); return true; }
      setPostalError(chk.reason === 'empty'
        ? 'Enter your postal code (the first three characters are enough), or choose your province below.'
        : 'That doesn’t look like a Canadian postal code. It should look like A1A 1A1, or just A1A. You can also choose your province below.');
      postalEl.focus();
      return false;
    }
    if (n === 2 && !fieldVal('age')) {
      const fs = form.querySelector(`fieldset[data-step="2"] .field`)!;
      if (!fs.querySelector('.field-error')) {
        const err = document.createElement('p');
        err.className = 'field-error';
        err.textContent = 'Pick the closest era. A rough guess still produces a good plan.';
        fs.appendChild(err);
      }
      return false;
    }
    return true;
  }

  nextBtn.addEventListener('click', () => {
    if (!validate(step)) return;
    if (step < TOTAL) show(step + 1);
    else finish();
  });
  backBtn.addEventListener('click', () => {
    if (step > 1) return show(step - 1);
    // Step 1: back to wherever the visitor came from on this site, else the home page.
    let sameSite = false;
    try { sameSite = Boolean(document.referrer) && new URL(document.referrer).origin === location.origin; } catch {}
    if (sameSite && history.length > 1) history.back();
    else location.href = '/ca/';
  });
  stepsNav.addEventListener('click', (e) => {
    const b = (e.target as Element).closest('button[data-go]') as HTMLButtonElement | null;
    if (!b || b.disabled) return;
    const n = Number(b.dataset.go);
    if (n > step && !validate(step)) return;
    show(n);
  });
  postalEl.addEventListener('input', () => { if (!postalErr.hidden) setPostalError(''); });
  provEl.addEventListener('change', () => { if (provEl.value) setPostalError(''); });
  form.addEventListener('submit', (e) => e.preventDefault());

  // ---------- location → covered city, climate profile ----------
  type Loc = { kind: 'ca'; fsa: string | null; province: ProvCode; region: any | null } | { kind: 'none' };
  function readLoc(): Loc {
    const chk = checkPostal(postalEl.value);
    if (chk.ok) {
      const region = chk.province === 'ON' ? D.regions.find((r: any) => r.fsa.some((p: string) => chk.fsa.startsWith(p))) ?? null : null;
      return { kind: 'ca', fsa: chk.fsa, province: chk.province, region };
    }
    const prov = provEl.value as ProvCode;
    if (prov) return { kind: 'ca', fsa: null, province: prov, region: null };
    return { kind: 'none' };
  }

  type Region = { slug: string; exact: boolean; name: string; prov: string; hdd: number; cdd: number; dc: number; am: number; prices: Prices };
  function regionFor(loc: Loc): Region {
    const C = D.calc;
    let slug: string | null = null;
    let exact = false;
    if (loc.kind === 'ca') {
      if (loc.fsa) {
        slug = C.fsa[loc.fsa] ?? null;
        exact = Boolean(slug);
        if (!slug) slug = nearestByFsa(loc.fsa);
      }
      if (!slug) slug = C.provRep[loc.province] ?? null;
    }
    if (!slug || !C.cities[slug]) slug = 'toronto';
    const c = C.cities[slug];
    return { slug, exact, name: c.n, prov: c.p, hdd: c.hdd, cdd: c.cdd, dc: c.dc, am: c.am, prices: c.pr };
  }

  /** Rural and uncovered postal areas: pick a covered city in the same part of the province. */
  function nearestByFsa(fsa: string): string | null {
    const a = fsa[0], b = fsa[1], ab = fsa.slice(0, 2);
    const M: Record<string, string> = {
      K: 'ottawa', N: 'london', P: 'sudbury', L: b === '0' ? 'barrie' : 'toronto', M: 'toronto',
      G: ab === 'G7' ? 'saguenay' : 'quebec-city', H: 'montreal', J: ab === 'J8' || ab === 'J9' ? 'gatineau' : 'sherbrooke',
      V: b === '0' ? 'kamloops' : 'vancouver',
      T: b === '0' || b === '4' ? 'red-deer' : ['1', '2', '3'].includes(b) ? 'calgary' : 'edmonton',
      S: ['7', '0'].includes(b) ? 'saskatoon' : 'regina',
    };
    if (ab === 'P7') return 'thunder-bay';
    const slug = M[a];
    return slug && D.calc.cities[slug] ? slug : null;
  }

  function climateFor(slug: string) {
    const place = D.climate.places[slug] ?? null;
    const profile = place ? D.climate.profiles[place.profile] ?? null : null;
    return { place, profile, key: place?.profile as string | undefined };
  }
  function flagsFor(slug: string): ClimateFlags {
    const { place } = climateFor(slug);
    return place ? { profile: place.profile, iceDams: place.iceDams, smoke: place.smoke, summerCooling: place.summerCooling } : {};
  }

  /** "Vancouver, British Columbia", "Ontario, near Barrie (the closest city we cover)" or "Nunavut (using Yellowknife’s …)". */
  function placeText(loc: Extract<Loc, { kind: 'ca' }>, R: Region): string {
    const prov = PROV_NAME[loc.province];
    if (R.exact) return `${R.name}, ${prov}`;
    if (loc.fsa && R.prov === loc.province) return `${prov}, near ${R.name} (the closest city we cover)`;
    return `${prov} (using ${R.name}’s climate and prices)`;
  }

  function updateMatchLine() {
    const loc = readLoc();
    if (loc.kind !== 'ca') { matchLine.hidden = true; return; }
    const R = regionFor(loc);
    const { profile } = climateFor(R.slug);
    const parts: string[] = [];
    if (loc.fsa) parts.push(esc(formatPostal(postalEl.value)));
    parts.push(esc(placeText(loc, R)));
    if (profile) parts.push(`${esc(profile.label)} climate`);
    matchLine.innerHTML = `${parts.join(' · ')} · <button type="button" class="linkish" id="changeLoc">Change</button>`;
    matchLine.hidden = false;
    document.getElementById('changeLoc')?.addEventListener('click', () => show(1));
  }

  /** Step 1: confirm what the postal code (or province) matched, as the visitor types. */
  const postalMatch = document.getElementById('postalMatch')!;
  function updatePostalMatch() {
    const loc = readLoc();
    if (loc.kind !== 'ca') { postalMatch.hidden = true; return; }
    const R = regionFor(loc);
    const { profile } = climateFor(R.slug);
    postalMatch.textContent = `✓ ${placeText(loc, R)}${profile ? ` · ${profile.label} climate` : ''}`;
    postalMatch.hidden = false;
  }
  postalEl.addEventListener('input', updatePostalMatch);
  provEl.addEventListener('change', updatePostalMatch);

  function syncSymptoms() {
    const R = regionFor(readLoc());
    const flags = flagsFor(R.slug);
    for (const s of SYMPTOMS) {
      const el = form.querySelector<HTMLElement>(`[data-sym="${s.slug}"]`);
      if (!el) continue;
      const on = s.show(flags);
      el.hidden = !on;
      const box = el.querySelector('input') as HTMLInputElement;
      if (!on && box.checked) box.checked = false;
    }
  }

  // ---------- house model (shared engine with the calculators) ----------
  type HeatInfo = { sys: SystemKey; label: string; screen: string; combustion: boolean; slider: 'gas' | 'elec' | 'other' };
  function heatInfo(heat: string, hage: string, age: string): HeatInfo {
    const newer = hage === 'new' || (hage === 'unsure' && ['1996-2010', '2011-plus'].includes(age));
    switch (heat) {
      case 'gasboiler': return { sys: newer ? 'gasBoilerCondensing' : 'gasBoilerMid', label: 'a gas boiler', screen: 'gas', combustion: true, slider: 'gas' };
      case 'electric': return { sys: 'electricResistance', label: 'electric baseboards', screen: 'electric', combustion: false, slider: 'elec' };
      case 'elecfurnace': return { sys: 'electricResistance', label: 'an electric furnace or boiler', screen: 'electric', combustion: false, slider: 'elec' };
      case 'heatpump': return { sys: hage === 'old' ? 'ashpStandard' : 'ashpCold', label: 'an air-source heat pump', screen: 'heatpump', combustion: false, slider: 'elec' };
      case 'geothermal': return { sys: 'gshp', label: 'a geothermal heat pump', screen: 'heatpump', combustion: false, slider: 'elec' };
      case 'oil': return { sys: hage === 'new' ? 'oilFurnaceNew' : hage === 'old' ? 'oilFurnaceOld' : 'oilFurnaceMid', label: 'oil', screen: 'oil', combustion: true, slider: 'other' };
      case 'propane': return { sys: newer ? 'propaneFurnaceCond' : 'propaneFurnaceStd', label: 'propane', screen: 'oil', combustion: true, slider: 'other' };
      case 'wood': return { sys: hage === 'new' ? 'woodCertified' : 'woodOld', label: 'wood', screen: 'oil', combustion: true, slider: 'other' };
      case 'outdoorwood': return { sys: 'outdoorWoodBoiler', label: 'an outdoor wood boiler', screen: 'oil', combustion: true, slider: 'other' };
      case 'pellet': return { sys: 'pellet', label: 'a pellet stove', screen: 'oil', combustion: true, slider: 'other' };
      default: return { sys: newer ? 'gasFurnaceHigh' : 'gasFurnaceMid', label: 'a gas furnace', screen: 'gas', combustion: true, slider: 'gas' };
    }
  }

  type WhKey = WaterHeaterKey | 'boiler';
  function whKey(wh: string, hi: HeatInfo): WhKey {
    switch (wh) {
      case 'gastank': return 'gasTank';
      case 'gastankless': return 'gasTankless';
      case 'electric': return 'electricTank';
      case 'heatpump': return 'heatPump';
      case 'oil': return 'oilTank';
      case 'boiler': return 'boiler';
    }
    if (hi.slider === 'gas') return 'gasTank';
    if (String(hi.sys).startsWith('oil')) return 'oilTank';
    return 'electricTank';
  }
  const WH_NAME: Record<string, string> = { gasTank: 'gas tank', gasTankless: 'gas tankless', electricTank: 'electric tank', heatPump: 'heat pump water heater', oilTank: 'oil-fired tank', boiler: 'combi boiler', gasCondensing: 'condensing gas tank' };
  function whFuel(k: WhKey, hi: HeatInfo): 'gas' | 'elec' | 'other' {
    if (k === 'boiler') return hi.slider;
    if (k === 'gasTank' || k === 'gasTankless' || k === 'gasCondensing') return 'gas';
    if (k === 'oilTank') return 'other';
    return 'elec';
  }

  function winKey(win: string, age: string): WindowKey {
    const M: Record<string, WindowKey> = { single: 'single', singlestorm: 'singleStorm', 'double-old': 'doubleClear', 'double-new': 'doubleLowE', triple: 'energyStar' };
    return M[win] ?? ((MODEL.envelope.windowByVintage as Record<string, WindowKey>)[age] ?? 'doubleClear');
  }

  type Answers = {
    loc: Loc; age: Vintage; htype: string; size: string; heat: string; hage: string; wh: string; ac: string;
    win: string; prev: string; sec: string[];
  };
  function readAnswers(): Answers {
    return {
      loc: readLoc(),
      age: (fieldVal('age') || '1966-1980') as Vintage,
      htype: fieldVal('htype') || 'detached',
      size: fieldVal('size') || 'medium',
      heat: fieldVal('heat') || 'gas',
      hage: fieldVal('hage') || 'unsure',
      wh: fieldVal('wh') || 'unsure',
      ac: fieldVal('ac') || 'unsure',
      win: fieldVal('win') || 'unsure',
      prev: fieldVal('prev') || 'no',
      sec: multiVal('sec'),
    };
  }

  /** Typical-house model at local climate and prices ('now' = average prices, for bills). */
  function houseModel(a: Answers) {
    const R = regionFor(a.loc);
    const hi = heatInfo(a.heat, a.hage, a.age);
    const area = floorAreaM2({ sizeBand: a.size as any });
    const type = a.htype === 'semi' ? 'semi' : 'detached';
    const demand = baselineDemandGJ({ vintage: a.age, floorAreaM2: area, hdd: R.hdd, type: type as any });
    const heatNow = heatingCost(demand, hi.sys, R.hdd, R.prices, 'now');
    const wk = whKey(a.wh, hi);
    const water = waterHeatingDemand(3, R.am);
    let waterCost: number | null = null;
    let waterUnits = 0;
    if (wk === 'boiler') {
      const c = heatingCost(water.gj, hi.sys, R.hdd, R.prices, 'now');
      waterCost = c.cost; waterUnits = c.units;
    } else {
      const c = waterHeaterCost(wk, water.gj, R.prices, 'now', { sys: hi.sys, hdd: R.hdd });
      waterCost = c.cost; waterUnits = c.units;
    }
    const baseKwh = D.calc.baseKwh * (D.calc.sizeMult[a.size] ?? 1);
    const tons = defaultAcTons(area);
    let acKwh = 0;
    let acNote = '';
    const S = MODEL.cooling.seerByAge as Record<string, number>;
    if (a.ac === 'central-new') { acKwh = coolingKwh({ cdd18: R.cdd, designCool: R.dc, capacityBtuh: tons * 12000, seer: S['2006to2022'] }).kwh; acNote = 'central AC, about SEER 13'; }
    else if (a.ac === 'central-old') { acKwh = coolingKwh({ cdd18: R.cdd, designCool: R.dc, capacityBtuh: tons * 12000, seer: S['1995to2006'] }).kwh; acNote = 'older central AC, about SEER 10'; }
    else if (a.ac === 'heatpump') { acKwh = coolingKwh({ cdd18: R.cdd, designCool: R.dc, capacityBtuh: tons * 12000, seer: MODEL.cooling.heatPumpSeer }).kwh; acNote = 'your heat pump'; }
    else if (a.ac === 'room') { acKwh = coolingKwh({ cdd18: R.cdd, designCool: R.dc, capacityBtuh: MODEL.cooling.room.capacityBtuh, room: true, units: 2 }).kwh; acNote = 'two window units'; }
    const ep = R.prices.electricity.now;
    const bills = { gas: 0, elec: baseKwh * ep + acKwh * ep, other: 0 };
    const heatCost = heatNow.cost ?? 0;
    bills[hi.slider] += heatCost;
    if (waterCost !== null) bills[whFuel(wk, hi)] += waterCost;
    if (hi.slider !== 'gas' && whFuel(wk, hi) !== 'gas') bills.gas = 0;
    return { R, hi, area, type, demand, heatNow, wk, water, waterCost, waterUnits, baseKwh, acKwh, acNote, tons, bills };
  }

  // ---------- bill sliders (pre-set from the house model) ----------
  const gasEl = document.getElementById('gasBill') as HTMLInputElement;
  const elecEl = document.getElementById('elecBill') as HTMLInputElement;
  const otherEl = document.getElementById('otherBill') as HTMLInputElement;
  const touched = { gas: false, elec: false, other: false };
  function fmtOut(el: HTMLInputElement, out: HTMLElement) {
    out.textContent = el.value === '0' ? '$0' : '$' + el.value + '/mo';
  }
  function wireSlider(el: HTMLInputElement, outId: string, key: 'gas' | 'elec' | 'other') {
    const out = document.getElementById(outId)!;
    el.addEventListener('input', () => { touched[key] = true; fmtOut(el, out); });
    fmtOut(el, out);
  }
  wireSlider(gasEl, 'gasOut', 'gas');
  wireSlider(elecEl, 'elecOut', 'elec');
  wireSlider(otherEl, 'otherOut', 'other');
  function syncHeatAge() {
    const h = fieldVal('heat');
    (document.getElementById('heatAgeField') as HTMLElement).hidden = ['electric', 'elecfurnace', 'outdoorwood', 'pellet', 'geothermal'].includes(h);
  }
  form.querySelectorAll('input[name="heat"]').forEach((el) => el.addEventListener('change', syncHeatAge));
  syncHeatAge();
  function billGuesses() {
    const m = houseModel(readAnswers());
    const r5 = (v: number) => String(Math.max(0, Math.round(v / 12 / 5) * 5));
    return { gas: r5(m.bills.gas), elec: r5(m.bills.elec), other: r5(m.bills.other), m };
  }
  function initBillSliders() {
    const g = billGuesses();
    if (!touched.gas) { gasEl.value = g.gas; fmtOut(gasEl, document.getElementById('gasOut')!); }
    if (!touched.elec) { elecEl.value = g.elec; fmtOut(elecEl, document.getElementById('elecOut')!); }
    if (!touched.other) { otherEl.value = g.other; fmtOut(otherEl, document.getElementById('otherOut')!); }
    const usesOther = g.m.hi.slider === 'other' || whFuel(g.m.wk, g.m.hi) === 'other';
    (document.getElementById('otherField') as HTMLElement).hidden = !usesOther;
    const hint = document.getElementById('gasHint');
    const usesGas = g.m.bills.gas > 0;
    if (hint) hint.textContent = usesGas
      ? `Pre-set to a typical similar home near ${g.m.R.name}. Drag to match your bill.`
      : '$0 = no gas service';
  }

  // ---------- rebates (same data and maths as the upgrade calculator) ----------
  const MEASURE_KEY: Record<string, string> = {
    'attic-insulation': 'attic', 'wall-insulation': 'walls', 'basement-insulation': 'basement', 'air-sealing': 'airSealing',
    'windows-doors': 'windows', 'heat-pump': 'ashp', 'water-heating': 'hpwh', controls: 'thermostat',
  };
  const REBATE_FUEL: Record<string, string> = {
    gas: 'gas', gasboiler: 'gas', electric: 'electricity', elecfurnace: 'electricity', heatpump: 'electricity', geothermal: 'electricity',
    oil: 'oil', propane: 'propane', wood: 'wood', outdoorwood: 'wood', pellet: 'wood',
  };
  function rebateFor(cat: string, prov: string, qty: Record<string, unknown>): { amount: number; program: string } | null {
    const list = (D.rebates[prov]?.[MEASURE_KEY[cat]] ?? []) as RebateEntry[];
    let best: { amount: number; program: string } | null = null;
    for (const e of list) {
      if (e.defaultOff) continue;
      const r = rebateAmount(e, qty as any);
      if (r.eligible && r.amount && r.amount > 0 && (!best || r.amount > best.amount)) best = { amount: r.amount, program: e.program };
    }
    return best;
  }

  // ---------- sequence ----------
  /** True when two texts share a run of `n` words: used to drop a second sentence that repeats the first. */
  function sharesPhrase(a: string, b: string, n = 4): boolean {
    const words = (s: string) => s.toLowerCase().replace(/[^a-z0-9\s-]/g, ' ').split(/\s+/).filter(Boolean);
    const wa = words(a);
    const wb = words(b);
    const grams = new Set<string>();
    for (let i = 0; i + n <= wa.length; i++) grams.add(wa.slice(i, i + n).join(' '));
    for (let i = 0; i + n <= wb.length; i++) if (grams.has(wb.slice(i, i + n).join(' '))) return true;
    return false;
  }

  function buildSequence(arch: any, heat: string, syms: string[], goals: string[], a: Answers, isON: boolean) {
    type Item = { category: string; action: string; why: string; score: number };
    const items: Item[] = arch.priorities.map((p: any, i: number) => ({ ...p, score: i * 10 }));
    const boost = (cat: string, by: number) => {
      const it = items.find((i) => i.category === cat);
      if (it) it.score -= by;
    };
    const ensure = (cat: string, action: string, why: string, score: number) => {
      if (!items.find((i) => i.category === cat)) items.push({ category: cat, action, why, score });
    };
    const resistanceOrFuel = ['electric', 'elecfurnace', 'oil', 'propane'].includes(heat);
    if (resistanceOrFuel) {
      ensure('heat-pump', 'Heat pump', 'With your heating fuel, this is usually the biggest single saving available.', -50);
      boost('heat-pump', 100);
    }
    if (heat === 'heatpump' || heat === 'geothermal') {
      const idx = items.findIndex((i) => i.category === 'heat-pump');
      if (idx >= 0) items.splice(idx, 1);
      ensure('controls', 'Get more from the heat pump you have', 'Controls, balancing and envelope work make an existing heat pump cheaper to run.', 45);
    }
    if (['wood', 'outdoorwood', 'pellet'].includes(heat)) {
      ensure('wood-safety', 'WETT inspection of the wood-burning system', 'Insurers usually ask for one, and it catches chimney and clearance problems before winter.', -5);
    }
    if (a.win === 'single' || a.win === 'singlestorm') boost('windows-doors', 15);
    if (a.wh === 'electric' || a.wh === 'oil') ensure('water-heating', 'Heat pump water heater', 'Hot water is the second-biggest energy use in most homes, and yours is on an expensive fuel.', 35);
    if (syms.includes('ice-dams')) { boost('air-sealing', 30); boost('attic-insulation', 25); }
    if (syms.includes('drafty-rooms')) boost('air-sealing', 25);
    if (syms.includes('cold-basement')) { boost('basement-insulation', 30); ensure('basement-insulation', 'Basement and rim joist insulation', 'Directly targets the cold-basement problem you flagged.', 25); }
    if (syms.includes('summer-overheating')) { boost('attic-insulation', 20); boost('heat-pump', 10); }
    if (syms.includes('cold-second-floor')) boost('air-sealing', 15);
    if (syms.includes('condensation-mould') || syms.includes('window-frost')) ensure('ventilation', 'Ventilation check, and an HRV if humidity is the problem', 'Condensation and musty air are usually ventilation problems: fix the cause, not the windows.', -10);
    if (syms.includes('smoke')) { boost('air-sealing', 15); ensure('ventilation', 'Ventilation and filtration for smoke days', 'Sealing leaks and filtering the air you bring in (MERV 13 where the system allows) keeps smoke out; an HRV or ERV supplies fresh air you can filter.', 20); }
    if (syms.includes('dry-winter')) boost('air-sealing', 20);
    if (syms.includes('humid-summer')) { boost('air-sealing', 10); boost('heat-pump', 10); }
    if (syms.includes('outages')) { boost('air-sealing', 10); boost('attic-insulation', 5); }
    if (goals.includes('heatpump')) boost('heat-pump', 40);
    if (goals.includes('solar')) ensure('solar', 'Rooftop solar + battery', isON ? 'On your goal list; in Ontario, Home Renovation Savings pays toward solar with a battery.' : 'On your goal list. Get the envelope done first: the audit tells you how much load the panels need to cover.', 55);
    if (goals.includes('emissions') && (heat === 'gas' || heat === 'gasboiler')) boost('heat-pump', 20);

    items.sort((x, y) => x.score - y.score);
    const seen = new Set<string>();
    const list = items.filter((i) => (seen.has(i.category) ? false : (seen.add(i.category), true))).slice(0, 6);
    // Seal before you insulate: air sealing always comes ahead of insulation work.
    const firstIns = list.findIndex((i) => /insulation/.test(i.category));
    const air = list.findIndex((i) => i.category === 'air-sealing');
    if (air > firstIns && firstIns >= 0) list.splice(firstIns, 0, list.splice(air, 1)[0]);
    // Ventilation follows air sealing ("build tight, ventilate right") unless a moisture or smoke problem was flagged.
    if (!syms.some((s) => ['condensation-mould', 'window-frost', 'smoke'].includes(s))) {
      const v = list.findIndex((i) => i.category === 'ventilation');
      const air2 = list.findIndex((i) => i.category === 'air-sealing');
      if (v >= 0 && air2 > v) { const [x] = list.splice(v, 1); list.splice(air2, 0, x); }
    }
    // Equipment after the envelope, so it can be sized smaller, unless the fuel is expensive or a heat pump is the goal.
    if (!resistanceOrFuel && !goals.includes('heatpump')) {
      const hp = list.findIndex((i) => i.category === 'heat-pump');
      let lastEnv = -1;
      list.forEach((i, k) => { if (i.category === 'air-sealing' || /insulation/.test(i.category)) lastEnv = k; });
      if (hp >= 0 && lastEnv > hp) { const [x] = list.splice(hp, 1); list.splice(lastEnv, 0, x); }
    }
    return list;
  }

  // ---------- results ----------
  function finish() {
    const a = readAnswers();
    if (a.loc.kind !== 'ca') { show(1); validate(1); return; }
    const loc = a.loc;
    const postal = postalEl.value.trim();
    const water = fieldVal('water') || 'municipal';
    const syms = multiVal('sym');
    const goals = multiVal('goal');
    const billsReal = touched.gas || touched.elec || touched.other;
    const gasBill = parseFloat(fieldVal('gasBill').replace(/[^0-9.]/g, '')) || 0;
    const elecBill = parseFloat(fieldVal('elecBill').replace(/[^0-9.]/g, '')) || 0;
    const otherBill = parseFloat(fieldVal('otherBill').replace(/[^0-9.]/g, '')) || 0;

    const arch = D.archetypes.find((x: any) => x.id === a.age);
    // Province-scoped glossary terms (e.g. Ontario's HRSP "assessment path") link only in that province's plan.
    resultsEl.setAttribute('data-gl-province', loc.province);
    const isON = loc.province === 'ON';
    const isToronto = Boolean(loc.fsa && loc.fsa[0] === 'M');
    const m = houseModel(a);
    const R = m.R;
    const C = climateFor(R.slug);
    const provSlug = PROV_SLUG[loc.province];
    const provName = PROV_NAME[loc.province];
    const city = D.cityInfo[R.slug];
    const ctx = { a, loc, isON, isToronto, m, R, C, provSlug, provName, city, syms, goals, water };

    $('#rTitle').textContent = `Your plan for a ${LABEL.era[a.age] === 'before 1946' ? 'pre-1946' : LABEL.era[a.age]} ${a.htype === 'condo' ? 'condo' : 'house'}`;
    $('#rSub').textContent = [
      LABEL.htype[a.htype] ?? a.htype,
      `heated by ${LABEL.heat[a.heat] ?? a.heat}`,
      R.exact ? `${R.name}, ${provName}` : loc.fsa && R.prov === loc.province ? `${provName}, near ${R.name}` : `${provName} (using ${R.name}’s climate and prices)`,
      C.profile ? `${C.profile.label} climate` : '',
    ].filter(Boolean).join(' · ');
    $('#rEra').textContent = ERA_NOTE[a.age] ?? '';

    const bills = { gas: gasBill, elec: elecBill, other: otherBill, real: billsReal };
    const cal = calibrationFor(m, bills);
    const picks = testPicks(a.age, m.hi.screen, syms, goals, a.htype, water, a.heat, isON);
    renderNext(ctx, picks);
    renderClimate(ctx);
    renderConcerns(ctx);
    renderBenchmark(m, a, bills, cal);
    renderProfile(arch, a.heat, isON);
    renderSequence(arch, a, syms, goals, m, cal, isON, isToronto, ctx);
    renderTests(picks, a.htype);
    renderPrograms(loc, goals, isON, isToronto);
    renderProviders(ctx);
    renderSystems(a, m, isON);
    renderMethod(m, cal);
    renderResources(ctx, arch);
    renderAuditCta(ctx);

    setMode('results');
    const params: Record<string, string> = {
      postal: checkPostal(postal).ok ? formatPostal(postal) : '', prov: checkPostal(postal).ok ? '' : loc.province,
      age: a.age, htype: a.htype, size: a.size, heat: a.heat, hage: a.hage, wh: a.wh, ac: a.ac, win: a.win, prev: a.prev,
      sec: a.sec.join(','), water, sym: syms.join(','), goal: goals.join(','),
      gas: touched.gas && gasBill ? String(gasBill) : '', elec: touched.elec && elecBill ? String(elecBill) : '',
      other: touched.other && otherBill ? String(otherBill) : '', done: '1',
    };
    const hp = new URLSearchParams();
    Object.entries(params).forEach(([k, v]) => { if (v) hp.set(k, v); });
    history.replaceState(null, '', location.pathname + '#' + hp.toString());
    // After the address holds the full plan, so the request's "Full plan" link reopens exactly this plan.
    prefillLead(arch, a, syms, goals, ctx, checklist, m, water);
    (window as unknown as { ayhPlan?: unknown }).ayhPlan = {
      home: {
        postal: params.postal, province: loc.province,
        city_slug: R.slug, city_name: R.name, era: a.age, home_type: a.htype, size_band: a.size,
        heating: a.heat, heating_age: a.hage, water_heater: a.wh, cooling: a.ac, windows: a.win,
        water_supply: water, prev_audit: a.prev, secondary: a.sec,
      },
      items: lastItems,
      // My Home reopens saved plans from a query string; the planner moves it after # on arrival.
      planner_query: '?' + hp.toString(),
    };
    document.dispatchEvent(new CustomEvent('ayh:plan'));
    setupSticky();
    const t = $('#rTitle');
    t.setAttribute('tabindex', '-1');
    t.focus({ preventScroll: true });
    resultsEl.scrollIntoView({ behavior: 'auto', block: 'start' });
  }

  type Ctx = {
    a: Answers; loc: Extract<Loc, { kind: 'ca' }>; isON: boolean; isToronto: boolean; m: ReturnType<typeof houseModel>; R: Region;
    C: ReturnType<typeof climateFor>; provSlug: string; provName: string; city: any; syms: string[]; goals: string[]; water: string;
  };

  function bookingFor(ctx: Ctx) {
    if (ctx.provSlug === 'north') return D.booking[`north-${ctx.loc.province}`] ?? D.booking.north;
    return D.booking[ctx.provSlug];
  }
  const shortLabel = (s: string) => s.split(/\s+[—(]\s*/)[0];

  // ---------- your next 3 steps ----------
  function renderNext(ctx: Ctx, picks: TestPick[]) {
    const b = bookingFor(ctx);
    const cityName = ctx.city?.n ?? ctx.R.name;
    const count = ctx.city?.providers ?? 0;
    const listHref = `/ca/services/home-energy-audit/${ctx.R.slug}/#providers`;
    const onDirectory = ctx.isON && ctx.loc.region;
    let primary = '';
    let secondary = '';
    // The phone's sticky bar names the real next action: a provincial program books the
    // evaluation; everywhere else our form matches you with an advisor (a referral, not a booking).
    const stickyText = document.getElementById('stickyText');
    const stickyBtn = document.getElementById('stickyBtn') as HTMLAnchorElement | null;
    if (stickyText && stickyBtn) {
      if (b?.bookWith) {
        stickyText.textContent = 'Next: book your EnerGuide evaluation';
        stickyBtn.textContent = `Book with ${shortLabel(b.bookWith.label)} ↗`;
        stickyBtn.href = b.bookWith.href;
        stickyBtn.target = '_blank';
        stickyBtn.rel = 'noopener';
      } else {
        stickyText.textContent = 'Next: get matched with a registered energy advisor';
        stickyBtn.textContent = 'Get matched';
        stickyBtn.href = '#lead-form';
        stickyBtn.removeAttribute('target');
        stickyBtn.removeAttribute('rel');
      }
    }
    if (b?.bookWith) {
      primary = `<a class="btn btn-primary" href="${esc(b.bookWith.href)}" rel="noopener" target="_blank">Book with ${esc(shortLabel(b.bookWith.label))} ↗</a>`;
      secondary = `<a href="#lead-form">Or ask us to match you with a registered energy advisor</a>`;
    } else {
      primary = `<a class="btn btn-primary" href="#lead-form">Get matched with a registered energy advisor</a>`;
      secondary = onDirectory
        ? `<a href="#rProviders">Or compare the advisors serving ${esc(ctx.loc.region.name)} below</a>`
        : count
          ? `<a href="${listHref}">Or see the ${count} licensed organization${count === 1 ? '' : 's'} serving ${esc(cityName)}${ctx.R.exact ? '' : ' (the closest city we cover)'}</a>`
          : `<a href="/ca/find/#${esc(ctx.provSlug)}">Or see how booking works in ${esc(ctx.provName)}</a>`;
    }
    const tests = picks.filter((p) => !p.health).slice(0, 4).concat(picks.filter((p) => p.health && p.level === 'strongly-flagged').slice(0, 2));
    const testLinks = tests.map((p) => `<a href="${esc(p.href)}">${esc(p.name)}</a>`).join('');
    let progs = ((D.provPrograms[ctx.provSlug] ?? []) as { name: string; headline: string; href: string; status: string; city?: string | null }[])
      // City-only programs (Toronto HELP) only for that city.
      .filter((p) => !p.city || p.city === ctx.R.slug);
    if (ctx.provSlug === 'north') {
      // One record covers all three territories: keep this territory's programs only.
      const rx = ctx.loc.province === 'YT' ? /^Yukon/i : ctx.loc.province === 'NU' ? /^Nunavut/i : /^(NWT|Northwest)/i;
      const mine = progs.filter((p) => rx.test(p.name));
      if (mine.length) progs = mine;
    }
    const progItems = progs.length
      ? progs.slice(0, 4).map((p) => `<li><a href="${esc(p.href)}">${esc(p.name)}</a>${p.headline ? ` — ${esc(p.headline)}` : ''}${p.status === 'income' ? ' <span class="chip chip-limited">income-qualified</span>' : ''}</li>`).join('')
      : `<li>${esc(ctx.provName)} has no province-wide home rebate right now. Check your city and utility: <a href="/ca/provinces/${esc(ctx.provSlug)}/">${esc(ctx.provName)} guide</a>.</li>`;
    $('#rNext').innerHTML = `
      <section class="card next-steps" id="next-steps" aria-labelledby="next-h">
        <h3 id="next-h">Your next 3 steps</h3>
        <ol class="ns-list">
          <li>
            <p class="ns-t">Book your EnerGuide evaluation (the home energy audit)</p>
            <p>${esc(b?.how ?? 'Book the evaluation with an NRCan-licensed service organization that serves your area.')}</p>
            ${b ? `<p class="ns-cost"><b>Cost:</b> ${esc(b.cost)}${b.help ? ` · <b>Help:</b> ${esc(b.help)}` : ''} <span class="small">(checked ${esc(b.checked)})</span></p>` : ''}
            <p class="ns-cta">${primary}${secondary}</p>
          </li>
          <li>
            <p class="ns-t">Ask your energy advisor for these tests</p>
            <p class="ns-tests">${testLinks}</p>
            <p><button type="button" class="btn btn-ghost btn-sm" id="copyTestsTop">Copy my test checklist</button></p>
          </li>
          <li>
            <p class="ns-t">After the audit, apply for the rebates</p>
            <ul class="ns-progs">${progItems}</ul>
            <p class="small">Programs that use the EnerGuide evaluation need the first visit before any work starts, so book it before you sign a contract.</p>
          </li>
        </ol>
      </section>`;
    wireCopy('copyTestsTop');
  }

  // ---------- your climate ----------
  function renderClimate(ctx: Ctx) {
    const el = $('#rClimate');
    const { profile, place } = ctx.C;
    if (!profile) { el.innerHTML = ''; return; }
    const radon = D.climate.provinces[ctx.provSlug]?.radon ?? '';
    const cityName = ctx.city?.n ?? ctx.R.name;
    const shown = profile.priorities.slice(0, 3);
    const items = shown.map((p: any) =>
      `<li><b>${esc(p.title)}.</b> ${esc(p.why)}${p.ask ? ` <span class="cb-ask">${/^ask\b/i.test(p.ask) ? '' : 'Ask: '}${esc(p.ask)}</span>` : ''}</li>`).join('');
    const smokeLine = place?.smoke && !shown.some((p: any) => /smoke/i.test(`${p.title} ${p.why}`))
      ? `<p class="small"><b>Wildfire smoke:</b> on smoke days, keep windows closed and filter the air, with a MERV 13 filter in the furnace or air handler where it fits, or a portable HEPA air cleaner in the room you sleep in. When the house is tightened, ask the advisor how fresh air will come in filtered.</p>`
      : '';
    el.innerHTML = `
      <section class="rsec climate-box" aria-labelledby="cb-h">
        <p class="cb-k"><span class="cb-chip">${esc(profile.label)}</span> <span>${esc(profile.regionName)}</span></p>
        <h3 id="cb-h">What homes ${ctx.R.prov !== ctx.loc.province ? `in ${esc(ctx.provName)}` : `${ctx.R.exact ? 'in' : 'near'} ${esc(cityName)}`} need</h3>
        <p class="cb-one">${esc(profile.oneLiner)}</p>
        ${place?.note && ctx.R.prov === ctx.loc.province ? `<p class="small">${esc(place.note)}</p>` : ''}
        <ol class="cb-list">${items}</ol>
        ${smokeLine}
        ${radon ? `<p class="small"><b>Radon in ${esc(ctx.provName)}:</b> ${esc(radon)}</p>` : ''}
        <p class="small"><b>When to book:</b> ${esc(profile.seasonNote)}</p>
        ${ctx.R.prov === ctx.loc.province ? `<p class="small"><a href="/ca/cities/${esc(ctx.R.slug)}/#regional-needs">Everything homes in ${esc(cityName)} need →</a></p>` : ''}
      </section>`;
  }

  // ---------- your concerns, explained ----------
  function renderConcerns(ctx: Ctx) {
    const el = $('#rConcerns');
    if (!ctx.syms.length) { el.innerHTML = ''; return; }
    const testLink = (slug: string) => {
      const t = D.tests.energy.find((x: any) => x.id === slug) ?? D.tests.health.find((x: any) => x.id === slug);
      return `<a href="/ca/tests/${esc(slug)}/">${esc(t?.name ?? slug.replace(/-/g, ' '))}</a>`;
    };
    const cards = ctx.syms.map((s) => {
      const label = SYMPTOM_LABEL[s] ?? s;
      const iss = D.issues.find((i: any) => i.slug === s);
      if (iss) {
        return `<div class="concern"><h4>${esc(label)}</h4>
          <p><span class="k">Usually:</span> ${esc(localize(iss.cause, ctx.isON) || iss.cause)}</p>
          ${iss.check ? `<p><span class="k">How the audit confirms it:</span> ${esc(iss.check)}</p>` : ''}
          ${iss.fix.length ? `<p><span class="k">Fixes, cheapest first:</span> ${iss.fix.map((f: string) => esc(f)).join(' → ')}</p>` : ''}
          <p><a href="/ca/issues/${esc(iss.slug)}/">${esc(iss.name)}: the full guide →</a></p></div>`;
      }
      const c = EXTRA_CONCERNS[s];
      if (!c) return '';
      return `<div class="concern"><h4>${esc(label)}</h4>
        <p><span class="k">Usually:</span> ${esc(c.cause)}</p>
        <p><span class="k">Tests that confirm it:</span> ${c.tests.map(testLink).join(', ')}</p>
        <p><span class="k">What fixes it:</span> ${esc(c.fix)}</p>
        <p><a href="${esc(c.more.href)}">${esc(c.more.label)} →</a></p></div>`;
    }).join('');
    el.innerHTML = `<div class="rsec"><h3>Your concerns, explained</h3><p class="sub">What usually causes each problem you flagged, how the audit confirms it, and the fixes, cheapest first.</p><div class="concern-list">${cards}</div></div>`;
  }

  type Bills = { gas: number; elec: number; other: number; real: boolean };
  function calibrationFor(m: ReturnType<typeof houseModel>, b: Bills) {
    if (!b.real) return calibrate(m.demand, m.hi.sys, m.R.hdd, m.R.prices, { mode: 'none', waterHeaterSameFuel: false });
    const monthly = m.hi.slider === 'gas' ? b.gas : m.hi.slider === 'elec' ? b.elec : b.other;
    const same = whFuel(m.wk, m.hi) === m.hi.slider;
    if (!(monthly > 0)) return calibrate(m.demand, m.hi.sys, m.R.hdd, m.R.prices, { mode: 'none', waterHeaterSameFuel: same });
    return calibrate(m.demand, m.hi.sys, m.R.hdd, m.R.prices, { mode: 'bill', monthlyBill: monthly, waterHeaterSameFuel: same });
  }

  function renderBenchmark(m: ReturnType<typeof houseModel>, a: Answers, b: Bills, cal: any) {
    const el = $('#rBenchmark');
    el.innerHTML = '';
    const userAnnual = (b.gas + b.elec + b.other) * 12;
    if (!b.real || !userAnnual || a.htype === 'condo') return;
    const typical = m.bills.gas + m.bills.elec + m.bills.other;
    if (!(typical > 0)) return;
    const lo = typical * 0.75, hi = typical * 1.25;
    const delta = Math.round(((userAnnual - typical) / typical) * 100);
    let verdict = '';
    let cls = 'bench-ok';
    if (delta > 25) { verdict = `You’re spending about <b class="bench-up">${delta}% more</b> than our estimate for a similar home here. Part of that can be how a household lives (more people, warmer settings, a hot tub), and part is the house itself; a blower door test and your bill history separate the two.`; cls = 'bench-up'; }
    else if (delta < -25) { verdict = `You’re spending about <b class="bench-ok">${Math.abs(delta)}% less</b> than our estimate for a similar home here, so the house may already have had upgrades. We’ve scaled the savings below down to match.`; }
    else { verdict = `You’re within the typical range for similar homes here. Targeted upgrades can still take a meaningful bite.`; }
    el.innerHTML = `
      <div class="card bench-card">
        <h3>Your bills vs. similar homes near ${esc(m.R.name)}</h3>
        <div class="figures">
          <div class="fig"><div class="n ${cls}">${money(userAnnual)}</div><div class="l">your estimated yearly energy spend</div></div>
          <div class="fig"><div class="n">${money(lo)}–${money(hi)}</div><div class="l">typical for a ${esc(LABEL.size[a.size] ?? a.size)} home built ${esc(LABEL.era[a.age])} with ${esc(m.hi.label)}, at local prices</div></div>
        </div>
        <p class="small">${verdict}</p>
        <p class="meta">Our model: about ${Math.round(m.demand)} GJ of heat a year for a house like yours (${m.R.hdd.toLocaleString('en-CA')} heating degree-days), plus hot water, cooling and about ${Math.round(m.baseKwh).toLocaleString('en-CA')} kWh for lights and appliances. ${cal.calibrated ? `Your bills put your heating at about ${Math.round(cal.actualDemandGJ)} GJ, so savings below are scaled by ${cal.factor.toFixed(2)}${cal.clamped ? ' (capped)' : ''}.` : ''}</p>
      </div>`;
  }

  function renderProfile(arch: any, heat: string, isON: boolean) {
    $('#rWalls').innerHTML = `
      <h3>What’s probably behind your walls</h3>
      <p class="small">${esc(localizeSummary(arch.summary))}</p>
      <ul class="kv">
        <li><span class="k">Walls</span><span>${esc(arch.typical.walls)}</span></li>
        <li><span class="k">Attic</span><span>${esc(arch.typical.attic)}</span></li>
        <li><span class="k">Air leaks</span><span>${esc(arch.typical.airtightness)}</span></li>
        <li><span class="k">Windows</span><span>${esc(arch.typical.windows)}</span></li>
        <li><span class="k">Basement</span><span>${esc(arch.typical.basement)}</span></li>
      </ul>`;
    const watch = watchFor(arch.watchFor, heat, isON, arch.id);
    $('#rWatch').innerHTML = `
      <h3>Watch for these</h3>
