  function renderTests(age: string, heat: string, syms: string[], goals: string[], htype: string, water: string) {
    const el = $('#rTests');
    if (htype === 'condo') { el.innerHTML = ''; return []; }
    const E = Object.fromEntries(D.tests.energy.map((t: any) => [t.id, t]));
    const H = Object.fromEntries(D.tests.health.map((t: any) => [t.id, t]));
    const older = ['pre-1946', '1946-1965', '1966-1980'].includes(age);
    const newer = ['1981-1995', '1996-2010', '2011-plus'].includes(age);
    const fuel = heat === 'gas' || heat === 'oil';

    const picks: { t: any; why: string; health?: boolean }[] = [];
    picks.push({ t: E['blower-door'], why: older ? 'Your era’s biggest unknown is air leakage — this puts a number on it and finds the entry points.' : 'Verifies the airtightness your home’s era promises — builders miss spots.' });
    picks.push({ t: E['thermal-imaging'], why: syms.includes('drafty-rooms') ? 'Finds the cold walls you flagged without opening anything.' : 'Maps exactly which cavities are empty before you pay to fill them.' });
    if (older || syms.includes('ice-dams')) picks.push({ t: E['attic-inspection'], why: syms.includes('ice-dams') ? 'Ice dams start in the attic — bypasses and thin insulation show up immediately.' : 'The cheapest big win of your era — this scopes it precisely.' });
    if (fuel) picks.push({ t: E['combustion-safety'], why: 'You heat with combustion — tightening the house requires this safety check first.' });
    if (goals.includes('heatpump') || heat === 'electric' || heat === 'oil' || syms.includes('summer-overheating')) picks.push({ t: E['heat-loss-calc'], why: heat === 'electric' ? 'Turns baseboard-to-heat-pump savings from a guess into a sized quote.' : 'Sizes the heat pump properly before anyone quotes you — oversizing is the industry’s favourite mistake.' });
    if ((syms.includes('cold-second-floor') || syms.includes('summer-overheating')) && heat !== 'electric') picks.push({ t: E['duct-leakage'], why: 'Your hot/cold floor problem usually lives in the ducts — measure before buying bigger equipment.' });
    if (syms.includes('condensation-mould') || newer) picks.push({ t: E['ventilation-assessment'], why: syms.includes('condensation-mould') ? 'Your condensation symptom is usually ventilation, not windows — this proves which, before you spend $20k on glass.' : 'Tighter eras need verified ventilation — humidity problems sneak up.' });
    picks.push({ t: E['bill-analysis'], why: 'Bring 12 months of bills to the assessment — it anchors every projection to your reality.' });
    const cards = picks.map(({ t, why }) => `
      <div class="test-card">
        <span class="ticon">${ICONS[t.icon] ?? ''}</span>
        <div>
          <h4><a class="tname" href="/ca/tests/${t.id}/">${esc(t.name)}</a></h4>
          <p class="tw">${esc(why)}</p>
          <p class="test-est"><b>Establishes:</b> ${esc(t.establishes)}</p>
          <p class="meta">${esc(t.cost)}</p>
        </div>
      </div>`).join('');

    const flags = screenSpecialtyTests({ era: age, heat, water, symptoms: syms, goals, htype });
    const LEVEL_CHIP: Record<string, string> = {
      'strongly-flagged': '<span class="chip chip-info">flagged for your home</span>',
      'flagged': '<span class="chip chip-limited">flagged</span>',
      'recommended': '<span class="chip chip-neutral">recommended</span>',
    };
    const flagCards = flags.map((f) => {
      const t = H[f.id] ?? {};
      return `
      <div class="test-card health">
        <span class="ticon">${ICONS[t.icon] ?? ''}</span>
        <div>
          <h4>${esc(f.name)} ${LEVEL_CHIP[f.level]}</h4>
          <p class="tw">${esc(f.why)}</p>
          ${t.cost ? `<p class="meta">${esc(t.cost)}</p>` : ''}
          <p class="tguide"><a href="${f.guide}"><strong>Full guide: how to test &amp; what to do →</strong></a></p>
        </div>
      </div>`;
    }).join('');

    el.innerHTML = `
      <div class="rsec">
        <h3>Tests that establish your requirements</h3>
        <p class="sub">Ask your advisor for these by name — they turn "probably" into measurements. <a href="/ca/tests/">Full testing guide →</a></p>
        <div class="test-grid">${cards}</div>
        <h3 class="spec-h">Specialty tests flagged for your home</h3>
        <p class="sub">Screened from your intake — era, heating, water source, and symptoms. Each links to its full guide.</p>
        <div class="test-grid">${flagCards}</div>
        <button type="button" class="btn btn-ghost btn-sm" id="copyTests">Copy my test checklist</button>
      </div>`;

    const names = [...picks.map((p) => p.t.name), ...flags.map((f) => f.name)];
    document.getElementById('copyTests')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText('Tests to include in my home energy audit:\n' + names.map((n) => '• ' + n).join('\n'));
        btn.textContent = 'Checklist copied ✓';
        setTimeout(() => (btn.textContent = 'Copy my test checklist'), 2000);
      } catch {}
    });
    return names;
  }

