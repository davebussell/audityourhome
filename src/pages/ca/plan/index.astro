<script>
  import { screenSpecialtyTests } from '../../../lib/screener';
  import {
    baselineDemandGJ, floorAreaM2, heatingCost, calibrate, geometry, atticMeasure, atticTargetR, wallMeasure,
    basementMeasure, windowMeasure, airMeasure, setbackMeasure, savingValue, waterHeatingDemand, waterHeaterCost,
    coolingKwh, defaultAcTons, MODEL,
  } from '../../../lib/calc/engine';
  import type { SystemKey, Vintage, WindowKey, WaterHeaterKey, Prices } from '../../../lib/calc/engine';

  const D = JSON.parse(document.getElementById('planner-data')!.textContent!);

  const form = document.getElementById('plannerForm') as HTMLFormElement;
  const stepsNav = document.getElementById('stepsNav')!;
  const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement;
  const backBtn = document.getElementById('backBtn') as HTMLButtonElement;
  const resultsEl = document.getElementById('results')!;
  const plannerEl = document.getElementById('planner')!;
  const TOTAL = 6;
  let step = 1;
  /** The upgrade sequence as shown, for saving to My Home. */
  let lastItems: Record<string, unknown>[] = [];

  const $ = (sel: string, root: ParentNode = document) => root.querySelector(sel) as HTMLElement;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const money = (n: number) => '$' + Math.round(n / 10) * 10;

  const PROVINCES: Record<string, string> = { A: 'NL', B: 'NS', C: 'PE', E: 'NB', G: 'QC', H: 'QC', J: 'QC', K: 'ON', L: 'ON', M: 'ON', N: 'ON', P: 'ON', R: 'MB', S: 'SK', T: 'AB', V: 'BC', X: 'NT', Y: 'YT' };

  const PROVINCE_NOTES: Record<string, string> = {
    QC: 'Since October 1, 2026, Quebec’s <b>Rénoclimat</b> makes the EnerGuide evaluation optional (up to $500 back toward it) and pays for roof, wall and foundation insulation and ENERGY STAR Most Efficient windows; <b>Hydro-Québec LogisVert</b> pays for heat pumps. <a href="/ca/programs/renoclimat/">Rénoclimat 2026 →</a> · <a href="/ca/provinces/quebec/">Quebec guide →</a>',
    MB: '<b>Efficiency Manitoba</b> pays a $400 EnerGuide evaluation rebate, insulation rebates by R-value, $100 per triple-pane ENERGY STAR window or door and up to $2,000 for a cold-climate heat pump. <a href="/ca/programs/efficiency-manitoba-rebates/">Manitoba rebates →</a>',
    NB: 'New Brunswick’s <b>Total Home Energy Savings Program</b> starts with a Home Energy Evaluation ($99 + HST for both visits) and pays published amounts for insulation, air sealing, windows and heat pumps. <a href="/ca/programs/nb-total-home-energy-savings/">NB program →</a>',
    NS: '<b>Efficiency Nova Scotia</b> runs a $199 home energy assessment (waived under its income threshold) with rebates for insulation, air sealing and heat pumps; the federal oil-to-heat-pump intake closed July 2, 2026. <a href="/ca/programs/efficiency-nova-scotia-rebates/">Nova Scotia rebates →</a>',
    PE: 'efficiencyPEI offers <b>$99 + HST</b> home energy assessments and pays for insulation, air sealing and windows ($125 per opening). Its heat pump rebates ended April 15, 2026. <a href="/ca/programs/efficiency-pei-rebates/">PEI rebates →</a>',
    BC: 'BC’s <b>Home Renovation Rebate</b> pays for insulation, windows and heat pump water heaters, and heat pumps when they replace electric heat (more in the north); the income-tiered <b>CleanBC Energy Savings Program</b> pays more. <a href="/ca/programs/cleanbc-energy-savings-program/">CleanBC rebates →</a> · <a href="/ca/provinces/bc/">BC guide →</a>',
    AB: 'Alberta has no provincial home rebate. <b>Clean Energy Improvement (CEIP)</b> financing runs in some municipalities and requires an EnerGuide evaluation (Calgary closed until winter 2026/27, Edmonton waitlisting). <a href="/ca/articles/alberta-energy-efficiency-rebates/">Alberta rebates in 2026 →</a>',
    SK: 'Saskatchewan’s Home Efficiency Retrofit Rebate ended in April 2026. The provincial <b>Home Renovation Tax Credit</b> (10.5% of eligible costs above $1,000, up to $420) still applies. <a href="/ca/articles/saskatchewan-energy-efficiency-rebates/">Saskatchewan options in 2026 →</a>',
    NL: '<b>takeCHARGE</b> pays insulation and air sealing rebates, and the Oil to Electric program pays up to $9,000 for a central heat pump ($22,000 if income-qualified). <a href="/ca/programs/takecharge-nl/">takeCHARGE NL →</a>',
    NT: 'The <b>Arctic Energy Alliance</b> runs EnerGuide evaluations ($200 + GST) and pays insulation and wood or pellet stove rebates. <a href="/ca/provinces/north/">Territories guide →</a>',
    YT: 'Yukon’s <b>Good Energy</b> rebates pay half of a heat pump (up to $10,500) plus insulation, air sealing and window rebates. <a href="/ca/provinces/north/">Territories guide →</a>',
    NU: 'Nunavut homeowner support runs through the <b>Nunavut Housing Corporation</b>. <a href="/ca/provinces/north/">Territories guide →</a>',
  };


  // ---------- wizard navigation ----------
  function show(n: number) {
    step = n;
    form.querySelectorAll('fieldset.step').forEach((f) => f.classList.toggle('on', (f as HTMLElement).dataset.step === String(n)));
    stepsNav.querySelectorAll('li').forEach((li) => {
      const s = Number((li as HTMLElement).dataset.step);
      li.classList.toggle('on', s === n);
      li.classList.toggle('done', s < n);
    });
    backBtn.hidden = n === 1;
    nextBtn.textContent = n === TOTAL ? 'See my plan' : 'Next';
    if (n === 6) initBillSliders();
    $('.field-error')?.remove();
    const first = form.querySelector<HTMLElement>(`fieldset[data-step="${n}"] input`);
    first?.focus({ preventScroll: true });
  }

  function fieldVal(name: string): string {
    const el = form.querySelector<HTMLInputElement>(`[name="${name}"]:checked, input[name="${name}"]:not([type=radio]):not([type=checkbox])`);
    return el?.value.trim() ?? '';
  }
  function multiVal(name: string): string[] {
    return [...form.querySelectorAll<HTMLInputElement>(`[name="${name}"]:checked`)].map((el) => el.value);
  }

  function validate(n: number): boolean {
    if (n === 2 && !fieldVal('age')) {
      const fs = form.querySelector(`fieldset[data-step="2"] .field`)!;
      if (!fs.querySelector('.field-error')) {
        const err = document.createElement('p');
        err.className = 'field-error';
        err.textContent = 'Pick the closest era — a rough guess still produces a good plan.';
        fs.appendChild(err);
      }
      return false;
    }
    return true;
  }

  nextBtn.addEventListener('click', () => {
    if (!validate(step)) return;
    if (step < TOTAL) show(step + 1);
    else finish();
  });
  backBtn.addEventListener('click', () => show(Math.max(1, step - 1)));
  form.addEventListener('submit', (e) => e.preventDefault());

  // ---------- region + house model (shared engine with the calculators) ----------
  type Region = { slug: string; exact: boolean; name: string; prov: string; hdd: number; cdd: number; dc: number; am: number; prices: Prices };
  function regionFor(loc: any): Region {
    const C = D.calc;
    let slug: string | null = null;
    let exact = false;
    if (loc.kind === 'ca') {
      slug = C.fsa[loc.fsa] ?? null;
      exact = Boolean(slug);
      if (!slug) slug = nearestByFsa(loc.fsa) ?? (loc.province ? C.provRep[loc.province] ?? null : null);
    }
    if (!slug) slug = 'toronto';
    const c = C.cities[slug];
    return { slug, exact, name: c.n, prov: c.p, hdd: c.hdd, cdd: c.cdd, dc: c.dc, am: c.am, prices: c.pr };
  }

  /** Rural and uncovered postal areas: pick a covered city in the same part of the province. */
  function nearestByFsa(fsa: string): string | null {
    const a = fsa[0], b = fsa[1], ab = fsa.slice(0, 2);
    const M: Record<string, string> = {
      K: 'ottawa', N: 'london', P: 'sudbury', L: b === '0' ? 'barrie' : 'toronto', M: 'toronto',
      G: ab === 'G7' ? 'saguenay' : 'quebec-city', H: 'montreal', J: ab === 'J8' || ab === 'J9' ? 'gatineau' : 'sherbrooke',
      V: b === '0' ? 'kamloops' : 'vancouver',
      T: b === '0' || b === '4' ? 'red-deer' : ['1', '2', '3'].includes(b) ? 'calgary' : 'edmonton',
      S: ['7', '0'].includes(b) ? 'saskatoon' : 'regina',
    };
    if (ab === 'P7') return 'thunder-bay';
    const slug = M[a];
    return slug && D.calc.cities[slug] ? slug : null;
  }

  type HeatInfo = { sys: SystemKey; label: string; screen: string; combustion: boolean; slider: 'gas' | 'elec' | 'other' };
  function heatInfo(heat: string, hage: string, age: string): HeatInfo {
    const newer = hage === 'new' || (hage === 'unsure' && ['1996-2010', '2011-plus'].includes(age));
    switch (heat) {
      case 'gasboiler': return { sys: newer ? 'gasBoilerCondensing' : 'gasBoilerMid', label: 'a gas boiler', screen: 'gas', combustion: true, slider: 'gas' };
      case 'electric': return { sys: 'electricResistance', label: 'electric baseboards', screen: 'electric', combustion: false, slider: 'elec' };
      case 'elecfurnace': return { sys: 'electricResistance', label: 'an electric furnace or boiler', screen: 'electric', combustion: false, slider: 'elec' };
      case 'heatpump': return { sys: hage === 'old' ? 'ashpStandard' : 'ashpCold', label: 'an air-source heat pump', screen: 'heatpump', combustion: false, slider: 'elec' };
      case 'geothermal': return { sys: 'gshp', label: 'a geothermal heat pump', screen: 'heatpump', combustion: false, slider: 'elec' };
      case 'oil': return { sys: hage === 'new' ? 'oilFurnaceNew' : hage === 'old' ? 'oilFurnaceOld' : 'oilFurnaceMid', label: 'oil', screen: 'oil', combustion: true, slider: 'other' };
      case 'propane': return { sys: newer ? 'propaneFurnaceCond' : 'propaneFurnaceStd', label: 'propane', screen: 'oil', combustion: true, slider: 'other' };
      case 'wood': return { sys: hage === 'new' ? 'woodCertified' : 'woodOld', label: 'wood', screen: 'oil', combustion: true, slider: 'other' };
      case 'outdoorwood': return { sys: 'outdoorWoodBoiler', label: 'an outdoor wood boiler', screen: 'oil', combustion: true, slider: 'other' };
      case 'pellet': return { sys: 'pellet', label: 'a pellet stove', screen: 'oil', combustion: true, slider: 'other' };
      default: return { sys: newer ? 'gasFurnaceHigh' : 'gasFurnaceMid', label: 'a gas furnace', screen: 'gas', combustion: true, slider: 'gas' };
    }
  }
  const HEAT_NAME: Record<string, string> = {
    gas: 'gas furnace', gasboiler: 'gas boiler', electric: 'electric baseboard', elecfurnace: 'electric furnace/boiler',
    heatpump: 'air-source heat pump', geothermal: 'geothermal heat pump', oil: 'oil', propane: 'propane', wood: 'wood',
    outdoorwood: 'outdoor wood boiler', pellet: 'pellet stove',
  };

  type WhKey = WaterHeaterKey | 'boiler';
  function whKey(wh: string, hi: HeatInfo): WhKey {
    switch (wh) {
      case 'gastank': return 'gasTank';
      case 'gastankless': return 'gasTankless';
      case 'electric': return 'electricTank';
      case 'heatpump': return 'heatPump';
      case 'oil': return 'oilTank';
      case 'boiler': return 'boiler';
    }
    if (hi.slider === 'gas') return 'gasTank';
    if (String(hi.sys).startsWith('oil')) return 'oilTank';
    return 'electricTank';
  }
  const WH_NAME: Record<string, string> = { gasTank: 'gas tank', gasTankless: 'gas tankless', electricTank: 'electric tank', heatPump: 'heat pump water heater', oilTank: 'oil-fired tank', boiler: 'combi boiler', gasCondensing: 'condensing gas tank' };
  function whFuel(k: WhKey, hi: HeatInfo): 'gas' | 'elec' | 'other' {
    if (k === 'boiler') return hi.slider;
    if (k === 'gasTank' || k === 'gasTankless' || k === 'gasCondensing') return 'gas';
    if (k === 'oilTank') return 'other';
    return 'elec';
  }

  function winKey(win: string, age: string): WindowKey {
    const M: Record<string, WindowKey> = { single: 'single', singlestorm: 'singleStorm', 'double-old': 'doubleClear', 'double-new': 'doubleLowE', triple: 'energyStar' };
    return M[win] ?? ((MODEL.envelope.windowByVintage as Record<string, WindowKey>)[age] ?? 'doubleClear');
  }

  type Answers = {
    loc: any; age: Vintage; htype: string; size: string; heat: string; hage: string; wh: string; ac: string;
    win: string; prev: string; sec: string[];
  };
  function readAnswers(): Answers {
    return {
      loc: parsePostal(fieldVal('postal')),
      age: (fieldVal('age') || '1966-1980') as Vintage,
      htype: fieldVal('htype') || 'detached',
      size: fieldVal('size') || 'medium',
      heat: fieldVal('heat') || 'gas',
      hage: fieldVal('hage') || 'unsure',
      wh: fieldVal('wh') || 'unsure',
      ac: fieldVal('ac') || 'unsure',
      win: fieldVal('win') || 'unsure',
      prev: fieldVal('prev') || 'no',
      sec: multiVal('sec'),
    };
  }

  /** Typical-house model at local climate and prices ('now' = average prices, for bills). */
  function houseModel(a: Answers) {
    const R = regionFor(a.loc);
    const hi = heatInfo(a.heat, a.hage, a.age);
    const area = floorAreaM2({ sizeBand: a.size as any });
    const type = a.htype === 'semi' ? 'semi' : 'detached';
    const demand = baselineDemandGJ({ vintage: a.age, floorAreaM2: area, hdd: R.hdd, type: type as any });
    const heatNow = heatingCost(demand, hi.sys, R.hdd, R.prices, 'now');
    const wk = whKey(a.wh, hi);
    const water = waterHeatingDemand(3, R.am);
    let waterCost: number | null = null;
    let waterUnits = 0;
    if (wk === 'boiler') {
      const c = heatingCost(water.gj, hi.sys, R.hdd, R.prices, 'now');
      waterCost = c.cost; waterUnits = c.units;
    } else {
      const c = waterHeaterCost(wk, water.gj, R.prices, 'now', { sys: hi.sys, hdd: R.hdd });
      waterCost = c.cost; waterUnits = c.units;
    }
    const baseKwh = D.calc.baseKwh * (D.calc.sizeMult[a.size] ?? 1);
    const tons = defaultAcTons(area);
    let acKwh = 0;
    let acNote = '';
    const S = MODEL.cooling.seerByAge as Record<string, number>;
    if (a.ac === 'central-new') { acKwh = coolingKwh({ cdd18: R.cdd, designCool: R.dc, capacityBtuh: tons * 12000, seer: S['2006to2022'] }).kwh; acNote = 'SEER 13'; }
    else if (a.ac === 'central-old') { acKwh = coolingKwh({ cdd18: R.cdd, designCool: R.dc, capacityBtuh: tons * 12000, seer: S['1995to2006'] }).kwh; acNote = 'SEER 10'; }
    else if (a.ac === 'heatpump') { acKwh = coolingKwh({ cdd18: R.cdd, designCool: R.dc, capacityBtuh: tons * 12000, seer: MODEL.cooling.heatPumpSeer }).kwh; acNote = 'heat pump'; }
    else if (a.ac === 'room') { acKwh = coolingKwh({ cdd18: R.cdd, designCool: R.dc, capacityBtuh: MODEL.cooling.room.capacityBtuh, room: true, units: 2 }).kwh; acNote = 'two window units'; }
    const ep = R.prices.electricity.now;
    const bills = { gas: 0, elec: baseKwh * ep + acKwh * ep, other: 0 };
    const heatCost = heatNow.cost ?? 0;
    bills[hi.slider] += heatCost;
    if (waterCost !== null) bills[whFuel(wk, hi)] += waterCost;
    if (hi.slider !== 'gas' && whFuel(wk, hi) !== 'gas') bills.gas = 0;
    return { R, hi, area, type, demand, heatNow, wk, water, waterCost, waterUnits, baseKwh, acKwh, acNote, tons, bills };
  }

  // ---------- bill sliders (pre-set from the house model) ----------
  const gasEl = document.getElementById('gasBill') as HTMLInputElement;
  const elecEl = document.getElementById('elecBill') as HTMLInputElement;
  const otherEl = document.getElementById('otherBill') as HTMLInputElement;
  const touched = { gas: false, elec: false, other: false };
  function fmtOut(el: HTMLInputElement, out: HTMLElement) {
    out.textContent = el.value === '0' ? '$0' : '$' + el.value + '/mo';
  }
  function wireSlider(el: HTMLInputElement, outId: string, key: 'gas' | 'elec' | 'other') {
    const out = document.getElementById(outId)!;
    el.addEventListener('input', () => { touched[key] = true; fmtOut(el, out); });
    fmtOut(el, out);
  }
  wireSlider(gasEl, 'gasOut', 'gas');
  wireSlider(elecEl, 'elecOut', 'elec');
  wireSlider(otherEl, 'otherOut', 'other');
  function syncHeatAge() {
    const h = fieldVal('heat');
    (document.getElementById('heatAgeField') as HTMLElement).hidden = ['electric', 'elecfurnace', 'outdoorwood', 'pellet', 'geothermal'].includes(h);
  }
  form.querySelectorAll('input[name="heat"]').forEach((el) => el.addEventListener('change', syncHeatAge));
  syncHeatAge();
  function billGuesses() {
    const m = houseModel(readAnswers());
    const r5 = (v: number) => String(Math.max(0, Math.round(v / 12 / 5) * 5));
    return { gas: r5(m.bills.gas), elec: r5(m.bills.elec), other: r5(m.bills.other), m };
  }
  function initBillSliders() {
    const g = billGuesses();
    if (!touched.gas) { gasEl.value = g.gas; fmtOut(gasEl, document.getElementById('gasOut')!); }
    if (!touched.elec) { elecEl.value = g.elec; fmtOut(elecEl, document.getElementById('elecOut')!); }
    if (!touched.other) { otherEl.value = g.other; fmtOut(otherEl, document.getElementById('otherOut')!); }
    const usesOther = g.m.hi.slider === 'other' || whFuel(g.m.wk, g.m.hi) === 'other';
    (document.getElementById('otherField') as HTMLElement).hidden = !usesOther;
    const hint = document.getElementById('gasHint');
    const usesGas = g.m.bills.gas > 0;
    if (hint) hint.textContent = usesGas
      ? `Pre-set to a typical similar home near ${g.m.R.name} — drag to match your bill`
      : '$0 = no gas service';
  }

  // ---------- interpretation helpers ----------
  function parsePostal(raw: string) {
    const v = raw.toUpperCase().replace(/\s+/g, '');
    if (/^\d{5}/.test(v)) return { kind: 'us' as const };
    const m = v.match(/^([A-Z]\d[A-Z])/);
    if (!m) return { kind: 'none' as const };
    const fsa = m[1];
    const province = PROVINCES[fsa[0]] ?? null;
    const region = D.regions.find((r: any) => r.fsa.some((p: string) => fsa.startsWith(p)));
    return { kind: 'ca' as const, fsa, province, region };
  }

  function buildSequence(arch: any, heat: string, syms: string[], goals: string[], a: Answers) {
    type Item = { category: string; action: string; why: string; score: number };
    const items: Item[] = arch.priorities.map((p: any, i: number) => ({ ...p, score: i * 10 }));

    const boost = (cat: string, by: number) => {
      const it = items.find((i) => i.category === cat);
      if (it) it.score -= by;
    };
    const ensure = (cat: string, action: string, why: string, score: number) => {
      if (!items.find((i) => i.category === cat)) items.push({ category: cat, action, why, score });
    };
    const resistanceOrFuel = ['electric', 'elecfurnace', 'oil', 'propane'].includes(heat);
    if (resistanceOrFuel) {
      ensure('heat-pump', 'Cold-climate heat pump', 'With your heating fuel, this is usually the biggest single saving available.', -50);
      boost('heat-pump', 100);
    }
    if (heat === 'heatpump' || heat === 'geothermal') {
      const idx = items.findIndex((i) => i.category === 'heat-pump');
      if (idx >= 0) items.splice(idx, 1);
      ensure('controls', 'Optimize the heat pump you have', 'Controls, balancing, and envelope work make an existing heat pump cheaper to run.', 45);
    }
    if (['wood', 'outdoorwood', 'pellet'].includes(heat)) {
      ensure('wood-safety', 'WETT inspection of the wood-burning system', 'Insurers usually ask for one, and it catches chimney and clearance problems before winter.', -5);
    }
    if (a.win === 'single' || a.win === 'singlestorm') boost('windows-doors', 15);
    if (a.wh === 'electric' || a.wh === 'oil') ensure('water-heating', 'Heat pump water heater', 'Hot water is the second-biggest energy use in most homes, and yours is on an expensive fuel.', 35);
    if (syms.includes('ice-dams')) { boost('air-sealing', 30); boost('attic-insulation', 25); }
    if (syms.includes('drafty-rooms')) boost('air-sealing', 25);
    if (syms.includes('cold-basement')) { boost('basement-insulation', 30); ensure('basement-insulation', 'Basement & rim joist insulation', 'Directly targets the cold-basement problem you flagged.', 25); }
    if (syms.includes('summer-overheating')) { boost('attic-insulation', 20); boost('heat-pump', 10); }
    if (syms.includes('cold-second-floor')) boost('air-sealing', 15);
    if (syms.includes('condensation-mould')) ensure('ventilation', 'Ventilation check / HRV', 'Condensation and musty air are usually ventilation problems — fix the cause, not the windows.', -10);
    if (goals.includes('heatpump')) boost('heat-pump', 40);
    if (goals.includes('solar')) ensure('solar', 'Rooftop solar + battery', 'On your goal list; in Ontario, Home Renovation Savings pays toward solar with a battery.', 55);
    if (goals.includes('emissions') && (heat === 'gas' || heat === 'gasboiler')) boost('heat-pump', 20);

    items.sort((x, y) => x.score - y.score);
    const seen = new Set<string>();
    return items.filter((i) => (seen.has(i.category) ? false : (seen.add(i.category), true))).slice(0, 6);
  }

  // ---------- results ----------
  function finish() {
    const a = readAnswers();
    const postal = fieldVal('postal');
    const water = fieldVal('water') || 'municipal';
    const syms = multiVal('sym');
    const goals = multiVal('goal');
    const billsReal = touched.gas || touched.elec || touched.other;
    const gasBill = parseFloat(fieldVal('gasBill').replace(/[^0-9.]/g, '')) || 0;
    const elecBill = parseFloat(fieldVal('elecBill').replace(/[^0-9.]/g, '')) || 0;
    const otherBill = parseFloat(fieldVal('otherBill').replace(/[^0-9.]/g, '')) || 0;

    const loc = a.loc;
    const arch = D.archetypes.find((x: any) => x.id === a.age);
    const isON = loc.kind !== 'ca' ? true : loc.province === 'ON'; // Ontario-first default when unknown
    const isToronto = loc.kind === 'ca' && loc.fsa![0] === 'M';
    const regionName = loc.kind === 'ca' && loc.region ? loc.region.name : null;
    const m = houseModel(a);

    $('#rTitle').textContent = `Your plan: ${arch.label.split('·')[1]?.trim() ?? arch.label} era home`;
    $('#rSub').textContent = [
      arch.years,
      a.htype === 'condo' ? 'condo/apartment' : a.htype === 'semi' ? 'semi or townhome' : 'detached',
      `heated by ${HEAT_NAME[a.heat] ?? a.heat}`,
      regionName ?? (loc.kind === 'ca' ? (m.R.exact ? m.R.name : (loc.province ?? 'Canada')) : loc.kind === 'us' ? 'United States' : 'Ontario (assumed)'),
    ].join(' · ');

    const bills = { gas: gasBill, elec: elecBill, other: otherBill, real: billsReal };
    const cal = calibrationFor(m, bills);
    renderBenchmark(m, a, bills, cal);
    renderProfile(arch);
    renderSequence(arch, a, syms, goals, m, cal, isON, isToronto);
    renderSystems(a, m);
    renderMethod(m, cal);
    const testsList = renderTests(a.age, m.hi.screen, syms, goals, a.htype, water);
    renderPrograms(loc, goals, isON, isToronto);
    renderIssues(syms);
    renderProviders(loc);
    renderResources(loc, syms, arch);
    prefillLead(arch, a, syms, goals, loc, testsList, m);

    plannerEl.hidden = true;
    resultsEl.hidden = false;
    const url = new URL(location.href);
    const params: Record<string, string> = {
      postal, age: a.age, htype: a.htype, size: a.size, heat: a.heat, hage: a.hage, wh: a.wh, ac: a.ac, win: a.win, prev: a.prev,
      sec: a.sec.join(','), water, sym: syms.join(','), goal: goals.join(','),
      gas: touched.gas && gasBill ? String(gasBill) : '', elec: touched.elec && elecBill ? String(elecBill) : '',
      other: touched.other && otherBill ? String(otherBill) : '', done: '1',
    };
    Object.entries(params).forEach(([k, v]) => (v ? url.searchParams.set(k, v) : url.searchParams.delete(k)));
    history.replaceState(null, '', url);
    (window as unknown as { ayhPlan?: unknown }).ayhPlan = {
      home: {
        postal, province: loc.kind === 'ca' ? loc.province : null,
        city_slug: m.R.slug, city_name: m.R.name, era: a.age, home_type: a.htype, size_band: a.size,
        heating: a.heat, heating_age: a.hage, water_heater: a.wh, cooling: a.ac, windows: a.win,
        water_supply: water, prev_audit: a.prev, secondary: a.sec,
      },
      items: lastItems,
      planner_query: url.search,
    };
    document.dispatchEvent(new CustomEvent('ayh:plan'));
    const t = $('#rTitle');
    t.setAttribute('tabindex', '-1');
    t.focus({ preventScroll: false });
  }

  type Bills = { gas: number; elec: number; other: number; real: boolean };
  function calibrationFor(m: ReturnType<typeof houseModel>, b: Bills) {
    if (!b.real) return calibrate(m.demand, m.hi.sys, m.R.hdd, m.R.prices, { mode: 'none', waterHeaterSameFuel: false });
    const monthly = m.hi.slider === 'gas' ? b.gas : m.hi.slider === 'elec' ? b.elec : b.other;
    const same = whFuel(m.wk, m.hi) === m.hi.slider;
    if (!(monthly > 0)) return calibrate(m.demand, m.hi.sys, m.R.hdd, m.R.prices, { mode: 'none', waterHeaterSameFuel: same });
    return calibrate(m.demand, m.hi.sys, m.R.hdd, m.R.prices, { mode: 'bill', monthlyBill: monthly, waterHeaterSameFuel: same });
  }

  function renderBenchmark(m: ReturnType<typeof houseModel>, a: Answers, b: Bills, cal: any) {
    const el = $('#rBenchmark');
    el.innerHTML = '';
    const userAnnual = (b.gas + b.elec + b.other) * 12;
    if (!b.real || !userAnnual || a.htype === 'condo') return;
    const typical = m.bills.gas + m.bills.elec + m.bills.other;
    if (!(typical > 0)) return;
    const lo = typical * 0.75, hi = typical * 1.25;
    const delta = Math.round(((userAnnual - typical) / typical) * 100);
    let verdict = '';
    let cls = 'bench-ok';
    if (delta > 25) { verdict = `You're spending about <b class="bench-up">${delta}% more</b> than our estimate for a similar home here. Part of that can be how a household lives (more people, warmer settings, a hot tub), and part is the house itself; a blower door test and your bill history separate the two.`; cls = 'bench-up'; }
    else if (delta < -25) { verdict = `You're spending about <b class="bench-ok">${Math.abs(delta)}% less</b> than our estimate for a similar home here, so the house may already have had upgrades. We've scaled the savings below down to match.`; }
    else { verdict = `You're within the typical range for similar homes here. Targeted upgrades can still take a meaningful bite.`; }
    el.innerHTML = `
      <div class="card bench-card">
        <h3>Your bills vs. similar homes near ${esc(m.R.name)}</h3>
        <div class="figures">
          <div class="fig"><div class="n ${cls}">${money(userAnnual)}</div><div class="l">your estimated yearly energy spend</div></div>
          <div class="fig"><div class="n">${money(lo)}–${money(hi)}</div><div class="l">typical for a ${esc(a.size === 'xlarge' ? 'very large' : a.size)} ${esc(a.age)} home with ${esc(m.hi.label)}, at local prices</div></div>
        </div>
        <p class="small">${verdict}</p>
        <p class="meta">Our model: about ${Math.round(m.demand)} GJ of heat a year for a house like yours (${m.R.hdd.toLocaleString('en-CA')} heating degree-days), plus hot water, cooling and about ${Math.round(m.baseKwh).toLocaleString('en-CA')} kWh for lights and appliances. ${cal.calibrated ? `Your bills put your heating at about ${Math.round(cal.actualDemandGJ)} GJ, so savings below are scaled by ${cal.factor.toFixed(2)}${cal.clamped ? ' (capped)' : ''}.` : ''}</p>
      </div>`;
  }

  function renderProfile(arch: any) {
    $('#rWalls').innerHTML = `
      <h3>What's probably behind your walls</h3>
      <p class="small">${esc(arch.summary)}</p>
      <ul class="kv">
        <li><span class="k">Walls</span><span>${esc(arch.typical.walls)}</span></li>
        <li><span class="k">Attic</span><span>${esc(arch.typical.attic)}</span></li>
        <li><span class="k">Air leaks</span><span>${esc(arch.typical.airtightness)}</span></li>
        <li><span class="k">Windows</span><span>${esc(arch.typical.windows)}</span></li>
        <li><span class="k">Basement</span><span>${esc(arch.typical.basement)}</span></li>
      </ul>`;
    $('#rWatch').innerHTML = `
      <h3>Watch for these</h3>
      ${arch.watchFor.map((w: any) => `<div class="watch-item ${w.severity}"><b>${esc(w.flag)}</b>${esc(w.detail)}</div>`).join('')}`;
  }

  /** Annual saving for one sequence item, valued at the next-unit (variable) price. */
  function itemSaving(cat: string, a: Answers, m: ReturnType<typeof houseModel>, cal: any): { dollars: number | null; note?: string; cost?: [number, number] } {
    const R = m.R;
    const demand = m.demand * cal.factor;
    const storeys = a.size === 'small' ? 1 : 2;
    const g = geometry(m.area, storeys, true);
    const E = MODEL.envelope;
    const C = MODEL.costs as any;
    const val = (gj: number) => savingValue(gj, m.hi.sys, R.hdd, R.prices, 'variable').dollars;
    switch (cat) {
      case 'air-sealing': {
        const r = airMeasure({ volumeM3: g.volumeM3, hdd: R.hdd, demandGJ: demand, calibration: 1 });
        return { dollars: val(r.gj), cost: [C.airSealing.low, C.airSealing.high] };
      }
      case 'attic-insulation': {
        const rb = (E.atticRByVintage as Record<string, number>)[a.age];
        const t = atticTargetR(R.hdd);
        const r = atticMeasure({ areaM2: g.atticM2, rBefore: rb, rAfter: t.target, hdd: R.hdd, demandGJ: demand, calibration: cal.factor });
        const sqft = g.atticM2 * 10.764;
        return { dollars: r.applicable ? val(r.gj) : 0, note: `R-${rb} to R-${t.target}`, cost: [C.atticPerSqft.low * sqft, C.atticPerSqft.high * sqft] };
      }
      case 'wall-insulation': {
        const rb = (E.wallRsiByVintage as Record<string, number>)[a.age];
        const r = wallMeasure({ areaM2: g.wallNetM2, option: 'dense', rsiBefore: rb, hdd: R.hdd, demandGJ: demand, calibration: cal.factor });
        return { dollars: r.applicable ? val(r.gj) : 0 };
      }
      case 'basement-insulation': {
        const rb = (E.basementRsiByVintage as Record<string, number>)[a.age];
        const r = basementMeasure({ areaM2: g.basementWallM2, rsiBefore: rb, rsiAfter: E.basementTargetRsi, hdd: R.hdd, demandGJ: demand, calibration: cal.factor });
        return { dollars: r.applicable ? val(r.gj) : 0 };
      }
      case 'windows-doors': {
        const before = winKey(a.win, a.age);
        const r = windowMeasure({ areaM2: g.windowM2, before, after: 'energyStar', hdd: R.hdd, demandGJ: demand, calibration: cal.factor });
        return { dollars: r.applicable ? val(r.gj) : 0, cost: [C.windowEach.low * g.windowCount, C.windowEach.high * g.windowCount], note: `${g.windowCount} windows` };
      }
      case 'heat-pump': {
        const now = heatingCost(demand, m.hi.sys, R.hdd, R.prices, 'variable');
        const hp = heatingCost(demand, 'ashpCold', R.hdd, R.prices, 'variable');
        if (now.cost === null || hp.cost === null) return { dollars: null };
        return { dollars: now.cost - hp.cost, cost: [C.ashpColdDucted.low, C.ashpColdDucted.high] };
      }
      case 'water-heating': {
        if (m.wk === 'heatPump') return { dollars: 0 };
        const cur = m.wk === 'boiler' ? heatingCost(m.water.gj, m.hi.sys, R.hdd, R.prices, 'variable').cost : waterHeaterCost(m.wk, m.water.gj, R.prices, 'variable').cost;
        const alt = waterHeaterCost('heatPump', m.water.gj, R.prices, 'variable', { sys: m.hi.sys, hdd: R.hdd });
        if (cur === null || alt.cost === null) return { dollars: null };
        return { dollars: cur - (alt.cost + (alt.extraCost ?? 0)) };
      }
      case 'controls': {
        const hp = m.hi.sys === 'ashpCold' || m.hi.sys === 'ashpStandard' || m.hi.sys === 'gshp';
        const r = setbackMeasure({ degrees: hp ? 2 : 3, hours: 8, demandGJ: demand, heatPump: hp });
        return { dollars: val(r.gj) };
      }
    }
    return { dollars: null };
  }

  function renderSequence(arch: any, a: Answers, syms: string[], goals: string[], m: ReturnType<typeof houseModel>, cal: any, isON: boolean, isToronto: boolean) {
    const el = $('#rSequence');
    if (a.htype === 'condo') {
      lastItems = [];
      el.innerHTML = `
        <div class="rsec"><h3>Condos work differently</h3>
        <p class="sub">EnerGuide evaluations and most rebates target houses and townhomes — in a condo, the envelope and heating usually belong to the corporation. Your best levers: in-suite sealing, window coverings, a heat-pump conversation with your board, and pushing the corporation toward a building-level audit.</p></div>`;
      return;
    }
    const seq = buildSequence(arch, a.heat, syms, goals, a);
    const ON_REBATE: Record<string, string> = {
        'air-sealing': 'HRSP assessment path',
        'attic-insulation': 'HRSP insulation rebates',
        'wall-insulation': 'HRSP insulation rebates',
        'basement-insulation': 'HRSP insulation rebates',
        'windows-doors': 'HRSP $100/opening',
        'heat-pump': 'HRSP heat pump rebate',
        'solar': 'HRSP solar + battery',
        'water-heating': 'HRSP $500',
        'controls': 'HRSP thermostat rebate',
    };
    const rebateChip = (cat: string) => {
      if (!isON) return '';
      const label = ON_REBATE[cat];
      const help = isToronto ? ' <span class="chip chip-neutral">+ HELP financing</span>' : '';
      return label ? `<span class="chip chip-active">${label}</span>${help}` : help;
    };
    const local = (t: string) => {
      let out = isON ? t : t.split(/(?<=[.!?])\s+/).filter((x) => !/HRSP|Ontario|Enbridge|Home Renovation Savings/.test(x)).join(' ');
      if (a.heat === 'propane') out = out.replace('Oil-heated homes', 'Oil- and propane-heated homes');
      return out;
    };
    lastItems = [];
    const rows = seq.map((item) => {
      const sm = findMeasure(item.category, a.age, m.hi.screen);
      const s = itemSaving(item.category, a, m, cal);
      lastItems.push({
        key: item.category, title: item.action, category: item.category,
        cost_low: s.cost ? Math.round(s.cost[0]) : null, cost_high: s.cost ? Math.round(s.cost[1]) : null,
        saving_year: s.dollars !== null && s.dollars !== undefined && s.dollars >= 15 ? Math.round(s.dollars) : null,
        rebate: isON ? ON_REBATE[item.category] ?? null : null,
      });
      let saveTxt = '';
      let payTxt = '';
      if (s.dollars !== null && s.dollars !== undefined) {
        if (s.dollars >= 15) {
          saveTxt = `about ${money(s.dollars)}/yr <span class="save-range">(likely ${money(s.dollars * 0.75)}–${money(s.dollars * 1.25)})</span>`;
          if (s.cost) {
            const y1 = s.cost[0] / s.dollars, y2 = s.cost[1] / s.dollars;
            if (y1 < 100) payTxt = `payback before rebates: ${Math.max(1, Math.round(y1))}–${Math.round(Math.min(y2, 99))}${y2 >= 99 ? '+' : ''} years`;
          }
        } else if (item.category === 'heat-pump' && s.dollars < 0) {
          saveTxt = `<span class="save-neg">costs about ${money(-s.dollars)}/yr more to run than your current fuel at today's prices</span>`;
        } else if (s.dollars < 15 && item.category !== 'ventilation' && item.category !== 'solar') {
          saveTxt = `<span class="save-small">little or no bill saving for a house like yours</span>`;
        }
      }
      const costTxt = s.cost ? `typical cost ${money(s.cost[0])}–${money(s.cost[1])}` : sm?.typicalCost ? `typical cost ${esc(sm.typicalCost)}` : '';
      const hpNote = item.category === 'heat-pump' && s.dollars !== null && s.dollars < 15
        ? ' With cheap gas, the case for a heat pump is comfort, air conditioning, lower emissions and rebates more than the bill.' : '';
      return `
        <div class="seq-item">
          <h4>${esc(item.action)}${s.note ? ` <span class="small">(${esc(s.note)})</span>` : ''}</h4>
          <p class="why">${esc(local(item.why))}${sm?.note && local(sm.note) ? ' ' + esc(local(sm.note)) : ''}${hpNote}</p>
          <div class="nums">
            ${saveTxt ? `<span class="save">${saveTxt}</span>` : ''}
            ${costTxt ? `<span class="cost">${costTxt}</span>` : ''}
            ${payTxt ? `<span class="cost">${payTxt}</span>` : ''}
            ${rebateChip(item.category)}
            ${item.category === 'heat-pump' && a.loc.kind !== 'us' ? '<a class="chip chip-info" href="/ca/programs/national-heat-pump-rebate/">+ federal rebate, opens early 2027</a>' : ''}
          </div>
        </div>`;
    });
    const basis = cal.calibrated
      ? `<span class="chip chip-active">Scaled to your bills</span> Dollar figures use your bills and ${esc(m.R.name)}-area prices and climate.`
      : `<span class="chip chip-neutral">Typical house estimate</span> Based on a typical ${esc(a.age)} house near ${esc(m.R.name)}. <a href="#" id="addBills">Add your bills</a> to scale these to your house.`;
    el.innerHTML = `
      <div class="rsec">
        <h3>Your upgrade sequence</h3>
        <p class="sub">Ordered for your era, heating, and the problems you flagged. ${basis}</p>
        <div class="seq">${rows.join('')}</div>
        <p class="small">Savings don't simply add up: once the attic is insulated there is less heat left to save elsewhere. We value savings at the price of your next unit of energy and stay on the low side on purpose.</p>
      </div>`;
    document.getElementById('addBills')?.addEventListener('click', (e) => {
      e.preventDefault();
      resultsEl.hidden = true; plannerEl.hidden = false; show(6);
      plannerEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  function renderSystems(a: Answers, m: ReturnType<typeof houseModel>) {
    const el = $('#rSystems');
    if (a.htype === 'condo') { el.innerHTML = ''; return; }
    const R = m.R;
    const cards: string[] = [];
    // water heater
    if (m.waterCost !== null) {
      const alts: string[] = [];
      const hpwh = waterHeaterCost('heatPump', m.water.gj, R.prices, 'now', { sys: m.hi.sys, hdd: R.hdd });
      const tl = R.prices.gas ? waterHeaterCost('gasTankless', m.water.gj, R.prices, 'now') : null;
      if (m.wk !== 'heatPump' && hpwh.cost !== null) alts.push(`heat pump water heater about ${money(hpwh.cost + (hpwh.extraCost ?? 0))}/yr`);
      if (tl && tl.cost !== null && m.wk === 'gasTank') alts.push(`gas tankless about ${money(tl.cost)}/yr (US DOE: on-demand units are 24–34% more efficient than tanks in homes using up to about 155 litres a day)`);
      cards.push(`<div class="sys-card"><h4>Hot water: ${esc(WH_NAME[m.wk] ?? m.wk)}${a.wh === 'unsure' ? ' (assumed)' : ''}</h4>
        <p class="small">About <b>${money(m.waterCost)}/yr</b> for a household of three near ${esc(R.name)} (cold water arrives at about ${m.water.inletC.toFixed(0)} °C here).${alts.length ? ' Alternatives: ' + alts.join('; ') + '.' : ''}</p>
        <p class="small"><a href="/ca/learn/water-heaters/">Water heaters compared →</a></p></div>`);
    }
    // cooling
    if (m.acKwh > 0) {
      const ep = R.prices.electricity.now;
      const old = a.ac === 'central-old';
      cards.push(`<div class="sys-card"><h4>Cooling: ${esc(m.acNote)}</h4>
        <p class="small">About <b>${Math.round(m.acKwh).toLocaleString('en-CA')} kWh</b> a summer (${money(m.acKwh * ep)}) with ${R.cdd} cooling degree-days near ${esc(R.name)}.${old ? ' An older central air conditioner is a natural time to switch to a heat pump: one unit then cools and heats.' : ''}</p>
        <p class="small"><a href="/ca/learn/air-conditioning/">Air conditioning and cooling →</a></p></div>`);
    }
    // windows
    if (a.win !== 'unsure') {
      const wk = winKey(a.win, a.age);
      const msg = (wk === 'single' || wk === 'singleStorm')
        ? 'Single glazing loses far more heat than an insulated wall, so replacement can pay here, but air sealing, attic and basement work usually pay faster. Storm windows are a cheaper middle step.'
        : wk === 'doubleClear'
          ? 'Older double-pane windows still work; replacing them mostly buys comfort and quiet. Do it when they fail or at a renovation, and seal around frames now.'
          : 'Your windows are already efficient; caulk and weatherstrip, and spend elsewhere first.';
      cards.push(`<div class="sys-card"><h4>Windows: ${esc((MODEL.envelope.windowU as any)[wk]?.label ?? wk)}</h4><p class="small">${msg}</p><p class="small"><a href="/ca/learn/windows-doors/">Windows and doors: when upgrades pay →</a></p></div>`);
    }
    // secondary heat
    if (a.sec.includes('woodstove') || ['wood', 'outdoorwood', 'pellet'].includes(a.heat)) {
      cards.push(`<div class="sys-card"><h4>Wood heat</h4><p class="small">Have a WETT-certified inspector check the stove, chimney and clearances (insurers usually ask), sweep as needed, and keep a working CO alarm. Wood and pellet costs vary too much to estimate; enter yours in the <a href="/ca/calculators/energy-costs/${esc(R.slug)}/">energy cost calculator</a>.</p><p class="small"><a href="/ca/tests/wood-burning-inspection/">Wood-burning inspections →</a></p></div>`);
    }
    if (a.sec.includes('spaceheaters')) {
      const ep = R.prices.electricity.now;
      cards.push(`<div class="sys-card"><h4>Electric space heaters</h4><p class="small">A 1,500 W heater costs about ${money(1.5 * ep * 100)} per 100 hours near ${esc(R.name)}. Needing one usually points to a draft, a cold room over a garage, or a duct problem worth finding.</p></div>`);
    }
    if (a.sec.includes('solar')) {
      cards.push(`<div class="sys-card"><h4>Free heat from the sun</h4><p class="small">Sunny south windows supply real heat on clear winter days. Our estimate allows for typical solar gain; if your bills come in lower than the typical range, this is one reason. Keep low-e coatings in mind when replacing south glass.</p><p class="small"><a href="/ca/learn/heating-systems/">Heating systems and solar gain →</a></p></div>`);
    }
    // previous audit
    if (a.prev === 'recent' || a.prev === 'older') {
      cards.push(`<div class="sys-card prev"><h4>You've had an evaluation before</h4><p class="small">Dig out the report: its upgrade list and blower-door number are still useful for planning. Whether it counts for rebates depends on the program. Ontario's Home Renovation Savings needs a first assessment dated January 28, 2025 or later, done by the same approved organization as the follow-up${a.prev === 'older' ? ', and renovations since your old report change the numbers' : ''}.</p><p class="small"><a href="/ca/learn/previous-audit/">What an old EnerGuide report is still good for →</a></p></div>`);
    }
    el.innerHTML = cards.length ? `<div class="rsec"><h3>Your home's systems</h3><p class="sub">Estimated at ${esc(R.name)}-area prices. Every number has a calculator behind it, pre-filled for your city.</p><div class="sys-grid">${cards.join('')}</div></div>` : '';
  }

  function renderMethod(m: ReturnType<typeof houseModel>, cal: any) {
    const R = m.R;
    $('#rMethod').innerHTML = `
      <details class="card card-pad method">
        <summary><strong>How we got these numbers</strong> <span class="small">(and why they're conservative)</span></summary>
        <p class="small">Your postal code ${R.exact ? `matched ${esc(R.name)}` : `isn't in one of the 70 cities we cover, so we used ${esc(R.name)}, the largest covered city in your province`}: ${R.hdd.toLocaleString('en-CA')} heating degree-days (NRCan HOT2000 weather data, the same data EnerGuide evaluations use) and local energy prices with taxes. A typical house like yours needs about <b>${Math.round(m.demand)} GJ</b> of heat a year (NRCan's heating need per square metre for your era, scaled to the local climate).${cal.calibrated ? ` Your bills point to about <b>${Math.round(cal.actualDemandGJ)} GJ</b>, so we scaled every saving by ${cal.factor.toFixed(2)}${cal.clamped ? ' (we cap the scaling between 0.5 and 1.6)' : ''}.` : ' Without your bills, we use the typical figure.'}</p>
        <p class="small">Each upgrade's saving comes from the physics of that part of the house (R-values, window U-values, air leakage) at your degree-days, then we multiply by 0.75 (0.4 for basements) because sun, people and appliances already supply free heat and real installations underperform their labels. Savings are valued at the price of your <em>next</em> unit of energy, without fixed monthly charges, which is lower than your average price.</p>
        <p class="small"><a href="/ca/calculators/upgrade-payback/${esc(R.slug)}/">Change any assumption in the upgrade calculator for ${esc(R.name)} →</a> · <a href="/ca/calculators/energy-costs/${esc(R.slug)}/">Compare heating systems →</a> · <a href="/ca/learn/real-numbers/">Worked examples with every step shown →</a></p>
      </details>`;
  }

  function findMeasure(category: string, era: string, heat: string) {
    const hk = heat === 'oil' ? 'oil' : heat === 'electric' ? 'electric' : 'gas';
    return D.savings.measures.find(
      (x: any) =>
        x.category === category &&
        (!x.eras?.length || x.eras.includes(era)) &&
        (!x.heatingTypes?.length || x.heatingTypes.includes(hk))
    );
  }

