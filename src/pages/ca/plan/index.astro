        <p class="sub">Every listing is a licensed service organization. Only assessments from the seven HRSP-approved organizations qualify for the $600 Home Renovation Savings rebate. <a href="/ca/find/${region.slug}/">Full ${esc(region.name)} directory →</a></p>
        <div class="mini-providers">${cards}</div>
      </div>`;
  }

  function renderResources(loc: any, syms: string[], arch: any) {
    const el = $('#rResources');
    const region = loc.kind === 'ca' ? loc.region : null;
    const items: string[] = [];
    if (region) items.push(`<li><a href="/ca/guides/${region.slug}/">The ${esc(region.name)} home energy guide</a> — local housing stock, rebates, and auditors in one place</li>`);
    items.push(`<li><a href="/ca/tests/">The complete home testing guide</a> — every test from blower doors to radon, and who performs each</li>`);
    items.push(`<li><a href="/ca/how-it-works/">What happens in an EnerGuide assessment</a> — the full walkthrough, step by step</li>`);
    items.push(`<li><a href="/ca/cost/">What an audit costs in Ontario</a> — real numbers, and the $600 rebate math</li>`);
    items.push(`<li><a href="/ca/programs/">The live program tracker</a> — every rebate verified against official pages</li>`);
    items.push(`<li><a href="https://natural-resources.canada.ca/energy-efficiency/home-energy-efficiency" rel="noopener" target="_blank">NRCan home energy efficiency hub ↗</a> — the official EnerGuide source</li>`);
    el.innerHTML = `
      <div class="rsec">
        <h3>Resources for your plan</h3>
        <ul class="res-list">${items.join('')}</ul>
      </div>`;
  }

  function prefillLead(arch: any, a: Answers, syms: string[], goals: string[], loc: any, testsList: string[], m: ReturnType<typeof houseModel>) {
    const where = loc.kind === 'ca' && loc.region ? loc.region.name : loc.kind === 'ca' ? (m.R.exact ? m.R.name : (loc.province ?? 'Canada')) : 'Ontario';
    const lines = [
      'My AuditYourHome plan summary:',
      `• Home: ${arch.years}, ${a.htype}, ${a.size}, heated by ${HEAT_NAME[a.heat] ?? a.heat}, in ${where}`,
      `• Water heater: ${a.wh === 'unsure' ? 'not sure' : (WH_NAME[whKey(a.wh, m.hi)] ?? a.wh)}; cooling: ${a.ac}; windows: ${a.win}`,
      a.prev === 'recent' || a.prev === 'older' ? `• Previous EnerGuide evaluation: yes (${a.prev === 'recent' ? 'last 3 years' : 'more than 3 years ago'})` : '',
      syms.length ? `• Issues: ${syms.join(', ')}` : '',
      goals.length ? `• Goals: ${goals.join(', ')}` : '',
      `• Tests to include in the audit: ${testsList.join('; ')}`,
      `• Full plan: ${location.href}`,
    ].filter(Boolean);
    const summary = lines.join('\n');
    const ta = document.querySelector<HTMLTextAreaElement>('#lead-form textarea[name="message"]');
    if (ta && !ta.value) ta.value = summary;
    const mailto = document.querySelector<HTMLAnchorElement>('#lead-form a[href^="mailto:"]');
    if (mailto) {
      const base = mailto.href.split('&body=')[0];
      mailto.href = `${base}&body=${encodeURIComponent(summary)}`;
    }
  }

  // ---------- restart / share / prefill ----------
  document.getElementById('restartBtn')?.addEventListener('click', () => {
    resultsEl.hidden = true;
    plannerEl.hidden = false;
    history.replaceState(null, '', location.pathname);
    show(1);
  });
  document.getElementById('copyLink')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(location.href);
      btn.textContent = 'Link copied ✓';
      setTimeout(() => (btn.textContent = 'Copy link to this plan'), 2000);
    } catch { btn.textContent = location.href; }
  });

  (function prefill() {
    const q = new URLSearchParams(location.search);
    if (!q.size) return;
    const set = (name: string, val: string | null) => {
      if (!val) return;
      const radio = form.querySelector<HTMLInputElement>(`[name="${name}"][value="${CSS.escape(val)}"]`);
      if (radio) radio.checked = true;
      else {
        const input = form.querySelector<HTMLInputElement>(`input[name="${name}"]:not([type=radio]):not([type=checkbox])`);
        if (input) input.value = val;
      }
    };
    set('postal', q.get('postal'));
    set('age', q.get('age'));
    set('htype', q.get('htype'));
    set('size', q.get('size'));
    set('heat', q.get('heat'));
    set('hage', q.get('hage'));
    set('wh', q.get('wh'));
    set('ac', q.get('ac'));
    set('win', q.get('win'));
    set('prev', q.get('prev'));
    set('water', q.get('water'));
    set('gasBill', q.get('gas'));
    set('elecBill', q.get('elec'));
    set('otherBill', q.get('other'));
    if (q.get('gas')) touched.gas = true;
    if (q.get('elec')) touched.elec = true;
    if (q.get('other')) touched.other = true;
    (q.get('sec') ?? '').split(',').filter(Boolean).forEach((v) => set('sec', v));
    (q.get('sym') ?? '').split(',').filter(Boolean).forEach((v) => set('sym', v));
    (q.get('goal') ?? '').split(',').filter(Boolean).forEach((v) => set('goal', v));
    if (q.get('done') === '1' && q.get('age')) finish();
  })();
</script>
