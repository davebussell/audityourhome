    padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    background: var(--card); border-top: 1px solid var(--line-strong); box-shadow: 0 -4px 16px rgba(26, 36, 48, 0.08);
  }
  .sticky-cta .sc-t { font-size: 14px; font-weight: 600; min-width: 0; line-height: 1.35; }
  /* a short label ("Get matched") stays on one line; a program name wraps inside the button */
