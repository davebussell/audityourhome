          <a href="/ca/programs/${p.slug}/">${esc(p.shortName)}</a>
          <span class="chip ${p.auditRequired ? 'chip-info' : 'chip-neutral'}">${p.auditRequired ? 'audit required' : 'no audit required'}</span>
          <span class="hl">${esc(p.headline)}</span>
        </div>`).join('');
      html = `<h3>Programs you likely qualify for</h3><p class="sub">Verified against official pages — <a href="/ca/programs/">full tracker here</a>.</p><div class="card card-pad">${rows}</div>`;
    }
    el.innerHTML = `<div class="rsec">${html}</div>`;
  }

  function renderIssues(syms: string[]) {
