        <details class="rsec-collapse">
          <summary>Show the ${nEnergy} energy tests and what each result means</summary>
          <div class="test-grid">${cards}</div>
        </details>
        ${flagCards ? `<h3 class="spec-h">Health and safety tests for your home</h3>
        <p class="sub">Screened from your answers: era, heating, water source and symptoms. These aren’t part of a standard energy audit.</p>
        ${strongLine}
        <details class="rsec-collapse">
          <summary>Show the ${nHealth} health and safety test${nHealth === 1 ? '' : 's'} and what each result means</summary>
          <p class="badge-legend"><b>Flagged for your home:</b> your answers point straight to it. <b>Flagged:</b> likely relevant for a home like yours. <b>Recommended:</b> good practice for any home.</p>
          <div class="test-grid">${flagCards}</div>
        </details>` : ''}
        <button type="button" class="btn btn-ghost btn-sm" id="copyTests">Copy my test checklist</button>
      </div>`;
    wireCopy('copyTests');
  }

  function wireCopy(id: string) {
    document.getElementById(id)?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const label = btn.textContent;
      try {
        await navigator.clipboard.writeText('Tests to include in my home energy audit:\n' + checklist.map((n) => '• ' + n).join('\n'));
        btn.textContent = 'Checklist copied ✓';
        setTimeout(() => (btn.textContent = label), 2000);
      } catch {}
    });
  }

  function renderProviders(ctx: Ctx) {
