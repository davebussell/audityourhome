---
import Base from '../../../layouts/Base.astro';
import LeadForm from '../../../components/LeadForm.astro';
import AccountSignup from '../../../components/AccountSignup.astro';
import { SITE, ACCOUNTS_ENABLED } from '../../../config/site';
import { breadcrumbSchema } from '../../../lib/schema';
import archetypes from '../../../data/archetypes.json';
import issues from '../../../data/issues.json';
import savings from '../../../data/savings.json';
import rates from '../../../data/rates.json';
import tests from '../../../data/tests.json';
import { regions, providers, programs, reviewLinks } from '../../../lib/data';
import { CALC_CITIES, PROVINCE_ORDER, resolvePrices, enginePrices } from '../../../lib/calc/data';
import { MODEL } from '../../../lib/calc/engine';
import localData from '../../../../tools/local-pages/out/cities.json';

const title = 'Home Energy Planner — what your home needs, what it saves | AuditYourHome';
const description =
  'Answer six quick questions about your home and bills. Get a read on what’s behind your walls, your upgrade sequence with conservative savings for your area, live rebates, and registered advisors near you.';

const payload = {
  archetypes,
  issues: issues.map((i) => ({ slug: i.slug, name: i.name, categories: i.categories })),
  savings,
  rates,
  regions: regions.map((r) => ({ slug: r.slug, name: r.name, fsa: r.fsaPrefixes })),
  tests,
  providers: providers.map((p) => ({
    slug: p.slug,
    name: p.name,
    type: p.type,
    serves: p.serves,
    phone: p.phone,
    website: p.website,
    pricing: p.pricing ? `${p.pricing.preRetrofit} initial · ${p.pricing.postRetrofit} follow-up` : null,
    registration: p.registration,
    hrsApproved: p.hrsApproved,
    reviews: reviewLinks(p),
  })),
  programs: programs
    .filter((p) => p.status !== 'closed')
    .map((p) => ({ id: p.id, slug: p.slug, shortName: p.shortName, headline: p.headline, auditRequired: p.auditRequired, jurisdiction: p.jurisdiction })),
};

// ---- region data for the estimator: climate + prices for each covered city, FSA → city, province → biggest city
const calcCities: Record<string, unknown> = {};
for (const c of CALC_CITIES) {
  calcCities[c.slug] = {
    n: c.label ?? c.name, p: c.prov, hdd: c.hot2000.hdd, cdd: c.eccc.cdd18,
    dc: c.hot2000.designCool ?? 29, am: c.eccc.annualMean, pr: enginePrices(resolvePrices(c)),
  };
}
const fsaCity: Record<string, string> = {};
for (const c of (localData as { cities: { slug: string; fsas?: string[] }[] }).cities) {
  for (const f of c.fsas ?? []) if (!fsaCity[f]) fsaCity[f] = c.slug;
}
const provRep: Record<string, string> = {};
for (const prov of PROVINCE_ORDER) {
  const list = CALC_CITIES.filter((c) => c.prov === prov).sort((a, b) => b.population - a.population);
  if (list[0]) provRep[prov] = list[0].slug;
}
(payload as Record<string, unknown>).calc = { cities: calcCities, fsa: fsaCity, provRep, baseKwh: rates.ontario.benchmarks.gasHeatedElecKwh, sizeMult: rates.ontario.benchmarks.sizeMultiplier };

// province price table for the assumptions section
const PROV_NAME: Record<string, string> = { BC: 'British Columbia', AB: 'Alberta', SK: 'Saskatchewan', MB: 'Manitoba', ON: 'Ontario', QC: 'Quebec', NB: 'New Brunswick', NS: 'Nova Scotia', PE: 'Prince Edward Island', NL: 'Newfoundland and Labrador', YT: 'Yukon', NT: 'Northwest Territories' };
const priceRows = PROVINCE_ORDER.filter((p) => provRep[p]).map((prov) => {
  const city = CALC_CITIES.find((c) => c.slug === provRep[prov])!;
  const rp = resolvePrices(city);
  return { prov: PROV_NAME[prov] ?? prov, city: city.label ?? city.name, elecAvg: rp.elec.avg, elecVar: rp.elec.variable, gasNow: rp.gas?.now ?? null, gasVar: rp.gas?.variable ?? null, oil: rp.oil?.perL ?? null };
});
const intensityRows = Object.entries(MODEL.demand.intensityGJperM2 as Record<string, number>);
const pricesAsOf = new Date(String(MODEL.asOf) + 'T12:00:00').toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' });

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/ca/' },
    { name: 'Home Energy Planner', path: '/ca/plan/' },
  ]),
];

// ---- visible assumptions table (same data the estimator reads)
const bm = rates.ontario.benchmarks;
const fmtN = (n: number) => n.toLocaleString('en-CA');
const pctN = (x: number) => `${Math.round(x * 100)}%`;
const ERA_LABEL: Record<string, string> = {
  'pre-1946': 'before 1946', '1946-1965': '1946–1965', '1966-1980': '1966–1980',
  '1981-1995': '1981–1995', '1996-2010': '1996–2010', '2011-plus': '2011 or later',
};
const SIZE_LABEL: Record<string, string> = { small: 'small', medium: 'medium', large: 'large', xlarge: 'very large' };
---

<Base title={title} description={description} schema={schema}>
  <div class="container">
    <div class="page-hero">
      <p class="eyebrow">Home Energy Planner</p>
      <h1>What does <em>your</em> home actually need?</h1>
      <p class="lede">
        Six quick questions. No email required. You'll get the likely story behind your walls, a
        prioritized upgrade plan with estimated savings, the rebates that are live right now, and
        registered advisors for your area.
      </p>
    </div>

    <div class="planner card" id="planner">
      <!-- progress -->
      <ol class="steps-nav" id="stepsNav" aria-label="Planner steps">
        <li data-step="1" class="on">Location</li>
        <li data-step="2">Your home</li>
        <li data-step="3">Heating</li>
        <li data-step="4">Symptoms</li>
        <li data-step="5">Goals</li>
        <li data-step="6">Bills</li>
      </ol>

      <form id="plannerForm" novalidate>
        <!-- STEP 1 -->
        <fieldset class="step on" data-step="1">
          <legend><h2>Where's the house?</h2></legend>
          <div class="field narrow">
            <label for="postal">Postal code (or US ZIP)</label>
            <input id="postal" name="postal" type="text" placeholder="e.g. M4E 2V5" autocomplete="postal-code" />
            <p class="small hint">We use this to match programs and advisors for your area. {ACCOUNTS_ENABLED ? 'It stays in your browser unless you save your plan or ask to be matched.' : 'It isn’t stored or sent anywhere.'}</p>
          </div>
        </fieldset>

        <!-- STEP 2 -->
        <fieldset class="step" data-step="2">
          <legend><h2>Tell us about the house</h2></legend>
          <div class="field">
            <span class="lbl">When was it built? <span class="hint-inline">(best guess is fine)</span></span>
            <div class="radio-row" role="radiogroup" aria-label="Year built">
              <label class="radio-pill"><input type="radio" name="age" value="pre-1946" /><span>Before 1946</span></label>
              <label class="radio-pill"><input type="radio" name="age" value="1946-1965" /><span>1946–1965</span></label>
              <label class="radio-pill"><input type="radio" name="age" value="1966-1980" /><span>1966–1980</span></label>
              <label class="radio-pill"><input type="radio" name="age" value="1981-1995" /><span>1981–1995</span></label>
              <label class="radio-pill"><input type="radio" name="age" value="1996-2010" /><span>1996–2010</span></label>
              <label class="radio-pill"><input type="radio" name="age" value="2011-plus" /><span>2011 or later</span></label>
            </div>
          </div>
          <div class="field">
            <span class="lbl">Home type</span>
            <div class="radio-row" role="radiogroup" aria-label="Home type">
              <label class="radio-pill"><input type="radio" name="htype" value="detached" checked /><span>Detached</span></label>
              <label class="radio-pill"><input type="radio" name="htype" value="semi" /><span>Semi / townhome</span></label>
              <label class="radio-pill"><input type="radio" name="htype" value="condo" /><span>Condo / apartment</span></label>
            </div>
          </div>
          <div class="field">
            <span class="lbl">Rough size</span>
            <div class="radio-row" role="radiogroup" aria-label="Home size">
              <label class="radio-pill"><input type="radio" name="size" value="small" /><span>Under 1,200 sq ft</span></label>
              <label class="radio-pill"><input type="radio" name="size" value="medium" checked /><span>1,200–2,000</span></label>
              <label class="radio-pill"><input type="radio" name="size" value="large" /><span>2,000–3,000</span></label>
              <label class="radio-pill"><input type="radio" name="size" value="xlarge" /><span>Over 3,000</span></label>
            </div>
          </div>
          <div class="field">
            <span class="lbl">Water source <span class="hint-inline">(flags well-water testing)</span></span>
            <div class="radio-row" role="radiogroup" aria-label="Water source">
              <label class="radio-pill"><input type="radio" name="water" value="municipal" checked /><span>Municipal</span></label>
              <label class="radio-pill"><input type="radio" name="water" value="well" /><span>Private well</span></label>
              <label class="radio-pill"><input type="radio" name="water" value="unsure" /><span>Not sure</span></label>
            </div>
          </div>
          <div class="field">
            <span class="lbl">Most of the windows are… <span class="hint-inline">(window age changes the math)</span></span>
            <div class="radio-row" role="radiogroup" aria-label="Windows">
              <label class="radio-pill"><input type="radio" name="win" value="single" /><span>Single-pane</span></label>
              <label class="radio-pill"><input type="radio" name="win" value="singlestorm" /><span>Single-pane + storms</span></label>
              <label class="radio-pill"><input type="radio" name="win" value="double-old" /><span>Double-pane, before 2000</span></label>
              <label class="radio-pill"><input type="radio" name="win" value="double-new" /><span>Double-pane, 2000 or later</span></label>
              <label class="radio-pill"><input type="radio" name="win" value="triple" /><span>Triple-pane / recent ENERGY STAR</span></label>
              <label class="radio-pill"><input type="radio" name="win" value="unsure" checked /><span>Not sure</span></label>
            </div>
          </div>
          <div class="field">
            <span class="lbl">Has the house had an EnerGuide evaluation (energy audit) before?</span>
            <div class="radio-row" role="radiogroup" aria-label="Previous energy evaluation">
              <label class="radio-pill"><input type="radio" name="prev" value="no" checked /><span>No</span></label>
              <label class="radio-pill"><input type="radio" name="prev" value="recent" /><span>Yes, in the last 3 years</span></label>
              <label class="radio-pill"><input type="radio" name="prev" value="older" /><span>Yes, longer ago</span></label>
              <label class="radio-pill"><input type="radio" name="prev" value="unsure" /><span>Not sure</span></label>
            </div>
          </div>
        </fieldset>

        <!-- STEP 3 -->
        <fieldset class="step" data-step="3">
          <legend><h2>Heating, hot water and cooling</h2></legend>
          <div class="field">
            <span class="lbl">Main heating</span>
            <div class="radio-row wrap" role="radiogroup" aria-label="Main heating">
              <label class="radio-pill"><input type="radio" name="heat" value="gas" checked /><span>Gas furnace</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="gasboiler" /><span>Gas boiler (radiators / in-floor)</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="electric" /><span>Electric baseboard</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="elecfurnace" /><span>Electric furnace or boiler</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="heatpump" /><span>Air-source heat pump</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="geothermal" /><span>Geothermal heat pump</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="oil" /><span>Oil furnace or boiler</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="propane" /><span>Propane</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="wood" /><span>Wood stove or wood furnace</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="outdoorwood" /><span>Outdoor wood boiler</span></label>
              <label class="radio-pill"><input type="radio" name="heat" value="pellet" /><span>Pellet stove</span></label>
            </div>
          </div>
          <div class="field" id="heatAgeField">
            <span class="lbl">How old is it?</span>
            <div class="radio-row" role="radiogroup" aria-label="Age of the heating system">
              <label class="radio-pill"><input type="radio" name="hage" value="new" /><span>Under 15 years</span></label>
              <label class="radio-pill"><input type="radio" name="hage" value="old" /><span>15 years or more</span></label>
              <label class="radio-pill"><input type="radio" name="hage" value="unsure" checked /><span>Not sure</span></label>
            </div>
          </div>
          <div class="field">
            <span class="lbl">Also heated by… <span class="hint-inline">(optional)</span></span>
            <div class="radio-row wrap">
              <label class="radio-pill"><input type="checkbox" name="sec" value="woodstove" /><span>Wood stove or fireplace</span></label>
              <label class="radio-pill"><input type="checkbox" name="sec" value="spaceheaters" /><span>Electric space heaters</span></label>
              <label class="radio-pill"><input type="checkbox" name="sec" value="solar" /><span>Lots of sunny south windows</span></label>
            </div>
          </div>
          <div class="field">
            <span class="lbl">Water heater</span>
            <div class="radio-row wrap" role="radiogroup" aria-label="Water heater">
              <label class="radio-pill"><input type="radio" name="wh" value="gastank" /><span>Gas tank</span></label>
              <label class="radio-pill"><input type="radio" name="wh" value="gastankless" /><span>Gas tankless (on-demand)</span></label>
              <label class="radio-pill"><input type="radio" name="wh" value="electric" /><span>Electric tank</span></label>
              <label class="radio-pill"><input type="radio" name="wh" value="heatpump" /><span>Heat pump water heater</span></label>
              <label class="radio-pill"><input type="radio" name="wh" value="oil" /><span>Oil-fired tank</span></label>
              <label class="radio-pill"><input type="radio" name="wh" value="boiler" /><span>From the boiler (combi)</span></label>
              <label class="radio-pill"><input type="radio" name="wh" value="unsure" checked /><span>Not sure</span></label>
            </div>
          </div>
          <div class="field">
            <span class="lbl">Cooling</span>
            <div class="radio-row wrap" role="radiogroup" aria-label="Cooling">
              <label class="radio-pill"><input type="radio" name="ac" value="none" /><span>No air conditioning</span></label>
              <label class="radio-pill"><input type="radio" name="ac" value="central-new" /><span>Central AC, under 10 years</span></label>
              <label class="radio-pill"><input type="radio" name="ac" value="central-old" /><span>Central AC, 10+ years</span></label>
              <label class="radio-pill"><input type="radio" name="ac" value="room" /><span>Window or portable units</span></label>
              <label class="radio-pill"><input type="radio" name="ac" value="heatpump" /><span>The heat pump cools</span></label>
              <label class="radio-pill"><input type="radio" name="ac" value="unsure" checked /><span>Not sure</span></label>
            </div>
          </div>
        </fieldset>

        <!-- STEP 4 -->
        <fieldset class="step" data-step="4">
          <legend><h2>Anything bugging you about the house?</h2></legend>
          <p class="small">Pick everything that applies — this tunes your plan.</p>
          <div class="radio-row wrap" id="symptomRow">
            <label class="radio-pill"><input type="checkbox" name="sym" value="drafty-rooms" /><span>Drafts / cold rooms</span></label>
            <label class="radio-pill"><input type="checkbox" name="sym" value="high-heating-bills" /><span>High heating bills</span></label>
            <label class="radio-pill"><input type="checkbox" name="sym" value="ice-dams" /><span>Ice dams / icicles</span></label>
            <label class="radio-pill"><input type="checkbox" name="sym" value="cold-second-floor" /><span>2nd floor hot/cold</span></label>
            <label class="radio-pill"><input type="checkbox" name="sym" value="condensation-mould" /><span>Condensation / musty air</span></label>
            <label class="radio-pill"><input type="checkbox" name="sym" value="cold-basement" /><span>Cold basement</span></label>
            <label class="radio-pill"><input type="checkbox" name="sym" value="summer-overheating" /><span>Won't stay cool in summer</span></label>
          </div>
        </fieldset>

        <!-- STEP 5 -->
        <fieldset class="step" data-step="5">
          <legend><h2>What are you hoping to do?</h2></legend>
          <div class="radio-row wrap">
            <label class="radio-pill"><input type="checkbox" name="goal" value="bills" checked /><span>Lower my bills</span></label>
            <label class="radio-pill"><input type="checkbox" name="goal" value="comfort" /><span>Fix comfort problems</span></label>
            <label class="radio-pill"><input type="checkbox" name="goal" value="heatpump" /><span>Get a heat pump</span></label>
            <label class="radio-pill"><input type="checkbox" name="goal" value="solar" /><span>Add solar</span></label>
            <label class="radio-pill"><input type="checkbox" name="goal" value="buying" /><span>Buying / just bought</span></label>
            <label class="radio-pill"><input type="checkbox" name="goal" value="reno" /><span>Renovating (opening walls/trim)</span></label>
            <label class="radio-pill"><input type="checkbox" name="goal" value="emissions" /><span>Cut emissions</span></label>
          </div>
        </fieldset>

        <!-- STEP 6 -->
        <fieldset class="step" data-step="6">
          <legend><h2>Add your bills for dollar estimates <span class="hint-inline">(optional)</span></h2></legend>
          <p class="small">
            We've pre-set these to a typical home of your size and era — drag to match your actual
            bills (a typical month across the year). Leave them as-is and we'll estimate from the
            typical figures.
          </p>
          <div class="sliders">
            <div class="field slider-field" id="gasField">
              <label for="gasBill">Average monthly natural gas bill <output id="gasOut" for="gasBill">$0</output></label>
              <input id="gasBill" name="gasBill" type="range" min="0" max="400" step="5" value="0" />
              <p class="meta slider-hint" id="gasHint">$0 = no gas service</p>
            </div>
            <div class="field slider-field">
              <label for="elecBill">Average monthly electricity bill <output id="elecOut" for="elecBill">$0</output></label>
              <input id="elecBill" name="elecBill" type="range" min="0" max="600" step="5" value="0" />
              <p class="meta slider-hint">Drag to match a recent bill</p>
            </div>
            <div class="field slider-field" id="otherField" hidden>
              <label for="otherBill">Average monthly oil, propane or wood spend <output id="otherOut" for="otherBill">$0</output></label>
              <input id="otherBill" name="otherBill" type="range" min="0" max="600" step="5" value="0" />
              <p class="meta slider-hint">Your yearly fuel spend ÷ 12</p>
            </div>
          </div>
          <p class="small bill-note">
            Why we ask: estimates based on a "typical" house can be far from your real bills. With
            your bills, every saving below is scaled to how much energy your house actually uses.
          </p>
        </fieldset>

        <div class="wizard-actions">
          <button type="button" class="btn btn-ghost" id="backBtn" hidden>Back</button>
          <button type="button" class="btn btn-primary" id="nextBtn">Next</button>
        </div>
      </form>
    </div>

    <!-- RESULTS -->
    <div id="results" hidden>
      <div class="results-head">
        <p class="eyebrow">Your plan</p>
        <h2 id="rTitle">Your home's energy profile</h2>
        <p class="small" id="rSub"></p>
      </div>

      <div id="rBenchmark"></div>
      <div class="grid-2 profile-grid">
        <div class="card card-pad" id="rWalls"></div>
        <div class="card card-pad" id="rWatch"></div>
      </div>
      <div id="rSequence"></div>
      <div id="rSystems"></div>
      <div id="rMethod"></div>
      <div id="rTests"></div>
      <div id="rPrograms"></div>
      <div id="rIssues"></div>
      <div id="rProviders"></div>
      <div id="rResources"></div>

      <div class="card card-pad audit-cta" id="rAuditCta">
        <h3>Estimates end where the audit begins</h3>
        <p>
          Everything above is based on how homes like yours typically perform (scaled to your bills
          if you entered them), not a model of your actual house. An EnerGuide evaluation (blower door test, thermal imaging, room-by-room
          heat-loss model) turns these ranges into numbers for <em>your</em> address, and it's the
          required first step for the biggest rebates. In Ontario, the $600 Home Renovation Savings
          rebate covers most of its cost if you book one of the seven HRSP-approved organizations and
          install at least two recommended upgrades.
        </p>
      </div>

      {ACCOUNTS_ENABLED && <AccountSignup mode="plan" />}

      <LeadForm
        heading="Want this plan handled?"
        sub="Send us your plan summary and we'll connect you with a registered service organization for your area."
        context="planner"
      />

      <p class="small disclaimer">
        Estimates are ranges based on how similar Canadian homes perform, your area's climate and
        energy prices, and the assumptions <a href="#assumptions">listed below</a>. They are deliberately
        conservative and are not a guarantee of savings. Program details change — confirm on official pages before spending.
        {ACCOUNTS_ENABLED
          ? 'The planner runs in your browser. Nothing you enter is stored unless you save your plan to My Home or ask to be matched.'
          : 'Nothing you enter here is stored or transmitted; the planner runs entirely in your browser.'}
      </p>
      <div class="wizard-actions">
        <button type="button" class="btn btn-ghost" id="restartBtn">Start over</button>
        <button type="button" class="btn btn-ghost" id="copyLink">Copy link to this plan</button>
      </div>
    </div>

    <section class="assumptions" id="assumptions">
      <h2>How the planner estimates, and the assumptions behind it</h2>
      <p class="small measure">
        Kept deliberately conservative. Your postal code picks the nearest of the 70 cities we cover
        (or your province's largest city), which sets the climate (heating degree-days from NRCan's
        HOT2000 weather data, the same data EnerGuide uses) and the energy prices. If you enter your
        bills, the heating estimate is scaled to them (within 0.5× to 1.6× of a typical house) and
        every saving is scaled the same way. An EnerGuide evaluation replaces all of this with
        measurements. Prices as of {pricesAsOf}.
      </p>
      <div class="tablewrap card">
        <table class="stack">
          <caption>Heating need of a typical house, by era</caption>
          <thead><tr><th>Built</th><th>Heat needed per m² of floor, at 4,200 degree-days</th></tr></thead>
          <tbody>
            {intensityRows.map(([k, v]) => (
              <tr><td data-label="Built">{ERA_LABEL[k] ?? k}</td><td data-label="Heat needed">{v} GJ/m² a year</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small measure">
        From NRCan's Comprehensive Energy Use Database (heating need per floor area by construction
        period), scaled to your city's degree-days and checked against NRCan's typical heating loads
        for Ottawa and Toronto houses. Semi-detached houses use 90% and row houses 80% of the detached
        figure. Upgrade savings use the physics of each part of the house (insulation R-values, window
        U-values, air leakage) with your local degree-days, then multiply by 0.75 above grade and 0.4
        for basement walls to stay conservative. No single upgrade is credited with more than 35% of
        your heating, and all of them together with no more than 60%. Savings are valued at the price
        of one more unit of energy (excluding fixed monthly charges), which is lower than your average
        price.
      </p>
      <div class="tablewrap card">
        <table class="stack">
          <caption>Energy prices used (largest covered city in each province; taxes in)</caption>
          <thead><tr><th>Province</th><th>Electricity, average</th><th>Electricity, next kWh</th><th>Natural gas, average</th><th>Natural gas, next m³</th><th>Heating oil</th></tr></thead>
          <tbody>
            {priceRows.map((r) => (
              <tr>
                <td data-label="Province"><strong>{r.prov}</strong> <span class="small">({r.city})</span></td>
                <td data-label="Electricity, average">${r.elecAvg.toFixed(3)}/kWh</td>
                <td data-label="Electricity, next kWh">${r.elecVar.toFixed(3)}/kWh</td>
                <td data-label="Gas, average">{r.gasNow !== null ? `$${r.gasNow.toFixed(3)}/m³` : 'no gas grid'}</td>
                <td data-label="Gas, next m³">{r.gasVar !== null ? `$${r.gasVar.toFixed(3)}/m³` : '—'}</td>
                <td data-label="Heating oil">{r.oil !== null ? `$${r.oil.toFixed(2)}/L` : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small measure">
        Electricity for lights, appliances and electronics is assumed at {fmtN(bm.gasHeatedElecKwh)} kWh a year for a
        medium house, scaled by size. Hot water uses 75 litres per person a day, heated from your
        area's average cold-water temperature to 55 °C. Air conditioning uses NRCan's cooling-hours
        method with your area's cooling degree-days, times 0.8. Every city's numbers, sources and
        formulas are laid out in the <a href="/ca/calculators/">calculators</a>, and
        <a href="/ca/learn/real-numbers/">worked examples</a> show the arithmetic step by step.
      </p>
    </section>
  </div>

  <script type="application/json" id="planner-data" set:html={JSON.stringify(payload)} />
</Base>

