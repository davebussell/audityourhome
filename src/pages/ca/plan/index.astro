    const b = bookingFor(ctx);
    const cityName = ctx.city?.n ?? ctx.R.name;
    const count = ctx.city?.providers ?? 0;
    if (!region) {
      const list = count
        ? `<a href="/ca/services/home-energy-audit/${esc(ctx.R.slug)}/#providers">See the ${count} licensed organization${count === 1 ? '' : 's'} serving ${esc(cityName)} →</a>`
        : `<a href="/ca/services/home-energy-audit/${esc(ctx.R.slug)}/">Home energy audits in ${esc(cityName)} →</a>`;
      const route = b?.bookWith
        ? `<p class="sub">In ${esc(ctx.provName)}, evaluations are booked ${esc(b.route.replace(/^Through /, 'through ').replace(/^Start with /, 'starting with '))}: <a href="${esc(b.bookWith.href)}" rel="noopener" target="_blank">${esc(shortLabel(b.bookWith.label))} ↗</a></p>`
        : '';
      el.innerHTML = `<div class="rsec"><h3>Find a registered energy advisor${ctx.R.exact ? ` in ${esc(cityName)}` : ''}</h3>
        ${route}
        <p class="sub">Every listing is an NRCan-licensed service organization whose registered energy advisors do EnerGuide evaluations.${ctx.R.exact ? '' : ` ${esc(cityName)} is the closest city we cover; organizations there often serve the surrounding area, so check their coverage.`}</p>
