---
import Base from '../../../layouts/Base.astro';
import Photo from '../../../components/Photo.astro';
import { ogFor } from '../../../lib/photos';
import LeadForm from '../../../components/LeadForm.astro';
import JourneyBar from '../../../components/JourneyBar.astro';
import { breadcrumbSchema, faqSchema } from '../../../lib/schema';
import issuesData from '../../../data/issues.json';
import { programs } from '../../../lib/data';

export function getStaticPaths() {
  return issuesData.map((i) => ({ params: { slug: i.slug } }));
}

const { slug } = Astro.params;
const issue = issuesData.find((i) => i.slug === slug)!;
const related = programs.filter((p) => (issue.programIds as string[]).includes(p.id) && p.status !== 'closed');
/** Optional fields: regional notes, who to call, related guides and sources (wildfire smoke, summer overheating). */
const extra = issue as typeof issue & {
  regional?: { region: string; text: string }[];
  whoToCall?: string[];
  related?: { label: string; href: string }[];
  sources?: { label: string; url: string }[];
};

const title = issue.programIds.length
  ? `${issue.name} — causes, fixes and rebates | AuditYourHome`
  : `${issue.name} — causes, fixes and who to call | AuditYourHome`;
/** The programs listed here are Ontario's (plus Toronto's and federal ones): say so on each line. */
const JURIS: Record<string, string> = { ontario: 'Ontario', toronto: 'Toronto only', canada: 'Canada-wide' };
const description = issue.metaDescription;

const faqs = [
  { q: `What causes ${issue.name.toLowerCase()}?`, a: issue.likelyCauses.join(' ') },
  { q: 'What would an energy audit find?', a: issue.auditMeasures.join(' ') },
  ...(extra.whoToCall?.length ? [{ q: 'Who should I call?', a: extra.whoToCall.join(' ') }] : []),
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/ca/' },
    { name: 'Fix an issue', path: '/ca/issues/' },
    { name: issue.name, path: `/ca/issues/${issue.slug}/` },
  ]),
  faqSchema(faqs),
];
const ISSUE_PHOTO: Record<string, string> = {
  'drafty-rooms': 'thermal-imaging',
  'high-heating-bills': 'energy-bill-analysis',
  'ice-dams': 'attic-insulation-inspection',
  'cold-second-floor': 'duct-leakage-testing',
  'condensation-mould': 'mold-testing',
  'cold-basement': 'ventilation-assessment',
  'summer-overheating': 'attic-insulation-inspection',
  'switching-to-heat-pump': 'heat-loss-calculation',
  'planning-solar': 'energy-bill-analysis',
  'buying-a-home': 'home-hero',
  'wildfire-smoke': 'ventilation-assessment',
};
const heroPhoto = ISSUE_PHOTO[slug ?? ''] ?? 'home-hero';
---

<Base title={title} description={description} schema={schema} ogImage={ogFor(heroPhoto)}>
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/ca/issues/">Fix an issue</a> <span aria-hidden="true">/</span> <span>{issue.name}</span>
    </nav>

    <div class="page-hero has-photo">
      <div class="hero-text">
      <h1>{issue.name}</h1>
      <p class="lede measure">{issue.symptom}</p>
      <p class="small plan-link">See how this fits your house: <a href="/ca/plan/">get your free plan →</a> (six short steps, no email)</p>
      </div>
      <Photo name={heroPhoto} eager />
    </div>

    <div class="jb-wrap"><JourneyBar country="ca" current={1} ticks={false} compact /></div>

    <div class="grid-2">
      <div class="card card-pad">
        <h3>What it usually means</h3>
        <ul class="clean">
          {issue.likelyCauses.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="card card-pad">
        <h3>What an audit measures</h3>
        <ul class="clean">
          {issue.auditMeasures.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>

    <div class="grid-2" style="margin-top: 18px;">
      <div class="card card-pad">
        <h3>Try first (cheap or free)</h3>
        <ul class="clean check">
          {issue.diyFirst.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="card card-pad">
        <h3>The fix ladder</h3>
        <ol class="ladder">
          {issue.fixLadder.map((f) => (
            <li>
              <span>{f.step}</span>
              <span class="cost meta">{f.cost}</span>
            </li>
          ))}
        </ol>
        <p class="meta">$ = under ~$1k · $$ = $1k–$5k · $$$ = $5k+ · $$$$ = $15k+</p>
      </div>
    </div>

    {extra.regional && extra.regional.length > 0 && (
      <section class="card card-pad regional" aria-labelledby="regional-h">
        <h3 id="regional-h">Where you live changes the answer</h3>
        <div class="reg-grid">
          {extra.regional.map((r) => (
            <div class="reg"><p class="reg-name">{r.region}</p><p class="mb-0">{r.text}</p></div>
          ))}
        </div>
      </section>
    )}

    {extra.whoToCall && extra.whoToCall.length > 0 && (
      <div class="card card-pad who">
        <h3>Who to call</h3>
        <ul class="clean">
          {extra.whoToCall.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    )}

    {extra.related && extra.related.length > 0 && (
      <div class="issue-related">
        {extra.related.map((r) => <a class="btn btn-ghost" href={r.href}>{r.label} →</a>)}
      </div>
    )}

    {related.length > 0 && (
      <div class="card card-pad rel">
        <h3>Rebates that apply</h3>
        <ul class="clean">
          {related.map((p) => (
            <li>
              <a href={`/ca/programs/${p.slug}/`}><strong>{p.shortName}</strong></a>
              {JURIS[p.jurisdiction] && <span class="chip chip-neutral juris">{JURIS[p.jurisdiction]}</span>} — {p.headline}
            </li>
          ))}
        </ul>
        <p class="small rel-more">
          {related.some((p) => p.jurisdiction === 'ontario' || p.jurisdiction === 'toronto') && 'Outside Ontario? '}
          <a href="/ca/programs/">See the rebates in your province or territory →</a>
        </p>
      </div>
    )}

    {extra.sources && extra.sources.length > 0 && (
      <div class="card card-pad srcs">
        <h3>Sources</h3>
        <ul class="clean">
          {extra.sources.map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}
        </ul>
      </div>
    )}

    <LeadForm
      heading="Want it diagnosed properly?"
      sub="A registered energy advisor measures instead of guessing — blower door, thermal imaging, and a written upgrade report priced against rebates."
      context={`issue-${issue.slug}`}
    />
  </div>
</Base>

<style>
  .crumbs { padding-top: 24px; font-size: 13.5px; color: var(--faint); }
  .jb-wrap { margin-bottom: 22px; }
  .crumbs a { color: var(--muted); }
  ul.clean { margin: 0; padding-left: 20px; display: grid; gap: 8px; font-size: 15px; }
  ul.clean.check { list-style: none; padding-left: 0; }
  ul.clean.check li { padding-left: 26px; position: relative; }
  ul.clean.check li::before { content: "✓"; position: absolute; left: 0; color: var(--pine); font-weight: 700; }
  .ladder { margin: 0 0 10px; padding-left: 22px; display: grid; gap: 10px; font-size: 15px; }
  .ladder li { display: flex; justify-content: space-between; gap: 14px; }
  .rel { border-left: 4px solid var(--pine); margin-top: 18px; }
  .rel .juris { margin-left: 6px; vertical-align: 1px; }
  .rel-more { margin: 12px 0 0; }
  .regional { margin-top: 18px; border-left: 4px solid var(--heat); }
  .reg-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin-top: 8px; }
  .reg { min-width: 0; }
  .reg-name { font-weight: 700; margin: 0 0 4px; }
  .reg p { font-size: 15px; }
  .who { margin-top: 18px; border-left: 4px solid var(--steel); }
  .issue-related { display: flex; flex-wrap: wrap; gap: 10px; margin: 18px 0 0; }
  .srcs { margin-top: 18px; border-left: 4px solid var(--steel); }
  .srcs ul.clean { font-size: 14px; }
  .srcs a { overflow-wrap: anywhere; }
</style>
