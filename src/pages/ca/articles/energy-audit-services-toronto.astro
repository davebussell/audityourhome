  erl: 'https://www.toronto.ca/services-payments/water-environment/environmental-grants-incentives/energy-retrofit-loans/',
  hiris: 'https://www.toronto.ca/community-people/community-partners/apartment-building-operators/tower-renewal/hi-ris/',
