const SRC = {
  ashrae: 'https://www.ashrae.org/technical-resources/standards-and-guidelines/read-only-versions-of-ashrae-standards',
  pei: 'https://www.princeedwardisland.ca/en/information/energy/strategic-energy-solutions-for-business-commercial-and-community-buildings',
