const title = 'Energy audit and energy management services in Toronto (2026): a guide for building owners | AuditYourHome';
const description =
  'Energy audits and energy management for Toronto commercial and multi-unit buildings: ASHRAE Standard 211 audit levels, who performs a mechanical engineering energy audit, monitoring and retro-commissioning, Ontario and City of Toronto reporting rules, and the Save on Energy, Enbridge and City programs that help pay.';

const faqs = [
  {
    q: 'What are energy audit and energy management services?',
    a: 'An energy audit is a one-time engineering study of where a building uses energy and what to fix. Energy management is the ongoing work that keeps the savings: benchmarking and reporting, monitoring with interval-meter data, retro-commissioning (tuning the systems a building already has) and, in larger organizations, a dedicated energy manager. In Toronto, buildings of 50,000 sq ft and up already report energy and water use every year to the Province and the City.',
  },
  {
    q: 'What is a mechanical engineering energy audit?',
    a: 'Usually an ASHRAE Level 2 or Level 3 audit of a building’s mechanical systems (heating, cooling, ventilation, hot water and controls) by an engineering firm, with costed recommendations. The City of Toronto’s retrofit loans ask for a facility description at ASHRAE Level 2 or equivalent and a feasibility study by a qualified third party such as a Professional Engineer or Certified Energy Manager. For a house, the comparable job is an EnerGuide evaluation plus a CSA F280 heat-loss calculation.',
  },
  {
    q: 'Do Toronto buildings have to report their energy use?',
    a: 'Buildings of 50,000 sq ft and larger report every year to Ontario (by July 1) and to the City of Toronto (by July 2) through ENERGY STAR Portfolio Manager. Under Toronto’s by-law, buildings of 10,000 to 49,999 sq ft start reporting to the City in 2027. Buildings of 100,000 sq ft and up need a certified professional to verify their data periodically.',
  },
  {
    q: 'Who pays for an energy audit of a Toronto building?',
    a: 'Enbridge Gas pays up to 50% of eligible audits and engineering studies (up to $10,000 per project for commercial customers, $20,000 for institutions) for customers using at least 100,000 m³ of gas a year, with pre-approval. Save on Energy funds retro-commissioning studies and pays for measured electricity savings, and the City offers free tune-up assessments for small non-profit, community and business buildings.',
  },
  {
    q: 'What is the difference between ASHRAE Level 1, 2 and 3 audits?',
    a: 'They are increasingly detailed. A Level 1 audit produces a list of recommended projects with estimated savings and costs. A Level 2 audit adds a savings and cost analysis of practical measures and operating changes, and flags major capital projects. A Level 3 audit analyzes those capital-intensive projects in depth.',
  },
];

const schema = [
