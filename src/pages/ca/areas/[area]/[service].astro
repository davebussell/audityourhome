---
import Base from '../../../../layouts/Base.astro';
import LeadForm from '../../../../components/LeadForm.astro';
import Photo from '../../../../components/Photo.astro';
import HousingPortrait from '../../../../components/HousingPortrait.astro';
import RegionalNeeds from '../../../../components/RegionalNeeds.astro';
import { placeClimate, TEST_FOR_CA_SERVICE } from '../../../../lib/climate';
import { breadcrumbSchema, faqSchema } from '../../../../lib/schema';
import { areaIndex, loadArea, fmt } from '../../../../lib/areas';
import type { Area, AreaPage, AreaService, AreaProviders } from '../../../../lib/areas';
import { ogFor } from '../../../../lib/photos';

export function getStaticPaths() {
  const out = [];
  for (const entry of areaIndex.areas) {
    const full = loadArea(entry.slug);
    const { pages, ...area } = full;
    for (const s of full.services) {
      out.push({ params: { area: entry.slug, service: s.slug }, props: { page: pages[s.slug], area, service: s } });
    }
  }
  return out;
}

interface Props {
  page: AreaPage;
  area: Omit<Area, 'pages'>;
  service: AreaService;
}
const { page: pg, area, service } = Astro.props;

/** City services that exist as /services/<svc>/<city>/ pages */
const CITY_SERVICES = new Set(['home-energy-audit', 'heat-loss-calculation', 'radon-testing', 'mold-testing', 'well-water-testing']);
const cityHref = (slug: string) => (CITY_SERVICES.has(service.slug) ? `/ca/services/${service.slug}/${slug}/` : `/ca/cities/${slug}/`);

const path = `/ca/areas/${area.slug}/${service.slug}/`;
const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/ca/' },
    { name: 'Areas', path: '/ca/areas/' },
    { name: area.name, path: `/ca/areas/${area.slug}/` },
    { name: service.name, path },
  ]),
  faqSchema(pg.faq),
];

const allNames = [
  ...area.municipalities.flatMap((m) => [m.name, ...m.communities]),
  ...(area.section ? [...(area.section.aliases ?? []), ...area.section.municipalities.flatMap((m) => [m.name, ...m.communities])] : []),
  ...(area.nearbyGroup ? area.nearbyGroup.municipalities.flatMap((m) => [m.name, ...m.communities]) : []),
];

const leadHeading = service.cat === 'energy'
  ? `Get matched with a registered advisor in ${area.inName}`
  : `Ask about ${service.short.toLowerCase()} in ${area.inName}`;
const leadSub = service.cat === 'energy'
  ? 'Tell us your postal code and what you’re planning. We’ll connect you with one registered service organization that covers your community. No spam, no shared lead lists.'
  : 'Tell us your postal code and what you’re dealing with. We’ll reply with the right kind of certified professional or lab for your community, and which programs apply.';

const statusChip: Record<string, [string, string]> = {
  active: ['chip-active', 'Open'],
  'active-limited': ['chip-limited', 'Open · deadline'],
  announced: ['chip-info', 'Announced · opens 2027'],
  closed: ['chip-closed', 'Closed'],
};
const provBlocks = [pg.providers, pg.providersSection].filter(Boolean) as AreaProviders[];
const photoKey = service.photo || area.photo;

// Climate profile from the area's main nearby city (none for Northern BC).
const mainCity = area.nearbyCities[0];
const clim = mainCity ? placeClimate('ca', mainCity.slug) : null;
const climTest = TEST_FOR_CA_SERVICE[service.slug] ?? (service.slug === 'wood-burning-inspection' ? 'wood-burning-inspection' : undefined);
const climHasTest = !!clim && !!climTest && (clim.profile.tests.some((t) => t.test === climTest)
  || clim.profile.priorities.some((x) => x.tests.includes(climTest)));
const climVariant: 'compact' | 'service' | null = !clim ? null
  : service.slug === 'home-energy-audit' ? 'compact' : climHasTest ? 'service' : null;
---

<Base title={pg.title} description={pg.description} schema={schema} ogImage={ogFor(photoKey)}>
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/ca/areas/">Areas</a> <span aria-hidden="true">/</span>
      <a href={`/ca/areas/${area.slug}/`}>{area.name}</a> <span aria-hidden="true">/</span>
      <span>{service.name}</span>
    </nav>

    <div class="page-hero has-photo">
      <div class="hero-text">
        <p class="eyebrow">{pg.kicker} · checked {area.checked}</p>
        <h1>{pg.h1}</h1>
        <p class="lede">{pg.lede}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#lead-form">{service.cat === 'energy' ? `Get matched in ${area.inName}` : 'Ask a question'} →</a>
          <a class="btn btn-ghost" href={service.guide}>{service.guideLabel}</a>
        </div>
      </div>
      <Photo name={photoKey} eager sizes="(max-width: 860px) calc(100vw - 44px), 500px" />
    </div>

    <div class="glance">
      {pg.glance.map((x) => (
        <div class="g"><p class="k">{x.k}</p><p class="v">{x.v}</p>{x.sub && <p class="s">{x.sub}</p>}</div>
      ))}
    </div>

    <div class="layout">
      <article class="main">
        <HousingPortrait
          slug={`area-${area.slug}`}
          name={area.name}
          era={area.stats.era}
          houses={area.stats.houses}
          hdd={area.portrait.hdd}
          designHeat={area.portrait.designHeat}
          heading={`How ${area.inName} is built`}
          housesLabel="single-detached, semi-detached, row, duplex and mobile homes"
          climateSource={area.portrait.source}
        />

        <p class="scope small">{area.scope}</p>

        {pg.sections.map((s) => (
          <section class="sec">
            <h2>{s.h2}</h2>
            <div class="prose" set:html={s.html} />
          </section>
        ))}

        {clim && mainCity && climVariant && (
          <RegionalNeeds
            country="ca"
            profile={clim.profile}
            placeName={mainCity.name}
            variant={climVariant}
            testSlug={climVariant === 'service' ? climTest : undefined}
            heading={climVariant === 'compact' ? `${area.inName}’s climate: ${clim.profile.label}` : `What this means in ${area.inName}’s climate`}
            moreHref={`/ca/cities/${mainCity.slug}/#regional-needs`}
          />
        )}

        <section class="sec comms" id="communities" data-communities={allNames.join('|')}>
          <h2>Communities we cover in {area.inName}</h2>
          <p class="small">Every town, village and hamlet below is part of this page, grouped by municipality (2021 Census population).</p>
          <ul class="mlist">
            {area.municipalities.map((m) => (
              <li><strong>{m.label}</strong> <span class="pop">{fmt(m.pop)}</span>{m.communities.length > 0 && <span class="cm">{m.communities.join(', ')}</span>}</li>
            ))}
          </ul>
          {area.section && (
            <>
              <h3>{area.section.name}</h3>
              <ul class="mlist">
                {area.section.municipalities.map((m) => (
                  <li><strong>{m.label}</strong> <span class="pop">{fmt(m.pop)}</span>{m.communities.length > 0 && <span class="cm">{m.communities.join(', ')}</span>}</li>
                ))}
              </ul>
            </>
          )}
          {area.nearbyGroup && (
            <>
              <h3>{area.nearbyGroup.label}</h3>
              <ul class="mlist">
                {area.nearbyGroup.municipalities.map((m) => (
                  <li><strong>{m.label}</strong> <span class="pop">{fmt(m.pop)}</span>{m.communities.length > 0 && <span class="cm">{m.communities.join(', ')}</span>}</li>
                ))}
              </ul>
            </>
          )}
          {area.coveredCities.length > 0 && (
            <p class="small covered">
              Covered on city pages:{' '}
              {area.coveredCities.map((c, i) => (
                <>
                  {i > 0 && '; '}
                  <a href={cityHref(c.slug)}>{c.name}</a>{c.communities.length > 0 && ` (${c.communities.join(', ')})`}
                </>
              ))}.
            </p>
          )}
        </section>

        {provBlocks.map((pb) => (
          <section class="sec providers" id={pb.key === 'main' ? 'providers' : `providers-${pb.key}`}>
            <h2>{pb.heading}</h2>
            <p class="small">{pb.note}</p>
            {area.prov === 'ON' && (
              <p class="small hrs-line">
                Only assessments from the seven HRSP-approved organizations qualify for the $600
                <a href="/ca/programs/home-renovation-savings-assessment/">Home Renovation Savings</a> rebate
                and its assessment-path upgrade rebates; each listing below says whether it's one of them.
              </p>
            )}
            <ul class="plist">
              {pb.items.map((p) => (
                <li class="prow">
                  <div class="pname">
                    {p.profile ? <a href={p.profile}><strong>{p.name}</strong></a> : <strong>{p.name}</strong>}
                    <span class="chips">
                      {area.prov === 'ON' && (p.hrs
                        ? <a class="chip chip-active" href="/ca/programs/home-renovation-savings-assessment/" title="One of the seven organizations approved for Ontario's Home Renovation Savings assessment path">HRSP-approved: Yes</a>
                        : <span class="chip chip-neutral" title="Not one of the seven organizations approved for Ontario's Home Renovation Savings assessment path">HRSP-approved: No</span>)}
                      {p.gcc && <span class="chip chip-neutral" title="Member of the Green Communities Canada non-profit network">Non-profit network</span>}
                      {p.profile && <span class="chip chip-info">Profile</span>}
                    </span>
                  </div>
                  <div class="pmeta">
                    {p.phone && <a class="tel" href={`tel:${p.phone.replace(/[^0-9+]/g, '')}`}>{p.phone}</a>}
                    <span class="towns">{p.allTowns ? `All ${pb.towns.length} towns` : p.towns.join(', ')}</span>
                  </div>
                </li>
              ))}
            </ul>
            <p class="meta">Source: NRCan list of service organizations, checked {area.checked}, matched by forward sortation area ({pb.fsas.join(', ')}). Call to confirm your road is covered.</p>
          </section>
        ))}

        {pg.programs && pg.programs.items.length > 0 && (
          <section class="sec" id="programs">
            <h2>{pg.programs.heading}</h2>
            <div class="progs">
              {pg.programs.items.map((p) => (
                <a class="card prog" href={p.href}>
                  <span class="pk">{p.kind}{p.audit ? ' · needs an evaluation' : ''}</span>
                  <strong>{p.name}</strong>
                  <span class="ps">{p.summary}</span>
                  {statusChip[p.status] && <span class={`chip ${statusChip[p.status][0]}`}>{statusChip[p.status][1]}</span>}
                </a>
              ))}
            </div>
          </section>
        )}

        <section class="sec">
          <h2>{service.name} in {area.inName}: common questions</h2>
          {pg.faq.map((f) => (
            <details class="faq"><summary>{f.q}</summary><div class="faq-body"><p>{f.a}</p></div></details>
          ))}
        </section>
      </article>

      <aside class="side">
        <div class="card card-pad snap">
          <p class="eyebrow">Area snapshot · {area.name}</p>
          <dl>
            {pg.snapshot.map((x) => (<><dt>{x.k}</dt><dd>{x.v}</dd></>))}
          </dl>
          <a class="more" href={`/ca/areas/${area.slug}/`}>The {area.name} area guide →</a>
        </div>
        <nav class="card card-pad rel" aria-label={`Other services in ${area.inName}`}>
          <p class="eyebrow">More in {area.name}</p>
          <ul>
            {pg.related.map((r) => <li><a href={r.href}>{r.label}</a></li>)}
          </ul>
        </nav>
        {(area.nearbyCities.length > 0 || area.articles.length > 0 || area.sitePages.length > 0) && (
          <nav class="card card-pad rel" aria-label="Nearby city pages and guides">
            <p class="eyebrow">Nearby and related</p>
            <ul>
              {area.nearbyCities.map((c) => <li><a href={cityHref(c.slug)}>{CITY_SERVICES.has(service.slug) ? `${service.short} in ${c.name}` : `${c.name} city guide`}</a></li>)}
              {area.articles.map((x) => <li><a href={x.href}>{x.label}</a></li>)}
              {area.sitePages.map((x) => <li><a href={x.href}>{x.label}</a></li>)}
              {service.hub && <li><a href={service.hub}>{service.name} in 70 cities</a></li>}
            </ul>
          </nav>
        )}
      </aside>
    </div>

    <div class="card card-pad srcs">
      <h3>Sources</h3>
      <ul>
        {pg.sources.map((s) => <li><a href={s.href} rel="noopener">{s.label}</a></li>)}
      </ul>
      <p class="meta">Checked {area.checked}. Census figures are 2021 totals for the municipalities listed; the climate normal is Environment and Climate Change Canada's station {area.portrait.station} ({area.portrait.stationKm} km from the area's centre point).</p>
    </div>

    <LeadForm heading={leadHeading} sub={leadSub} region={area.leadRegion} context={`area-${service.slug}-${area.slug}`} />
  </div>
</Base>

<style>
  .glance { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 6px 0 30px; }
  .glance .g { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; min-width: 0; }
  .glance .k { font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); margin-bottom: 4px; }
  .glance .v { font-family: var(--mono); font-weight: 600; font-size: 16px; color: var(--ink); margin: 0; overflow-wrap: anywhere; }
  .glance .s { font-size: 12.5px; color: var(--muted); margin: 2px 0 0; line-height: 1.35; }
  @media (max-width: 840px) { .glance { grid-template-columns: repeat(2, 1fr); } }

  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 40px; align-items: start; }
  @media (max-width: 960px) { .layout { grid-template-columns: 1fr; gap: 28px; } }
  .main { min-width: 0; }
  .scope { margin: 18px 0 0; max-width: 70ch; padding-left: 12px; border-left: 3px solid var(--line-strong); }
  .sec { margin-top: 34px; padding: 0; }
  .sec h2 { font-size: 24px; margin-bottom: 12px; }
  .sec h3 { font-size: 17px; margin: 18px 0 8px; }
  .prose { max-width: 70ch; }
  .prose :global(p) { margin: 0 0 1em; }
  .prose :global(ul) { padding-left: 20px; margin: 0 0 1em; display: grid; gap: 6px; }
  .prose :global(a) { overflow-wrap: anywhere; }
  .prose :global(table) { margin: 0 0 1.2em; }

  .mlist { list-style: none; margin: 10px 0 6px; padding: 0; border-top: 1px solid var(--line); max-width: 78ch; }
  .mlist li { padding: 9px 2px; border-bottom: 1px solid var(--line); font-size: 15px; line-height: 1.5; }
  .mlist .pop { font-family: var(--mono); font-size: 12.5px; color: var(--faint); margin-left: 6px; }
  .mlist .cm { display: block; color: var(--muted); font-size: 14px; }
  .covered { margin-top: 12px; max-width: 78ch; }

  .plist { list-style: none; margin: 12px 0 10px; padding: 0; border-top: 1px solid var(--line); }
  .prow { display: flex; justify-content: space-between; align-items: center; gap: 10px 20px; flex-wrap: wrap; padding: 12px 2px; border-bottom: 1px solid var(--line); }
  .pname { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; min-width: 0; }
  .pname a { text-decoration: none; }
  .chips { display: inline-flex; flex-wrap: wrap; gap: 6px; }
  .chips a { text-decoration: none; }
  .pmeta { display: flex; align-items: center; gap: 6px 16px; flex-wrap: wrap; font-size: 14px; color: var(--muted); min-width: 0; }
  .tel { font-family: var(--mono); font-size: 13.5px; font-weight: 600; white-space: nowrap; }
  .towns { font-size: 12.5px; overflow-wrap: anywhere; }

  .progs { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
  .prog { display: grid; gap: 6px; align-content: start; padding: 16px 18px; text-decoration: none; color: var(--ink); border-left: 4px solid var(--pine); }
  .prog:hover { border-color: var(--pine); box-shadow: var(--shadow-md); color: var(--ink); }
  .prog .pk { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.04em; color: var(--pine); text-transform: uppercase; }
  .prog .ps { font-size: 14px; color: var(--muted); line-height: 1.5; }
  .prog .chip { justify-self: start; }

  .side { display: grid; gap: 16px; position: sticky; top: 84px; }
  @media (max-width: 960px) { .side { position: static; } }
  .snap dl { margin: 0; display: grid; grid-template-columns: 1fr auto; gap: 8px 12px; font-size: 14px; }
  .snap dt { color: var(--muted); }
  .snap dd { margin: 0; font-family: var(--mono); font-weight: 600; font-size: 13.5px; text-align: right; }
  .snap .more { display: inline-block; margin-top: 14px; font-weight: 600; font-size: 14px; }
  .rel ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; font-size: 14px; }
  .side .eyebrow { margin-bottom: 10px; }

  .srcs { border-left: 4px solid var(--steel); margin: 30px 0 26px; }
  .srcs ul { margin: 0 0 10px; padding-left: 20px; display: grid; gap: 6px; font-size: 14px; }
  .srcs a { overflow-wrap: anywhere; }
</style>
