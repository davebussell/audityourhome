---
import Base from '../../../layouts/Base.astro';
import Photo from '../../../components/Photo.astro';
import LeadForm from '../../../components/LeadForm.astro';
import { breadcrumbSchema } from '../../../lib/schema';
import { areaIndex, fmt } from '../../../lib/areas';
import { ogFor } from '../../../lib/photos';

const areas = areaIndex.areas;
const totalCommunities = areas.reduce((n, a) => n + a.communityCount, 0);
const provs = [
  { code: 'ON', name: 'Ontario' },
  { code: 'BC', name: 'British Columbia' },
];
const title = `Area guides: home energy audits, radon and well water testing in ${totalCommunities} towns and hamlets | AuditYourHome`;
const description = `County and regional guides for ${areas.length} areas around the cities we cover, from Simcoe County and Muskoka to the Okanagan and Northern BC: EnerGuide audits, heat loss calculations, radon, mould, well water and WETT inspections, with local health-unit, climate and census data.`;
const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/ca/' },
    { name: 'Areas', path: '/ca/areas/' },
  ]),
];
const SHOW = 14;
---

<Base title={title} description={description} schema={schema} ogImage={ogFor('region-ontario')}>
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/ca/">Home</a> <span aria-hidden="true">/</span> <span>Areas</span></nav>

    <div class="page-hero has-photo">
      <div class="hero-text">
        <p class="eyebrow">{areas.length} area guides · {totalCommunities} communities · checked {areaIndex.checked}</p>
        <h1>Area guides for the towns and hamlets around our cities</h1>
        <p class="lede">
          Most of our local pages are for cities. These guides cover the counties and regions around them, town by town,
          with the numbers that shape an energy audit or a home health test there: the local health unit's radon and well-water
          programs, climate normals, the housing stock and the energy advisors registered for nearby postal codes.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#ontario">Ontario areas ↓</a>
          <a class="btn btn-ghost" href="/ca/cities/">Browse the 70 city guides</a>
        </div>
      </div>
      <Photo name="region-ontario" eager />
    </div>

    <section class="svcs">
      <h2>Six guides in every area</h2>
      <ul class="slist">
        {areaIndex.services.map((s) => (
          <li><strong>{s.name}</strong><span>{s.blurb}</span><a href={s.guide}>{s.guideLabel} →</a></li>
        ))}
      </ul>
    </section>

    {provs.map((p) => (
      <section class="prov" id={p.code === 'ON' ? 'ontario' : 'bc'}>
        <h2>{p.name}</h2>
        <div class="alist">
          {areas.filter((a) => a.prov === p.code).map((a) => (
            <article class="card acard" data-communities={a.communities.join('|')}>
              <h3><a href={`/ca/areas/${a.slug}/`}>{a.name}</a></h3>
              <p class="kind small">{a.kind}</p>
              <p class="nums"><span>{fmt(a.pop)} people</span><span>{a.communityCount} communities</span></p>
              <p class="cm">
                {a.communities.slice(0, SHOW).join(', ')}{a.communities.length > SHOW ? `, and ${a.communities.length - SHOW} more` : ''}.
              </p>
              {a.coveredCities.length > 0 && (
                <p class="small cc">City pages nearby: {a.coveredCities.map((c, i) => <>{i > 0 && ', '}<a href={`/ca/cities/${c.slug}/`}>{c.name}</a></>)}</p>
              )}
              <a class="go" href={`/ca/areas/${a.slug}/`}>Open the {a.name} guide →</a>
            </article>
          ))}
        </div>
      </section>
    ))}

    <div class="card card-pad note">
      <h3>How these pages are built</h3>
      <p class="mb-0 small">
        Communities come from Natural Resources Canada's geographical names database and Statistics Canada's population
        centres, grouped by municipality. Population and housing figures are from the 2021 Census,
        climate normals from Environment and Climate Change Canada, design temperatures from the National Building Code 2020,
        and radon and well-water details from Health Canada and each area's public health unit. Each guide lists its sources.
      </p>
    </div>

    <LeadForm heading="Not sure which test your home needs?" context="areas-index" />
  </div>
</Base>

<style>
  .svcs, .prov { padding: 30px 0 0; }
  .svcs h2, .prov h2 { font-size: 26px; }
  .slist { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
  .slist li { display: grid; gap: 4px; padding: 14px 16px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); font-size: 14.5px; min-width: 0; }
  .slist span { color: var(--muted); }
  .slist a { font-weight: 600; font-size: 14px; }
  .alist { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .acard { padding: 20px 22px; display: grid; gap: 6px; align-content: start; min-width: 0; }
  .acard h3 { font-size: 20px; margin: 0; }
  .acard h3 a { text-decoration: none; color: var(--ink); }
  .acard h3 a:hover { color: var(--heat-deep); }
  .kind { margin: 0; }
  .nums { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 2px 0; font-family: var(--mono); font-size: 13px; color: var(--heat-deep); }
  .cm { font-size: 14.5px; color: var(--muted); margin: 0; overflow-wrap: anywhere; }
  .cc { margin: 0; }
  .go { font-weight: 600; font-size: 14.5px; margin-top: 4px; }
  .note { border-left: 4px solid var(--steel); margin: 34px 0 26px; }
</style>
