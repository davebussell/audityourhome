---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { ogFor } from '../lib/photos';
import LeadForm from '../components/LeadForm.astro';
import { SITE } from '../config/site';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const title = 'Home energy audit (assessment) cost in Ontario (2026): real prices and the $600 rebate | AuditYourHome';
const description =
  'What a home energy assessment (EnerGuide energy audit) costs in Ontario in 2026: about $500–$700 for the first visit and $200–$450 for the follow-up, the providers that publish prices, and who qualifies for the $600 Home Renovation Savings rebate.';

const faqs = [
  {
    q: 'How much does a home energy audit or assessment cost in Ontario in 2026?',
    a: 'Typical Ontario prices are about $500–$700 for the initial EnerGuide evaluation and $200–$450 for the follow-up, plus HST where it applies: Windfall Ecology Centre charges $500 and $250 plus HST, Reep Green Solutions $540 and $406 with no HST, and the City-backed programs in London and Waterloo Region quote $500–$700 as typical for the first visit. NRCan puts the two visits together at $600–$1,000 on average. Larger homes cost more. The Home Renovation Savings Program pays back $600 toward the two assessments once you install at least two recommended upgrades, but only assessments from the seven HRSP-approved organizations qualify. If an approved organization charges in the typical range, that leaves roughly $100–$550 plus HST; with any other provider you pay the full price.',
  },
  {
    q: 'Which providers qualify for the $600 assessment rebate?',
    a: 'Only the seven organizations approved for the Home Renovation Savings assessment path: AmeriSpec, Canada Energy Audit, Energy Werx, Greenbrain, NRGwise, The Energuy and The Home Inspectors Group. The same organization has to do both assessments. Book the follow-up by November 30, 2026; it must be done within 180 days of the first visit or by December 31, 2026, whichever comes first. None of the seven publishes a price, so ask for a written quote.',
  },
  {
    q: 'Why do so few providers publish prices?',
    a: 'Habit, mostly. The industry runs on phone quotes, and NRCan itself tells homeowners prices vary by location and home size. We show published prices on each provider’s card and list those providers first; transparency is the sort we reward.',
  },
  {
    q: 'Is a "free energy audit" real?',
    a: 'In Ontario, a truly free EnerGuide assessment is rare — free walkthroughs are usually sales visits for insulation, windows, or HVAC. A real assessment includes a blower door test and produces an EnerGuide rating and report from an NRCan-registered advisor. If there is no blower door, it is not the audit the rebate programs require.',
  },
  {
    q: 'What does the price include?',
    a: 'The initial visit takes about two hours on site: a blower door airtightness test, insulation levels in the walls, ceilings and basement, an inventory of windows and exterior doors, and the size and efficiency of your heating, cooling and water heating equipment. Afterwards you get your EnerGuide rating, label and a renovation upgrade report. The follow-up visit takes about an hour, re-tests after your upgrades and unlocks the rebates.',
  },
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Cost guide', path: '/cost/' },
  ]),
  faqSchema(faqs),
];
---

<Base title={title} description={description} schema={schema} ogImage={ogFor('energy-bill-analysis')}>
  <div class="container">
    <div class="page-hero has-photo">
      <div class="hero-text">
      <p class="eyebrow">Cost guide · updated {SITE.dataReviewDate}</p>
      <h1>Home energy audit (assessment) cost in Ontario</h1>
      <p class="lede measure">
        Short version: expect about <strong>$500–$700</strong> for the initial EnerGuide
        evaluation and <strong>$200–$450</strong> for the follow-up, plus HST where it applies. Ontario's Home Renovation Savings program pays a <strong>$600
        rebate</strong> toward the two visits, but only assessments from the seven HRSP-approved
        organizations qualify, and only once you install at least two recommended upgrades.
      </p>
      </div>
      <Photo name={'energy-bill-analysis'} eager />
    </div>

    <div class="tablewrap card">
      <table class="stack">
        <caption class="sr-only">Ontario home energy audit costs, 2026</caption>
        <thead>
          <tr><th>Item</th><th>Typical price</th><th>Notes</th></tr>
        </thead>
        <tbody>
          <tr><td data-label="Item"><strong>Initial EnerGuide evaluation</strong></td><td data-label="Typical price"><span class="money">$500–$700</span> + HST where it applies</td><td data-label="Notes">Blower door, measurements, rating, upgrade report. Published: Windfall $500 + HST; Reep $540, no HST. London and Waterloo Region city programs: $500–$700 typical</td></tr>
          <tr><td data-label="Item"><strong>Follow-up evaluation</strong></td><td data-label="Typical price"><span class="money">$200–$450</span> + HST where it applies</td><td data-label="Notes">Re-test after upgrades. Published: Windfall $250 + HST; Reep $406 ($440 if another organization did the first visit)</td></tr>
          <tr><td data-label="Item">Large-home surcharge</td><td data-label="Typical price"><span class="money">$50–$275</span></td><td data-label="Notes">Windfall adds $50–$150 above 2,500 sq ft; Reep adds $50–$275 above 3,000 sq ft</td></tr>
          <tr><td data-label="Item">HRSP assessment rebate</td><td data-label="Typical price"><span class="money">−$600</span></td><td data-label="Notes">HRSP-approved organizations only, the same one for both visits; paid after 2+ recommended upgrades; follow-up booked by Nov 30 and done within 180 days or by Dec 31, 2026, whichever comes first</td></tr>
          <tr><td data-label="Item"><strong>Net cost, HRSP-approved organization</strong></td><td data-label="Typical price"><span class="money">About $100–$550</span> + HST</td><td data-label="Notes">If its prices fall in the typical range and you finish the rebate path</td></tr>
          <tr><td data-label="Item"><strong>Net cost, any other provider</strong></td><td data-label="Typical price"><span class="money">Full price</span></td><td data-label="Notes">No Home Renovation Savings assessment rebate</td></tr>
        </tbody>
      </table>
    </div>

    <div class="measure prose">
      <h2>The honest context</h2>
      <p>
        NRCan says the pre- and post-retrofit evaluations together cost
        <a href="https://natural-resources.canada.ca/energy-efficiency/home-energy-efficiency/find-service-organizations-existing-homes" rel="noopener" target="_blank">$600 to $1,000 on average</a>,
        and most providers don't publish prices. Two in our directory do: Windfall Ecology Centre
        ($500 initial and $250 follow-up, plus HST) and Reep Green Solutions ($540 and $406, with no
        HST because it's a registered charity; Kitchener Utilities gas customers pay $490 for the
        first visit). Neither is one of the seven HRSP-approved organizations, so their evaluations
        don't earn the $600 rebate, and none of the seven publishes a price. That opacity is an
        industry habit, not a law of nature, and it's why we surface published prices first.
      </p>
      <p>
        Some cities add their own help. For a limited time, <a href="https://betterhomesottawa.ca/rebate-and-incentive-programs/better-homes-loan-program/" rel="noopener" target="_blank">Better Homes Ottawa</a>
        takes $600 off its retrofit loans for participants who aren't getting the Home Renovation
        Savings assessment rebate, and <a href="https://betterhomesptbo.ca/loan-program/" rel="noopener" target="_blank">Better Homes Peterborough</a>
        pays $600 toward an EnerGuide assessment for loan participants who finish their retrofit and
        aren't getting a similar rebate elsewhere.
      </p>
      <p>
        Two warnings worth their weight: first, the federal <strong>Greener Homes Grant and Loan are
        closed</strong> — any site or salesperson promising them is out of date, including on the cost
        of "free" evaluations those programs once subsidized. Second, a <strong>"free audit" from an
        insulation or HVAC company is a sales visit</strong>, not an EnerGuide assessment — it won't
        qualify you for the assessment-path rebates, and its recommendations tend to match what the
        company sells.
      </p>
      <p>
        Whether the audit pays for itself depends on your home, which is exactly what it measures:
        the renovation upgrade report lists the recommended upgrades with their estimated energy
        savings and your EnerGuide rating before and after them
        (<a href="https://natural-resources.canada.ca/energy-efficiency/product-energy-ratings/energuide/after-your-energuide-home-evaluation" rel="noopener" target="_blank">NRCan ↗</a>).
        Start with <a href="/plan/">the planner</a> to see your likely numbers before you book.
      </p>
    </div>

    <h2>Common questions</h2>
    <div class="measure">
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <div class="faq-body"><p>{f.a}</p></div>
        </details>
      ))}
    </div>

    <LeadForm
      heading="Get a real quote"
      sub="We'll match you with a registered service organization for your area — and tell you if a published-price provider serves you."
      context="cost-guide"
    />
  </div>
</Base>

<style>
  .tablewrap { margin-bottom: 32px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .prose { margin-bottom: 36px; }
  .prose h2 { margin-top: 8px; }
</style>
