---
import Base from '../../../layouts/Base.astro';
import LeadForm from '../../../components/LeadForm.astro';
import CalcStyles from '../../../components/calc/CalcStyles.astro';
import EnergyCostsCalc from '../../../components/calc/EnergyCostsCalc.astro';
import EnergyGlance from '../../../components/calc/EnergyGlance.astro';
import UpgradePaybackCalc from '../../../components/calc/UpgradePaybackCalc.astro';
import UpgradeGlance from '../../../components/calc/UpgradeGlance.astro';
import HomeHealthCalc from '../../../components/calc/HomeHealthCalc.astro';
import HealthGlance from '../../../components/calc/HealthGlance.astro';
import ApplianceEnergyCalc from '../../../components/calc/ApplianceEnergyCalc.astro';
import ApplianceGlance from '../../../components/calc/ApplianceGlance.astro';
import HowWeCalculate from '../../../components/calc/HowWeCalculate.astro';
import CityIndex from '../../../components/calc/CityIndex.astro';
import { breadcrumbSchema, faqSchema } from '../../../lib/schema';
import { ogFor } from '../../../lib/photos';
import { CALC_META, CALC_SLUGS, CALC_CITIES, cityBySlug, cityName, type CalcSlug } from '../../../lib/calc/data';
import { energyPage } from '../../../lib/calc/pages/energy';
import { upgradePage } from '../../../lib/calc/pages/upgrade';
import { healthPage } from '../../../lib/calc/pages/health';
import { appliancePage } from '../../../lib/calc/pages/appliance';
import { LEAD_AREA, SERVICE_LINKS, otherCalcs } from '../../../lib/calc/pages/common';
import { stationName } from '../../../lib/calc/format';

export function getStaticPaths() {
  return CALC_SLUGS.flatMap((calc) => CALC_CITIES.map((c) => ({ params: { calc, city: c.slug } })));
}

const { calc, city: slug } = Astro.params as { calc: CalcSlug; city: string };
const city = cityBySlug(slug);
const name = cityName(city);
const meta = CALC_META[calc];
const page: any =
  calc === 'upgrade-payback' ? upgradePage(city)
  : calc === 'home-health' ? healthPage(city)
  : calc === 'appliance-energy' ? appliancePage(city)
  : energyPage(city);
const path = `/calculators/${calc}/${city.slug}/`;
const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Calculators', path: '/calculators/' },
    { name: meta.name, path: `/calculators/${calc}/` },
    { name, path },
  ]),
  faqSchema(page.faqs),
];
const area = city.prov === 'ON' ? city.onRegion ?? 'other-ontario' : LEAD_AREA[city.prov] ?? '';
const others = otherCalcs(calc, city);
---

<Base title={page.title} description={page.description} schema={schema} ogImage={ogFor(meta.photo)}>
  <CalcStyles />
  <div class="container cpage">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/calculators/">Calculators</a> <span aria-hidden="true">/</span>
      <a href={`/calculators/${calc}/`}>{meta.name}</a> <span aria-hidden="true">/</span>
      <span>{name}</span>
    </nav>

    <div class="page-hero calc-hero">
      <p class="eyebrow">{page.kicker}</p>
      <h1>{page.h1}</h1>
      <p class="lede" set:html={page.lede} />
    </div>

    <div class="facts-strip">
      {page.facts.map((f) => (
        <div class="g"><p class="k">{f.k}</p><p class="v">{f.v}</p>{f.s && <p class="s">{f.s}</p>}</div>
      ))}
    </div>

    {calc === 'energy-costs' && <EnergyCostsCalc payload={page.payload} rp={page.rp} cityName={name} />}
    {calc === 'upgrade-payback' && <UpgradePaybackCalc payload={page.payload} cityName={name} />}
    {calc === 'home-health' && <HomeHealthCalc payload={page.payload} cityName={name} />}
    {calc === 'appliance-energy' && <ApplianceEnergyCalc payload={page.payload} cityName={name} priceNote={page.priceNote} />}

    {calc === 'energy-costs' && <EnergyGlance page={page} cityName={name} />}
    {calc === 'upgrade-payback' && <UpgradeGlance page={page} cityName={name} provName={city.provName} />}
    {calc === 'home-health' && <HealthGlance page={page} cityName={name} provName={city.provName} />}
    {calc === 'appliance-energy' && <ApplianceGlance page={page} cityName={name} />}

    <section class="sec" id="faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Common questions in {name}</h2>
      <div class="faq-wrap">
        {page.faqs.map((f) => (
          <details class="faq"><summary>{f.q}</summary><div class="faq-body"><p>{f.a}</p></div></details>
        ))}
      </div>
    </section>

    <HowWeCalculate calc={calc} cityName={name} hdd={city.hot2000.hdd} annualMean={city.eccc.annualMean} prov={city.prov} />

    <section class="sec" aria-labelledby="more-h">
      <h2 id="more-h">More for {name}</h2>
      <div class="calc-cards">
        {others.map((o) => (
          <a class="card calc-card" href={o.href}><strong>{o.label}</strong><span>{o.blurb}</span></a>
        ))}
      </div>
      <div class="linkrow">
        <a class="primary" href="/plan/">Build your upgrade plan →</a>
        <a href={`/cities/${city.slug}/`}>All home services in {name}</a>
        {SERVICE_LINKS[calc].map((s) => <a href={`/services/${s.slug}/${city.slug}/`}>{s.label} in {name}</a>)}
        <a href={`/provinces/${city.provSlug}/`}>{city.provName} rebates and programs</a>
      </div>
    </section>

    <div class="card card-pad srcs">
      <h3>Sources</h3>
      <ul class="src-list">
        {page.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title} ↗</a></li>)}
      </ul>
      <p class="meta">Prices and programs checked October 8, 2026. Climate: NRCan HOT2000 ({city.hot2000.station}) for heating and ECCC 1981–2010 normals ({stationName(city.eccc.station)}) for cooling and temperatures.</p>
    </div>

    <section class="sec city-index" aria-labelledby="ci-h">
      <h2 id="ci-h">{meta.name} for other cities</h2>
      <CityIndex calc={calc} current={city.slug} />
    </section>

    <div class="lead-wrap">
      <LeadForm
        heading={`Want real numbers for your house in ${name}?`}
        sub="An EnerGuide evaluation measures your house and replaces every assumption on this page. Tell us your postal code and we'll connect you with a registered energy advisor for your area."
        region={area}
        context={`calc-${calc}-${city.slug}`}
      />
    </div>
  </div>
</Base>

<style>
  .calc-hero { padding-bottom: 22px; }
  .calc-hero .lede { max-width: 72ch; font-size: 18px; }
  .lead-wrap { margin: 36px 0 30px; }
</style>
