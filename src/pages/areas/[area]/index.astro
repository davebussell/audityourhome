---
import Base from '../../../layouts/Base.astro';
import Photo from '../../../components/Photo.astro';
import HousingPortrait from '../../../components/HousingPortrait.astro';
import LeadForm from '../../../components/LeadForm.astro';
import { breadcrumbSchema } from '../../../lib/schema';
import { areaIndex, loadArea, fmt } from '../../../lib/areas';
import type { Area } from '../../../lib/areas';
import { ogFor } from '../../../lib/photos';

export function getStaticPaths() {
  return areaIndex.areas.map((a) => {
    const { pages, ...area } = loadArea(a.slug);
    const hea = pages['home-energy-audit'];
    return { params: { area: a.slug }, props: { area, provCount: hea?.providers?.count ?? 0, provTowns: hea?.providers?.towns ?? [] } };
  });
}

interface Props { area: Omit<Area, 'pages'>; provCount: number; provTowns: string[] }
const { area, provCount, provTowns } = Astro.props;
const hub = area.hub;

const title = `${hub.title} | AuditYourHome`;
const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Areas', path: '/areas/' },
    { name: area.name, path: `/areas/${area.slug}/` },
  ]),
];
const byCat = (cat: string) => hub.services.filter((s) => s.cat === cat);
const cats = [
  { cat: 'energy', title: 'Energy audits and heat pump sizing' },
  { cat: 'health', title: 'Home health and safety' },
];
const statusChip: Record<string, [string, string]> = {
  active: ['chip-active', 'Open'],
  'active-limited': ['chip-limited', 'Open · deadline'],
  announced: ['chip-info', 'Announced · opens 2027'],
  closed: ['chip-closed', 'Closed'],
};
const allNames = [
  ...area.municipalities.flatMap((m) => [m.name, ...m.communities]),
  ...(area.section ? [...(area.section.aliases ?? []), ...area.section.municipalities.flatMap((m) => [m.name, ...m.communities])] : []),
  ...(area.nearbyGroup ? area.nearbyGroup.municipalities.flatMap((m) => [m.name, ...m.communities]) : []),
];
const guides = area.services.filter((s) => s.guide);
---

<Base title={title} description={hub.description} schema={schema} ogImage={ogFor(area.photo)}>
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/areas/">Areas</a> <span aria-hidden="true">/</span>
      <span>{area.name}</span>
    </nav>

    <div class="page-hero has-photo">
      <div class="hero-text">
        <p class="eyebrow">{area.provName} · area guide · {area.communityCount} communities · checked {area.checked}</p>
        <h1>{hub.h1}</h1>
        <p class="lede">{hub.lede}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={`/areas/${area.slug}/home-energy-audit/`}>Energy audits in {area.inName} →</a>
          <a class="btn btn-ghost" href="#communities">All {area.communityCount} communities</a>
        </div>
      </div>
      <Photo name={area.photo} eager />
    </div>

    <div class="glance">
      {hub.facts.map((x) => (
        <div class="g"><p class="k">{x.k}</p><p class="v">{x.v}</p>{x.sub && <p class="s">{x.sub}</p>}</div>
      ))}
    </div>

    <HousingPortrait
      slug={`area-${area.slug}`}
      name={area.name}
      era={area.stats.era}
      houses={area.stats.houses}
      hdd={area.portrait.hdd}
      designHeat={area.portrait.designHeat}
      heading={`How ${area.inName} is built`}
      housesLabel="single-detached, semi-detached, row, duplex and mobile homes"
      climateSource={area.portrait.source}
    />

    <p class="scope small measure">{area.scope}</p>

    <section class="svc" id="services">
      <h2>Six local guides for {area.inName}</h2>
      {cats.map((c) => byCat(c.cat).length > 0 && (
        <div class="cat">
          <h3>{c.title}</h3>
          <div class="pcards">
            {byCat(c.cat).map((s) => (
              <a class="pcard-link" href={`/areas/${area.slug}/${s.slug}/`}>
                <Photo name={s.photo} sizes="(max-width: 560px) calc(100vw - 44px), 280px" hud={false} plain />
                <div class="pcard-body">
                  <h3>{s.name}</h3>
                  <span class="metric">{s.metric}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="facts">
      <h2>{area.name} at a glance</h2>
      <div class="fgrid">
        {hub.cards.map((c) => <div class="card card-pad"><p class="eyebrow">{c.eyebrow}</p><p>{c.text}</p></div>)}
      </div>
    </section>

    <section class="comms" id="communities" data-communities={allNames.join('|')}>
      <h2>Every community in {area.inName}</h2>
      <p class="small measure">Grouped by municipality, with 2021 Census populations. Names come from Natural Resources Canada's geographical names database and Statistics Canada's population centres.</p>
      <ul class="mlist">
        {area.municipalities.map((m) => (
          <li><strong>{m.label}</strong> <span class="pop">{fmt(m.pop)}</span>{m.communities.length > 0 && <span class="cm">{m.communities.join(', ')}</span>}</li>
        ))}
      </ul>
      {area.section && (
        <>
          <h3>{area.section.name}</h3>
          <p class="small measure">{fmt(area.section.stats.pop)} people (2021); {area.section.stats.notOccupiedPct}% of its {fmt(area.section.stats.dwellings)} private dwellings weren't anyone's permanent home on census day.</p>
          <ul class="mlist">
            {area.section.municipalities.map((m) => (
              <li><strong>{m.label}</strong> <span class="pop">{fmt(m.pop)}</span>{m.communities.length > 0 && <span class="cm">{m.communities.join(', ')}</span>}</li>
            ))}
          </ul>
        </>
      )}
      {area.nearbyGroup && (
        <>
          <h3>{area.nearbyGroup.label}</h3>
          <ul class="mlist">
            {area.nearbyGroup.municipalities.map((m) => (
              <li><strong>{m.label}</strong> <span class="pop">{fmt(m.pop)}</span>{m.communities.length > 0 && <span class="cm">{m.communities.join(', ')}</span>}</li>
            ))}
          </ul>
        </>
      )}
      {area.coveredCities.length > 0 && (
        <>
          <h3>Covered on city pages</h3>
          <ul class="mlist">
            {area.coveredCities.map((c) => (
              <li><a href={`/cities/${c.slug}/`}><strong>{c.name}</strong></a> <span class="pop">{fmt(c.pop)}</span><span class="cm">{c.why}</span></li>
            ))}
          </ul>
        </>
      )}
    </section>

    <section class="who">
      <h2>Who does the work in {area.inName}</h2>
      <ul class="measure wlist">
        <li><strong>Energy evaluations and heat loss calculations:</strong> NRCan's list (checked {area.checked}) shows {provCount} registered service organizations for postal codes in {provTowns.join(', ')}. <a href={`/areas/${area.slug}/home-energy-audit/#providers`}>See them with phone numbers</a>; confirm they travel to your community.</li>
        <li><strong>Radon:</strong> certified measurement and mitigation professionals are listed in the <a href="https://c-nrpp.ca/find-a-professional/" rel="noopener">C-NRPP directory ↗</a>.</li>
        <li><strong>Wood stoves and chimneys:</strong> WETT-certified professionals are listed in the <a href="https://www.wettinc.ca/" rel="noopener">WETT directory ↗</a>; see <a href={`/areas/${area.slug}/wood-burning-inspection/`}>wood-burning inspections in {area.inName}</a>.</li>
        <li><strong>Well water:</strong> {area.prov === 'ON' ? 'free bacteria tests through the local public health unit; chemistry through a licensed private lab.' : 'a qualified private lab (search the CALA directory).'} <a href={`/areas/${area.slug}/well-water-testing/`}>Details for {area.inName}</a>.</li>
      </ul>
    </section>

    {hub.programs.length > 0 && (
      <section class="progsec">
        <h2>Rebates and financing for {area.inName} homes</h2>
        <div class="progs">
          {hub.programs.map((p) => (
            <a class="card prog" href={p.href}>
              <span class="pk">{p.kind}{p.audit ? ' · needs an evaluation' : ''}</span>
              <strong>{p.name}</strong>
              <span class="ps">{p.summary}</span>
              {statusChip[p.status] && <span class={`chip ${statusChip[p.status][0]}`}>{statusChip[p.status][1]}</span>}
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="nearby">
      <h2>Nearby city pages and guides</h2>
      <div class="nb">
        {area.nearbyCities.map((c) => <a href={`/cities/${c.slug}/`}><span>{c.name}</span></a>)}
        {area.articles.map((x) => <a href={x.href}><span>{x.label}</span></a>)}
        {area.sitePages.map((x) => <a href={x.href}><span>{x.label}</span></a>)}
        {guides.map((s) => <a href={s.guide}><span>{s.guideLabel}</span></a>)}
        <a class="all" href="/areas/">All area guides →</a>
      </div>
    </section>

    <div class="card card-pad srcs">
      <h3>Sources</h3>
      <ul>
        {hub.sources.map((s) => <li><a href={s.href} rel="noopener">{s.label}</a></li>)}
      </ul>
      <p class="meta">Checked {area.checked}.</p>
    </div>

    <LeadForm heading={`Planning upgrades in ${area.inName}?`} region={area.leadRegion} context={`area-${area.slug}`} />
  </div>
</Base>

<style>
  .glance { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 6px 0 26px; }
  .glance .g { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; min-width: 0; }
  .glance .k { font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); margin-bottom: 4px; }
  .glance .v { font-family: var(--mono); font-weight: 600; font-size: 16px; color: var(--ink); margin: 0; overflow-wrap: anywhere; }
  .glance .s { font-size: 12.5px; color: var(--muted); margin: 2px 0 0; line-height: 1.35; }
  @media (max-width: 840px) { .glance { grid-template-columns: repeat(2, 1fr); } }
  .scope { margin: 18px 0 0; padding-left: 12px; border-left: 3px solid var(--line-strong); }
  .facts, .svc, .who, .comms, .progsec { padding: 34px 0 0; }
  .facts h2, .svc h2, .who h2, .comms h2, .progsec h2 { font-size: 26px; }
  .comms h3 { font-size: 18px; margin: 22px 0 6px; }
  .fgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 760px) { .fgrid { grid-template-columns: 1fr; } }
  .fgrid p:last-child { margin: 0; font-size: 15px; }
  .fgrid .eyebrow { margin-bottom: 6px; }
  .cat { margin: 18px 0 8px; }
  .cat > h3 { font-size: 14px; font-family: var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 0 0 12px; }
  .pcard-body .metric { font-family: var(--mono); font-size: 12.5px; color: var(--heat-deep); }
  .mlist { list-style: none; margin: 10px 0 6px; padding: 0; border-top: 1px solid var(--line); max-width: 82ch; }
  .mlist li { padding: 9px 2px; border-bottom: 1px solid var(--line); font-size: 15px; line-height: 1.5; }
  .mlist a { text-decoration: none; }
  .mlist .pop { font-family: var(--mono); font-size: 12.5px; color: var(--faint); margin-left: 6px; }
  .mlist .cm { display: block; color: var(--muted); font-size: 14px; }
  .wlist { padding-left: 20px; display: grid; gap: 8px; font-size: 15.5px; }
  .wlist a { overflow-wrap: anywhere; }
  .progs { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
  .prog { display: grid; gap: 6px; align-content: start; padding: 16px 18px; text-decoration: none; color: var(--ink); border-left: 4px solid var(--pine); }
  .prog:hover { box-shadow: var(--shadow-md); color: var(--ink); }
  .prog .pk { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.04em; color: var(--pine); text-transform: uppercase; }
  .prog .ps { font-size: 14px; color: var(--muted); line-height: 1.5; }
  .prog .chip { justify-self: start; }
  .nearby { padding: 34px 0 8px; }
  .nearby h2 { font-size: 22px; }
  .nb { display: flex; flex-wrap: wrap; gap: 10px; }
  .nb a { display: inline-flex; align-items: center; gap: 10px; border: 1.5px solid var(--line-strong); border-radius: 999px; padding: 8px 16px; text-decoration: none; font-weight: 600; font-size: 14.5px; color: var(--ink); background: var(--card); max-width: 100%; }
  .nb a span { overflow-wrap: anywhere; }
  .nb a:hover { border-color: var(--ink); }
  .nb a.all { background: var(--ink); color: #fff; border-color: var(--ink); }
  .srcs { border-left: 4px solid var(--steel); margin: 30px 0 26px; }
  .srcs ul { margin: 0 0 10px; padding-left: 20px; display: grid; gap: 6px; font-size: 14px; }
  .srcs a { overflow-wrap: anywhere; }
</style>
