---
import { siteFor } from '../config/site';
import { websiteSchema, absolutize } from '../lib/schema';
import { countryOf, publicPath, COUNTRIES } from '../lib/country';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OtherSite from '../components/OtherSite.astro';
import '../styles/global.css';
import '../styles/glossary.css';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD blocks for this page */
  schema?: Record<string, unknown>[];
  /** Set false on utility pages (404 etc.) */
  indexable?: boolean;
  /** Social-card image path (1200×630), e.g. from ogFor() in lib/photos.ts */
  ogImage?: string;
  /** Load Google Analytics and Clarity. Off on account pages, whose addresses carry sign-in tokens. */
  analytics?: boolean;
}

const { title, description, schema = [], indexable = true, ogImage, analytics = true } = Astro.props;
/* Pages are built under /ca/ and /us/ and published at the root of each country's own domain. */
const country = countryOf(Astro.url.pathname);
const site = siteFor(country);
const ogDefault = country === 'us' ? '/og-default-us.png' : '/og-default.png';
const ogUrl = new URL(ogImage ?? ogDefault, site.url).href;
const canonical = new URL(publicPath(Astro.url.pathname), site.url).href;
const blocks = [websiteSchema(country), ...schema].map((b) => absolutize(b, site.url));
const lang = country ? COUNTRIES[country].locale : 'en';
const contentGroup = country ?? 'global';
---

<!doctype html>
<html lang={lang} data-country={country ?? 'ca'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    {country && <meta property="og:locale" content={COUNTRIES[country].ogLocale} />}
    <meta name="ayh-country" content={contentGroup} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />

    {/* Google tag (gtag.js), Click Shift Portfolio; Microsoft Clarity */}
    {analytics && (
      <Fragment>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QK0ETT28BD"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QK0ETT28BD', { content_group: (document.querySelector('meta[name="ayh-country"]') || {}).content || 'global' });
    </script>
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "yjaem8xfxi");
    </script>
      </Fragment>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@500;600&display=swap"
    />

    {blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
  </head>
  <body>
    <OtherSite country={country ?? 'ca'} />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
